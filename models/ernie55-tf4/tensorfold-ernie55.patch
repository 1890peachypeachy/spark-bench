+// Exact 4-segment MultiMax transform on FP32 logits (preserves -inf)
+extern "C" __global__ void tf_ernie55_multimax(
+    float* __restrict__ logits,
+    const float* __restrict__ ranges,  // [4]
+    const float* __restrict__ ts,      // [4]
+    int64_t count
