diff --git a/zig/build/ernie55.zig b/zig/build/ernie55.zig
new file mode 100644
index 0000000..3c64998
--- /dev/null
+++ b/zig/build/ernie55.zig
@@ -0,0 +1,25 @@
+//! ERNIE 5.5 Flash Preview CUDA family build wiring: module, standalone verification tool, and host tests.
+const std = @import("std");
+
+pub fn module(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, cuda: *std.Build.Module, core: *std.Build.Module, lanes: *std.Build.Module) *std.Build.Module {
+    const m = b.createModule(.{ .root_source_file = b.path("zig/src/families/ernie55/ernie55.zig"), .target = target, .optimize = optimize, .link_libc = true });
+    m.addImport("cuda", cuda);
+    m.addImport("core", core);
+    m.addImport("lanes", lanes);
+    return m;
+}
+
+pub fn targets(b: *std.Build, target: std.Build.ResolvedTarget, optimize: std.builtin.OptimizeMode, strip: bool, cuda: *std.Build.Module, core: *std.Build.Module, lanes: *std.Build.Module) void {
+    const mod = module(b, target, optimize, cuda, core, lanes);
+    const m = b.createModule(.{ .root_source_file = b.path("zig/src/families/ernie55/cuda_dump_main.zig"), .target = target, .optimize = optimize, .link_libc = true, .strip = strip });
+    m.addImport("cuda", cuda);
+    m.addImport("ernie55", mod);
+    const exe = b.addExecutable(.{ .name = "tf-ernie55-cuda", .root_module = m });
+    b.step("tf-ernie55-cuda", "ERNIE 5.5 Flash Preview CUDA forward parity and speed tool").dependOn(&b.addInstallArtifact(exe, .{}).step);
+}
+
+pub fn hostTests(b: *std.Build, host: std.Build.ResolvedTarget, cuda: *std.Build.Module, core: *std.Build.Module, lanes: *std.Build.Module, all: *std.Build.Step) void {
+    const run = b.addRunArtifact(b.addTest(.{ .root_module = module(b, host, .debug, cuda, core, lanes) }));
+    b.step("test-ernie55-host", "ERNIE 5.5 host tests: config, TP4 sharding, RoPE, E4M3 decode (no GPU)").dependOn(&run.step);
+    all.dependOn(&run.step);
+}
diff --git a/zig/kernels/cuda/ernie55/dsa_attn.cu b/zig/kernels/cuda/ernie55/dsa_attn.cu
new file mode 100644
index 0000000..60379e5
--- /dev/null
+++ b/zig/kernels/cuda/ernie55/dsa_attn.cu
@@ -0,0 +1,476 @@
+// ERNIE 5.5 Flash Preview MLA-DSA (6 layers: 7, 14, 21, 28, 35, 42):
+//   - MLA KV cache [capacity, 576] BF16 (512 normed kv_c + 64 roped k_pe)
+//   - Lightning Indexer K cache [capacity, 128] BF16 (LayerNorm + NeoX RoPE-64 + Hadamard-128)
+//   - Absorbed Q [rows, H_loc, 576] = [q_nope @ wk, q_rope]
+//   - Multi-head MQA MLA-DSA attention over SWA-128 + top-2048 indexer tokens + softmax_offset sink
+//   - Expanded V [rows, H_loc, 256] = o_lat @ wv^T
+
+#include <cuda_bf16.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+__device__ __forceinline__ float bf2f(__nv_bfloat16 v) { return __bfloat162float(v); }
+__device__ __forceinline__ __nv_bfloat16 f2bf(float v) { return __float2bfloat16_rn(v); }
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_down_sync(0xffffffffu, v, off);
+    }
+    return v;
+}
+
+__device__ __forceinline__ float warp_allreduce_sum(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_xor_sync(0xffffffffu, v, off);
+    }
+    return v;
+}
+
+}  // namespace
+
+// Store normed kv_c [rows, 512] + roped k_pe [rows, 64] into mla_kv[positions[r], 0..575]
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_dsa_kv_store(
+    const __nv_bfloat16* __restrict__ kv_c,  // [rows, 512]
+    const __nv_bfloat16* __restrict__ k_pe,  // [rows, 64] (already GPT-J roped)
+    const int32_t* __restrict__ positions,   // [rows]
+    __nv_bfloat16* __restrict__ mla_kv,      // [capacity, 576]
+    int rows
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    int pos = positions[r];
+    __nv_bfloat16* dst = mla_kv + (int64_t)pos * 576;
+    const __nv_bfloat16* sc = kv_c + (int64_t)r * 512;
+    const __nv_bfloat16* sp = k_pe + (int64_t)r * 64;
+    for (int i = threadIdx.x; i < 512; i += blockDim.x) dst[i] = sc[i];
+    if (threadIdx.x < 64) dst[512 + threadIdx.x] = sp[threadIdx.x];
+}
+
+// Store indexer key k_idx [rows, 128] into idx_k[positions[r], 0..127]
+// Launch: grid=(rows), block=(128)
+extern "C" __global__ void tf_ernie55_dsa_idx_k_store(
+    const __nv_bfloat16* __restrict__ k_idx,
+    const int32_t* __restrict__ positions,
+    __nv_bfloat16* __restrict__ idx_k,
+    int rows
+) {
+    int r = blockIdx.x;
+    int d = threadIdx.x;
+    if (r >= rows || d >= 128) return;
+    idx_k[(int64_t)positions[r] * 128 + d] = k_idx[(int64_t)r * 128 + d];
+}
+
+// Absorb Q into latent space:
+//   q     : [rows, H_loc, 256] BF16 (192 nope + 64 rope)
+//   wk    : [H_loc, 192, 512] BF16 (from kv_b_proj)
+//   q_abs : [rows, H_loc, 576] BF16 (512 absorbed + 64 rope)
+// Launch: grid=(ceil(512/4), H_loc, rows), block=(128) -> 1 warp per output latent dim l (0..511), plus rope copy
+extern "C" __global__ void tf_ernie55_dsa_absorb_q(
+    const __nv_bfloat16* __restrict__ q,
+    const __nv_bfloat16* __restrict__ wk,
+    __nv_bfloat16* __restrict__ q_abs,
+    int rows,
+    int H_loc
+) {
+    int r = blockIdx.z;
+    int h = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int l = blockIdx.x * 4 + warp;
+    if (r >= rows || h >= H_loc || l >= 512) return;
+
+    const __nv_bfloat16* qp = q + ((int64_t)r * H_loc + h) * 256;
+    const __nv_bfloat16* wp = wk + (int64_t)h * 192 * 512 + l;
+    float acc = 0.0f;
+    // 192 / 32 = 6 elems per lane
+    for (int d = lane; d < 192; d += 32) {
+        acc = fmaf(bf2f(qp[d]), bf2f(wp[(int64_t)d * 512]), acc);
+    }
+    acc = warp_sum(acc);
+    __nv_bfloat16* dst = q_abs + ((int64_t)r * H_loc + h) * 576;
+    if (lane == 0) {
+        dst[l] = f2bf(acc);
+        if (l < 64) {
+            dst[512 + l] = qp[192 + l];
+        }
+    }
+}
+
+// Expand V from latent space:
+//   o_lat : [rows, H_loc, 512] BF16
+//   wv    : [H_loc, 256, 512] BF16 (row-major [h, d, l]!)
+//   o_v   : [rows, H_loc, 256] BF16
+// Launch: grid=(ceil(256/4), H_loc, rows), block=(128) -> 1 warp per output v_dim d (0..255)
+extern "C" __global__ void tf_ernie55_dsa_expand_v(
+    const __nv_bfloat16* __restrict__ o_lat,
+    const __nv_bfloat16* __restrict__ wv,
+    __nv_bfloat16* __restrict__ o_v,
+    int rows,
+    int H_loc
+) {
+    int r = blockIdx.z;
+    int h = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int d = blockIdx.x * 4 + warp;
+    if (r >= rows || h >= H_loc || d >= 256) return;
+
+    const __nv_bfloat16* op = o_lat + ((int64_t)r * H_loc + h) * 512;
+    const __nv_bfloat16* wp = wv + ((int64_t)h * 256 + d) * 512;
+    float acc = 0.0f;
+    for (int l = lane * 4; l < 512; l += 128) {
+        uint2 ov = *reinterpret_cast<const uint2*>(op + l);
+        uint2 wv2 = *reinterpret_cast<const uint2*>(wp + l);
+        const __nv_bfloat16* o2 = reinterpret_cast<const __nv_bfloat16*>(&ov);
+        const __nv_bfloat16* w2 = reinterpret_cast<const __nv_bfloat16*>(&wv2);
+        acc = fmaf(bf2f(o2[0]), bf2f(w2[0]), acc);
+        acc = fmaf(bf2f(o2[1]), bf2f(w2[1]), acc);
+        acc = fmaf(bf2f(o2[2]), bf2f(w2[2]), acc);
+        acc = fmaf(bf2f(o2[3]), bf2f(w2[3]), acc);
+    }
+    acc = warp_sum(acc);
+    if (lane == 0) {
+        o_v[((int64_t)r * H_loc + h) * 256 + d] = f2bf(acc);
+    }
+}
+
+// Lightning Indexer scores: for query row r at pos, score every older token t in [0 .. pos - window_size]:
+//   score[r, t] = sum_{h=0..63} (weights[r, h] * weights_scale) * max(0, dot(q_idx[r, h, 0..127], idx_k[t, 0..127]))
+// Launch: grid=(ceil(max_older / 4), rows), block=(128) -> 1 warp per key token t (only launched when max_older > topk)
+extern "C" __global__ void tf_ernie55_dsa_indexer_scores(
+    const __nv_bfloat16* __restrict__ q_idx,   // [rows, 64, 128]
+    const __nv_bfloat16* __restrict__ idx_k,   // [capacity, 128]
+    const __nv_bfloat16* __restrict__ weights, // [rows, 64]
+    const int32_t* __restrict__ positions,     // [rows]
+    float* __restrict__ scores,                // [rows, max_older]
+    int rows,
+    int max_older,
+    int window_size,
+    float weights_scale
+) {
+    int r = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int t = blockIdx.x * 4 + warp;
+    if (r >= rows || t >= max_older) return;
+    int n_older = positions[r] - window_size + 1;
+    if (t >= n_older) {
+        if (lane == 0) scores[(int64_t)r * max_older + t] = -1e38f;
+        return;
+    }
+
+    // Load key k_idx[t, 0..127] into registers: 4 floats per lane!
+    const __nv_bfloat16* kp = idx_k + (int64_t)t * 128 + lane * 4;
+    uint2 kv = *reinterpret_cast<const uint2*>(kp);
+    const __nv_bfloat16* k2 = reinterpret_cast<const __nv_bfloat16*>(&kv);
+    float k0 = bf2f(k2[0]), k1 = bf2f(k2[1]), k2f = bf2f(k2[2]), k3 = bf2f(k2[3]);
+
+    const __nv_bfloat16* qr = q_idx + (int64_t)r * 64 * 128;
+    const __nv_bfloat16* wr = weights + (int64_t)r * 64;
+    float total = 0.0f;
+    for (int h = 0; h < 64; ++h) {
+        const __nv_bfloat16* qh = qr + (int64_t)h * 128 + lane * 4;
+        uint2 qv = *reinterpret_cast<const uint2*>(qh);
+        const __nv_bfloat16* q2 = reinterpret_cast<const __nv_bfloat16*>(&qv);
+        float d = bf2f(q2[0]) * k0 + bf2f(q2[1]) * k1 + bf2f(q2[2]) * k2f + bf2f(q2[3]) * k3;
+        d = warp_sum(d);
+        if (lane == 0 && d > 0.0f) {
+            total = fmaf(bf2f(wr[h]) * weights_scale, d, total);
+        }
+    }
+    if (lane == 0) {
+        scores[(int64_t)r * max_older + t] = total;
+    }
+}
+
+// Fast radix-threshold top-k selection for Lightning Indexer (selects top `topk` from `n_older`, appends SWA window).
+// Uses parallel 256-bin float-key histogram in shared memory (O(n_older) in ~15 us even at 200K context!).
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_dsa_select_topk(
+    const float* __restrict__ scores,      // [rows, max_older]
+    const int32_t* __restrict__ positions, // [rows]
+    int32_t* __restrict__ out_indices,     // [rows, topk + window_size]
+    int32_t* __restrict__ out_counts,      // [rows]
+    int rows,
+    int max_older,
+    int topk,
+    int window_size
+) {
+    int r = blockIdx.x;
+    int tid = threadIdx.x;
+    if (r >= rows) return;
+
+    int pos = positions[r];
+    int width = topk + window_size;
+    int32_t* dst = out_indices + (int64_t)r * width;
+
+    // Fast path: full sequence fits inside topk + window_size -> exact dense attention over 0..pos!
+    if (pos + 1 <= width) {
+        int n = pos + 1;
+        for (int i = tid; i < n; i += blockDim.x) dst[i] = i;
+        if (tid == 0) out_counts[r] = n;
+        return;
+    }
+
+    int n_older = pos - window_size + 1;
+    const float* sr = scores + (int64_t)r * max_older;
+
+    // Map IEEE-754 float -> order-preserving uint32 key
+    auto f2ord = [](float f) -> uint32_t {
+        uint32_t u = __float_as_uint(f);
+        uint32_t mask = (u & 0x80000000u) ? 0xFFFFFFFFu : 0x80000000u;
+        return u ^ mask;
+    };
+
+    // 4-pass MSB 8-bit radix threshold finder to locate exact k-th largest uint32 key!
+    __shared__ uint32_t s_hist[256];
+    __shared__ uint32_t s_prefix;
+    __shared__ uint32_t s_rem;
+    __shared__ uint32_t s_write_cnt;
+    if (tid == 0) {
+        s_prefix = 0u;
+        s_rem = (uint32_t)topk;
+        s_write_cnt = 0u;
+    }
+    __syncthreads();
+
+    for (int pass = 0; pass < 4; ++pass) {
+        int shift = 24 - pass * 8;
+        uint32_t pmask = (pass == 0) ? 0u : (0xFFFFFFFFu << (shift + 8));
+        uint32_t pval = s_prefix;
+        s_hist[tid] = 0u;
+        __syncthreads();
+
+        for (int i = tid; i < n_older; i += blockDim.x) {
+            uint32_t k = f2ord(sr[i]);
+            if ((k & pmask) == pval) {
+                atomicAdd(&s_hist[(k >> shift) & 0xFFu], 1u);
+            }
+        }
+        __syncthreads();
+
+        if (tid == 0) {
+            uint32_t rem = s_rem;
+            for (int b = 255; b >= 0; --b) {
+                uint32_t c = s_hist[b];
+                if (c >= rem) {
+                    s_prefix = pval | ((uint32_t)b << shift);
+                    s_rem = rem;
+                    break;
+                }
+                rem -= c;
+            }
+        }
+        __syncthreads();
+    }
+
+    uint32_t thresh = s_prefix;
+    // Pass A: collect all elements strictly greater than thresh
+    for (int i = tid; i < n_older; i += blockDim.x) {
+        if (f2ord(sr[i]) > thresh) {
+            uint32_t slot = atomicAdd(&s_write_cnt, 1u);
+            if (slot < (uint32_t)topk) dst[slot] = i;
+        }
+    }
+    __syncthreads();
+    // Pass B: fill ties equal to thresh up to exact topk
+    for (int i = tid; i < n_older; i += blockDim.x) {
+        if (f2ord(sr[i]) == thresh) {
+            uint32_t slot = atomicAdd(&s_write_cnt, 1u);
+            if (slot < (uint32_t)topk) dst[slot] = i;
+        }
+    }
+    __syncthreads();
+
+    // Append SWA window [pos - window_size + 1 .. pos]
+    int swa_start = pos - window_size + 1;
+    for (int i = tid; i < window_size; i += blockDim.x) {
+        dst[topk + i] = swa_start + i;
+    }
+    if (tid == 0) out_counts[r] = width;
+}
+
+// High-throughput multi-head MQA MLA-DSA absorbed latent attention:
+//   q_abs   : [rows, H_loc, 576] BF16 (512 latent + 64 rope)
+//   mla_kv  : [capacity, 576] BF16
+//   indices : nullable [rows, idx_stride] int32 (when null or pos+1 <= idx_stride, reads 0..pos directly!)
+//   counts  : nullable [rows] int32
+//   sinks   : [H_loc] F32 (from softmax_offset)
+//   out_lat : [rows, H_loc, 512] BF16
+//
+// Each CTA has 256 threads = 8 warps, 2 heads per warp = 16 heads per CTA!
+// Lane 0..31 owns 16 latent dims (d = lane*16..lane*16+15) + 2 rope dims (r = lane*2, lane*2+1)!
+// Launch: grid=(ceil(H_loc / 16), rows), block=(256)
+extern "C" __global__ void tf_ernie55_dsa_attn(
+    const __nv_bfloat16* __restrict__ q_abs,
+    const __nv_bfloat16* __restrict__ mla_kv,
+    const int32_t* __restrict__ indices,   // nullable
+    const int32_t* __restrict__ counts,    // nullable
+    const float* __restrict__ sinks,       // [H_loc]
+    const int32_t* __restrict__ positions, // [rows]
+    __nv_bfloat16* __restrict__ out_lat,   // [rows, H_loc, 512]
+    int rows,
+    int H_loc,
+    int idx_stride,
+    float scale
+) {
+    int r = blockIdx.y;
+    if (r >= rows) return;
+    int h_base = blockIdx.x * 16;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int h0 = h_base + warp * 2;
+    int h1 = h0 + 1;
+    bool v0 = (h0 < H_loc);
+    bool v1 = (h1 < H_loc);
+
+    int pos = positions[r];
+    bool use_idx = (indices != nullptr && counts != nullptr);
+    int total_k = use_idx ? counts[r] : (pos + 1);
+    const int32_t* idx_row = use_idx ? (indices + (int64_t)r * idx_stride) : nullptr;
+
+    float q0[16], q1[16];
+    float qr0[2], qr1[2];
+    float acc0[16], acc1[16];
+    const __nv_bfloat16* qp0 = q_abs + ((int64_t)r * H_loc + h0) * 576;
+    const __nv_bfloat16* qp1 = q_abs + ((int64_t)r * H_loc + h1) * 576;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) {
+        q0[i] = v0 ? bf2f(qp0[lane * 16 + i]) * scale : 0.0f;
+        q1[i] = v1 ? bf2f(qp1[lane * 16 + i]) * scale : 0.0f;
+        acc0[i] = 0.0f;
+        acc1[i] = 0.0f;
+    }
+    qr0[0] = v0 ? bf2f(qp0[512 + lane * 2]) * scale : 0.0f;
+    qr0[1] = v0 ? bf2f(qp0[512 + lane * 2 + 1]) * scale : 0.0f;
+    qr1[0] = v1 ? bf2f(qp1[512 + lane * 2]) * scale : 0.0f;
+    qr1[1] = v1 ? bf2f(qp1[512 + lane * 2 + 1]) * scale : 0.0f;
+
+    float m0 = v0 ? sinks[h0] : -1e38f;
+    float m1 = v1 ? sinks[h1] : -1e38f;
+    float l0 = 1.0f;
+    float l1 = 1.0f;
+
+    constexpr int BK = 16;
+    __shared__ __nv_bfloat16 s_kv[BK][576];
+
+    for (int k0 = 0; k0 < total_k; k0 += BK) {
+        int cnt = (total_k - k0 < BK) ? (total_k - k0) : BK;
+        for (int t = 0; t < cnt; ++t) {
+            int tok = use_idx ? idx_row[k0 + t] : (k0 + t);
+            const __nv_bfloat16* src = mla_kv + (int64_t)tok * 576;
+            // 256 threads load 576 BF16: first 256 uint32 (= 512 BF16), then 32 uint32 (= 64 BF16)
+            reinterpret_cast<uint32_t*>(s_kv[t])[threadIdx.x] =
+                reinterpret_cast<const uint32_t*>(src)[threadIdx.x];
+            if (threadIdx.x < 32) {
+                reinterpret_cast<uint32_t*>(s_kv[t] + 512)[threadIdx.x] =
+                    reinterpret_cast<const uint32_t*>(src + 512)[threadIdx.x];
+            }
+        }
+        __syncthreads();
+
+        for (int t = 0; t < cnt; ++t) {
+            const __nv_bfloat16* kp = &s_kv[t][lane * 16];
+            const __nv_bfloat16* kr = &s_kv[t][512 + lane * 2];
+            float kv[16];
+            float kr0 = bf2f(kr[0]), kr1 = bf2f(kr[1]);
+            float d0 = qr0[0] * kr0 + qr0[1] * kr1;
+            float d1 = qr1[0] * kr0 + qr1[1] * kr1;
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                kv[i] = bf2f(kp[i]);
+                d0 = fmaf(q0[i], kv[i], d0);
+                d1 = fmaf(q1[i], kv[i], d1);
+            }
+            d0 = warp_allreduce_sum(d0);
+            d1 = warp_allreduce_sum(d1);
+
+            if (v0) {
+                float nm = fmaxf(m0, d0);
+                float alpha = expf(m0 - nm);
+                float p = expf(d0 - nm);
+                l0 = l0 * alpha + p;
+#pragma unroll
+                for (int i = 0; i < 16; ++i) acc0[i] = fmaf(p, kv[i], acc0[i] * alpha);
+                m0 = nm;
+            }
+            if (v1) {
+                float nm = fmaxf(m1, d1);
+                float alpha = expf(m1 - nm);
+                float p = expf(d1 - nm);
+                l1 = l1 * alpha + p;
+#pragma unroll
+                for (int i = 0; i < 16; ++i) acc1[i] = fmaf(p, kv[i], acc1[i] * alpha);
+                m1 = nm;
+            }
+        }
+        __syncthreads();
+    }
+
+    if (v0) {
+        float inv_l = 1.0f / l0;
+        __nv_bfloat16* op = out_lat + ((int64_t)r * H_loc + h0) * 512 + lane * 16;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) op[i] = f2bf(acc0[i] * inv_l);
+    }
+    if (v1) {
+        float inv_l = 1.0f / l1;
+        __nv_bfloat16* op = out_lat + ((int64_t)r * H_loc + h1) * 512 + lane * 16;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) op[i] = f2bf(acc1[i] * inv_l);
+    }
+}
+
+// Fused DSA kv_a [rows, 576] -> kv_a_layernorm(0..511) + GPT-J RoPE(512..575) -> mla_kv[positions[r], 0..575]
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_dsa_kv_norm_rope_store(
+    const __nv_bfloat16* __restrict__ kv_a,   // [rows, 576]
+    const __nv_bfloat16* __restrict__ norm_w, // [512]
+    const int32_t* __restrict__ positions,    // [rows]
+    const float* __restrict__ inv_freq,       // [32]
+    __nv_bfloat16* __restrict__ mla_kv,       // [capacity, 576]
+    int rows,
+    float eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    int pos = positions[r];
+    const __nv_bfloat16* src = kv_a + (int64_t)r * 576;
+    __nv_bfloat16* dst = mla_kv + (int64_t)pos * 576;
+
+    __shared__ float s_red[32];
+    float v0 = bf2f(src[threadIdx.x * 2]);
+    float v1 = bf2f(src[threadIdx.x * 2 + 1]);
+    float sq = v0 * v0 + v1 * v1;
+    int lane = threadIdx.x & 31;
+    int warp = threadIdx.x >> 5;
+    sq = warp_sum(sq);
+    if (lane == 0) s_red[warp] = sq;
+    __syncthreads();
+    if (warp == 0) {
+        float tot = (lane < 8) ? s_red[lane] : 0.0f;
+        tot = warp_sum(tot);
+        if (lane == 0) s_red[0] = rsqrtf(tot / 512.0f + eps);
+    }
+    __syncthreads();
+    float rrms = s_red[0];
+
+    dst[threadIdx.x * 2]     = f2bf(v0 * rrms * bf2f(norm_w[threadIdx.x * 2]));
+    dst[threadIdx.x * 2 + 1] = f2bf(v1 * rrms * bf2f(norm_w[threadIdx.x * 2 + 1]));
+
+    if (threadIdx.x < 32) {
+        int pair = threadIdx.x;
+        float e = bf2f(src[512 + pair * 2]);
+        float o = bf2f(src[512 + pair * 2 + 1]);
+        float theta = (float)pos * inv_freq[pair];
+        float c, s;
+        __sincosf(theta, &s, &c);
+        dst[512 + pair * 2]     = f2bf(e * c - o * s);
+        dst[512 + pair * 2 + 1] = f2bf(o * c + e * s);
+    }
+}
diff --git a/zig/kernels/cuda/ernie55/hca_attn.cu b/zig/kernels/cuda/ernie55/hca_attn.cu
new file mode 100644
index 0000000..743df13
--- /dev/null
+++ b/zig/kernels/cuda/ernie55/hca_attn.cu
@@ -0,0 +1,434 @@
+// ERNIE 5.5 Flash Preview HCA (Heavily Compressed Attention, 37 layers + 3 DSpark layers):
+//   - SWA-128 ring cache [swa_cap, 512] BF16 (swa_cap is power of 2, e.g. 1024)
+//   - C128 compressor state ring [state_cap, 2, 512] F32 + compressed KV cache [comp_cap, 512] BF16
+//   - Shared-memory multi-head MQA attention (loads each KV row ONCE across all H_loc=16 heads!)
+//   - Virtual sink logit attn_sink[h] folded cleanly into online softmax init (m = sink, l = 1, acc = 0)
+
+#include <cuda_bf16.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+__device__ __forceinline__ float bf2f(__nv_bfloat16 v) { return __bfloat162float(v); }
+__device__ __forceinline__ __nv_bfloat16 f2bf(float v) { return __float2bfloat16_rn(v); }
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_down_sync(0xffffffffu, v, off);
+    }
+    return v;
+}
+
+__device__ __forceinline__ float warp_allreduce_sum(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_xor_sync(0xffffffffu, v, off);
+    }
+    return v;
+}
+
+}  // namespace
+
+// Apply GPT-J RoPE on dims [448..512) of normed kv [rows, 512] and store into swa_kv[pos & swa_mask]
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_hca_kv_rope_store(
+    const __nv_bfloat16* __restrict__ kv,   // [rows, 512] (already kv_layernormed)
+    const int32_t* __restrict__ positions,  // [rows]
+    const float* __restrict__ inv_freq,     // [32]
+    __nv_bfloat16* __restrict__ swa_kv,     // [swa_cap, 512]
+    int rows,
+    int swa_mask
+) {
+    int r = blockIdx.x;
+    int t = threadIdx.x;  // 0..255 -> pair [2*t, 2*t+1]
+    if (r >= rows) return;
+    int pos = positions[r];
+    const __nv_bfloat16* src = kv + (int64_t)r * 512;
+    __nv_bfloat16* dst = swa_kv + (int64_t)(pos & swa_mask) * 512;
+    float e = bf2f(src[2 * t]);
+    float o = bf2f(src[2 * t + 1]);
+    if (t >= 224) {
+        int pair = t - 224;
+        float theta = (float)pos * inv_freq[pair];
+        float c, s;
+        __sincosf(theta, &s, &c);
+        float ne = e * c - o * s;
+        float no = o * c + e * s;
+        e = ne;
+        o = no;
+    }
+    dst[2 * t]     = f2bf(e);
+    dst[2 * t + 1] = f2bf(o);
+}
+
+// Save compressor partial states:
+//   comp_state[pos & state_mask, 0, d] = float(wkv[r, d])
+//   comp_state[pos & state_mask, 1, d] = float(wgate[r, d]) + ape[pos % 128, d]
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_hca_comp_save(
+    const __nv_bfloat16* __restrict__ wkv,    // [rows, 512]
+    const __nv_bfloat16* __restrict__ wgate,  // [rows, 512]
+    const float* __restrict__ ape,            // [128, 512]
+    const int32_t* __restrict__ positions,    // [rows]
+    float* __restrict__ comp_state,           // [state_cap, 2, 512]
+    int rows,
+    int state_mask
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    int pos = positions[r];
+    int slot = pos & state_mask;
+    int ape_row = pos & 127;
+    const __nv_bfloat16* kvr = wkv + (int64_t)r * 512;
+    const __nv_bfloat16* gr = wgate + (int64_t)r * 512;
+    const float* ar = ape + (int64_t)ape_row * 512;
+    float* dst_kv = comp_state + (int64_t)slot * 1024;
+    float* dst_sc = dst_kv + 512;
+    for (int d = threadIdx.x; d < 512; d += blockDim.x) {
+        dst_kv[d] = bf2f(kvr[d]);
+        dst_sc[d] = bf2f(gr[d]) + ar[d];
+    }
+}
+
+// Flush completed C128 compressed KV blocks for any row where (pos + 1) % 128 == 0:
+//   1. Per-dim softmax over t=0..127 of comp_state[(blk*128 + t) & state_mask, 1, d]
+//   2. Weighted sum of comp_state[..., 0, d] -> ckv[d]
+//   3. RMSNorm(ckv, norm_w, eps) -> round to BF16 -> F32
+//   4. GPT-J RoPE on dims [448..512) at position blk * 128 (start of block!)
+//   5. Store BF16 to comp_kv[blk, 0..511]
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_hca_comp_flush(
+    const float* __restrict__ comp_state,     // [state_cap, 2, 512]
+    const __nv_bfloat16* __restrict__ norm_w, // [512]
+    const int32_t* __restrict__ positions,    // [rows]
+    const float* __restrict__ inv_freq,       // [32]
+    __nv_bfloat16* __restrict__ comp_kv,      // [comp_cap, 512]
+    int rows,
+    int state_mask,
+    float eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    int pos = positions[r];
+    if (((pos + 1) & 127) != 0) return;
+
+    int blk = pos >> 7;
+    int s0 = blk << 7;
+    __shared__ float s_ckv[512];
+    __shared__ float s_red[32];
+
+    // Each of 256 threads handles 2 dims: d0 = threadIdx.x, d1 = threadIdx.x + 256
+    for (int pass = 0; pass < 2; ++pass) {
+        int d = threadIdx.x + pass * 256;
+        float mx = -1e38f;
+        for (int t = 0; t < 128; ++t) {
+            int slot = (s0 + t) & state_mask;
+            float sc = comp_state[(int64_t)slot * 1024 + 512 + d];
+            if (sc > mx) mx = sc;
+        }
+        float denom = 0.0f;
+        float wsum = 0.0f;
+        for (int t = 0; t < 128; ++t) {
+            int slot = (s0 + t) & state_mask;
+            float sc = comp_state[(int64_t)slot * 1024 + 512 + d];
+            float kv = comp_state[(int64_t)slot * 1024 + d];
+            float p = expf(sc - mx);
+            denom += p;
+            wsum += p * kv;
+        }
+        s_ckv[d] = wsum / denom;
+    }
+    __syncthreads();
+
+    // RMSNorm over 512 dims
+    float v0 = s_ckv[2 * threadIdx.x];
+    float v1 = s_ckv[2 * threadIdx.x + 1];
+    float sq = v0 * v0 + v1 * v1;
+    int lane = threadIdx.x & 31;
+    int warp = threadIdx.x >> 5;
+    sq = warp_sum(sq);
+    if (lane == 0) s_red[warp] = sq;
+    __syncthreads();
+    if (warp == 0) {
+        float tot = (lane < 8) ? s_red[lane] : 0.0f;
+        tot = warp_sum(tot);
+        if (lane == 0) s_red[0] = rsqrtf(tot / 512.0f + eps);
+    }
+    __syncthreads();
+    float rrms = s_red[0];
+
+    // Round to BF16 -> F32 before RoPE (exact match with fused_compress_quant_cache.py)
+    float e = bf2f(f2bf(v0 * rrms * bf2f(norm_w[2 * threadIdx.x])));
+    float o = bf2f(f2bf(v1 * rrms * bf2f(norm_w[2 * threadIdx.x + 1])));
+
+    if (threadIdx.x >= 224) {
+        int pair = threadIdx.x - 224;
+        float theta = (float)s0 * inv_freq[pair];
+        float c, s;
+        __sincosf(theta, &s, &c);
+        float ne = e * c - o * s;
+        float no = o * c + e * s;
+        e = ne;
+        o = no;
+    }
+
+    __nv_bfloat16* dst = comp_kv + (int64_t)blk * 512;
+    dst[2 * threadIdx.x]     = f2bf(e);
+    dst[2 * threadIdx.x + 1] = f2bf(o);
+}
+
+// High-throughput multi-head MQA HCA attention (16 heads per CTA -> each KV row read ONCE from DRAM!)
+// Supports both SWA-128 + C128 compressed KV (or SWA-only when comp_kv == nullptr for DSpark).
+// Each CTA has 256 threads = 8 warps; each warp handles 2 Q heads (16 heads/CTA total!).
+// Each lane owns 16 dims of head_dim=512 (d = lane*16 .. lane*16+15) in registers!
+// Launch: grid=(ceil(H_loc / 16), rows), block=(256)
+extern "C" __global__ void tf_ernie55_hca_attn(
+    const __nv_bfloat16* __restrict__ q,       // [rows, H_loc, 512]
+    const __nv_bfloat16* __restrict__ swa_kv,  // [swa_cap, 512]
+    const __nv_bfloat16* __restrict__ comp_kv, // nullable [comp_cap, 512]
+    const float* __restrict__ attn_sink,       // [H_loc]
+    const int32_t* __restrict__ positions,     // [rows]
+    __nv_bfloat16* __restrict__ out,           // [rows, H_loc, 512]
+    int rows,
+    int H_loc,
+    int swa_mask,
+    int window_size,
+    float scale
+) {
+    int r = blockIdx.y;
+    if (r >= rows) return;
+    int h_base = blockIdx.x * 16;
+    int warp = threadIdx.x >> 5;   // 0..7
+    int lane = threadIdx.x & 31;   // 0..31 -> 16 dims [lane*16 .. lane*16+15]
+    int h0 = h_base + warp * 2;
+    int h1 = h0 + 1;
+    bool v0 = (h0 < H_loc);
+    bool v1 = (h1 < H_loc);
+
+    int pos = positions[r];
+    int swa_start = (pos >= window_size - 1) ? (pos - (window_size - 1)) : 0;
+    int n_swa = pos - swa_start + 1;
+    int n_comp = (comp_kv != nullptr) ? ((pos + 1) >> 7) : 0;
+    int total_k = n_swa + n_comp;
+
+    // Load Q[h0] and Q[h1] into registers (16 floats each per lane)
+    float q0[16], q1[16];
+    float acc0[16], acc1[16];
+    const __nv_bfloat16* qp0 = q + ((int64_t)r * H_loc + h0) * 512 + lane * 16;
+    const __nv_bfloat16* qp1 = q + ((int64_t)r * H_loc + h1) * 512 + lane * 16;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) {
+        q0[i] = v0 ? bf2f(qp0[i]) * scale : 0.0f;
+        q1[i] = v1 ? bf2f(qp1[i]) * scale : 0.0f;
+        acc0[i] = 0.0f;
+        acc1[i] = 0.0f;
+    }
+    float m0 = v0 ? attn_sink[h0] : -1e38f;
+    float m1 = v1 ? attn_sink[h1] : -1e38f;
+    float l0 = 1.0f;
+    float l1 = 1.0f;
+
+    // Shared memory tile: 16 KV rows x 512 BF16 = 16 KB
+    constexpr int BK = 16;
+    __shared__ __nv_bfloat16 s_kv[BK][512];
+
+    for (int k0 = 0; k0 < total_k; k0 += BK) {
+        int cnt = (total_k - k0 < BK) ? (total_k - k0) : BK;
+        // Cooperatively load cnt rows of 512 BF16 (256 threads x 8 elems = 2048 elems = 4 rows per step)
+        for (int t = 0; t < cnt; ++t) {
+            int gi = k0 + t;
+            const __nv_bfloat16* src_row = (gi < n_swa)
+                ? (swa_kv + (int64_t)((swa_start + gi) & swa_mask) * 512)
+                : (comp_kv + (int64_t)(gi - n_swa) * 512);
+            // 256 threads -> 2 BF16 (uint32_t) per thread covers all 512 BF16 in 1 coalesced load!
+            reinterpret_cast<uint32_t*>(s_kv[t])[threadIdx.x] =
+                reinterpret_cast<const uint32_t*>(src_row)[threadIdx.x];
+        }
+        __syncthreads();
+
+        for (int t = 0; t < cnt; ++t) {
+            const __nv_bfloat16* kp = &s_kv[t][lane * 16];
+            float kv[16];
+            float d0 = 0.0f, d1 = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                kv[i] = bf2f(kp[i]);
+                d0 = fmaf(q0[i], kv[i], d0);
+                d1 = fmaf(q1[i], kv[i], d1);
+            }
+            d0 = warp_allreduce_sum(d0);
+            d1 = warp_allreduce_sum(d1);
+
+            if (v0) {
+                float nm = fmaxf(m0, d0);
+                float alpha = expf(m0 - nm);
+                float p = expf(d0 - nm);
+                l0 = l0 * alpha + p;
+#pragma unroll
+                for (int i = 0; i < 16; ++i) acc0[i] = fmaf(p, kv[i], acc0[i] * alpha);
+                m0 = nm;
+            }
+            if (v1) {
+                float nm = fmaxf(m1, d1);
+                float alpha = expf(m1 - nm);
+                float p = expf(d1 - nm);
+                l1 = l1 * alpha + p;
+#pragma unroll
+                for (int i = 0; i < 16; ++i) acc1[i] = fmaf(p, kv[i], acc1[i] * alpha);
+                m1 = nm;
+            }
+        }
+        __syncthreads();
+    }
+
+    if (v0) {
+        float inv_l = 1.0f / l0;
+        __nv_bfloat16* op = out + ((int64_t)r * H_loc + h0) * 512 + lane * 16;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) op[i] = f2bf(acc0[i] * inv_l);
+    }
+    if (v1) {
+        float inv_l = 1.0f / l1;
+        __nv_bfloat16* op = out + ((int64_t)r * H_loc + h1) * 512 + lane * 16;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) op[i] = f2bf(acc1[i] * inv_l);
+    }
+}
+
+// DSpark ring-buffer KV norm + trailing-64 GPT-J RoPE store into kv_ring[pos & ring_mask].
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_hca_kv_store_ring(
+    const __nv_bfloat16* __restrict__ kv_in,     // [rows, 512]
+    const __nv_bfloat16* __restrict__ kv_norm,   // [512]
+    const int32_t* __restrict__ positions,       // [rows]
+    const float* __restrict__ inv_freq,          // [32]
+    __nv_bfloat16* __restrict__ kv_ring,         // [ring_size, 512]
+    int rows,
+    int ring_mask,
+    float eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    int tid = threadIdx.x;
+    const __nv_bfloat16* src = kv_in + (int64_t)r * 512;
+    int pos = positions[r];
+    __nv_bfloat16* dst = kv_ring + (int64_t)(pos & ring_mask) * 512;
+
+    float v0 = __bfloat162float(src[tid]);
+    float v1 = __bfloat162float(src[tid + 256]);
+    float ss = v0 * v0 + v1 * v1;
+
+    __shared__ float smem[8];
+    int lane = tid & 31;
+    int warp = tid >> 5;
+    for (int off = 16; off > 0; off >>= 1) ss += __shfl_down_sync(0xffffffff, ss, off);
+    if (lane == 0) smem[warp] = ss;
+    __syncthreads();
+    if (warp == 0) {
+        ss = (lane < 8) ? smem[lane] : 0.0f;
+        for (int off = 4; off > 0; off >>= 1) ss += __shfl_down_sync(0xffffffff, ss, off);
+        if (lane == 0) smem[0] = rsqrtf(ss / 512.0f + eps);
+    }
+    __syncthreads();
+    float inv = smem[0];
+
+    float n0 = v0 * inv * __bfloat162float(kv_norm[tid]);
+    float n1 = v1 * inv * __bfloat162float(kv_norm[tid + 256]);
+    dst[tid] = __float2bfloat16(n0);
+    // Keep normed value in shared memory for trailing-64 GPT-J RoPE [448..512)
+    __shared__ float rope_buf[64];
+    if (tid + 256 < 448) {
+        dst[tid + 256] = __float2bfloat16(n1);
+    } else {
+        rope_buf[tid + 256 - 448] = __bfloat162float(__float2bfloat16(n1));
+    }
+    __syncthreads();
+    if (tid < 32) {
+        float ang = (float)pos * inv_freq[tid];
+        float c, s;
+        __sincosf(ang, &s, &c);
+        float a = rope_buf[2 * tid];
+        float b = rope_buf[2 * tid + 1];
+        dst[448 + 2 * tid]     = __float2bfloat16(a * c - b * s);
+        dst[448 + 2 * tid + 1] = __float2bfloat16(a * s + b * c);
+    }
+}
+
+// DSpark non-causal HCA attention over ring buffer kv_ring[k & ring_mask] for k in [lo .. hi] + attn_sink.
+// Launch: grid=(ceil(H/4), B), block=(128) (4 warps = 4 heads per block; shared memory holds KV row)
+extern "C" __global__ void tf_ernie55_hca_attn_dspark(
+    const __nv_bfloat16* __restrict__ q,         // [B, H, 512]
+    const __nv_bfloat16* __restrict__ kv_ring,   // [ring_size, 512]
+    const float* __restrict__ attn_sink,         // [H]
+    __nv_bfloat16* __restrict__ out,             // [B, H, 512]
+    int B,
+    int H,
+    int lo,
+    int hi,
+    int ring_mask,
+    float scale
+) {
+    int r = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int h = blockIdx.x * 4 + warp;
+    if (r >= B) return;
+
+    float qr[16];
+    float acc[16];
+    if (h < H) {
+        const __nv_bfloat16* qp = q + ((int64_t)r * H + h) * 512;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) {
+            qr[i] = __bfloat162float(qp[lane * 16 + i]);
+            acc[i] = 0.0f;
+        }
+    }
+
+    float m = (h < H) ? attn_sink[h] : -INFINITY;
+    float l = 1.0f;
+
+    __shared__ __nv_bfloat16 s_kv[512];
+    int tid = threadIdx.x;
+
+    for (int k = lo; k <= hi; ++k) {
+        const __nv_bfloat16* kp = kv_ring + (int64_t)(k & ring_mask) * 512;
+        // Cooperative load of 512 BF16 (1024 bytes = 128 threads x 8 bytes)
+        reinterpret_cast<uint2*>(s_kv)[tid] = reinterpret_cast<const uint2*>(kp)[tid];
+        __syncthreads();
+
+        if (h < H) {
+            float dot = 0.0f;
+            float kv_reg[16];
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                float v = __bfloat162float(s_kv[lane * 16 + i]);
+                kv_reg[i] = v;
+                dot += qr[i] * v;
+            }
+            for (int off = 16; off > 0; off >>= 1) dot += __shfl_down_sync(0xffffffff, dot, off);
+            float score = __shfl_sync(0xffffffff, dot, 0) * scale;
+            float m_new = fmaxf(m, score);
+            float alpha = expf(m - m_new);
+            float beta = expf(score - m_new);
+            l = l * alpha + beta;
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                acc[i] = acc[i] * alpha + beta * kv_reg[i];
+            }
+            m = m_new;
+        }
+        __syncthreads();
+    }
+
+    if (h < H) {
+        float inv_l = 1.0f / l;
+        __nv_bfloat16* op = out + ((int64_t)r * H + h) * 512;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) {
+            op[lane * 16 + i] = __float2bfloat16(acc[i] * inv_l);
+        }
+    }
+}
diff --git a/zig/kernels/cuda/ernie55/mxfp4_situ.cu b/zig/kernels/cuda/ernie55/mxfp4_situ.cu
new file mode 100644
index 0000000..5fd83fd
--- /dev/null
+++ b/zig/kernels/cuda/ernie55/mxfp4_situ.cu
@@ -0,0 +1,208 @@
+// Native SM121 MXFP4 (OCP E2M1 + UE8M0 group-32) grouped-expert MoE kernels
+// with fused SITU(beta=4.0, linear_beta=25.0) activation for ERNIE 5.5 Flash Preview.
+//
+// Zero-LUT PTX E2M1->bf16x2 decode + 128-bit coalesced vector loads (1 full 32-elem MXFP4 group per load).
+
+#include <cuda_bf16.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+// Decode low nibble -> low bf16, high nibble -> high bf16 of one byte using 3 register instructions (0 LUTs!).
+__device__ __forceinline__ __nv_bfloat162 e2m1_byte_to_bf162(uint32_t b) {
+    const uint32_t v = (b & 0xFu) | ((b & 0xF0u) << 12);
+    const uint32_t t = ((v & 0x00070007u) << 6) | ((v & 0x00080008u) << 12);
+    uint32_t r;
+    asm("fma.rn.bf16x2 %0, %1, %2, %3;\n" : "=r"(r) : "r"(t), "r"(0x7E807E80u), "r"(0x80008000u));
+    return *reinterpret_cast<const __nv_bfloat162*>(&r);
+}
+
+__device__ __forceinline__ float ue8m0_to_f32(uint8_t e) {
+    return (e == 0) ? 5.8774717541114375e-39f : __int_as_float((uint32_t)e << 23);
+}
+
+__device__ __forceinline__ float sigmoid_rn(float x) {
+    return __fdiv_rn(1.0f, 1.0f + expf(-x));
+}
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_down_sync(0xffffffffu, v, off);
+    }
+    return v;
+}
+
+// Dot product of 32 packed E2M1 weights (16 bytes = uint4 = 1 full MXFP4 group) against 32 BF16 activations in smem.
+__device__ __forceinline__ float dot32_e2m1(uint4 qw, const __nv_bfloat162* x2) {
+    const uint32_t words[4] = {qw.x, qw.y, qw.z, qw.w};
+    float s0 = 0.0f, s1 = 0.0f;
+#pragma unroll
+    for (int w = 0; w < 4; ++w) {
+        uint32_t wd = words[w];
+        uint4 xv = *reinterpret_cast<const uint4*>(x2 + w * 4);
+        const __nv_bfloat162* xp = reinterpret_cast<const __nv_bfloat162*>(&xv);
+#pragma unroll
+        for (int b = 0; b < 4; ++b) {
+            float2 wf = __bfloat1622float2(e2m1_byte_to_bf162((wd >> (b * 8)) & 0xFFu));
+            float2 xf = __bfloat1622float2(xp[b]);
+            s0 = fmaf(wf.x, xf.x, s0);
+            s1 = fmaf(wf.y, xf.y, s1);
+        }
+    }
+    return s0 + s1;
+}
+
+// Dot product of 16 packed E2M1 weights (8 bytes = uint2 = half of an MXFP4 group) against 16 BF16 activations in smem.
+__device__ __forceinline__ float dot16_e2m1(uint2 qw, const __nv_bfloat162* x2) {
+    const uint32_t words[2] = {qw.x, qw.y};
+    float s0 = 0.0f, s1 = 0.0f;
+#pragma unroll
+    for (int w = 0; w < 2; ++w) {
+        uint32_t wd = words[w];
+        uint4 xv = *reinterpret_cast<const uint4*>(x2 + w * 4);
+        const __nv_bfloat162* xp = reinterpret_cast<const __nv_bfloat162*>(&xv);
+#pragma unroll
+        for (int b = 0; b < 4; ++b) {
+            float2 wf = __bfloat1622float2(e2m1_byte_to_bf162((wd >> (b * 8)) & 0xFFu));
+            float2 xf = __bfloat1622float2(xp[b]);
+            s0 = fmaf(wf.x, xf.x, s0);
+            s1 = fmaf(wf.y, xf.y, s1);
+        }
+    }
+    return s0 + s1;
+}
+
+}  // namespace
+
+// Fused MXFP4 w1 + w3 -> SITU(beta, linear_beta) for selected topk experts.
+// K = 2048 => Kg = 64 groups of 32 => 2 full uint4 (16B) coalesced loads per lane in a 32-thread warp!
+// Launch: grid=(ceil(N_loc/4), topk, rows), block=(128), smem = K * sizeof(__nv_bfloat16) (4 KB)
+extern "C" __global__ void tf_ernie55_mxfp4_w13_situ(
+    const __nv_bfloat16* __restrict__ x,
+    const uint8_t* __restrict__ w1_q,
+    const uint8_t* __restrict__ w1_s,
+    const uint8_t* __restrict__ w3_q,
+    const uint8_t* __restrict__ w3_s,
+    const int32_t* __restrict__ ids,
+    __nv_bfloat16* __restrict__ out,
+    int rows,
+    int topk,
+    int N_loc,
+    int K,
+    float beta,
+    float linear_beta
+) {
+    int r = blockIdx.z;
+    int tk = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int n = blockIdx.x * 4 + warp;
+    if (r >= rows || tk >= topk) return;
+
+    extern __shared__ __nv_bfloat16 s_x[];
+    const __nv_bfloat16* xr = x + (int64_t)r * K;
+    for (int i = threadIdx.x * 8; i < K; i += blockDim.x * 8) {
+        *reinterpret_cast<uint4*>(s_x + i) = *reinterpret_cast<const uint4*>(xr + i);
+    }
+    __syncthreads();
+
+    if (n >= N_loc) return;
+
+    int e = ids[(int64_t)r * topk + tk];
+    int Kg = K >> 5;
+    int64_t q_off = ((int64_t)e * N_loc + n) * (K >> 1);
+    int64_t s_off = ((int64_t)e * N_loc + n) * Kg;
+
+    const uint4* q1 = reinterpret_cast<const uint4*>(w1_q + q_off);
+    const uint4* q3 = reinterpret_cast<const uint4*>(w3_q + q_off);
+    const uint8_t* s1 = w1_s + s_off;
+    const uint8_t* s3 = w3_s + s_off;
+    const __nv_bfloat162* sx2 = reinterpret_cast<const __nv_bfloat162*>(s_x);
+
+    float g_acc = 0.0f;
+    float u_acc = 0.0f;
+    // Each lane loads 1 full group (16 bytes = 32 weights) per iteration -> 512 bytes coalesced across warp!
+    for (int g = lane; g < Kg; g += 32) {
+        const __nv_bfloat162* xp = sx2 + g * 16;
+        uint4 v1 = __ldg(q1 + g);
+        uint4 v3 = __ldg(q3 + g);
+        float sc1 = ue8m0_to_f32(__ldg(s1 + g));
+        float sc3 = ue8m0_to_f32(__ldg(s3 + g));
+        g_acc = fmaf(dot32_e2m1(v1, xp), sc1, g_acc);
+        u_acc = fmaf(dot32_e2m1(v3, xp), sc3, u_acc);
+    }
+
+    g_acc = warp_sum(g_acc);
+    u_acc = warp_sum(u_acc);
+
+    if (lane == 0) {
+        float sg = beta * tanhf(g_acc / beta) * sigmoid_rn(g_acc);
+        float su = linear_beta * tanhf(u_acc / linear_beta);
+        out[((int64_t)r * topk + tk) * N_loc + n] = __float2bfloat16_rn(sg * su);
+    }
+}
+
+// MXFP4 w2 + weighted topk combine (deterministic sequential sum over tk = 0..topk-1, ZERO atomics).
+// K_loc = 512 on TP=4 => 16 groups of 32 => 2 lanes per group (uint2 = 8 bytes/lane -> 1 single coalesced 256B pass, ZERO K-loop!).
+// Launch: grid=(ceil(N_out/4), rows), block=(128), smem = topk * K_loc * sizeof(__nv_bfloat16)
+extern "C" __global__ void tf_ernie55_mxfp4_w2_combine(
+    const __nv_bfloat16* __restrict__ mid,
+    const uint8_t* __restrict__ w2_q,
+    const uint8_t* __restrict__ w2_s,
+    const int32_t* __restrict__ ids,
+    const float* __restrict__ weights,
+    __nv_bfloat16* __restrict__ out,
+    int rows,
+    int topk,
+    int N_out,
+    int K_loc
+) {
+    int r = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int n = blockIdx.x * 4 + warp;
+    if (r >= rows) return;
+
+    extern __shared__ __nv_bfloat16 s_mid[];
+    int total_mid = topk * K_loc;
+    const __nv_bfloat16* mr = mid + (int64_t)r * total_mid;
+    for (int i = threadIdx.x * 8; i < total_mid; i += blockDim.x * 8) {
+        *reinterpret_cast<uint4*>(s_mid + i) = *reinterpret_cast<const uint4*>(mr + i);
+    }
+    __syncthreads();
+
+    if (n >= N_out) return;
+
+    int K2 = K_loc >> 1;
+    int Kg = K_loc >> 5;
+    int halves = Kg << 1;  // 2 halves (16 elems = 8 bytes = uint2) per MXFP4 group
+
+    float total = 0.0f;
+    for (int tk = 0; tk < topk; ++tk) {
+        int e = ids[(int64_t)r * topk + tk];
+        float w = weights[(int64_t)r * topk + tk];
+        int64_t q_off = ((int64_t)e * N_out + n) * K2;
+        int64_t s_off = ((int64_t)e * N_out + n) * Kg;
+        const uint2* q2 = reinterpret_cast<const uint2*>(w2_q + q_off);
+        const uint8_t* s2 = w2_s + s_off;
+        const __nv_bfloat162* xtk = reinterpret_cast<const __nv_bfloat162*>(s_mid + tk * K_loc);
+
+        float acc = 0.0f;
+        for (int h = lane; h < halves; h += 32) {
+            int g = h >> 1;
+            uint2 v = __ldg(q2 + h);
+            float sc = ue8m0_to_f32(__ldg(s2 + g));
+            acc = fmaf(dot16_e2m1(v, xtk + h * 8), sc, acc);
+        }
+        acc = warp_sum(acc);
+        if (lane == 0) {
+            total = fmaf(acc, w, total);
+        }
+    }
+
+    if (lane == 0) {
+        out[(int64_t)r * N_out + n] = __float2bfloat16_rn(total);
+    }
+}
diff --git a/zig/kernels/cuda/ernie55/ops.cu b/zig/kernels/cuda/ernie55/ops.cu
new file mode 100644
index 0000000..acc4205
--- /dev/null
+++ b/zig/kernels/cuda/ernie55/ops.cu
@@ -0,0 +1,1257 @@
+// ERNIE 5.5 Flash Preview core CUDA kernels (SM121 / GB10):
+// mHC pre/post/contract, split-feature router, SITU, VHA, GPT-J RoPE/inv-RoPE,
+// Walsh-Hadamard 128, RMSNorm/LayerNorm, MultiMax, and BF16 GEMV/GEMM.
+
+#include <cuda_bf16.h>
+#include <math.h>
+#include <stdint.h>
+
+namespace {
+
+__device__ __forceinline__ float sigmoid_rn(float x) {
+    return __fdiv_rn(1.0f, 1.0f + expf(-x));
+}
+
+__device__ __forceinline__ float bf2f(__nv_bfloat16 v) {
+    return __bfloat162float(v);
+}
+
+__device__ __forceinline__ __nv_bfloat16 f2bf(float v) {
+    return __float2bfloat16_rn(v);
+}
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_down_sync(0xffffffffu, v, off);
+    }
+    return v;
+}
+
+__device__ __forceinline__ float block_sum(float v, float* smem) {
+    int lane = threadIdx.x & 31;
+    int warp = threadIdx.x >> 5;
+    int nwarps = blockDim.x >> 5;
+    v = warp_sum(v);
+    if (lane == 0) smem[warp] = v;
+    __syncthreads();
+    float out = 0.0f;
+    if (warp == 0) {
+        out = (lane < nwarps) ? smem[lane] : 0.0f;
+        out = warp_sum(out);
+        if (lane == 0) smem[0] = out;
+    }
+    __syncthreads();
+    return smem[0];
+}
+
+}  // namespace
+
+// Broadcast token embeddings [rows, H] -> 4-stream mHC residual [rows, 4, H]
+extern "C" __global__ void tf_ernie55_embed_broadcast(
+    const int32_t* __restrict__ ids,
+    const __nv_bfloat16* __restrict__ table,
+    __nv_bfloat16* __restrict__ out,
+    int rows,
+    int hidden,
+    int hc_mult
+) {
+    int r = blockIdx.y;
+    int h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (r >= rows || h >= hidden) return;
+    int32_t tok = ids[r];
+    __nv_bfloat16 v = table[(int64_t)tok * hidden + h];
+    int64_t base = (int64_t)r * hc_mult * hidden + h;
+    for (int c = 0; c < hc_mult; ++c) {
+        out[base + (int64_t)c * hidden] = v;
+    }
+}
+
+// ERNIE 5.5 mHC pre:
+//   rms = 1 / (sqrt(mean(res^2)) + rms_eps)
+//   mix[0..23] = (res_flat @ fn^T) * rms   (fn is [24, 4*H] F32)
+//   pre[0..3]  = sigmoid(mix[0..3] * scale[0] + base[0..3]) + hc_eps
+//   post[0..3] = sigmoid(mix[4..7] * scale[1] + base[4..7]) * post_alpha
+//   comb[4x4]  = Sinkhorn(mix[8..23] * scale[2] + base[8..23], iters, hc_eps)
+//   layer_in   = RMSNorm(bf16(sum_c pre[c] * res[c, :]), norm_w, norm_eps)
+// Launch: grid=(rows), block=(256), smem = 4*H*2 + 256 bytes (~33 KB for H=4096)
+extern "C" __global__ void tf_ernie55_mhc_pre(
+    const __nv_bfloat16* __restrict__ res,      // [rows, 4, H]
+    const float* __restrict__ fn,               // [24, 4*H]
+    const float* __restrict__ hc_scale,         // [3]
+    const float* __restrict__ hc_base,          // [24]
+    const __nv_bfloat16* __restrict__ norm_w,   // [H]
+    float* __restrict__ post_mix,               // [rows, 4]
+    float* __restrict__ comb_mix,               // [rows, 16]
+    __nv_bfloat16* __restrict__ layer_in,       // [rows, H]
+    int rows,
+    int hidden,
+    float rms_eps,
+    float hc_eps,
+    float post_alpha,
+    int sinkhorn_iters,
+    float norm_eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    const int hc_dim = 4 * hidden;
+    const int tid = threadIdx.x;
+    const int nthr = blockDim.x;
+
+    extern __shared__ unsigned char raw_smem[];
+    __nv_bfloat16* s_res = reinterpret_cast<__nv_bfloat16*>(raw_smem);
+    float* s_red = reinterpret_cast<float*>(raw_smem + hc_dim * sizeof(__nv_bfloat16));
+    float* s_mix = s_red + 32;  // 24 floats
+    float* s_pre = s_mix + 24;  // 4 floats
+
+    // Load residual [4*H] into shared memory and compute sqrsum
+    const __nv_bfloat16* rptr = res + (int64_t)r * hc_dim;
+    float sq = 0.0f;
+    for (int i = tid; i < hc_dim; i += nthr) {
+        __nv_bfloat16 b = rptr[i];
+        s_res[i] = b;
+        float f = bf2f(b);
+        sq += f * f;
+    }
+    float total_sq = block_sum(sq, s_red);
+    float inv_rms = 1.0f / (sqrtf(total_sq / (float)hc_dim) + rms_eps);
+
+    // 24 dot products: 8 warps, each warp handles 3 output rows of fn [24, hc_dim]
+    int warp = tid >> 5;
+    int lane = tid & 31;
+    int nwarps = nthr >> 5;
+    for (int j = warp; j < 24; j += nwarps) {
+        const float* frow = fn + (int64_t)j * hc_dim;
+        float acc = 0.0f;
+        for (int i = lane; i < hc_dim; i += 32) {
+            acc += bf2f(s_res[i]) * frow[i];
+        }
+        acc = warp_sum(acc);
+        if (lane == 0) s_mix[j] = acc * inv_rms;
+    }
+    __syncthreads();
+
+    // Thread 0 computes pre, post, and 20-iter 4x4 Sinkhorn
+    if (tid == 0) {
+        float sc0 = hc_scale[0], sc1 = hc_scale[1], sc2 = hc_scale[2];
+        for (int c = 0; c < 4; ++c) {
+            s_pre[c] = sigmoid_rn(s_mix[c] * sc0 + hc_base[c]) + hc_eps;
+            post_mix[(int64_t)r * 4 + c] = sigmoid_rn(s_mix[4 + c] * sc1 + hc_base[4 + c]) * post_alpha;
+        }
+        float cm[4][4];
+        for (int i = 0; i < 4; ++i) {
+            float rmax = -1e38f;
+            for (int j = 0; j < 4; ++j) {
+                float v = s_mix[8 + i * 4 + j] * sc2 + hc_base[8 + i * 4 + j];
+                cm[i][j] = v;
+                if (v > rmax) rmax = v;
+            }
+            float rsum = 0.0f;
+            for (int j = 0; j < 4; ++j) {
+                cm[i][j] = expf(cm[i][j] - rmax);
+                rsum += cm[i][j];
+            }
+            for (int j = 0; j < 4; ++j) {
+                cm[i][j] = cm[i][j] / rsum + hc_eps;
+            }
+        }
+        // First col-norm
+        for (int j = 0; j < 4; ++j) {
+            float csum = cm[0][j] + cm[1][j] + cm[2][j] + cm[3][j] + hc_eps;
+            for (int i = 0; i < 4; ++i) cm[i][j] /= csum;
+        }
+        // Remaining sinkhorn_iters - 1 iterations
+        for (int it = 1; it < sinkhorn_iters; ++it) {
+            for (int i = 0; i < 4; ++i) {
+                float rsum = cm[i][0] + cm[i][1] + cm[i][2] + cm[i][3] + hc_eps;
+                for (int j = 0; j < 4; ++j) cm[i][j] /= rsum;
+            }
+            for (int j = 0; j < 4; ++j) {
+                float csum = cm[0][j] + cm[1][j] + cm[2][j] + cm[3][j] + hc_eps;
+                for (int i = 0; i < 4; ++i) cm[i][j] /= csum;
+            }
+        }
+        for (int i = 0; i < 4; ++i) {
+            for (int j = 0; j < 4; ++j) {
+                comb_mix[(int64_t)r * 16 + i * 4 + j] = cm[i][j];
+            }
+        }
+    }
+    __syncthreads();
+
+    // Collapse residual with pre_mix, round to BF16 (matching mhc_kernels.py), then RMSNorm
+    float p0 = s_pre[0], p1 = s_pre[1], p2 = s_pre[2], p3 = s_pre[3];
+    float norm_sq = 0.0f;
+    for (int h = tid; h < hidden; h += nthr) {
+        float v = p0 * bf2f(s_res[h]) +
+                  p1 * bf2f(s_res[hidden + h]) +
+                  p2 * bf2f(s_res[2 * hidden + h]) +
+                  p3 * bf2f(s_res[3 * hidden + h]);
+        __nv_bfloat16 vb = f2bf(v);
+        s_res[h] = vb;  // stash collapsed BF16 in s_res[0..hidden)
+        float vf = bf2f(vb);
+        norm_sq += vf * vf;
+    }
+    float total_norm_sq = block_sum(norm_sq, s_red);
+    float rrms = rsqrtf(total_norm_sq / (float)hidden + norm_eps);
+
+    __nv_bfloat16* optr = layer_in + (int64_t)r * hidden;
+    for (int h = tid; h < hidden; h += nthr) {
+        float v = bf2f(s_res[h]) * rrms * bf2f(norm_w[h]);
+        optr[h] = f2bf(v);
+    }
+}
+
+// ERNIE 5.5 mHC post:
+//   out[r, j, h] = post_mix[r, j] * x[r, h] + sum_{k=0..3} comb_mix[r, k*4 + j] * res[r, k, h]
+//   optional aux_mean[r, h] = 0.25 * sum_{j=0..3} out[r, j, h]
+extern "C" __global__ void tf_ernie55_mhc_post(
+    const __nv_bfloat16* __restrict__ x,        // [rows, H]
+    const __nv_bfloat16* __restrict__ res,      // [rows, 4, H]
+    const float* __restrict__ post_mix,         // [rows, 4]
+    const float* __restrict__ comb_mix,         // [rows, 16] (row=in, col=out)
+    __nv_bfloat16* __restrict__ out,            // [rows, 4, H]
+    __nv_bfloat16* __restrict__ aux_mean,       // nullable [rows, H]
+    int rows,
+    int hidden
+) {
+    int r = blockIdx.y;
+    int h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (r >= rows || h >= hidden) return;
+
+    float xv = bf2f(x[(int64_t)r * hidden + h]);
+    int64_t rbase = (int64_t)r * 4 * hidden + h;
+    float b0 = bf2f(res[rbase]);
+    float b1 = bf2f(res[rbase + hidden]);
+    float b2 = bf2f(res[rbase + 2 * hidden]);
+    float b3 = bf2f(res[rbase + 3 * hidden]);
+
+    const float* pm = post_mix + (int64_t)r * 4;
+    const float* cm = comb_mix + (int64_t)r * 16;
+
+    float mean_acc = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        float v = pm[j] * xv
+                + cm[0 * 4 + j] * b0
+                + cm[1 * 4 + j] * b1
+                + cm[2 * 4 + j] * b2
+                + cm[3 * 4 + j] * b3;
+        __nv_bfloat16 vb = f2bf(v);
+        out[rbase + (int64_t)j * hidden] = vb;
+        mean_acc += bf2f(vb);
+    }
+    if (aux_mean != nullptr) {
+        aux_mean[(int64_t)r * hidden + h] = f2bf(mean_acc * 0.25f);
+    }
+}
+
+// ERNIE 5.5 final mHC contract + final RMSNorm (model.mhc_contract + model.norm):
+//   rsqrt = rsqrt(mean(res^2) + rms_eps)
+//   pre[m] = sigmoid((res_flat @ hc_head_fn[m]) * rsqrt * hc_head_scale[0] + hc_head_base[m]) + hc_eps
+//   out = RMSNorm(bf16(sum_m pre[m] * res[m, :]), norm_w, norm_eps)
+extern "C" __global__ void tf_ernie55_mhc_contract_norm(
+    const __nv_bfloat16* __restrict__ res,      // [rows, 4, H]
+    const float* __restrict__ fn,               // [4, 4*H]
+    const float* __restrict__ hc_scale,         // [1]
+    const float* __restrict__ hc_base,          // [4]
+    const __nv_bfloat16* __restrict__ norm_w,   // [H]
+    __nv_bfloat16* __restrict__ out,            // [rows, H]
+    int rows,
+    int hidden,
+    float rms_eps,
+    float hc_eps,
+    float norm_eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    const int hc_dim = 4 * hidden;
+    const int tid = threadIdx.x;
+    const int nthr = blockDim.x;
+
+    extern __shared__ unsigned char raw_smem[];
+    __nv_bfloat16* s_res = reinterpret_cast<__nv_bfloat16*>(raw_smem);
+    float* s_red = reinterpret_cast<float*>(raw_smem + hc_dim * sizeof(__nv_bfloat16));
+    float* s_pre = s_red + 32;
+
+    const __nv_bfloat16* rptr = res + (int64_t)r * hc_dim;
+    float sq = 0.0f;
+    for (int i = tid; i < hc_dim; i += nthr) {
+        __nv_bfloat16 b = rptr[i];
+        s_res[i] = b;
+        float f = bf2f(b);
+        sq += f * f;
+    }
+    float total_sq = block_sum(sq, s_red);
+    float rrms_hc = rsqrtf(total_sq / (float)hc_dim + rms_eps);
+
+    int warp = tid >> 5;
+    int lane = tid & 31;
+    if (warp < 4) {
+        const float* frow = fn + (int64_t)warp * hc_dim;
+        float acc = 0.0f;
+        for (int i = lane; i < hc_dim; i += 32) {
+            acc += bf2f(s_res[i]) * frow[i];
+        }
+        acc = warp_sum(acc);
+        if (lane == 0) {
+            s_pre[warp] = sigmoid_rn(acc * rrms_hc * hc_scale[0] + hc_base[warp]) + hc_eps;
+        }
+    }
+    __syncthreads();
+
+    float p0 = s_pre[0], p1 = s_pre[1], p2 = s_pre[2], p3 = s_pre[3];
+    float norm_sq = 0.0f;
+    for (int h = tid; h < hidden; h += nthr) {
+        float v = p0 * bf2f(s_res[h]) +
+                  p1 * bf2f(s_res[hidden + h]) +
+                  p2 * bf2f(s_res[2 * hidden + h]) +
+                  p3 * bf2f(s_res[3 * hidden + h]);
+        __nv_bfloat16 vb = f2bf(v);
+        s_res[h] = vb;
+        float vf = bf2f(vb);
+        norm_sq += vf * vf;
+    }
+    float total_norm_sq = block_sum(norm_sq, s_red);
+    float rrms = rsqrtf(total_norm_sq / (float)hidden + norm_eps);
+
+    __nv_bfloat16* optr = out + (int64_t)r * hidden;
+    for (int h = tid; h < hidden; h += nthr) {
+        optr[h] = f2bf(bf2f(s_res[h]) * rrms * bf2f(norm_w[h]));
+    }
+}
+
+// Split-feature router logits: scores[r, e] = sigmoid(x[r] . w0[e]) + sigmoid(x[r] . w1[e])
+// Launch: grid=(ceil(E/4), rows), block=(128) (1 warp per expert)
+extern "C" __global__ void tf_ernie55_router_logits(
+    const __nv_bfloat16* __restrict__ x,   // [rows, H]
+    const __nv_bfloat16* __restrict__ w0,  // [E, H]
+    const __nv_bfloat16* __restrict__ w1,  // [E, H]
+    float* __restrict__ scores,            // [rows, E]
+    int rows,
+    int E,
+    int hidden
+) {
+    int r = blockIdx.y;
+    int warp = threadIdx.x >> 5;
+    int lane = threadIdx.x & 31;
+    int e = blockIdx.x * 4 + warp;
+    if (r >= rows || e >= E) return;
+
+    const __nv_bfloat16* xr = x + (int64_t)r * hidden;
+    const __nv_bfloat16* r0 = w0 + (int64_t)e * hidden;
+    const __nv_bfloat16* r1 = w1 + (int64_t)e * hidden;
+    float a0 = 0.0f, a1 = 0.0f;
+    for (int i = lane * 4; i < hidden; i += 128) {
+        uint2 xv = *reinterpret_cast<const uint2*>(xr + i);
+        uint2 v0 = *reinterpret_cast<const uint2*>(r0 + i);
+        uint2 v1 = *reinterpret_cast<const uint2*>(r1 + i);
+        const __nv_bfloat16* xp = reinterpret_cast<const __nv_bfloat16*>(&xv);
+        const __nv_bfloat16* p0 = reinterpret_cast<const __nv_bfloat16*>(&v0);
+        const __nv_bfloat16* p1 = reinterpret_cast<const __nv_bfloat16*>(&v1);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float xf = bf2f(xp[j]);
+            a0 += xf * bf2f(p0[j]);
+            a1 += xf * bf2f(p1[j]);
+        }
+    }
+    a0 = warp_sum(a0);
+    a1 = warp_sum(a1);
+    if (lane == 0) {
+        scores[(int64_t)r * E + e] = sigmoid_rn(a0) + sigmoid_rn(a1);
+    }
+}
+
+// Top-K routing with e_score_correction_bias + renorm + learnable routed_scaling_factor_param
+// Launch: grid=(rows), block=(32)
+extern "C" __global__ void tf_ernie55_router_topk(
+    const float* __restrict__ scores,      // [rows, E]
+    const float* __restrict__ bias,        // [E]
+    const float* __restrict__ scale,       // [E]
+    int32_t* __restrict__ out_ids,         // [rows, K]
+    float* __restrict__ out_weights,       // [rows, K]
+    int rows,
+    int E,
+    int K,
+    int norm_topk
+) {
+    int r = blockIdx.x;
+    int lane = threadIdx.x;
+    if (r >= rows) return;
+
+    const float* sr = scores + (int64_t)r * E;
+    // E <= 512 => 16 entries per lane
+    float my_sel[16];
+    float my_sc[16];
+    int nloc = (E + 31) >> 5;
+    for (int i = 0; i < nloc; ++i) {
+        int idx = lane + i * 32;
+        if (idx < E) {
+            float sc = sr[idx];
+            my_sc[i] = sc;
+            my_sel[i] = sc + bias[idx];
+        } else {
+            my_sc[i] = 0.0f;
+            my_sel[i] = -1e38f;
+        }
+    }
+
+    int sel_ids[16];
+    float sel_w[16];
+    float wsum = 0.0f;
+    for (int k = 0; k < K; ++k) {
+        float best_v = -1e38f;
+        int best_i = E;
+        float best_sc = 0.0f;
+        for (int i = 0; i < nloc; ++i) {
+            int idx = lane + i * 32;
+            float v = my_sel[i];
+            if (v > best_v || (v == best_v && idx < best_i)) {
+                best_v = v;
+                best_i = idx;
+                best_sc = my_sc[i];
+            }
+        }
+        // Warp reduction for max value with lowest-index tie-break
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            float ov = __shfl_xor_sync(0xffffffffu, best_v, off);
+            int oi = __shfl_xor_sync(0xffffffffu, best_i, off);
+            float osc = __shfl_xor_sync(0xffffffffu, best_sc, off);
+            if (ov > best_v || (ov == best_v && oi < best_i)) {
+                best_v = ov;
+                best_i = oi;
+                best_sc = osc;
+            }
+        }
+        sel_ids[k] = best_i;
+        sel_w[k] = best_sc;
+        wsum += best_sc;
+        // Mask out chosen expert in owning lane
+        if ((best_i & 31) == lane) {
+            int slot = best_i >> 5;
+            my_sel[slot] = -1e38f;
+        }
+    }
+
+    if (lane == 0) {
+        float inv_sum = (norm_topk && wsum > 0.0f) ? (1.0f / (wsum + 1e-20f)) : 1.0f;
+        // Note: match vllm_ernie exact renorm: weights / sum (no 1e-20 if sum > 0)
+        if (norm_topk && wsum > 0.0f) inv_sum = 1.0f / wsum;
+        for (int k = 0; k < K; ++k) {
+            int id = sel_ids[k];
+            out_ids[(int64_t)r * K + k] = id;
+            out_weights[(int64_t)r * K + k] = sel_w[k] * inv_sum * scale[id];
+        }
+    }
+}
+
+// SITU-GLU activation: (beta * tanh(g / beta) * sigmoid(g)) * (linear_beta * tanh(u / linear_beta))
+extern "C" __global__ void tf_ernie55_situ_and_mul(
+    const __nv_bfloat16* __restrict__ gate,
+    const __nv_bfloat16* __restrict__ up,
+    __nv_bfloat16* __restrict__ out,
+    int64_t count,
+    float beta,
+    float linear_beta
+) {
+    int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    float g = bf2f(gate[i]);
+    float u = bf2f(up[i]);
+    float sg = beta * tanhf(g / beta) * sigmoid_rn(g);
+    float su = linear_beta * tanhf(u / linear_beta);
+    out[i] = f2bf(sg * su);
+}
+
+// Standard RMSNorm (optional weight: if norm_w == nullptr, weightless RMSNorm)
+// Launch: grid=(rows), block=(256)
+extern "C" __global__ void tf_ernie55_rms_norm(
+    const __nv_bfloat16* __restrict__ x,
+    const __nv_bfloat16* __restrict__ w,  // nullable
+    __nv_bfloat16* __restrict__ out,
+    int rows,
+    int dim,
+    float eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    __shared__ float s_red[32];
+    const __nv_bfloat16* xr = x + (int64_t)r * dim;
+    __nv_bfloat16* yr = out + (int64_t)r * dim;
+    float sq = 0.0f;
+    for (int i = threadIdx.x; i < dim; i += blockDim.x) {
+        float v = bf2f(xr[i]);
+        sq += v * v;
+    }
+    float rrms = rsqrtf(block_sum(sq, s_red) / (float)dim + eps);
+    if (w != nullptr) {
+        for (int i = threadIdx.x; i < dim; i += blockDim.x) {
+            yr[i] = f2bf(bf2f(xr[i]) * rrms * bf2f(w[i]));
+        }
+    } else {
+        for (int i = threadIdx.x; i < dim; i += blockDim.x) {
+            yr[i] = f2bf(bf2f(xr[i]) * rrms);
+        }
+    }
+}
+
+// LayerNorm (for DSA indexer k_norm, dim=128)
+// Launch: grid=(rows), block=(128)
+extern "C" __global__ void tf_ernie55_layer_norm(
+    const __nv_bfloat16* __restrict__ x,
+    const __nv_bfloat16* __restrict__ w,
+    const __nv_bfloat16* __restrict__ b,
+    __nv_bfloat16* __restrict__ out,
+    int rows,
+    int dim,
+    float eps
+) {
+    int r = blockIdx.x;
+    if (r >= rows) return;
+    __shared__ float s_red[32];
+    const __nv_bfloat16* xr = x + (int64_t)r * dim;
+    __nv_bfloat16* yr = out + (int64_t)r * dim;
+    float s1 = 0.0f;
+    for (int i = threadIdx.x; i < dim; i += blockDim.x) s1 += bf2f(xr[i]);
+    float mean = block_sum(s1, s_red) / (float)dim;
+    float s2 = 0.0f;
+    for (int i = threadIdx.x; i < dim; i += blockDim.x) {
+        float d = bf2f(xr[i]) - mean;
+        s2 += d * d;
+    }
+    float inv = rsqrtf(block_sum(s2, s_red) / (float)dim + eps);
+    for (int i = threadIdx.x; i < dim; i += blockDim.x) {
+        float v = (bf2f(xr[i]) - mean) * inv * bf2f(w[i]) + bf2f(b[i]);
+        yr[i] = f2bf(v);
+    }
+}
