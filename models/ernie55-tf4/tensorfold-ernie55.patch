+    int r = blockIdx.x;
+    if (r >= rows) return;
+    const int tid = threadIdx.x;
+    const int nthr = blockDim.x;
+    const int hc_dim = 4 * hidden;
+
+    extern __shared__ unsigned char raw_smem[];
+    __nv_bfloat16* s_col = reinterpret_cast<__nv_bfloat16*>(raw_smem);
+    float* s_red = reinterpret_cast<float*>(raw_smem + hidden * sizeof(__nv_bfloat16));
+    float* s_pre = s_red + 32;
+
+    if (tid == 0) {
+        float inv_rms = 1.0f / (sqrtf(sqrsum_in[r] / (float)hc_dim) + rms_eps);
+        const float* mr = mix_raw + (int64_t)r * 24;
+        float sc0 = hc_scale[0], sc1 = hc_scale[1], sc2 = hc_scale[2];
+        for (int c = 0; c < 4; ++c) {
+            s_pre[c] = sigmoid_rn((mr[c] * inv_rms) * sc0 + hc_base[c]) + hc_eps;
+            post_mix[(int64_t)r * 4 + c] = sigmoid_rn((mr[4 + c] * inv_rms) * sc1 + hc_base[4 + c]) * post_alpha;
+        }
+        float cm[4][4];
+        for (int i = 0; i < 4; ++i) {
+            float rmax = -1e38f;
+            for (int j = 0; j < 4; ++j) {
+                float v = (mr[8 + i * 4 + j] * inv_rms) * sc2 + hc_base[8 + i * 4 + j];
