diff --git a/zig/src/families/ernie55/config.zig b/zig/src/families/ernie55/config.zig
new file mode 100644
index 0000000..71c7a4e
--- /dev/null
+++ b/zig/src/families/ernie55/config.zig
@@ -0,0 +1,289 @@
+//! ERNIE 5.5 Flash Preview (`model_type: "ernie5_5_moe"`) architecture configuration.
+const std = @import("std");
+
+pub const max_layers = 64;
+pub const max_dspark_targets = 8;
+
+pub const AttnKind = enum(u8) { hca, dsa };
+
+pub const RopeScaling = struct {
+    factor: f64 = 16.0,
+    original_max_positions: u32 = 65536,
+    beta_fast: f64 = 32.0,
+    beta_slow: f64 = 1.0,
+    yarn: bool = true,
+};
+
+pub const Config = struct {
+    vocab: u32 = 201216,
+    hidden: u32 = 4096,
+    layers: u32 = 43,
+    first_k_dense: u32 = 1,
+    eps: f32 = 1e-6,
+
+    // mHC hyper-connections
+    hc_mult: u32 = 4,
+    hc_sinkhorn_iters: u32 = 20,
+    hc_eps: f32 = 1e-6,
+    hc_post_alpha: f32 = 2.0,
+
+    // HCA attention (compress_ratios[i] > 0, e.g. 128)
+    heads: u32 = 64,
+    kv_heads: u32 = 1,
+    head_dim: u32 = 512,
+    q_lora: u32 = 1024,
+    kv_lora: u32 = 512,
+    qk_nope: u32 = 448,
+    qk_rope: u32 = 64,
+    o_groups: u32 = 8,
+    o_lora: u32 = 1024,
+    sliding_window: u32 = 128,
+    compress_ratio: u32 = 128,
+    vha_rank: u32 = 16,
+
+    // Hybrid MLA-DSA attention (compress_ratios[i] <= 0, e.g. -2)
+    mla_heads: u32 = 64,
+    mla_q_lora: u32 = 1024,
+    mla_kv_lora: u32 = 512,
+    mla_qk_nope: u32 = 192,
+    mla_qk_rope: u32 = 64,
+    mla_v_dim: u32 = 256,
+    index_heads: u32 = 64,
+    index_dim: u32 = 128,
+    index_topk: u32 = 2048,
+
+    // RoPE
+    max_positions: u32 = 1048576,
+    rope_theta: f64 = 8000000.0,
+    compress_rope_theta: f64 = 160000.0,
+    rope_scaling: RopeScaling = .{},
+
+    // Dense MLP & Latent MXFP4 MoE
+    intermediate: u32 = 14336,
+    moe_intermediate: u32 = 2048,
+    moe_latent: u32 = 2048,
+    experts: u32 = 512,
+    shared_experts: u32 = 1,
+    topk: u32 = 10,
+    norm_topk: bool = true,
+    situ_beta: f32 = 4.0,
+    situ_linear_beta: f32 = 25.0,
+
+    // Tokens
+    bos_id: u32 = 1,
+    eos_id: u32 = 2,
+    pad_id: u32 = 0,
+
+    // Per-layer schedule
+    compress_ratios: [max_layers]i32 = @splat(128),
+
+    // Bundled DSpark draft head (model.mtp.*)
+    dspark_block_size: u32 = 7,
+    dspark_markov_rank: u32 = 256,
+    dspark_noise_token: u32 = 1024,
+    dspark_targets: [max_dspark_targets]u32 = @splat(0),
+    dspark_target_count: u32 = 0,
+
+    pub fn attnKind(c: *const Config, layer: u32) AttnKind {
+        return if (c.compress_ratios[layer] <= 0) .dsa else .hca;
+    }
+
+    pub fn isDsa(c: *const Config, layer: u32) bool {
+        return c.attnKind(layer) == .dsa;
+    }
+
+    pub fn isHca(c: *const Config, layer: u32) bool {
+        return c.attnKind(layer) == .hca;
+    }
+
+    pub fn isMoe(c: *const Config, layer: u32) bool {
+        return layer >= c.first_k_dense;
+    }
+
+    pub fn dsaCount(c: *const Config) u32 {
+        var n: u32 = 0;
+        for (0..c.layers) |i| n += @intFromBool(c.isDsa(@intCast(i)));
+        return n;
+    }
+
+    pub fn hcaCount(c: *const Config) u32 {
+        return c.layers - c.dsaCount();
+    }
+
+    pub fn hasBundledDspark(c: *const Config) bool {
+        return c.dspark_target_count > 0 and c.layers > c.dspark_target_count;
+    }
+
+    pub fn hcDim(c: *const Config) u32 {
+        return c.hc_mult * c.hidden;
+    }
+
+    pub fn hcMixOut(c: *const Config) u32 {
+        return c.hc_mult * (2 + c.hc_mult);
+    }
+
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Config {
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(bytes);
+        return parse(gpa, bytes);
+    }
+
+    pub fn parse(gpa: std.mem.Allocator, bytes: []const u8) !Config {
+        const doc = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+        defer doc.deinit();
+        if (doc.value != .object) return error.BadErnie55Config;
+        const o = doc.value.object;
+
+        try expectStr(o, "model_type", "ernie5_5_moe");
+        try expectStr(o, "hidden_act", "situ");
+
+        var c: Config = .{};
+        c.vocab = try optU32(o, "vocab_size", c.vocab);
+        c.hidden = try optU32(o, "hidden_size", c.hidden);
+        c.layers = try optU32(o, "num_hidden_layers", c.layers);
+        if (c.layers == 0 or c.layers > max_layers) return error.BadErnie55Config;
+        c.first_k_dense = try optU32(o, "first_k_dense_replace", c.first_k_dense);
+        c.eps = @floatCast(try optF64(o, "rms_norm_eps", c.eps));
+
+        c.hc_mult = try optU32(o, "hc_mult", c.hc_mult);
+        c.hc_sinkhorn_iters = try optU32(o, "hc_sinkhorn_iters", c.hc_sinkhorn_iters);
+        c.hc_eps = @floatCast(try optF64(o, "hc_eps", c.hc_eps));
+
+        c.heads = try optU32(o, "num_attention_heads", c.heads);
+        c.kv_heads = try optU32(o, "num_key_value_heads", c.kv_heads);
+        c.head_dim = try optU32(o, "head_dim", c.head_dim);
+        c.q_lora = try optU32(o, "q_lora_rank", c.q_lora);
+        c.kv_lora = try optU32(o, "kv_lora_rank", c.kv_lora);
+        c.qk_nope = try optU32(o, "qk_nope_head_dim", c.qk_nope);
+        c.qk_rope = try optU32(o, "qk_rope_head_dim", c.qk_rope);
+        c.o_groups = try optU32(o, "o_groups", c.o_groups);
+        c.o_lora = try optU32(o, "o_lora_rank", c.o_lora);
+        c.sliding_window = try optU32(o, "sliding_window", c.sliding_window);
+
+        c.mla_heads = try optU32(o, "hybrid_mla_num_attention_heads", c.mla_heads);
+        c.mla_q_lora = try optU32(o, "hybrid_mla_q_lora_rank", c.mla_q_lora);
+        c.mla_kv_lora = try optU32(o, "hybrid_mla_kv_lora_rank", c.mla_kv_lora);
+        c.mla_qk_nope = try optU32(o, "hybrid_mla_qk_nope_head_dim", c.mla_qk_nope);
+        c.mla_qk_rope = try optU32(o, "hybrid_mla_qk_rope_head_dim", c.mla_qk_rope);
+        c.mla_v_dim = try optU32(o, "hybrid_mla_v_head_dim", c.mla_v_dim);
+        c.index_heads = try optU32(o, "index_n_heads", c.index_heads);
+        c.index_dim = try optU32(o, "index_head_dim", c.index_dim);
+        c.index_topk = try optU32(o, "index_topk", c.index_topk);
+
+        c.max_positions = try optU32(o, "max_position_embeddings", c.max_positions);
+        c.rope_theta = try optF64(o, "rope_theta", c.rope_theta);
+        c.compress_rope_theta = try optF64(o, "compress_rope_theta", c.compress_rope_theta);
+        if (o.get("rope_scaling")) |rs| {
+            if (rs != .object) return error.BadErnie55Config;
+            const ro = rs.object;
+            c.rope_scaling.factor = try optF64(ro, "factor", c.rope_scaling.factor);
+            c.rope_scaling.original_max_positions = try optU32(ro, "original_max_position_embeddings", c.rope_scaling.original_max_positions);
+            c.rope_scaling.beta_fast = try optF64(ro, "beta_fast", c.rope_scaling.beta_fast);
+            c.rope_scaling.beta_slow = try optF64(ro, "beta_slow", c.rope_scaling.beta_slow);
+            if (ro.get("type")) |tv| {
+                c.rope_scaling.yarn = (tv == .string and std.mem.eql(u8, tv.string, "yarn"));
+            }
+        }
+
+        c.intermediate = try optU32(o, "intermediate_size", c.intermediate);
+        c.moe_intermediate = try optU32(o, "moe_intermediate_size", c.moe_intermediate);
+        c.moe_latent = try optU32(o, "moe_latent_size", c.moe_latent);
+        c.experts = try optU32(o, "n_routed_experts", c.experts);
+        c.shared_experts = try optU32(o, "n_shared_experts", c.shared_experts);
+        c.topk = try optU32(o, "num_experts_per_tok", c.topk);
+        if (o.get("norm_topk_prob")) |v| {
+            if (v != .bool) return error.BadErnie55Config;
+            c.norm_topk = v.bool;
+        }
+        c.situ_beta = @floatCast(try optF64(o, "activation_situ_beta", c.situ_beta));
+        c.situ_linear_beta = @floatCast(try optF64(o, "activation_situ_linear_beta", c.situ_linear_beta));
+
+        c.bos_id = try optU32(o, "bos_token_id", c.bos_id);
+        c.eos_id = try optU32(o, "eos_token_id", c.eos_id);
+        c.pad_id = try optU32(o, "pad_token_id", c.pad_id);
+
+        if (o.get("compress_ratios")) |cr| {
+            if (cr != .array or cr.array.items.len < c.layers) return error.BadErnie55Config;
+            var max_cr: u32 = 1;
+            for (0..c.layers) |i| {
+                const v = cr.array.items[i];
+                if (v != .integer) return error.BadErnie55Config;
+                c.compress_ratios[i] = @intCast(v.integer);
+                if (v.integer > 1) max_cr = @max(max_cr, @as(u32, @intCast(v.integer)));
+            }
+            c.compress_ratio = max_cr;
+        }
+
+        c.dspark_block_size = try optU32(o, "dspark_block_size", c.dspark_block_size);
+        c.dspark_markov_rank = try optU32(o, "dspark_markov_rank", c.dspark_markov_rank);
+        c.dspark_noise_token = try optU32(o, "dspark_noise_token_id", c.dspark_noise_token);
+        if (o.get("dspark_target_layer_ids")) |dt| {
+            if (dt != .array or dt.array.items.len > max_dspark_targets) return error.BadErnie55Config;
+            c.dspark_target_count = @intCast(dt.array.items.len);
+            for (dt.array.items, 0..) |v, i| {
+                if (v != .integer or v.integer < 0) return error.BadErnie55Config;
+                c.dspark_targets[i] = @intCast(v.integer);
+            }
+        }
+
+        // Validate quantization_config: must be block-128 FP8 + MXFP4 experts
+        if (o.get("quantization_config")) |qc| {
+            if (qc != .object) return error.UnsupportedErnie55Quant;
+            const qo = qc.object;
+            try expectStr(qo, "quant_method", "fp8");
+            try expectStr(qo, "expert_dtype", "mxfp4");
+        } else return error.UnsupportedErnie55Quant;
+
+        // Sanity checks on fixed kernel invariants
+        if (c.hc_mult != 4 or c.head_dim != 512 or c.qk_rope != 64 or c.qk_nope != 448) return error.UnsupportedErnie55Shape;
+        if (c.mla_kv_lora != 512 or c.mla_qk_nope != 192 or c.mla_qk_rope != 64 or c.mla_v_dim != 256) return error.UnsupportedErnie55Shape;
+        if (c.index_dim != 128 or c.o_groups != 8) return error.UnsupportedErnie55Shape;
+        return c;
+    }
+};
+
+fn expectStr(o: std.json.ObjectMap, key: []const u8, want: []const u8) !void {
+    const v = o.get(key) orelse return error.BadErnie55Config;
+    if (v != .string or !std.mem.eql(u8, v.string, want)) return error.UnsupportedErnie55Config;
+}
+
+fn optU32(o: std.json.ObjectMap, key: []const u8, fallback: u32) !u32 {
+    const v = o.get(key) orelse return fallback;
+    if (v != .integer or v.integer < 0 or v.integer > std.math.maxInt(u32)) return error.BadErnie55Config;
+    return @intCast(v.integer);
+}
+
+fn optF64(o: std.json.ObjectMap, key: []const u8, fallback: f64) !f64 {
+    const v = o.get(key) orelse return fallback;
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        else => error.BadErnie55Config,
+    };
+}
+
+test "ernie55 config parses the release shape and layer schedule" {
+    const sample =
+        \\{
+        \\  "model_type": "ernie5_5_moe",
+        \\  "hidden_act": "situ",
+        \\  "vocab_size": 201216,
+        \\  "hidden_size": 4096,
+        \\  "num_hidden_layers": 43,
+        \\  "first_k_dense_replace": 1,
+        \\  "compress_ratios": [128,128,128,128,128,128,128,-2,128,128,128,128,128,128,-2,128,128,128,128,128,128,-2,128,128,128,128,128,128,-2,128,128,128,128,128,128,-2,128,128,128,128,128,128,-2],
+        \\  "dspark_target_layer_ids": [40, 41, 42],
+        \\  "quantization_config": {"quant_method": "fp8", "expert_dtype": "mxfp4", "weight_block_size": [128, 128]}
+        \\}
+    ;
+    const c = try Config.parse(std.testing.allocator, sample);
+    try std.testing.expectEqual(@as(u32, 43), c.layers);
+    try std.testing.expectEqual(@as(u32, 6), c.dsaCount());
+    try std.testing.expectEqual(@as(u32, 37), c.hcaCount());
+    try std.testing.expect(c.isHca(0) and !c.isMoe(0));
+    try std.testing.expect(c.isHca(1) and c.isMoe(1));
+    try std.testing.expect(c.isDsa(7) and c.isDsa(14) and c.isDsa(42));
+    try std.testing.expect(c.hasBundledDspark());
+}
diff --git a/zig/src/families/ernie55/cuda_dspark.zig b/zig/src/families/ernie55/cuda_dspark.zig
new file mode 100644
index 0000000..bc28aaf
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_dspark.zig
@@ -0,0 +1,214 @@
+//! Bundled 3-layer DSpark speculative drafter for ERNIE 5.5 Flash Preview (SWA-128 non-causal HCA + Latent MXFP4 MoE + Markov head + MultiMax).
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+const shard = @import("cuda_shard.zig");
+const weights = @import("cuda_weights.zig");
+const kv_mod = @import("cuda_kv.zig");
+const fw = @import("cuda_forward.zig");
+
+const Driver = cuda.Driver;
+const Stream = cuda.Stream;
+const DeviceBuffer = cuda.DeviceBuffer;
+const Scratch = kv_mod.Scratch;
+
+pub const block_size: usize = 7;
+pub const noise_token: i32 = 1024;
+pub const num_layers: usize = 3;
+/// Power-of-2 ring capacity > sliding_window (128) + block_size (7).
+pub const ring_cap: usize = 256;
+pub const ring_mask: usize = ring_cap - 1;
+/// Target layers tapped (0-indexed; checkpoint's dspark_target_layer_ids = [40, 41, 42] are 1-indexed).
+pub const tap_layers = [3]usize{ 39, 40, 41 };
+
+/// Per-sequence DSpark SWA KV ring cache: 3 layers x 256 slots x 512 BF16 = 768 KiB total!
+pub const Caches = struct {
+    buf: DeviceBuffer,
+    layer_bytes: usize,
+
+    pub fn init(d: *const Driver) !Caches {
+        const layer_bytes = ring_cap * 512 * 2;
+        var buf = try DeviceBuffer.alloc(d, num_layers * layer_bytes);
+        errdefer buf.free();
+        try buf.fill8(0, null);
+        return .{ .buf = buf, .layer_bytes = layer_bytes };
+    }
+
+    pub fn deinit(self: *Caches) void {
+        self.buf.free();
+        self.* = undefined;
+    }
+
+    pub fn ring(self: *const Caches, l: usize) u64 {
+        return self.buf.ptr + l * self.layer_bytes;
+    }
+};
+
+const pick_stride: usize = 16; // 16-byte aligned {float val, i32 id, pad[8]} for RoCE allGather
+const max_world: usize = 8;
+
+/// Reusable DSpark runner state (on-device Markov walk + RoCE 16B pick gather).
+pub const Drafter = struct {
+    d: *const Driver,
+    w: *const weights.DsparkWeights,
+    scores: DeviceBuffer, // F32 [vocab_width]
+    picks: DeviceBuffer, // [max_world * 16] + walk [16 * 4]
+    walk_off: usize,
+
+    pub fn init(d: *const Driver, w: *const weights.DsparkWeights, vocab_width: usize) !Drafter {
+        var scores = try DeviceBuffer.alloc(d, vocab_width * 4);
+        errdefer scores.free();
+        const walk_off = max_world * pick_stride;
+        var picks = try DeviceBuffer.alloc(d, walk_off + 16 * 4);
+        errdefer picks.free();
+        try picks.fill8(0, null);
+        return .{
+            .d = d,
+            .w = w,
+            .scores = scores,
+            .picks = picks,
+            .walk_off = walk_off,
+        };
+    }
+
+    pub fn deinit(self: *Drafter) void {
+        self.picks.free();
+        self.scores.free();
+        self.* = undefined;
+    }
+
+    /// Absorb `rows` target context hidden taps (`taps_dev` = BF16 [rows, 12288]) at positions `p0 .. p0 + rows - 1`.
+    /// Only the trailing min(rows, 128) tokens can ever fall inside the SWA-128 window, so long prefills stay O(128).
+    pub fn absorb(
+        self: *const Drafter,
+        runner: *const fw.Runner,
+        s: Stream,
+        caches: *const Caches,
+        sc: *const Scratch,
+        taps_dev: u64,
+        rows: usize,
+        p0: usize,
+    ) !void {
+        if (rows == 0) return;
+        const c = &runner.w.config;
+        const take = @min(rows, c.sliding_window);
+        const skip = rows - take;
+        const start_pos = p0 + skip;
+        const taps_ptr = taps_dev + skip * (3 * c.hidden) * 2;
+
+        // Upload positions [start_pos .. start_pos + take - 1]
+        var pos_host: [128]i32 = undefined;
+        for (0..take) |i| pos_host[i] = @intCast(start_pos + i);
+        try cuda.copy_source.enqueue(self.d, sc.positions, std.mem.sliceAsBytes(pos_host[0..take]), s);
+
+        // main_x = rms_norm(feature_projection(taps), feature_norm) -> sc.layer_in [take, 4096]
+        try runner.fp8(s, taps_ptr, 3 * c.hidden, take, self.w.feature_proj, sc.layer_in, sc.qmmf_part);
+        try runner.k.rmsNorm(s, sc.layer_in, self.w.feature_norm, sc.layer_in, take, c.hidden, c.eps);
+
+        // Project context KV for each of the 3 draft layers using plain RoPE (mla_inv_freq) -> ring cache.
+        for (0..num_layers) |li| {
+            const dl = &self.w.layers[li];
+            try runner.fp8(s, sc.layer_in, c.hidden, take, dl.hca.kv_proj, sc.kv_a, sc.qmmf_part);
+            try runner.k.hcaKvStoreRing(s, sc.kv_a, dl.hca.kv_norm, sc.positions, runner.w.mla_inv_freq, caches.ring(li), take, ring_mask, c.eps);
+        }
+    }
+
+    /// Draft `out.len` speculative tokens (1 <= out.len <= 7) starting from `anchor` at position `p`.
+    /// Context positions `0 .. p - 1` must already be absorbed into `caches`.
+    pub fn draft(
+        self: *const Drafter,
+        runner: *const fw.Runner,
+        s: Stream,
+        caches: *const Caches,
+        sc: *const Scratch,
+        anchor: i32,
+        p: usize,
+        out: []i32,
+    ) !void {
+        const c = &runner.w.config;
+        const sh = &runner.w.share;
+        const k = runner.k;
+        const n_out = out.len;
+        if (n_out == 0 or n_out > block_size) return error.InvalidDraftCount;
+
+        // 1. Upload block tokens [anchor, noise, ..., noise] and positions [p .. p + 6]
+        var ids: [block_size]i32 = .{ anchor, noise_token, noise_token, noise_token, noise_token, noise_token, noise_token };
+        var pos: [block_size]i32 = undefined;
+        for (0..block_size) |j| pos[j] = @intCast(p + j);
+        try cuda.copy_source.enqueue(self.d, sc.ids, std.mem.sliceAsBytes(&ids), s);
+        try cuda.copy_source.enqueue(self.d, sc.positions, std.mem.sliceAsBytes(&pos), s);
+
+        // 2. Embed + broadcast to 4-stream mHC residual (reusing target embed)
+        try k.embedBroadcast(s, sc.ids, runner.w.embed, sc.res_a, block_size, c.hidden, c.hc_mult);
+        var res_cur = sc.res_a;
+        var res_nxt = sc.res_b;
+
+        const lo: usize = (p + 1) -| c.sliding_window;
+        const hi: usize = p + block_size - 1;
+
+        // 3. 3 draft layers (non-causal SWA-128 HCA with plain mla_inv_freq RoPE + Latent MXFP4 MoE)
+        for (0..num_layers) |li| {
+            const dl = &self.w.layers[li];
+            try k.mhcPreFast(
+                s, res_cur, dl.hc_attn.fn_w, sc.mhc_mix_raw, sc.mhc_sqrsum,
+                dl.hc_attn.scale, dl.hc_attn.base, dl.attn_norm,
+                sc.post_mix, sc.comb_mix, sc.layer_in,
+                block_size, c.hidden, c.eps, c.hc_eps, c.hc_post_alpha, c.hc_sinkhorn_iters, c.eps,
+            );
+
+            try runner.forwardHcaDspark(s, &dl.hca, caches.ring(li), sc, block_size, lo, hi, ring_mask);
+
+            try k.mhcPost(s, sc.sub_out, res_cur, sc.post_mix, sc.comb_mix, res_nxt, 0, block_size, c.hidden);
+            std.mem.swap(u64, &res_cur, &res_nxt);
+
+            try k.mhcPreFast(
+                s, res_cur, dl.hc_ffn.fn_w, sc.mhc_mix_raw, sc.mhc_sqrsum,
+                dl.hc_ffn.scale, dl.hc_ffn.base, dl.ffn_norm,
+                sc.post_mix, sc.comb_mix, sc.layer_in,
+                block_size, c.hidden, c.eps, c.hc_eps, c.hc_post_alpha, c.hc_sinkhorn_iters, c.eps,
+            );
+
+            try runner.forwardMoe(s, &dl.moe, sc, block_size);
+
+            try k.mhcPost(s, sc.sub_out, res_cur, sc.post_mix, sc.comb_mix, res_nxt, 0, block_size, c.hidden);
+            std.mem.swap(u64, &res_cur, &res_nxt);
+        }
+
+        // 4. Draft mHC contract + norm -> shared target lm_head (raw logits, NO multimax yet!)
+        try k.mhcContractNorm(
+            s, res_cur, self.w.hc_head_fn, self.w.hc_head_scale, self.w.hc_head_base, self.w.norm,
+            sc.layer_in, n_out, c.hidden, c.eps, c.hc_eps, c.eps,
+        );
+        try runner.lane.matmulF32(s, sc.layer_in, c.hidden, n_out, runner.w.lm_head, sc.logits, sc.qmmf_part);
+
+        // 5. On-device Markov walk: walk[0] = anchor; for step j = 0..n_out-1:
+        //    scores = multimax(logits[j] + w2 @ w1[walk[j]]) -> argmax -> RoCE 16B allGather -> pickMerge -> walk[j+1]
+        const walk_ptr = self.picks.ptr + self.walk_off;
+        try cuda.copy_source.enqueue(self.d, walk_ptr, std.mem.asBytes(&anchor), s);
+        const mine = self.picks.ptr + sh.rank * pick_stride;
+        for (0..n_out) |j| {
+            const row_logits = sc.logits + j * sh.vocab_width * 4;
+            try k.dsparkMarkovMultimax(
+                s, row_logits, self.w.markov_w2, self.w.markov_w1,
+                walk_ptr + j * 4, self.scores.ptr,
+                runner.w.multimax_ranges, runner.w.multimax_ts,
+                sh.vocab_width,
+            );
+            // argmax writes out_id (4B) and out_val (4B); pack as {val @ +0, id @ +4} matching pick_merge!
+            try k.argmaxF32(s, self.scores.ptr, mine + 4, mine, 1, sh.vocab_width, sh.vocab_lo);
+            if (runner.group) |g| {
+                if (g.world > 1) {
+                    try g.allGather(s, mine, self.picks.ptr, pick_stride);
+                }
+            }
+            try k.pickMerge(s, self.picks.ptr, sh.world, pick_stride, walk_ptr, j);
+        }
+
+        // Single sync + download of walk[1 .. n_out + 1]
+        try s.synchronize();
+        if (runner.group) |g| try g.check();
+        var walk_host: [block_size + 1]i32 = undefined;
+        try cuda.memory.download(self.d, walk_ptr, std.mem.sliceAsBytes(walk_host[0 .. n_out + 1]));
+        @memcpy(out, walk_host[1 .. n_out + 1]);
+    }
+};
diff --git a/zig/src/families/ernie55/cuda_dump_main.zig b/zig/src/families/ernie55/cuda_dump_main.zig
new file mode 100644
index 0000000..521c26d
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_dump_main.zig
@@ -0,0 +1,357 @@
+//! tf-ernie55-cuda: standalone parity check & decode/prefill/DSpark benchmark for ERNIE 5.5 Flash Preview on CUDA (TP=1/2/4).
+const std = @import("std");
+const cuda = @import("cuda");
+const ernie = @import("ernie55");
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+
+    var model_dir: []const u8 = "/var/tmp/models/ERNIE-5.5-Flash-Preview";
+    var max_layers: ?u32 = null;
+    var decode_steps: usize = 16;
+    var dspark_k: usize = 0;
+    var tp: usize = 1;
+    var rank: usize = 0;
+    var capacity: usize = 4096;
+    var prompt_str: []const u8 = "1,20000,1500,500";
+    var dump_path: ?[]const u8 = null;
+
+    var i: usize = 1;
+    while (i < args.len) : (i += 1) {
+        if (std.mem.eql(u8, args[i], "--model") and i + 1 < args.len) {
+            i += 1;
+            model_dir = args[i];
+        } else if (std.mem.eql(u8, args[i], "--layers") and i + 1 < args.len) {
+            i += 1;
+            max_layers = try std.fmt.parseInt(u32, args[i], 10);
+        } else if (std.mem.eql(u8, args[i], "--steps") and i + 1 < args.len) {
+            i += 1;
+            decode_steps = try std.fmt.parseInt(usize, args[i], 10);
+        } else if (std.mem.eql(u8, args[i], "--dspark") and i + 1 < args.len) {
+            i += 1;
+            dspark_k = try std.fmt.parseInt(usize, args[i], 10);
+        } else if (std.mem.eql(u8, args[i], "--tp") and i + 1 < args.len) {
+            i += 1;
+            tp = try std.fmt.parseInt(usize, args[i], 10);
+        } else if (std.mem.eql(u8, args[i], "--rank") and i + 1 < args.len) {
+            i += 1;
+            rank = try std.fmt.parseInt(usize, args[i], 10);
+        } else if (std.mem.eql(u8, args[i], "--cap") and i + 1 < args.len) {
+            i += 1;
+            capacity = try std.fmt.parseInt(usize, args[i], 10);
+        } else if (std.mem.eql(u8, args[i], "--ids") and i + 1 < args.len) {
+            i += 1;
+            prompt_str = args[i];
+        } else if (std.mem.eql(u8, args[i], "--dump") and i + 1 < args.len) {
+            i += 1;
+            dump_path = args[i];
+        }
+    }
+
+    var prompt_ids: std.ArrayList(i32) = .empty;
+    var it = std.mem.splitScalar(u8, prompt_str, ',');
+    while (it.next()) |tok| {
+        if (tok.len == 0) continue;
+        try prompt_ids.append(a, try std.fmt.parseInt(i32, tok, 10));
+    }
+    const n_prompt = prompt_ids.items.len;
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, false);
+    defer stream.deinit();
+
+    var group_opt: ?cuda.tp_group.Group = null;
+    if (tp > 1) {
+        group_opt = try cuda.tp_group.Group.open(&driver, rank, tp);
+        if (init.environ_map.get("TF_ROCE") != null) try group_opt.?.openRoce(gpa, io, &driver, stream, 64 * 1024 * 1024);
+    }
+    defer if (group_opt) |*g| g.close();
+
+    var lane = try cuda.qmmf.Lane.load(&driver, 12);
+    defer lane.unload();
+    lane.pdl = true;
+
+    var kernels = try ernie.cuda_kernels.Kernels.load(&driver);
+    defer kernels.unload();
+
+    const t0 = std.Io.Clock.awake.now(io);
+    var w = try ernie.cuda_weights.load(gpa, io, &driver, model_dir, rank, tp, .{
+        .max_layers = max_layers,
+        .load_dspark = dspark_k > 0,
+    });
+    defer w.deinit();
+    const t_load = std.Io.Clock.awake.now(io);
+    const load_s = @as(f64, @floatFromInt(t0.durationTo(t_load).nanoseconds)) / 1e9;
+    if (rank == 0) {
+        std.debug.print("[ernie55] loaded {d} layers (dspark={d}) in {d:.2}s ({d:.2} GiB)\n", .{
+            w.loaded_layers, dspark_k, load_s, @as(f64, @floatFromInt(w.bytes)) / (1024.0 * 1024.0 * 1024.0),
+        });
+    }
+
+    // NCCL barrier after weight load so slower NVMe ranks finish before any RoCE fast-path spin-wait.
+    if (group_opt) |*g| {
+        var bar: [8]u64 = @splat(0);
+        bar[rank] = 0xE55_0001;
+        try g.gather(u64, &driver, stream, 0xE55_0001, bar[0..tp]);
+    }
+
+    var kvc = try ernie.cuda_kv.KvCache.alloc(gpa, &driver, &w.config, w.loaded_layers, capacity);
+    defer kvc.deinit();
+    const max_rows = @max(n_prompt, @max(@as(usize, 16), dspark_k + 1));
+    var sc = try ernie.cuda_kv.Scratch.alloc(&driver, &w.config, &w.share, max_rows, capacity);
+    defer sc.deinit();
+
+    const runner: ernie.cuda_forward.Runner = .{
+        .k = &kernels,
+        .lane = &lane,
+        .w = &w,
+        .group = if (group_opt) |*g| g else null,
+    };
+
+    var dspark_caches: ?ernie.cuda_dspark.Caches = null;
+    defer if (dspark_caches) |*dc| dc.deinit();
+    var drafter: ?ernie.cuda_dspark.Drafter = null;
+    defer if (drafter) |*dr| dr.deinit();
+    if (dspark_k > 0) {
+        dspark_caches = try ernie.cuda_dspark.Caches.init(&driver);
+        drafter = try ernie.cuda_dspark.Drafter.init(&driver, &w.dspark.?, w.share.vocab_width);
+    }
+
+    // Helper: pick greedy argmax across TP ranks for `n_rows` rows using 1 single RoCE allGather.
+    const Pair16 = extern struct { val: f32, id: i32, pad0: u32 = 0, pad1: u32 = 0 };
+    const pickRows = struct {
+        fn run(d: *const cuda.Driver, s: cuda.Stream, g_opt: ?*const cuda.tp_group.Group, sc_ptr: *const ernie.cuda_kv.Scratch, row0: usize, n_rows: usize, out: []i32) !void {
+            var ids_loc: [16]i32 = undefined;
+            var vals_loc: [16]f32 = undefined;
+            try cuda.memory.download(d, sc_ptr.argmax_id + row0 * 4, std.mem.sliceAsBytes(ids_loc[0..n_rows]));
+            try cuda.memory.download(d, sc_ptr.argmax_val + row0 * 4, std.mem.sliceAsBytes(vals_loc[0..n_rows]));
+            if (g_opt) |g| {
+                if (g.world > 1) {
+                    var loc: [16]Pair16 = undefined;
+                    for (0..n_rows) |r| loc[r] = .{ .val = vals_loc[r], .id = ids_loc[r] };
+                    const bytes = n_rows * @sizeOf(Pair16);
+                    try sc_ptr.buf.upload(sc_ptr.moe_pack - sc_ptr.buf.ptr, std.mem.sliceAsBytes(loc[0..n_rows]));
+                    try g.allGather(s, sc_ptr.moe_pack, sc_ptr.tp_gather, bytes);
+                    try s.synchronize();
+                    try g.check();
+                    var all: [8 * 16]Pair16 = undefined;
+                    try cuda.memory.download(d, sc_ptr.tp_gather, std.mem.sliceAsBytes(all[0 .. g.world * n_rows]));
+                    for (0..n_rows) |r| {
+                        var best = all[r];
+                        for (1..g.world) |wk| {
+                            const p = all[wk * n_rows + r];
+                            if (p.val > best.val or (p.val == best.val and p.id < best.id)) best = p;
+                        }
+                        out[r] = best.id;
+                    }
+                    return;
+                }
+            }
+            for (0..n_rows) |r| out[r] = ids_loc[r];
+        }
+    }.run;
+
+    // Prefill
+    const pos_host = try a.alloc(i32, n_prompt);
+    for (0..n_prompt) |idx| pos_host[idx] = @intCast(idx);
+    try sc.buf.upload(sc.ids - sc.buf.ptr, std.mem.sliceAsBytes(prompt_ids.items));
+    try sc.buf.upload(sc.positions - sc.buf.ptr, std.mem.sliceAsBytes(pos_host));
+
+    const t_pf0 = std.Io.Clock.awake.now(io);
+    const pf_taps: u64 = if (dspark_k > 0) sc.dspark_taps else 0;
+    try runner.forwardWithTaps(stream, &kvc, &sc, n_prompt, n_prompt - 1, true, pf_taps);
+    if (dspark_k > 0) {
+        try drafter.?.absorb(&runner, stream, &dspark_caches.?, &sc, sc.dspark_taps, n_prompt, 0);
+    }
+    try stream.synchronize();
+    if (group_opt) |*g| try g.check();
+    const t_pf1 = std.Io.Clock.awake.now(io);
+    const pf_ms = @as(f64, @floatFromInt(t_pf0.durationTo(t_pf1).nanoseconds)) / 1e6;
+
+    if (dump_path) |dp| {
+        if (rank == 0) {
+            const h_bytes = try gpa.alloc(u8, n_prompt * w.config.hidden * 2);
+            defer gpa.free(h_bytes);
+            try cuda.memory.download(&driver, sc.layer_in, h_bytes);
+            try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = dp, .data = h_bytes });
+            std.debug.print("[ernie55] dumped final hidden ({d} bytes) -> {s}\n", .{ h_bytes.len, dp });
+        }
+    }
+
+    var first_arr: [1]i32 = undefined;
+    try pickRows(&driver, stream, if (group_opt) |*g| g else null, &sc, n_prompt - 1, 1, &first_arr);
+    var next_tok = first_arr[0];
+    var gen = try a.alloc(i32, decode_steps);
+    var cur_pos: usize = n_prompt;
+    const use_graph = (tp == 1) or (if (group_opt) |*g| g.fast != null else false);
+
+    if (dspark_k == 0) {
+        // Plain 1-token decode with CUDA Graph
+        var graph_exec: ?cuda.graph.Exec = null;
+        defer if (graph_exec) |*ge| ge.deinit();
+        var t_dec0 = std.Io.Clock.awake.now(io);
+        var timed_steps: usize = 0;
+        for (0..decode_steps) |step| {
+            if (step == 2) t_dec0 = std.Io.Clock.awake.now(io);
+            if (step >= 2 and step + 1 < decode_steps) timed_steps += 1;
+            gen[step] = next_tok;
+            if (step + 1 == decode_steps) break;
+            const pos_i32: i32 = @intCast(cur_pos);
+            try sc.buf.upload(sc.ids - sc.buf.ptr, std.mem.asBytes(&next_tok));
+            try sc.buf.upload(sc.positions - sc.buf.ptr, std.mem.asBytes(&pos_i32));
+            if (use_graph and cur_pos + 1 <= 2176) {
+                if (graph_exec) |ge| {
+                    try ge.launchOn(stream);
+                } else if (step == 0) {
+                    try runner.forward(stream, &kvc, &sc, 1, cur_pos, true);
+                } else {
+                    try cuda.graph.beginCapture(stream, .thread_local);
+                    try runner.forward(stream, &kvc, &sc, 1, cur_pos, true);
+                    var g = try cuda.graph.endCapture(stream);
+                    defer g.deinit();
+                    graph_exec = try g.instantiate();
+                    try graph_exec.?.launchOn(stream);
+                }
+            } else {
+                try runner.forward(stream, &kvc, &sc, 1, cur_pos, true);
+            }
+            try stream.synchronize();
+            if (group_opt) |*g| try g.check();
+            try pickRows(&driver, stream, if (group_opt) |*g| g else null, &sc, 0, 1, &first_arr);
+            next_tok = first_arr[0];
+            cur_pos += 1;
+        }
+        const t_dec1 = std.Io.Clock.awake.now(io);
+        const dec_ms = @as(f64, @floatFromInt(t_dec0.durationTo(t_dec1).nanoseconds)) / 1e6;
+        if (rank == 0) {
+            const steps_run = if (timed_steps > 0) timed_steps else 1;
+            const ms_per_tok = dec_ms / @as(f64, @floatFromInt(steps_run));
+            const tok_s = 1000.0 / ms_per_tok;
+            std.debug.print("[ernie55] PLAIN layers={d} tp={d} weights={d:.2} GiB | prefill({d} tok)={d:.2} ms | decode({d} tok)={d:.2} ms ({d:.2} ms/tok, {d:.2} tok/s)\n", .{
+                w.loaded_layers, tp, @as(f64, @floatFromInt(w.bytes)) / (1024.0 * 1024.0 * 1024.0), n_prompt, pf_ms, steps_run, dec_ms, ms_per_tok, tok_s,
+            });
+            std.debug.print("[ernie55] generated ids:", .{});
+            for (gen) |t| std.debug.print(" {d}", .{t});
+            std.debug.print("\n", .{});
+        }
+    } else {
+        // Bundled 3-layer DSpark speculative decoding with CUDA Graph on the (K+1)-row target verify step!
+        const R = dspark_k + 1;
+        var verify_graph: ?cuda.graph.Exec = null;
+        defer if (verify_graph) |*ge| ge.deinit();
+
+        var produced: usize = 0;
+        var rounds: usize = 0;
+        var timed_rounds: usize = 0;
+        var timed_tokens: usize = 0;
+        var draft_ns_sum: i128 = 0;
+        var verify_ns_sum: i128 = 0;
+        var absorb_ns_sum: i128 = 0;
+        var t_dec0 = std.Io.Clock.awake.now(io);
+
+        var drafts: [8]i32 = undefined;
+        var verify_ids: [8]i32 = undefined;
+        var verify_pos: [8]i32 = undefined;
+        var targ_out: [8]i32 = undefined;
+
+        while (produced < decode_steps) {
+            if (rounds == 2) t_dec0 = std.Io.Clock.awake.now(io);
+
+            // 1. DSpark draft K tokens from anchor = next_tok at position cur_pos
+            const td0 = std.Io.Clock.awake.now(io);
+            try drafter.?.draft(&runner, stream, &dspark_caches.?, &sc, next_tok, cur_pos, drafts[0..dspark_k]);
+            const td1 = std.Io.Clock.awake.now(io);
+
+            // 2. Target verify R = K + 1 tokens: [next_tok, drafts[0..K]] at [cur_pos .. cur_pos + K]
+            verify_ids[0] = next_tok;
+            verify_pos[0] = @intCast(cur_pos);
+            for (0..dspark_k) |j| {
+                verify_ids[j + 1] = drafts[j];
+                verify_pos[j + 1] = @intCast(cur_pos + j + 1);
+            }
+            const tv0 = std.Io.Clock.awake.now(io);
+            try sc.buf.upload(sc.ids - sc.buf.ptr, std.mem.sliceAsBytes(verify_ids[0..R]));
+            try sc.buf.upload(sc.positions - sc.buf.ptr, std.mem.sliceAsBytes(verify_pos[0..R]));
+            if (use_graph and cur_pos + R <= 2176) {
+                if (verify_graph) |ge| {
+                    try ge.launchOn(stream);
+                } else if (rounds == 0) {
+                    try runner.forwardWithTaps(stream, &kvc, &sc, R, cur_pos + dspark_k, true, sc.dspark_taps);
+                } else {
+                    try cuda.graph.beginCapture(stream, .thread_local);
+                    try runner.forwardWithTaps(stream, &kvc, &sc, R, cur_pos + dspark_k, true, sc.dspark_taps);
+                    var g = try cuda.graph.endCapture(stream);
+                    defer g.deinit();
+                    verify_graph = try g.instantiate();
+                    try verify_graph.?.launchOn(stream);
+                }
+            } else {
+                try runner.forwardWithTaps(stream, &kvc, &sc, R, cur_pos + dspark_k, true, sc.dspark_taps);
+            }
+            try stream.synchronize();
+            if (group_opt) |*g| try g.check();
+            try pickRows(&driver, stream, if (group_opt) |*g| g else null, &sc, 0, R, targ_out[0..R]);
+            const tv1 = std.Io.Clock.awake.now(io);
+
+            // 3. Commit accepted tokens (row 0 = next_tok always committed, plus matching drafts)
+            var accepted: usize = 1;
+            if (produced < decode_steps) {
+                gen[produced] = next_tok;
+                produced += 1;
+            }
+            for (0..dspark_k) |j| {
+                if (targ_out[j] == drafts[j]) {
+                    if (produced < decode_steps) {
+                        gen[produced] = drafts[j];
+                        produced += 1;
+                    }
+                    accepted += 1;
+                } else {
+                    break;
+                }
+            }
+            const new_next = targ_out[accepted - 1];
+
+            // 4. Absorb ONLY the `accepted` committed rows into DSpark context KV
+            const ta0 = std.Io.Clock.awake.now(io);
+            try drafter.?.absorb(&runner, stream, &dspark_caches.?, &sc, sc.dspark_taps, accepted, cur_pos);
+            try stream.synchronize();
+            const ta1 = std.Io.Clock.awake.now(io);
+
+            if (rounds >= 2) {
+                timed_rounds += 1;
+                timed_tokens += accepted;
+                draft_ns_sum += td0.durationTo(td1).nanoseconds;
+                verify_ns_sum += tv0.durationTo(tv1).nanoseconds;
+                absorb_ns_sum += ta0.durationTo(ta1).nanoseconds;
+            }
+            cur_pos += accepted;
+            next_tok = new_next;
+            rounds += 1;
+        }
+        const t_dec1 = std.Io.Clock.awake.now(io);
+        const dec_ms = @as(f64, @floatFromInt(t_dec0.durationTo(t_dec1).nanoseconds)) / 1e6;
+        if (rank == 0) {
+            const tr: f64 = @floatFromInt(@max(timed_rounds, 1));
+            const tt: f64 = @floatFromInt(@max(timed_tokens, 1));
+            const tok_s = tt * 1000.0 / dec_ms;
+            const mean_acc = tt / tr;
+            const d_ms = @as(f64, @floatFromInt(draft_ns_sum)) / (tr * 1e6);
+            const v_ms = @as(f64, @floatFromInt(verify_ns_sum)) / (tr * 1e6);
+            const a_ms = @as(f64, @floatFromInt(absorb_ns_sum)) / (tr * 1e6);
+            std.debug.print("[ernie55] DSPARK(k={d}) layers={d} tp={d} weights={d:.2} GiB | prefill({d} tok)={d:.2} ms | {d} tok / {d} rnds (acc={d:.2} tok/rnd) in {d:.2} ms ({d:.2} tok/s) | draft={d:.2}ms verify={d:.2}ms absorb={d:.2}ms\n", .{
+                dspark_k, w.loaded_layers, tp, @as(f64, @floatFromInt(w.bytes)) / (1024.0 * 1024.0 * 1024.0), n_prompt, pf_ms, timed_tokens, timed_rounds, mean_acc, dec_ms, tok_s, d_ms, v_ms, a_ms,
+            });
+            std.debug.print("[ernie55] generated ids:", .{});
+            for (gen) |t| std.debug.print(" {d}", .{t});
+            std.debug.print("\n", .{});
+        }
+    }
+    return 0;
+}
diff --git a/zig/src/families/ernie55/cuda_engine.zig b/zig/src/families/ernie55/cuda_engine.zig
new file mode 100644
index 0000000..1fcc466
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_engine.zig
@@ -0,0 +1,471 @@
+//! Multi-slot ERNIE 5.5 Flash Preview CUDA engine for tensorfold-native (TP=1/2/4, RoCE, chunked prefill, CUDA graphs, bundled 3-layer DSpark).
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+const shard = @import("cuda_shard.zig");
+const weights = @import("cuda_weights.zig");
+const kv_mod = @import("cuda_kv.zig");
+const kernels = @import("cuda_kernels.zig");
+const fw = @import("cuda_forward.zig");
+const dspark = @import("cuda_dspark.zig");
+const sampler = @import("cuda_sampler.zig");
+
+pub const prompt_rows: usize = 256;
+pub const window_rows: usize = 16;
+pub const max_slots: usize = 16;
+
+pub const Seq = struct {
+    kv: kv_mod.KvCache,
+    draft: ?dspark.Caches = null,
+    stash: ?cuda.DeviceBuffer = null, // BF16 [window_rows, 12288] target aux taps from last verify
+    first_logits: ?cuda.DeviceBuffer = null, // F32 [vocab_width] last prompt row logits for firstMasked
+    sampling: ?sampler.Sampling = null,
+    verify_graphs: [8]?cuda.graph.Exec = @splat(null),
+    verify_warmed: [8]bool = @splat(false),
+
+    pub fn deinit(self: *Seq) void {
+        for (&self.verify_graphs) |*g| if (g.*) |*ge| {
+            ge.deinit();
+            g.* = null;
+        };
+        if (self.first_logits) |*fl| fl.free();
+        if (self.stash) |*st| st.free();
+        if (self.draft) |*dr| dr.deinit();
+        self.kv.deinit();
+    }
+};
+
+/// A kept prompt state: its id (the same on every rank) and the position it stands at.
+pub const Kept = struct { id: u64, at: u32 };
+/// Where a prompt pass resumes: a kept state's id and position.
+pub const Resume = struct { id: u64, at: usize };
+const Snap = struct { buf: cuda.DeviceBuffer, at: usize };
+/// Kept states stand on the prompt grid; the HCA rings keep this many positions below one.
+const snap_ring: usize = 256;
+
+pub const Options = struct {
+    capacity: usize,
+    load_dspark: bool = true,
+};
+
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    lane: cuda.qmmf.Lane,
+    k: kernels.Kernels,
+    w: weights.Weights,
+    group: ?*const cuda.tp_group.Group = null,
+    sc_pf: kv_mod.Scratch,
+    sc_dec: kv_mod.Scratch,
+    smp: sampler.Sampler,
+    drafter: ?dspark.Drafter = null,
+    seqs: std.ArrayList(?*Seq) = .empty,
+    cur: ?*Seq = null,
+    slot: u32 = 0,
+    capacity: usize,
+    snaps: std.AutoHashMapUnmanaged(u64, Snap) = .empty,
+    next_snap: u64 = 1,
+    dropped: std.ArrayList(u32) = .empty, // ids rank 0 freed, sent to the other ranks with the next step
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, rank: usize, world: usize, o: Options) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+
+        var stream = try cuda.Stream.init(d, false);
+        errdefer stream.deinit();
+
+        var lane = try cuda.qmmf.Lane.load(d, 12);
+        errdefer lane.unload();
+        lane.pdl = true;
+
+        var k = try kernels.Kernels.load(d);
+        errdefer k.unload();
+
+        var w = try weights.load(gpa, io, d, dir, rank, world, .{ .load_dspark = o.load_dspark });
+        errdefer w.deinit();
+
+        var sc_pf = try kv_mod.Scratch.alloc(d, &w.config, &w.share, prompt_rows, o.capacity);
+        errdefer sc_pf.deinit();
+
+        var sc_dec = try kv_mod.Scratch.alloc(d, &w.config, &w.share, window_rows, o.capacity);
+        errdefer sc_dec.deinit();
+
+        var smp = try sampler.Sampler.init(d, w.config.vocab, w.share.vocab_width, window_rows);
+        errdefer smp.deinit();
+
+        e.* = .{
+            .gpa = gpa,
+            .io = io,
+            .d = d,
+            .stream = stream,
+            .lane = lane,
+            .k = k,
+            .w = w,
+            .sc_pf = sc_pf,
+            .sc_dec = sc_dec,
+            .smp = smp,
+            .drafter = null,
+            .capacity = o.capacity,
+        };
+        if (e.w.dspark) |*dw| {
+            e.drafter = try dspark.Drafter.init(d, dw, e.w.share.vocab_width);
+        }
+        return e;
+    }
+
+    pub fn deinit(e: *Engine) void {
+        for (e.seqs.items) |slot_opt| if (slot_opt) |sq| {
+            sq.deinit();
+            e.gpa.destroy(sq);
+        };
+        e.seqs.deinit(e.gpa);
+        var it = e.snaps.valueIterator();
+        while (it.next()) |x| x.buf.free();
+        e.snaps.deinit(e.gpa);
+        e.dropped.deinit(e.gpa);
+        if (e.drafter) |*dr| dr.deinit();
+        e.smp.deinit();
+        e.sc_dec.deinit();
+        e.sc_pf.deinit();
+        e.w.deinit();
+        e.k.unload();
+        e.lane.unload();
+        e.stream.deinit();
+        e.gpa.destroy(e);
+    }
+
+    pub fn runner(e: *const Engine) fw.Runner {
+        return .{ .k = &e.k, .lane = &e.lane, .w = &e.w, .group = e.group };
+    }
+
+    pub fn streamBytes(e: *const Engine) usize {
+        const cap = e.capacity;
+        const c = &e.w.config;
+        const comp_cap = (cap + c.compress_ratio - 1) / c.compress_ratio + 2;
+        var total: usize = 0;
+        for (0..e.w.loaded_layers) |li| {
+            if (c.isDsa(@intCast(li))) {
+                total += cap * (576 + 128) * 2;
+            } else {
+                total += kv_mod.swa_cap * (512 * 2 + 2 * 512 * 4) + comp_cap * 512 * 2;
+            }
+        }
+        if (e.drafter != null) {
+            total += dspark.num_layers * dspark.ring_cap * 512 * 2;
+            total += window_rows * 3 * c.hidden * 2;
+        }
+        total += e.w.share.vocab_width * 4;
+        return total;
+    }
+
+    pub fn bind(e: *Engine, slot: u32) !void {
+        while (e.seqs.items.len <= slot) try e.seqs.append(e.gpa, null);
+        if (e.seqs.items[slot] == null) {
+            const sq = try e.gpa.create(Seq);
+            errdefer e.gpa.destroy(sq);
+            var kvc = try kv_mod.KvCache.alloc(e.gpa, e.d, &e.w.config, e.w.loaded_layers, e.capacity);
+            errdefer kvc.deinit();
+            var dc: ?dspark.Caches = null;
+            var stash: ?cuda.DeviceBuffer = null;
+            if (e.drafter != null) {
+                dc = try dspark.Caches.init(e.d);
+                errdefer if (dc) |*x| x.deinit();
+                stash = try cuda.DeviceBuffer.alloc(e.d, window_rows * 3 * e.w.config.hidden * 2);
+            }
+            errdefer if (stash) |*x| x.free();
+            const fl = try cuda.DeviceBuffer.alloc(e.d, e.w.share.vocab_width * 4);
+            sq.* = .{ .kv = kvc, .draft = dc, .stash = stash, .first_logits = fl };
+            e.seqs.items[slot] = sq;
+        }
+        e.cur = e.seqs.items[slot];
+        e.slot = slot;
+    }
+
+    pub fn release(e: *Engine, slot: u32) void {
+        if (slot < e.seqs.items.len) {
+            if (e.seqs.items[slot]) |sq| {
+                sq.deinit();
+                e.gpa.destroy(sq);
+                e.seqs.items[slot] = null;
+            }
+            if (e.slot == slot) e.cur = null;
+        }
+    }
+
+    pub fn pos(e: *const Engine) usize {
+        return if (e.cur) |sq| sq.kv.pos else 0;
+    }
+
+    pub fn begin(e: *Engine, sampling: ?sampler.Sampling) !void {
+        const sq = e.cur orelse return error.NoSequence;
+        sq.kv.reset();
+        sq.sampling = sampler.check(sampling);
+    }
+
+    /// Run one prompt chunk (`ids.len <= prompt_rows`) starting at `pos0` of a `total`-token prompt.
+    /// If `is_last`, saves last row's logits for `firstMasked` and returns the drawn first token.
+    pub fn chunk(e: *Engine, ids: []const u32, pos0: usize, total: usize, is_last: bool, resume_id: u64) !u32 {
+        const sq = e.cur orelse return error.NoSequence;
+        const n = ids.len;
+        if (n == 0 or n > prompt_rows or pos0 + n > e.capacity) return error.BadChunk;
+        if (resume_id != 0) {
+            const at = try e.restoreState(resume_id);
+            if (at != pos0) return error.SnapshotOutOfStep;
+        }
+        if (sq.kv.pos != pos0) return error.ChunkOutOfStep;
+
+        var ids_i32: [prompt_rows]i32 = undefined;
+        var pos_i32: [prompt_rows]i32 = undefined;
+        for (0..n) |i| {
+            ids_i32[i] = @intCast(ids[i]);
+            pos_i32[i] = @intCast(pos0 + i);
+        }
+        try e.sc_pf.buf.upload(e.sc_pf.ids - e.sc_pf.buf.ptr, std.mem.sliceAsBytes(ids_i32[0..n]));
+        try e.sc_pf.buf.upload(e.sc_pf.positions - e.sc_pf.buf.ptr, std.mem.sliceAsBytes(pos_i32[0..n]));
+
+        // Every chunk's trailing rows go into the draft ring, so a state kept at any chunk start carries it.
+        _ = total;
+        const need_taps = e.drafter != null;
+        const taps_ptr: u64 = if (need_taps) e.sc_pf.dspark_taps else 0;
+
+        const r = e.runner();
+        try r.forwardWithTaps(e.stream, &sq.kv, &e.sc_pf, n, pos0 + n - 1, is_last, taps_ptr);
+
+        if (need_taps) try e.drafter.?.absorb(&r, e.stream, &sq.draft.?, &e.sc_pf, e.sc_pf.dspark_taps, n, pos0);
+
+        if (is_last) {
+            // Save last row F32 logits for optional firstMasked redraw
+            const last_logits = e.sc_pf.logits + (n - 1) * e.w.share.vocab_width * 4;
+            try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(sq.first_logits.?.ptr, last_logits, e.w.share.vocab_width * 4, e.stream.handle), "cuMemcpyDtoDAsync");
+        }
+
+        sq.kv.pos = pos0 + n;
+        if (!is_last) {
+            try e.stream.synchronize();
+            if (e.group) |g| try g.check();
+            return 0;
+        }
+
+        if (sq.sampling) |smp_cfg| {
+            const last_logits = e.sc_pf.logits + (n - 1) * e.w.share.vocab_width * 4;
+            try e.smp.gatherF32(&e.k, e.stream, e.group, &e.w.share, last_logits, 1);
+            var out: [1]u32 = undefined;
+            try e.smp.drawFull(e.stream, 1, pos0 + n, sampler.rule(smp_cfg), &out);
+            if (e.group) |g| try g.check();
+            return out[0];
+        } else {
+            try e.stream.synchronize();
+            if (e.group) |g| try g.check();
+            var out: [1]u32 = undefined;
+            try e.pickGreedy(&e.sc_pf, n - 1, 1, &out);
+            return out[0];
+        }
+    }
+
+    /// Redraw the prompt's first token under a grammar mask (`bits` device ptr to bitmask words).
+    pub fn firstMasked(e: *Engine, bits: u64) !u32 {
+        const sq = e.cur orelse return error.NoSequence;
+        const words = (e.w.config.vocab + 31) / 32;
+        try e.smp.gatherF32(&e.k, e.stream, e.group, &e.w.share, sq.first_logits.?.ptr, 1);
+        if (bits != 0) try e.smp.mask(e.stream, 1, bits, words);
+        const r = if (sq.sampling) |scfg| sampler.rule(scfg) else sampler.greedyRule();
+        var out: [1]u32 = undefined;
+        try e.smp.drawFull(e.stream, 1, sq.kv.pos, r, &out);
+        if (e.group) |g| try g.check();
+        return out[0];
+    }
+
+    /// Verify `ids` (`1 <= ids.len <= window_rows`) at `sq.kv.pos .. sq.kv.pos + rows - 1`.
+    /// Does NOT advance `sq.kv.pos`; caller calls `keep(kept_n)` afterwards!
+    pub fn verify(e: *Engine, ids: []const u32, out: []u32, bits: u64) !void {
+        const sq = e.cur orelse return error.NoSequence;
+        const rows = ids.len;
+        if (rows == 0 or rows > window_rows or sq.kv.pos + rows > e.capacity) return error.BadWindow;
+
+        var ids_i32: [window_rows]i32 = undefined;
+        var pos_i32: [window_rows]i32 = undefined;
+        for (0..rows) |i| {
+            ids_i32[i] = @intCast(ids[i]);
+            pos_i32[i] = @intCast(sq.kv.pos + i);
+        }
+        try e.sc_dec.buf.upload(e.sc_dec.ids - e.sc_dec.buf.ptr, std.mem.sliceAsBytes(ids_i32[0..rows]));
+        try e.sc_dec.buf.upload(e.sc_dec.positions - e.sc_dec.buf.ptr, std.mem.sliceAsBytes(pos_i32[0..rows]));
+
+        const taps_out: u64 = if (e.drafter != null) e.sc_dec.dspark_taps else 0;
+        const r = e.runner();
+        const use_graph = (e.group == null or e.group.?.fast != null) and rows <= 8 and (sq.kv.pos + rows <= 2176);
+
+        if (use_graph) {
+            const gi = rows - 1;
+            if (sq.verify_graphs[gi]) |ge| {
+                try ge.launchOn(e.stream);
+            } else if (!sq.verify_warmed[gi]) {
+                try r.forwardWithTaps(e.stream, &sq.kv, &e.sc_dec, rows, sq.kv.pos + rows - 1, true, taps_out);
+                sq.verify_warmed[gi] = true;
+            } else {
+                try cuda.graph.beginCapture(e.stream, .thread_local);
+                try r.forwardWithTaps(e.stream, &sq.kv, &e.sc_dec, rows, sq.kv.pos + rows - 1, true, taps_out);
+                var g = try cuda.graph.endCapture(e.stream);
+                defer g.deinit();
+                sq.verify_graphs[gi] = try g.instantiate();
+                try sq.verify_graphs[gi].?.launchOn(e.stream);
+            }
+        } else {
+            try r.forwardWithTaps(e.stream, &sq.kv, &e.sc_dec, rows, sq.kv.pos + rows - 1, true, taps_out);
+        }
+
+        if (sq.stash) |st| {
+            try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(st.ptr, e.sc_dec.dspark_taps, rows * 3 * e.w.config.hidden * 2, e.stream.handle), "cuMemcpyDtoDAsync");
+        }
+
+        if (sq.sampling != null or bits != 0) {
+            try e.smp.gatherF32(&e.k, e.stream, e.group, &e.w.share, e.sc_dec.logits, rows);
+            if (bits != 0) {
+                const words = (e.w.config.vocab + 31) / 32;
+                try e.smp.mask(e.stream, rows, bits, words);
+            }
+            const rl = if (sq.sampling) |scfg| sampler.rule(scfg) else sampler.greedyRule();
+            try e.smp.drawFull(e.stream, rows, sq.kv.pos + 1, rl, out);
+            if (e.group) |g| try g.check();
+        } else {
+            try e.stream.synchronize();
+            if (e.group) |g| try g.check();
+            try e.pickGreedy(&e.sc_dec, 0, rows, out);
+        }
+    }
+
+    pub fn keep(e: *Engine, n: usize) !void {
+        const sq = e.cur orelse return error.NoSequence;
+        sq.kv.pos += n;
+    }
+
+    /// Absorb the `kept_n` committed rows from `sq.stash` (if > 0) and draft `out.len` speculative tokens from `anchor`.
+    pub fn block(e: *Engine, kept_n: usize, anchor: u32, out: []u32) !void {
+        const sq = e.cur orelse return error.NoSequence;
+        const dr = &(e.drafter orelse return error.NoDraftHead);
+        const r = e.runner();
+        if (kept_n > 0) {
+            const p0 = sq.kv.pos -| kept_n;
+            try dr.absorb(&r, e.stream, &sq.draft.?, &e.sc_dec, sq.stash.?.ptr, kept_n, p0);
+        }
+        // The lane host asks for depth 0 when a stream has no draft budget left (e.g. its last token); the kept rows
+        // are still absorbed above so the drafter cache stays aligned, and every rank returns here alike.
+        if (out.len == 0) return;
+        var out_i32: [dspark.block_size]i32 = undefined;
+        try dr.draft(&r, e.stream, &sq.draft.?, &e.sc_dec, @intCast(anchor), sq.kv.pos, out_i32[0..out.len]);
+        for (out, out_i32[0..out.len]) |*dst, v| dst.* = @intCast(v);
+    }
+
+    /// Bytes a state kept at `at` takes on this rank: DSA rows below it, the HCA rings' last positions and
+    /// compressed blocks, the draft ring.
+    pub fn stateBytes(e: *const Engine, at: usize) u64 {
+        var total: u64 = 0;
+        for (0..e.w.loaded_layers) |li| {
+            if (e.w.config.isDsa(@intCast(li))) {
+                total += at * (576 + 128) * 2;
+            } else {
+                total += @as(u64, @min(at, snap_ring)) * 512 * 2 + (at / e.w.config.compress_ratio) * 512 * 2;
+            }
+        }
+        if (e.drafter != null) total += dspark.num_layers * dspark.ring_cap * 512 * 2;
+        return @max(total, 256);
+    }
+
+    fn copy(e: *const Engine, dst: u64, src: u64, n: usize) !void {
+        if (n == 0) return;
+        try e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(dst, src, n, e.stream.handle), "cuMemcpyDtoDAsync");
+    }
+
+    /// The bound sequence's state at `at` and `buf` (out: to buf), part after part in stateBytes' order.
+    fn copyState(e: *Engine, sq: *Seq, buf: u64, at: usize, out: bool) !void {
+        var off: u64 = 0;
+        const c = &e.w.config;
+        for (sq.kv.layers[0..e.w.loaded_layers]) |ly| {
+            switch (ly) {
+                .dsa => |d| {
+                    for ([_]u64{ d.mla_kv, d.idx_k }, [_]usize{ at * 576 * 2, at * 128 * 2 }) |src, n| {
+                        try e.copy(if (out) buf + off else src, if (out) src else buf + off, n);
+                        off += n;
+                    }
+                },
+                .hca => |h| {
+                    const lo = at -| snap_ring; // at sits on the grid: these slots stand side by side in the ring
+                    const ring_at = h.swa_kv + (lo & kv_mod.swa_mask) * 512 * 2;
+                    const ring_n = (at - lo) * 512 * 2;
+                    try e.copy(if (out) buf + off else ring_at, if (out) ring_at else buf + off, ring_n);
+                    off += ring_n;
+                    const comp_n = (at / c.compress_ratio) * 512 * 2;
+                    try e.copy(if (out) buf + off else h.comp_kv, if (out) h.comp_kv else buf + off, comp_n);
+                    off += comp_n;
+                },
+            }
+        }
+        if (sq.draft) |*dc| {
+            const n = dspark.num_layers * dc.layer_bytes;
+            try e.copy(if (out) buf + off else dc.buf.ptr, if (out) dc.buf.ptr else buf + off, n);
+        }
+    }
+
+    /// The bound sequence's state at its position `at` (a chunk start) copied under `id` (every rank keeps one id).
+    pub fn keepAs(e: *Engine, id: u64, at: usize) !void {
+        const sq = e.cur orelse return error.NoSequence;
+        if (at == 0 or at != sq.kv.pos or at % prompt_rows != 0 or e.snaps.contains(id)) return error.BadKeep;
+        var buf = try cuda.DeviceBuffer.alloc(e.d, e.stateBytes(at));
+        errdefer buf.free();
+        try e.copyState(sq, buf.ptr, at, true);
+        try e.snaps.put(e.gpa, id, .{ .buf = buf, .at = at });
+    }
+
+    /// The bound sequence restored to state `id`: its caches below the state's position, its length there.
+    pub fn restoreState(e: *Engine, id: u64) !usize {
+        const sq = e.cur orelse return error.NoSequence;
+        const x = e.snaps.get(id) orelse return error.SnapshotStale;
+        try e.copyState(sq, x.buf.ptr, x.at, false);
+        sq.kv.pos = x.at;
+        return x.at;
+    }
+
+    pub fn holds(e: *const Engine, id: u64) bool {
+        return e.snaps.contains(id);
+    }
+
+    pub fn dropState(e: *Engine, id: u64) void {
+        const kv = e.snaps.fetchRemove(id) orelse return;
+        e.stream.synchronize() catch {};
+        var b = kv.value.buf;
+        b.free();
+    }
+
+    fn pickGreedy(e: *const Engine, sc: *const kv_mod.Scratch, row0: usize, n_rows: usize, out: []u32) !void {
+        const Pair16 = extern struct { val: f32, id: i32, pad0: u32 = 0, pad1: u32 = 0 };
+        var ids_loc: [window_rows]i32 = undefined;
+        var vals_loc: [window_rows]f32 = undefined;
+        try cuda.memory.download(e.d, sc.argmax_id + row0 * 4, std.mem.sliceAsBytes(ids_loc[0..n_rows]));
+        try cuda.memory.download(e.d, sc.argmax_val + row0 * 4, std.mem.sliceAsBytes(vals_loc[0..n_rows]));
+        if (e.group) |g| {
+            if (g.world > 1) {
+                var loc: [window_rows]Pair16 = undefined;
+                for (0..n_rows) |r| loc[r] = .{ .val = vals_loc[r], .id = ids_loc[r] };
+                const bytes = n_rows * @sizeOf(Pair16);
+                try sc.buf.upload(sc.moe_pack - sc.buf.ptr, std.mem.sliceAsBytes(loc[0..n_rows]));
+                try g.allGather(e.stream, sc.moe_pack, sc.tp_gather, bytes);
+                try e.stream.synchronize();
+                try g.check();
+                var all: [8 * window_rows]Pair16 = undefined;
+                try cuda.memory.download(e.d, sc.tp_gather, std.mem.sliceAsBytes(all[0 .. g.world * n_rows]));
+                for (0..n_rows) |r| {
+                    var best = all[r];
+                    for (1..g.world) |wk| {
+                        const p = all[wk * n_rows + r];
+                        if (p.val > best.val or (p.val == best.val and p.id < best.id)) best = p;
+                    }
+                    out[r] = @intCast(best.id);
+                }
+                return;
+            }
+        }
+        for (0..n_rows) |r| out[r] = @intCast(ids_loc[r]);
+    }
+};
diff --git a/zig/src/families/ernie55/cuda_follow.zig b/zig/src/families/ernie55/cuda_follow.zig
new file mode 100644
index 0000000..a80bdf7
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_follow.zig
@@ -0,0 +1,307 @@
+//! TP over processes for ERNIE 5.5: rank 0 broadcasts each step (header + ids) over NCCL; ranks 1..world-1 follow in lockstep.
+const std = @import("std");
+const cuda = @import("cuda");
+const engine = @import("cuda_engine.zig");
+const sampler = @import("cuda_sampler.zig");
+const Engine = engine.Engine;
+
+pub const Kind = enum(u32) {
+    begin = 1,
+    chunk,
+    verify,
+    keep,
+    block,
+    first_masked,
+    release,
+    idle,
+    end,
+    save, // a: the kept state's id, seed: its position
+    drop, // ids: kept states rank 0 let go
+};
+
+pub const Header = extern struct {
+    kind: u32,
+    n: u32 = 0,
+    depth: u32 = 0,
+    flags: u32 = 0,
+    a: u64 = 0,
+    seed: u64 = 0,
+    temperature: f64 = 0,
+    top_p: f64 = 0,
+    min_p: f64 = 0,
+    top_k: u32 = 0,
+    slot: u32 = 0,
+
+    comptime {
+        std.debug.assert(@sizeOf(Header) == 64);
+    }
+};
+
+pub const Words = extern struct { w: [96]u32 };
+pub const put_ids = 96 - 16;
+
+pub const Link = struct {
+    d: *const cuda.Driver,
+    lib: *const cuda.nccl.Library,
+    comm: cuda.nccl.Comm,
+    stream: cuda.Stream,
+    buf: cuda.DeviceBuffer,
+    ids: []u32,
+    gpa: std.mem.Allocator,
+    asleep: bool = false,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, lib: *const cuda.nccl.Library, comm: cuda.nccl.Comm, stream: cuda.Stream, max_ids: usize) !Link {
+        const buf = try cuda.DeviceBuffer.alloc(d, 64 + max_ids * 4);
+        errdefer {
+            var owned = buf;
+            owned.free();
+        }
+        return .{
+            .d = d,
+            .lib = lib,
+            .comm = comm,
+            .stream = stream,
+            .buf = buf,
+            .ids = try gpa.alloc(u32, max_ids),
+            .gpa = gpa,
+        };
+    }
+
+    pub fn deinit(l: *Link) void {
+        l.gpa.free(l.ids);
+        l.buf.free();
+    }
+
+    fn post(l: *Link, bytes: usize) !void {
+        try l.lib.check(l.lib.api.ncclBroadcast(l.buf.ptr, l.buf.ptr, bytes, .u8, 0, l.comm, l.stream.handle), "ncclBroadcast");
+    }
+
+    pub fn send(l: *Link, put: cuda.Function, h: Header, ids: []const u32) !void {
+        if (ids.len > l.ids.len) return error.TooManyIds;
+        var hh = h;
+        hh.n = @intCast(ids.len);
+        if (ids.len <= put_ids) {
+            var w: Words = undefined;
+            @memcpy(w.w[0..16], std.mem.bytesAsSlice(u32, std.mem.asBytes(&hh)));
+            @memcpy(w.w[16..][0..ids.len], ids);
+            var a: cuda.Args = .{};
+            a.add(l.buf.ptr);
+            a.add(@as(u32, @intCast(16 + ids.len)));
+            a.add(w);
+            try cuda.launch.launch(put, .{ .grid = .{ .x = 1 }, .block = .{ .x = 128 } }, l.stream, &a);
+        } else {
+            try l.buf.uploadAsync(0, std.mem.asBytes(&hh), l.stream.handle);
+            try l.buf.uploadAsync(64, std.mem.sliceAsBytes(ids), l.stream.handle);
+        }
+        try l.post(64);
+        if (ids.len > 0) try l.post(64 + ids.len * 4);
+        if (ids.len > put_ids) try l.stream.synchronize();
+    }
+
+    pub fn receive(l: *Link) !struct { h: Header, ids: []const u32 } {
+        try l.post(64);
+        try l.stream.synchronize();
+        var h: Header = undefined;
+        try l.buf.download(0, std.mem.asBytes(&h));
+        if (h.n > l.ids.len) return error.TooManyIds;
+        if (h.n > 0) {
+            try l.post(64 + h.n * 4);
+            try l.stream.synchronize();
+            try l.buf.download(64, std.mem.sliceAsBytes(l.ids[0..h.n]));
+        }
+        return .{ .h = h, .ids = l.ids[0..h.n] };
+    }
+};
+
+pub const Leader = struct {
+    e: *Engine,
+    link: ?*Link,
+
+    fn send(x: Leader, h: Header, ids: []const u32) !void {
+        const l = x.link orelse return;
+        var hh = h;
+        hh.slot = x.e.slot;
+        if (l.asleep) {
+            cuda.tp_watch.wake();
+            l.asleep = false;
+        }
+        if (x.e.dropped.items.len > 0) { // the states rank 0's store let go since the last step, freed first
+            const n = @min(x.e.dropped.items.len, l.ids.len);
+            try l.send(x.e.k.put_words, .{ .kind = @intFromEnum(Kind.drop), .slot = x.e.slot }, x.e.dropped.items[0..n]);
+            x.e.dropped.replaceRangeAssumeCapacity(0, n, &.{});
+        }
+        try l.send(x.e.k.put_words, hh, ids);
+    }
+
+    /// The bound sequence's state at `at` kept on every rank under one new id.
+    pub fn save(x: Leader, at: usize) !engine.Kept {
+        const id = x.e.next_snap;
+        x.e.next_snap += 1; // an id is used once, even when this rank's copy then fails
+        if (at == 0 or at != x.e.pos()) return error.BadKeep;
+        try x.send(.{ .kind = @intFromEnum(Kind.save), .a = id, .seed = at }, &.{});
+        x.e.keepAs(id, at) catch |err| {
+            x.drop(id); // the other ranks free their copy at the next step
+            return err;
+        };
+        return .{ .id = id, .at = @intCast(at) };
+    }
+
+    /// A state rank 0's store let go: freed here now, on the other ranks at the next step.
+    pub fn drop(x: Leader, id: u64) void {
+        x.e.dropState(id);
+        if (x.link != null) x.e.dropped.append(x.e.gpa, @intCast(id)) catch {};
+    }
+
+    pub fn bind(x: Leader, slot: u32) !void {
+        try x.e.bind(slot);
+    }
+
+    pub fn begin(x: Leader, sampling: ?sampler.Sampling) !void {
+        const s = sampler.check(sampling);
+        var h: Header = .{ .kind = @intFromEnum(Kind.begin) };
+        if (s) |v| {
+            h.flags = 1;
+            h.seed = v.seed;
+            h.temperature = v.temperature;
+            h.top_p = v.top_p;
+            h.min_p = v.min_p;
+            h.top_k = v.top_k;
+        }
+        try x.send(h, &.{});
+        try x.e.begin(s);
+    }
+
+    pub fn chunk(x: Leader, ids: []const u32, pos0: usize, total: usize, is_last: bool, resume_id: u64) !u32 {
+        try x.send(.{
+            .kind = @intFromEnum(Kind.chunk),
+            .depth = @intCast(pos0),
+            .flags = if (is_last) 1 else 0,
+            .a = total,
+            .seed = resume_id,
+        }, ids);
+        return x.e.chunk(ids, pos0, total, is_last, resume_id);
+    }
+
+    pub fn firstMasked(x: Leader, bits: u64, masks: []const u32) !u32 {
+        try x.send(.{
+            .kind = @intFromEnum(Kind.first_masked),
+            .depth = if (masks.len > 0) 1 else 0,
+        }, masks);
+        return x.e.firstMasked(bits);
+    }
+
+    pub fn verify(x: Leader, ids: []const u32, out: []u32, bits: u64, masks: []const u32) !void {
+        if (masks.len == 0) {
+            try x.send(.{ .kind = @intFromEnum(Kind.verify), .depth = 0 }, ids);
+            return x.e.verify(ids, out, 0);
+        }
+        const total = ids.len + masks.len;
+        const buf = try x.e.gpa.alloc(u32, total);
+        defer x.e.gpa.free(buf);
+        @memcpy(buf[0..ids.len], ids);
+        @memcpy(buf[ids.len..], masks);
+        try x.send(.{ .kind = @intFromEnum(Kind.verify), .depth = @intCast(ids.len) }, buf);
+        return x.e.verify(ids, out, bits);
+    }
+
+    pub fn keep(x: Leader, n: usize) !void {
+        try x.send(.{ .kind = @intFromEnum(Kind.keep), .a = n }, &.{});
+        try x.e.keep(n);
+    }
+
+    pub fn block(x: Leader, kept_n: usize, anchor: u32, out: []u32) !void {
+        try x.send(.{
+            .kind = @intFromEnum(Kind.block),
+            .depth = @intCast(out.len),
+            .flags = anchor,
+            .a = kept_n,
+        }, &.{});
+        try x.e.block(kept_n, anchor, out);
+    }
+
+    pub fn release(x: Leader, slot: u32) !void {
+        try x.e.bind(slot);
+        try x.send(.{ .kind = @intFromEnum(Kind.release) }, &.{});
+        x.e.release(slot);
+    }
+
+    pub fn idle(x: Leader) !void {
+        const l = x.link orelse return;
+        if (l.asleep) return;
+        try x.send(.{ .kind = @intFromEnum(Kind.idle) }, &.{});
+        try l.stream.synchronize();
+        l.asleep = true;
+    }
+
+    pub fn end(x: Leader) !void {
+        try x.send(.{ .kind = @intFromEnum(Kind.end) }, &.{});
+    }
+};
+
+pub fn follow(e: *Engine, link: *Link) !void {
+    const words_per_row = (e.w.config.vocab + 31) / 32;
+    var mask_dev: ?cuda.DeviceBuffer = null;
+    defer if (mask_dev) |*b| b.free();
+    var out_buf: [engine.window_rows]u32 = undefined;
+
+    while (true) {
+        const msg = try link.receive();
+        const h = msg.h;
+        const kind: Kind = @enumFromInt(h.kind);
+        switch (kind) {
+            .end => return,
+            .idle => cuda.tp_watch.sleep(e.io),
+            .release => e.release(h.slot),
+            .begin => {
+                try e.bind(h.slot);
+                const s: ?sampler.Sampling = if (h.flags != 0) .{
+                    .seed = h.seed,
+                    .temperature = h.temperature,
+                    .top_p = h.top_p,
+                    .min_p = h.min_p,
+                    .top_k = h.top_k,
+                } else null;
+                try e.begin(s);
+            },
+            .chunk => {
+                try e.bind(h.slot);
+                _ = try e.chunk(msg.ids, h.depth, @intCast(h.a), h.flags != 0, h.seed);
+            },
+            .first_masked => {
+                try e.bind(h.slot);
+                var bits: u64 = 0;
+                if (h.depth != 0 and msg.ids.len == words_per_row) {
+                    if (mask_dev == null) mask_dev = try cuda.DeviceBuffer.alloc(e.d, engine.window_rows * words_per_row * 4);
+                    try mask_dev.?.upload(0, std.mem.sliceAsBytes(msg.ids));
+                    bits = mask_dev.?.ptr;
+                }
+                _ = try e.firstMasked(bits);
+            },
+            .verify => {
+                try e.bind(h.slot);
+                if (h.depth == 0) {
+                    try e.verify(msg.ids, out_buf[0..msg.ids.len], 0);
+                } else {
+                    const n_ids: usize = h.depth;
+                    const masks = msg.ids[n_ids..];
+                    if (mask_dev == null) mask_dev = try cuda.DeviceBuffer.alloc(e.d, engine.window_rows * words_per_row * 4);
+                    try mask_dev.?.upload(0, std.mem.sliceAsBytes(masks));
+                    try e.verify(msg.ids[0..n_ids], out_buf[0..n_ids], mask_dev.?.ptr);
+                }
+            },
+            .keep => {
+                try e.bind(h.slot);
+                try e.keep(@intCast(h.a));
+            },
+            .block => {
+                try e.bind(h.slot);
+                try e.block(@intCast(h.a), h.flags, out_buf[0..h.depth]);
+            },
+            .save => {
+                try e.bind(h.slot);
+                try e.keepAs(h.a, @intCast(h.seed));
+            },
+            .drop => for (msg.ids) |id| e.dropState(id),
+        }
+    }
+}
diff --git a/zig/src/families/ernie55/cuda_forward.zig b/zig/src/families/ernie55/cuda_forward.zig
new file mode 100644
index 0000000..75d2ff5
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_forward.zig
@@ -0,0 +1,427 @@
+//! ERNIE 5.5 Flash Preview full CUDA forward pass (TP=1/2/4, HCA + C128 + MLA-DSA + Latent MXFP4 SITU MoE + mHC + MultiMax).
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+const shard = @import("cuda_shard.zig");
+const weights = @import("cuda_weights.zig");
+const kv_mod = @import("cuda_kv.zig");
+const kernels = @import("cuda_kernels.zig");
+
+const Stream = cuda.Stream;
+const Lane = cuda.qmmf.Lane;
+const Group = cuda.tp_group.Group;
+const Kernels = kernels.Kernels;
+const Weights = weights.Weights;
+const KvCache = kv_mod.KvCache;
+const Scratch = kv_mod.Scratch;
+
+pub const Runner = struct {
+    k: *const Kernels,
+    lane: *const Lane,
+    w: *const Weights,
+    group: ?*const Group = null,
+
+    pub fn allReduceBf16(self: *const Runner, s: Stream, buf: u64, gather_buf: u64, count: usize) !void {
+        const g = self.group orelse return;
+        if (g.world <= 1) return;
+        try g.allGather(s, buf, gather_buf, count * 2);
+        try self.k.rankSumBf16(s, gather_buf, buf, count, g.world);
+    }
+
+    pub fn allReduceF32(self: *const Runner, s: Stream, buf: u64, gather_buf: u64, count: usize) !void {
+        const g = self.group orelse return;
+        if (g.world <= 1) return;
+        try g.allGather(s, buf, gather_buf, count * 4);
+        try self.k.rankSumF32(s, gather_buf, buf, count, g.world);
+    }
+
+    pub fn fp8(self: *const Runner, s: Stream, x: u64, ldx: usize, rows: usize, w: cuda.qmmf.Weight, y: u64, part: u64) !void {
+        try self.lane.matmul(s, x, ldx, rows, w, y, part);
+    }
+
+    /// Run `rows` tokens (`ids_dev [rows] i32`, `pos_dev [rows] i32`) through all loaded layers.
+    /// `max_pos` is the maximum position in this batch (used to skip DSA indexer when max_pos + 1 <= 2176).
+    /// Writes final contracted+normed hidden states to `sc.layer_in [rows, 4096]`, and logits to `sc.logits [rows, vocab_width]`.
+    pub fn forward(
+        self: *const Runner,
+        s: Stream,
+        kv: *KvCache,
+        sc: *const Scratch,
+        rows: usize,
+        max_pos: usize,
+        compute_logits: bool,
+    ) !void {
+        return self.forwardWithTaps(s, kv, sc, rows, max_pos, compute_logits, 0);
+    }
+
+    pub fn forwardWithTaps(
+        self: *const Runner,
+        s: Stream,
+        kv: *KvCache,
+        sc: *const Scratch,
+        rows: usize,
+        max_pos: usize,
+        compute_logits: bool,
+        taps_out: u64,
+    ) !void {
+        const c = &self.w.config;
+        const sh = &self.w.share;
+        const k = self.k;
+
+        // 1. Embed lookup + broadcast to 4-stream mHC residual
+        try k.embedBroadcast(s, sc.ids, self.w.embed, sc.res_a, rows, c.hidden, c.hc_mult);
+
+        var res_cur = sc.res_a;
+        var res_nxt = sc.res_b;
+
+        // 2. Decoder layers
+        for (self.w.layers, 0..) |*ly, li| {
+            // --- 2a. Attention mHC pre (collapse + attn_norm) ---
+            try k.mhcPreFast(
+                s,
+                res_cur,
+                ly.hc_attn.fn_w,
+                sc.mhc_mix_raw,
+                sc.mhc_sqrsum,
+                ly.hc_attn.scale,
+                ly.hc_attn.base,
+                ly.attn_norm,
+                sc.post_mix,
+                sc.comb_mix,
+                sc.layer_in,
+                rows,
+                c.hidden,
+                c.eps,
+                c.hc_eps,
+                c.hc_post_alpha,
+                c.hc_sinkhorn_iters,
+                c.eps,
+            );
+
+            // --- 2b. Attention (HCA or MLA-DSA) -> sc.sub_out [rows, 4096] ---
+            switch (ly.attn) {
+                .hca => |*hca| try self.forwardHca(s, hca, &kv.layers[li].hca, sc, rows),
+                .dsa => |*dsa| try self.forwardDsa(s, dsa, &kv.layers[li].dsa, sc, rows, max_pos),
+            }
+
+            // --- 2c. Attention mHC post ---
+            try k.mhcPost(s, sc.sub_out, res_cur, sc.post_mix, sc.comb_mix, res_nxt, 0, rows, c.hidden);
+            std.mem.swap(u64, &res_cur, &res_nxt);
+
+            // --- 2d. FFN mHC pre (collapse + ffn_norm) ---
+            try k.mhcPreFast(
+                s,
+                res_cur,
+                ly.hc_ffn.fn_w,
+                sc.mhc_mix_raw,
+                sc.mhc_sqrsum,
+                ly.hc_ffn.scale,
+                ly.hc_ffn.base,
+                ly.ffn_norm,
+                sc.post_mix,
+                sc.comb_mix,
+                sc.layer_in,
+                rows,
+                c.hidden,
+                c.eps,
+                c.hc_eps,
+                c.hc_post_alpha,
+                c.hc_sinkhorn_iters,
+                c.eps,
+            );
+
+            // --- 2e. FFN (Dense SITU MLP or Latent MXFP4 SITU MoE + Shared) -> sc.sub_out ---
+            switch (ly.ffn) {
+                .dense => |*mlp| try self.forwardDenseMlp(s, mlp, sc, rows),
+                .moe => |*moe| try self.forwardMoe(s, moe, sc, rows),
+            }
+
+            // --- 2f. FFN mHC post (with optional DSpark aux_mean tap at layers 39, 40, 41) ---
+            const tap_ptr: u64 = if (taps_out != 0 and li >= 39 and li <= 41)
+                sc.dspark_taps_tmp + (li - 39) * rows * c.hidden * 2
+            else
+                0;
+            try k.mhcPost(s, sc.sub_out, res_cur, sc.post_mix, sc.comb_mix, res_nxt, tap_ptr, rows, c.hidden);
+            std.mem.swap(u64, &res_cur, &res_nxt);
+        }
+
+        if (taps_out != 0 and self.w.layers.len >= 42) {
+            const slot_bytes = rows * c.hidden * 2;
+            try k.concat3Bf16(
+                s,
+                sc.dspark_taps_tmp,
+                sc.dspark_taps_tmp + slot_bytes,
+                sc.dspark_taps_tmp + 2 * slot_bytes,
+                taps_out,
+                rows,
+                c.hidden,
+            );
+        }
+
+        // 3. Final mHC contract + final RMSNorm -> sc.layer_in [rows, 4096]
+        try k.mhcContractNorm(
+            s,
+            res_cur,
+            self.w.hc_head_fn,
+            self.w.hc_head_scale,
+            self.w.hc_head_base,
+            self.w.norm,
+            sc.layer_in,
+            rows,
+            c.hidden,
+            c.eps,
+            c.hc_eps,
+            c.eps,
+        );
+
+        // 4. Sharded LM head + MultiMax -> sc.logits [rows, vocab_width] F32
+        if (compute_logits) {
+            try self.lane.matmulF32(s, sc.layer_in, c.hidden, rows, self.w.lm_head, sc.logits, sc.qmmf_part);
+            try k.applyMultimax(s, sc.logits, self.w.multimax_ranges, self.w.multimax_ts, rows * sh.vocab_width);
+            try k.argmaxF32(s, sc.logits, sc.argmax_id, sc.argmax_val, rows, sh.vocab_width, sh.vocab_lo);
+        }
+    }
+
+    fn forwardHca(self: *const Runner, s: Stream, hca: *const weights.HcaWeights, lkv: *const kv_mod.HcaKv, sc: *const Scratch, rows: usize) !void {
+        const c = &self.w.config;
+        const sh = &self.w.share;
+        const k = self.k;
+
+        // 1. q_down + q_layernorm -> sc.q_down [rows, 1024]
+        try self.fp8(s, sc.layer_in, c.hidden, rows, hca.q_down, sc.q_down, sc.qmmf_part);
+        try k.rmsNorm(s, sc.q_down, hca.q_norm, sc.q_down, rows, c.q_lora, c.eps);
+
+        // 2. kv_proj + kv_layernorm + RoPE + SWA store
+        try self.fp8(s, sc.layer_in, c.hidden, rows, hca.kv_proj, sc.kv_a, sc.qmmf_part);
+        try k.rmsNorm(s, sc.kv_a, hca.kv_norm, sc.kv_norm, rows, c.head_dim, c.eps);
+        try k.hcaKvRopeStore(s, sc.kv_norm, sc.positions, self.w.hca_inv_freq, lkv.swa_kv, rows, kv_mod.swa_mask);
+
+        // 3. C128 Compressor (save state + boundary flush)
+        if (hca.comp_wkv) |cwkv| {
+            try self.fp8(s, sc.layer_in, c.hidden, rows, cwkv, sc.comp_wkv, sc.qmmf_part);
+            try self.fp8(s, sc.layer_in, c.hidden, rows, hca.comp_wgate.?, sc.comp_wgate, sc.qmmf_part);
+            try k.hcaCompSave(s, sc.comp_wkv, sc.comp_wgate, hca.comp_ape, sc.positions, lkv.comp_state, rows, kv_mod.swa_mask);
+            try k.hcaCompFlush(s, lkv.comp_state, hca.comp_norm, sc.positions, self.w.hca_inv_freq, lkv.comp_kv, rows, kv_mod.swa_mask, c.eps);
+        }
+
+        // 4. q_up + weightless per-head Q-RMSNorm + GPT-J RoPE
+        try self.fp8(s, sc.q_down, c.q_lora, rows, hca.q_up, sc.q_up, sc.qmmf_part);
+        try k.hcaQnormRope(s, sc.q_up, sc.positions, self.w.hca_inv_freq, rows, sh.heads, c.eps);
+
+        // 5. o_gate [rows, o_width]
+        try self.fp8(s, sc.q_down, c.q_lora, rows, hca.o_gate, sc.o_gate, sc.qmmf_part);
+
+        // 6. HCA Attention (SWA-128 + C128 compressed KV + attn_sink) -> sc.attn_o [rows, heads, 512]
+        const scale: f32 = @floatCast(1.0 / @sqrt(@as(f64, @floatFromInt(c.head_dim))));
+        const comp_ptr = if (hca.comp_wkv != null) lkv.comp_kv else 0;
+        try k.hcaAttn(s, sc.q_up, lkv.swa_kv, comp_ptr, hca.attn_sink, sc.positions, sc.attn_o, rows, sh.heads, kv_mod.swa_mask, c.sliding_window, scale);
+
+        // 7. VHA post-mix (U^T @ o -> TP AllReduce -> o += V @ z)
+        try k.vhaUProj(s, sc.attn_o, hca.vha_u, sc.vha_z, rows, sh.heads, c.head_dim);
+        try self.allReduceF32(s, sc.vha_z, sc.vha_z_all, rows * c.vha_rank * c.head_dim);
+        try k.vhaVAdd(s, sc.attn_o, hca.vha_v, sc.vha_z, rows, sh.heads, c.head_dim);
+
+        // 8. Inverse GPT-J RoPE on dims [448..512) of sc.attn_o [rows, heads, 512]
+        try k.ropeGptj(s, sc.attn_o, sc.positions, self.w.hca_inv_freq, rows, sh.heads, c.head_dim, c.qk_nope, -1);
+
+        // 9. Grouped wo_a (sh.groups local groups, each [1024, 4096]) -> sc.wo_a_out [rows, o_width]
+        const group_k: usize = (c.heads / c.o_groups) * c.head_dim; // 4096
+        const ldx: usize = sh.groups * group_k;
+        if (rows == 1 or sh.groups == 1) {
+            for (0..sh.groups) |g| {
+                const x_ptr = sc.attn_o + g * group_k * 2;
+                const y_ptr = sc.wo_a_out + g * c.o_lora * 2;
+                try self.fp8(s, x_ptr, ldx, rows, hca.wo_a[g], y_ptr, sc.qmmf_part);
+            }
+        } else {
+            // Multi-row prefill: write contiguous [groups, rows, o_lora] into sc.q_up (temp) then interleave to [rows, groups, o_lora]
+            for (0..sh.groups) |g| {
+                const x_ptr = sc.attn_o + g * group_k * 2;
+                const y_ptr = sc.q_up + g * rows * c.o_lora * 2;
+                try self.fp8(s, x_ptr, ldx, rows, hca.wo_a[g], y_ptr, sc.qmmf_part);
+            }
+            try k.interleaveGroups(s, sc.q_up, sc.wo_a_out, sh.groups, rows, c.o_lora);
+        }
+
+        // 10. Gate * wo_a_out -> wo_b -> TP AllReduce -> sc.sub_out [rows, 4096]
+        try k.sigmoidMulBf16(s, sc.wo_a_out, sc.o_gate, sc.wo_a_out, rows * sh.o_width);
+        try self.fp8(s, sc.wo_a_out, sh.o_width, rows, hca.wo_b, sc.sub_out, sc.qmmf_part);
+        try self.allReduceBf16(s, sc.sub_out, sc.tp_gather, rows * c.hidden);
+    }
+
+    /// Non-causal SWA-128 HCA attention for DSpark draft layers (plain RoPE at mla_inv_freq, no compressor).
+    pub fn forwardHcaDspark(
+        self: *const Runner,
+        s: Stream,
+        hca: *const weights.HcaWeights,
+        kv_ring: u64,
+        sc: *const Scratch,
+        rows: usize,
+        lo: usize,
+        hi: usize,
+        ring_mask: usize,
+    ) !void {
+        const c = &self.w.config;
+        const sh = &self.w.share;
+        const k = self.k;
+
+        // 1. q_down + q_layernorm
+        try self.fp8(s, sc.layer_in, c.hidden, rows, hca.q_down, sc.q_down, sc.qmmf_part);
+        try k.rmsNorm(s, sc.q_down, hca.q_norm, sc.q_down, rows, c.q_lora, c.eps);
+
+        // 2. kv_proj + kv_layernorm + plain RoPE (mla_inv_freq) -> ring cache
+        try self.fp8(s, sc.layer_in, c.hidden, rows, hca.kv_proj, sc.kv_a, sc.qmmf_part);
+        try k.hcaKvStoreRing(s, sc.kv_a, hca.kv_norm, sc.positions, self.w.mla_inv_freq, kv_ring, rows, ring_mask, c.eps);
+
+        // 3. q_up + weightless per-head Q-RMSNorm + plain GPT-J RoPE (mla_inv_freq)
+        try self.fp8(s, sc.q_down, c.q_lora, rows, hca.q_up, sc.q_up, sc.qmmf_part);
+        try k.hcaQnormRope(s, sc.q_up, sc.positions, self.w.mla_inv_freq, rows, sh.heads, c.eps);
+
+        // 4. o_gate [rows, o_width]
+        try self.fp8(s, sc.q_down, c.q_lora, rows, hca.o_gate, sc.o_gate, sc.qmmf_part);
+
+        // 5. Non-causal SWA-128 attention over [lo .. hi] + attn_sink
+        const scale: f32 = @floatCast(1.0 / @sqrt(@as(f64, @floatFromInt(c.head_dim))));
+        try k.hcaAttnDspark(s, sc.q_up, kv_ring, hca.attn_sink, sc.attn_o, rows, sh.heads, lo, hi, ring_mask, scale);
+
+        // 6. VHA post-mix (U^T @ o -> TP AllReduce -> o += V @ z)
+        try k.vhaUProj(s, sc.attn_o, hca.vha_u, sc.vha_z, rows, sh.heads, c.head_dim);
+        try self.allReduceF32(s, sc.vha_z, sc.vha_z_all, rows * c.vha_rank * c.head_dim);
+        try k.vhaVAdd(s, sc.attn_o, hca.vha_v, sc.vha_z, rows, sh.heads, c.head_dim);
+
+        // 7. Inverse plain GPT-J RoPE on dims [448..512)
+        try k.ropeGptj(s, sc.attn_o, sc.positions, self.w.mla_inv_freq, rows, sh.heads, c.head_dim, c.qk_nope, -1);
+
+        // 8. Grouped wo_a -> sigmoid gate -> wo_b -> TP AllReduce
+        const group_k: usize = (c.heads / c.o_groups) * c.head_dim;
+        const ldx: usize = sh.groups * group_k;
+        if (rows == 1 or sh.groups == 1) {
+            for (0..sh.groups) |g| {
+                const x_ptr = sc.attn_o + g * group_k * 2;
+                const y_ptr = sc.wo_a_out + g * c.o_lora * 2;
+                try self.fp8(s, x_ptr, ldx, rows, hca.wo_a[g], y_ptr, sc.qmmf_part);
+            }
+        } else {
+            for (0..sh.groups) |g| {
+                const x_ptr = sc.attn_o + g * group_k * 2;
+                const y_ptr = sc.q_up + g * rows * c.o_lora * 2;
+                try self.fp8(s, x_ptr, ldx, rows, hca.wo_a[g], y_ptr, sc.qmmf_part);
+            }
+            try k.interleaveGroups(s, sc.q_up, sc.wo_a_out, sh.groups, rows, c.o_lora);
+        }
+        try k.sigmoidMulBf16(s, sc.wo_a_out, sc.o_gate, sc.wo_a_out, rows * sh.o_width);
+        try self.fp8(s, sc.wo_a_out, sh.o_width, rows, hca.wo_b, sc.sub_out, sc.qmmf_part);
+        try self.allReduceBf16(s, sc.sub_out, sc.tp_gather, rows * c.hidden);
+    }
+
+    fn forwardDsa(self: *const Runner, s: Stream, dsa: *const weights.DsaWeights, lkv: *const kv_mod.DsaKv, sc: *const Scratch, rows: usize, max_pos: usize) !void {
+        const c = &self.w.config;
+        const sh = &self.w.share;
+        const k = self.k;
+
+        // 1. q_a + q_a_layernorm -> sc.q_down [rows, 1024]
+        try self.fp8(s, sc.layer_in, c.hidden, rows, dsa.q_a, sc.q_down, sc.qmmf_part);
+        try k.rmsNorm(s, sc.q_down, dsa.q_a_norm, sc.q_down, rows, c.mla_q_lora, c.eps);
+
+        // 2. kv_a [rows, 576] -> fused kv_a_layernorm(0..511) + GPT-J RoPE(512..575) -> lkv.mla_kv
+        try self.fp8(s, sc.layer_in, c.hidden, rows, dsa.kv_a, sc.kv_a, sc.qmmf_part);
+        try k.dsaKvNormRopeStore(s, sc.kv_a, dsa.kv_a_norm, sc.positions, self.w.mla_inv_freq, lkv.mla_kv, rows, c.eps);
+
+        // 3. Lightning Indexer: always update idx_k cache! (wk -> LayerNorm -> NeoX RoPE[0..64) -> Hadamard-128 -> store)
+        try self.fp8(s, sc.layer_in, c.hidden, rows, dsa.idx_wk, sc.idx_k, sc.qmmf_part);
+        try k.layerNorm(s, sc.idx_k, dsa.idx_k_norm_w, dsa.idx_k_norm_b, sc.idx_k, rows, c.index_dim, c.eps);
+        try k.ropeNeox(s, sc.idx_k, sc.positions, self.w.mla_inv_freq, rows, 1, c.index_dim, 0);
+        try k.hadamard128(s, sc.idx_k, rows);
+        try k.dsaIdxKStore(s, sc.idx_k, sc.positions, lkv.idx_k, rows);
+
+        // 4. Score & select top-2048 + SWA-128 ONLY when max_pos + 1 > 2176!
+        const dense_width = c.index_topk + c.sliding_window; // 2176
+        var use_sparse = false;
+        if (max_pos + 1 > dense_width) {
+            use_sparse = true;
+            try self.fp8(s, sc.q_down, c.mla_q_lora, rows, dsa.idx_wq_b, sc.idx_q, sc.qmmf_part);
+            try k.ropeNeox(s, sc.idx_q, sc.positions, self.w.mla_inv_freq, rows, c.index_heads, c.index_dim, 0);
+            try k.hadamard128(s, sc.idx_q, rows * c.index_heads);
+            try self.fp8(s, sc.layer_in, c.hidden, rows, dsa.idx_weights_proj, sc.idx_w, sc.qmmf_part);
+
+            const max_older = max_pos + 1 - c.sliding_window;
+            const w_scale: f32 = @floatCast(1.0 / (@sqrt(@as(f64, @floatFromInt(c.index_dim))) * @sqrt(@as(f64, @floatFromInt(c.index_heads)))));
+            try k.dsaIndexerScores(s, sc.idx_q, lkv.idx_k, sc.idx_w, sc.positions, sc.idx_scores, rows, max_older, c.sliding_window, w_scale);
+            try k.dsaSelectTopk(s, sc.idx_scores, sc.positions, sc.idx_sel, sc.idx_cnt, rows, max_older, c.index_topk, c.sliding_window);
+        }
+
+        // 5. q_b [rows, heads, 256] + GPT-J RoPE on [192..256) + absorb_q -> sc.q_abs [rows, heads, 576]
+        const q_head = c.mla_qk_nope + c.mla_qk_rope;
+        try self.fp8(s, sc.q_down, c.mla_q_lora, rows, dsa.q_b, sc.q_up, sc.qmmf_part);
+        try k.ropeGptj(s, sc.q_up, sc.positions, self.w.mla_inv_freq, rows, sh.heads, q_head, c.mla_qk_nope, 1);
+        try k.dsaAbsorbQ(s, sc.q_up, dsa.wk, sc.q_abs, rows, sh.heads);
+
+        // 6. o_gate [rows, dsa_o_width]
+        try self.fp8(s, sc.q_down, c.mla_q_lora, rows, dsa.o_gate, sc.o_gate, sc.qmmf_part);
+
+        // 7. MLA-DSA Attention -> sc.attn_o [rows, heads, 512] -> expand_v -> sc.attn_o_v [rows, heads, 256]
+        const scale: f32 = @floatCast(1.0 / @sqrt(@as(f64, @floatFromInt(q_head))));
+        const idx_ptr: u64 = if (use_sparse) sc.idx_sel else 0;
+        const cnt_ptr: u64 = if (use_sparse) sc.idx_cnt else 0;
+        try k.dsaAttn(s, sc.q_abs, lkv.mla_kv, idx_ptr, cnt_ptr, dsa.sinks, sc.positions, sc.attn_o, rows, sh.heads, dense_width, scale);
+        try k.dsaExpandV(s, sc.attn_o, dsa.wv, sc.attn_o_v, rows, sh.heads);
+
+        // 8. VHA post-mix (U^T @ o_v -> TP AllReduce -> o_v += V @ z)
+        try k.vhaUProj(s, sc.attn_o_v, dsa.vha_u, sc.vha_z, rows, sh.heads, c.mla_v_dim);
+        try self.allReduceF32(s, sc.vha_z, sc.vha_z_all, rows * c.vha_rank * c.mla_v_dim);
+        try k.vhaVAdd(s, sc.attn_o_v, dsa.vha_v, sc.vha_z, rows, sh.heads, c.mla_v_dim);
+
+        // 9. Gate * o_v -> o_proj -> TP AllReduce -> sc.sub_out [rows, 4096]
+        try k.sigmoidMulBf16(s, sc.attn_o_v, sc.o_gate, sc.attn_o_v, rows * sh.dsa_o_width);
+        try self.fp8(s, sc.attn_o_v, sh.dsa_o_width, rows, dsa.o_proj, sc.sub_out, sc.qmmf_part);
+        try self.allReduceBf16(s, sc.sub_out, sc.tp_gather, rows * c.hidden);
+    }
+
+    fn forwardDenseMlp(self: *const Runner, s: Stream, mlp: *const weights.DenseMlpWeights, sc: *const Scratch, rows: usize) !void {
+        const c = &self.w.config;
+        const sh = &self.w.share;
+        const k = self.k;
+
+        try self.fp8(s, sc.layer_in, c.hidden, rows, mlp.gate, sc.dense_gate, sc.qmmf_part);
+        try self.fp8(s, sc.layer_in, c.hidden, rows, mlp.up, sc.dense_up, sc.qmmf_part);
+        try k.situAndMul(s, sc.dense_gate, sc.dense_up, sc.dense_gate, rows * sh.dense_width, c.situ_beta, c.situ_linear_beta);
+        try self.fp8(s, sc.dense_gate, sh.dense_width, rows, mlp.down, sc.sub_out, sc.qmmf_part);
+        try self.allReduceBf16(s, sc.sub_out, sc.tp_gather, rows * c.hidden);
+    }
+
+    pub fn forwardMoe(self: *const Runner, s: Stream, moe: *const weights.MoeWeights, sc: *const Scratch, rows: usize) !void {
+        const c = &self.w.config;
+        const sh = &self.w.share;
+        const k = self.k;
+
+        // 1. Split-feature router via qmmf packed BF16 [2*E, H] -> sigmoid(w0) + sigmoid(w1)
+        try self.lane.matmulF32(s, sc.layer_in, c.hidden, rows, moe.gate_packed, sc.router_raw, sc.qmmf_part);
+        try k.routerSplitSum(s, sc.router_raw, sc.router_scores, rows, c.experts);
+        try k.routerTopk(s, sc.router_scores, moe.bias, moe.routed_scale, sc.topk_ids, sc.topk_w, rows, c.experts, c.topk, c.norm_topk);
+
+        // 2. Routed path: fc1_latent -> MXFP4 w13_situ -> MXFP4 w2_combine (TP partial [rows, 2048])
+        try self.fp8(s, sc.layer_in, c.hidden, rows, moe.fc1_latent, sc.latent_in, sc.qmmf_part);
+        try k.mxfp4W13Situ(s, sc.latent_in, moe.w1_q, moe.w1_s, moe.w3_q, moe.w3_s, sc.topk_ids, sc.moe_mid, rows, c.topk, sh.moe_width, c.moe_latent, c.situ_beta, c.situ_linear_beta);
+        try k.mxfp4W2Combine(s, sc.moe_mid, moe.w2_q, moe.w2_s, sc.topk_ids, sc.topk_w, sc.routed_out, rows, c.topk, c.moe_latent, sh.moe_width);
+
+        // 3. Shared expert path: w1/w3 -> SITU -> w2 (TP partial [rows, 4096])
+        try self.fp8(s, sc.layer_in, c.hidden, rows, moe.shared_w1, sc.dense_gate, sc.qmmf_part);
+        try self.fp8(s, sc.layer_in, c.hidden, rows, moe.shared_w3, sc.dense_up, sc.qmmf_part);
+        try k.situAndMul(s, sc.dense_gate, sc.dense_up, sc.dense_gate, rows * sh.moe_width, c.situ_beta, c.situ_linear_beta);
+        try self.fp8(s, sc.dense_gate, sh.moe_width, rows, moe.shared_w2, sc.shared_out, sc.qmmf_part);
+
+        // 4. Single packed AllReduce for BOTH [routed_out (2048), shared_out (4096)] = 6144 elements!
+        if (self.group) |g| {
+            if (g.world > 1) {
+                try k.packPairBf16(s, sc.routed_out, sc.shared_out, sc.moe_pack, rows, c.moe_latent, c.hidden);
+                try self.allReduceBf16(s, sc.moe_pack, sc.tp_gather, rows * (c.moe_latent + c.hidden));
+                try k.unpackPairBf16(s, sc.moe_pack, sc.routed_out, sc.shared_out, rows, c.moe_latent, c.hidden);
+            }
+        }
+
+        // 5. Post-combine latent_norm -> fc2_latent_proj + shared_out -> sc.sub_out [rows, 4096]
+        try k.rmsNorm(s, sc.routed_out, moe.latent_norm, sc.routed_out, rows, c.moe_latent, c.eps);
+        try self.fp8(s, sc.routed_out, c.moe_latent, rows, moe.fc2_latent, sc.sub_out, sc.qmmf_part);
+        try k.addBf16(s, sc.sub_out, sc.shared_out, sc.sub_out, rows * c.hidden);
+    }
+};
