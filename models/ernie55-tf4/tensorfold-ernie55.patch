+    if (lane == 0) {
+        if (out_f32 != nullptr) out_f32[(int64_t)r * N + n] = acc;
+        if (out_bf16 != nullptr) out_bf16[(int64_t)r * N + n] = f2bf(acc);
+    }
+}
