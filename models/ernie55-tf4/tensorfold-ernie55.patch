+//! Per-sequence KV cache and reusable forward scratch buffers for ERNIE 5.5 Flash Preview.
+const std = @import("std");
+const cuda = @import("cuda");
+const cfg = @import("config.zig");
+const shard = @import("cuda_shard.zig");
+
+const Driver = cuda.Driver;
+const DeviceBuffer = cuda.DeviceBuffer;
+
+/// Ring capacity for HCA SWA-128 KV cache and C128 compressor state (power of 2 >= max_chunk + 128).
+pub const swa_cap: usize = 1024;
+pub const swa_mask: usize = swa_cap - 1;
+
+pub const HcaKv = struct {
+    swa_kv: u64, // BF16 [swa_cap, 512]
+    comp_state: u64, // F32 [swa_cap, 2, 512]
+    comp_kv: u64, // BF16 [comp_cap, 512]
+};
+
+pub const DsaKv = struct {
+    mla_kv: u64, // BF16 [capacity, 576]
+    idx_k: u64, // BF16 [capacity, 128]
+};
+
+pub const LayerKv = union(enum) {
+    hca: HcaKv,
+    dsa: DsaKv,
+};
+
+pub const KvCache = struct {
+    gpa: std.mem.Allocator,
+    capacity: usize,
+    comp_cap: usize,
+    pos: usize = 0,
+    buf: DeviceBuffer,
+    layers: []LayerKv,
+
+    pub fn alloc(gpa: std.mem.Allocator, d: *const Driver, c: *const cfg.Config, n_layers: u32, capacity: usize) !KvCache {
+        const comp_cap = (capacity + c.compress_ratio - 1) / c.compress_ratio + 2;
+        var layers = try gpa.alloc(LayerKv, n_layers);
+        errdefer gpa.free(layers);
+
+        var total: usize = 0;
+        for (0..n_layers) |li| {
+            if (c.isDsa(@intCast(li))) {
+                total = alignUp(total, 256);
+                total += capacity * 576 * 2;
+                total = alignUp(total, 256);
+                total += capacity * 128 * 2;
+            } else {
+                total = alignUp(total, 256);
+                total += swa_cap * 512 * 2;
+                total = alignUp(total, 256);
+                total += swa_cap * 2 * 512 * 4;
+                total = alignUp(total, 256);
+                total += comp_cap * 512 * 2;
+            }
+        }
+        const buf = try DeviceBuffer.alloc(d, @max(total, 256));
+        errdefer {
+            var owned = buf;
+            owned.free();
+        }
+        try buf.fill8(0, null);
+
+        var off: usize = 0;
+        for (0..n_layers) |li| {
+            if (c.isDsa(@intCast(li))) {
+                off = alignUp(off, 256);
+                const mla_kv = buf.ptr + off;
+                off += capacity * 576 * 2;
+                off = alignUp(off, 256);
+                const idx_k = buf.ptr + off;
+                off += capacity * 128 * 2;
+                layers[li] = .{ .dsa = .{ .mla_kv = mla_kv, .idx_k = idx_k } };
+            } else {
+                off = alignUp(off, 256);
+                const swa_kv = buf.ptr + off;
+                off += swa_cap * 512 * 2;
+                off = alignUp(off, 256);
+                const comp_state = buf.ptr + off;
+                off += swa_cap * 2 * 512 * 4;
+                off = alignUp(off, 256);
+                const comp_kv = buf.ptr + off;
+                off += comp_cap * 512 * 2;
+                layers[li] = .{ .hca = .{ .swa_kv = swa_kv, .comp_state = comp_state, .comp_kv = comp_kv } };
+            }
+        }
+
+        return .{
+            .gpa = gpa,
+            .capacity = capacity,
+            .comp_cap = comp_cap,
+            .pos = 0,
+            .buf = buf,
+            .layers = layers,
+        };
+    }
+
+    pub fn reset(self: *KvCache) void {
+        self.pos = 0;
+    }
+
+    pub fn deinit(self: *KvCache) void {
+        self.buf.free();
+        self.gpa.free(self.layers);
+        self.* = undefined;
+    }
+};
+
+/// Reusable device scratch for up to `max_rows` tokens in one forward pass.
+pub const Scratch = struct {
+    max_rows: usize,
+    capacity: usize,
+    buf: DeviceBuffer,
+
+    ids: u64, // i32 [max_rows]
+    positions: u64, // i32 [max_rows]
+    res_a: u64, // BF16 [max_rows, 4, 4096]
+    res_b: u64, // BF16 [max_rows, 4, 4096]
+    post_mix: u64, // F32 [max_rows, 4]
+    mhc_mix_raw: u64, // F32 [max_rows, 24]
+    mhc_sqrsum: u64, // F32 [max_rows]
+    comb_mix: u64, // F32 [max_rows, 16]
+    layer_in: u64, // BF16 [max_rows, 4096]
+    sub_out: u64, // BF16 [max_rows, 4096]
+
+    // Attention scratch (shared between HCA and DSA)
+    q_down: u64, // BF16 [max_rows, 1024]
+    kv_a: u64, // BF16 [max_rows, 576] (512 for HCA, 576 for DSA)
+    kv_norm: u64, // BF16 [max_rows, 512]
+    q_up: u64, // BF16 [max_rows, max(heads*512, heads*256)]
+    q_abs: u64, // BF16 [max_rows, heads, 576]
+    attn_o: u64, // BF16 [max_rows, heads * 512]
+    attn_o_v: u64, // BF16 [max_rows, heads * 256]
+    o_gate: u64, // BF16 [max_rows, max(o_width, dsa_o_width)]
+    wo_a_out: u64, // BF16 [max_rows, o_width]
+    vha_z: u64, // F32 [max_rows, 16, 512]
+    vha_z_all: u64, // F32 [world, max_rows, 16, 512]
+    comp_wkv: u64, // BF16 [max_rows, 512]
+    comp_wgate: u64, // BF16 [max_rows, 512]
+
+    // DSA indexer scratch
+    idx_q: u64, // BF16 [max_rows, 64, 128]
+    idx_k: u64, // BF16 [max_rows, 128]
+    idx_w: u64, // BF16 [max_rows, 64]
+    idx_scores: u64, // F32 [min(max_rows, 64), capacity]
+    idx_sel: u64, // i32 [max_rows, 2176]
+    idx_cnt: u64, // i32 [max_rows]
+
+    // FFN / MoE scratch
+    dense_gate: u64, // BF16 [max_rows, dense_width]
+    dense_up: u64, // BF16 [max_rows, dense_width]
+    router_raw: u64, // F32 [max_rows, 2 * experts]
+    router_scores: u64, // F32 [max_rows, experts]
+    topk_ids: u64, // i32 [max_rows, topk]
+    topk_w: u64, // F32 [max_rows, topk]
+    latent_in: u64, // BF16 [max_rows, 2048]
+    moe_mid: u64, // BF16 [max_rows, topk, moe_width]
+    routed_out: u64, // BF16 [max_rows, 2048]
+    shared_out: u64, // BF16 [max_rows, 4096]
+    moe_pack: u64, // BF16 [max_rows, 6144]
+    tp_gather: u64, // BF16 [world, max_rows, 6144]
+
+    // DSpark target aux taps: 3 slots of [max_rows, 4096] + concatenated [max_rows, 12288]
+    dspark_taps_tmp: u64, // BF16 [3, max_rows, 4096]
+    dspark_taps: u64, // BF16 [max_rows, 12288]
+
+    // qmmf split-K partial accumulator + logits
+    qmmf_part: u64, // F32 [8, max_rows, max_n]
+    logits: u64, // F32 [max_rows, vocab_width]
+    argmax_id: u64, // i32 [max_rows]
+    argmax_val: u64, // F32 [max_rows]
+
+    pub fn alloc(d: *const Driver, c: *const cfg.Config, sh: *const shard.Share, max_rows: usize, capacity: usize) !Scratch {
+        const R = max_rows;
+        const max_n = @max(sh.vocab_width, @max(sh.heads * 512, sh.dense_width));
+        const idx_score_rows = @min(R, 64);
+
+        var off: usize = 0;
+        const reserve = struct {
+            fn f(cur: *usize, bytes: usize) usize {
+                cur.* = alignUp(cur.*, 256);
+                const p = cur.*;
+                cur.* += bytes;
+                return p;
+            }
+        }.f;
+
+        var s: Scratch = undefined;
+        s.max_rows = R;
+        s.capacity = capacity;
+
+        const o_ids = reserve(&off, R * 4);
+        const o_pos = reserve(&off, R * 4);
+        const o_res_a = reserve(&off, R * 4 * c.hidden * 2);
+        const o_res_b = reserve(&off, R * 4 * c.hidden * 2);
+        const o_post_mix = reserve(&off, R * 4 * 4);
+        const o_mhc_mix = reserve(&off, R * 24 * 4);
+        const o_mhc_sq = reserve(&off, R * 4);
+        const o_comb_mix = reserve(&off, R * 16 * 4);
+        const o_layer_in = reserve(&off, R * c.hidden * 2);
+        const o_sub_out = reserve(&off, R * c.hidden * 2);
+
+        const o_q_down = reserve(&off, R * c.q_lora * 2);
+        const o_kv_a = reserve(&off, R * 576 * 2);
+        const o_kv_norm = reserve(&off, R * 512 * 2);
+        const o_q_up = reserve(&off, R * sh.heads * 512 * 2);
+        const o_q_abs = reserve(&off, R * sh.heads * 576 * 2);
+        const o_attn_o = reserve(&off, R * sh.heads * 512 * 2);
+        const o_attn_o_v = reserve(&off, R * sh.heads * 256 * 2);
+        const o_o_gate = reserve(&off, R * @max(sh.o_width, sh.dsa_o_width) * 2);
+        const o_wo_a = reserve(&off, R * sh.o_width * 2);
+        const o_vha_z = reserve(&off, R * 16 * 512 * 4);
+        const o_vha_z_all = reserve(&off, sh.world * R * 16 * 512 * 4);
+        const o_comp_wkv = reserve(&off, R * 512 * 2);
+        const o_comp_wgate = reserve(&off, R * 512 * 2);
+
+        const o_idx_q = reserve(&off, R * 64 * 128 * 2);
+        const o_idx_k = reserve(&off, R * 128 * 2);
+        const o_idx_w = reserve(&off, R * 64 * 2);
+        const o_idx_scores = reserve(&off, idx_score_rows * capacity * 4);
+        const o_idx_sel = reserve(&off, R * (c.index_topk + c.sliding_window) * 4);
+        const o_idx_cnt = reserve(&off, R * 4);
+
+        const o_dense_gate = reserve(&off, R * sh.dense_width * 2);
+        const o_dense_up = reserve(&off, R * sh.dense_width * 2);
+        const o_router_raw = reserve(&off, R * 2 * c.experts * 4);
+        const o_router_sc = reserve(&off, R * c.experts * 4);
+        const o_topk_ids = reserve(&off, R * c.topk * 4);
+        const o_topk_w = reserve(&off, R * c.topk * 4);
+        const o_latent_in = reserve(&off, R * c.moe_latent * 2);
+        const o_moe_mid = reserve(&off, R * c.topk * sh.moe_width * 2);
+        const o_routed_out = reserve(&off, R * c.moe_latent * 2);
+        const o_shared_out = reserve(&off, R * c.hidden * 2);
+        const o_moe_pack = reserve(&off, R * (c.moe_latent + c.hidden) * 2);
+        const o_tp_gather = reserve(&off, sh.world * R * (c.moe_latent + c.hidden) * 2);
+
+        const o_taps_tmp = reserve(&off, 3 * R * c.hidden * 2);
+        const o_taps = reserve(&off, R * 3 * c.hidden * 2);
+
+        const o_qmmf_part = reserve(&off, 8 * R * max_n * 4);
+        const o_logits = reserve(&off, R * sh.vocab_width * 4);
+        const o_argmax_id = reserve(&off, R * 4);
+        const o_argmax_val = reserve(&off, R * 4);
+
+        s.buf = try DeviceBuffer.alloc(d, off);
+        const b = s.buf.ptr;
+
+        s.ids = b + o_ids;
+        s.positions = b + o_pos;
+        s.res_a = b + o_res_a;
+        s.res_b = b + o_res_b;
+        s.post_mix = b + o_post_mix;
+        s.mhc_mix_raw = b + o_mhc_mix;
+        s.mhc_sqrsum = b + o_mhc_sq;
+        s.comb_mix = b + o_comb_mix;
+        s.layer_in = b + o_layer_in;
+        s.sub_out = b + o_sub_out;
+        s.q_down = b + o_q_down;
+        s.kv_a = b + o_kv_a;
+        s.kv_norm = b + o_kv_norm;
+        s.q_up = b + o_q_up;
+        s.q_abs = b + o_q_abs;
+        s.attn_o = b + o_attn_o;
+        s.attn_o_v = b + o_attn_o_v;
+        s.o_gate = b + o_o_gate;
+        s.wo_a_out = b + o_wo_a;
+        s.vha_z = b + o_vha_z;
+        s.vha_z_all = b + o_vha_z_all;
+        s.comp_wkv = b + o_comp_wkv;
+        s.comp_wgate = b + o_comp_wgate;
+        s.idx_q = b + o_idx_q;
+        s.idx_k = b + o_idx_k;
+        s.idx_w = b + o_idx_w;
+        s.idx_scores = b + o_idx_scores;
+        s.idx_sel = b + o_idx_sel;
+        s.idx_cnt = b + o_idx_cnt;
+        s.dense_gate = b + o_dense_gate;
+        s.dense_up = b + o_dense_up;
+        s.router_raw = b + o_router_raw;
+        s.router_scores = b + o_router_sc;
+        s.topk_ids = b + o_topk_ids;
+        s.topk_w = b + o_topk_w;
+        s.latent_in = b + o_latent_in;
+        s.moe_mid = b + o_moe_mid;
+        s.routed_out = b + o_routed_out;
+        s.shared_out = b + o_shared_out;
+        s.moe_pack = b + o_moe_pack;
+        s.tp_gather = b + o_tp_gather;
+        s.dspark_taps_tmp = b + o_taps_tmp;
+        s.dspark_taps = b + o_taps;
+        s.qmmf_part = b + o_qmmf_part;
+        s.logits = b + o_logits;
+        s.argmax_id = b + o_argmax_id;
+        s.argmax_val = b + o_argmax_val;
+        return s;
+    }
+
+    pub fn deinit(self: *Scratch) void {
+        self.buf.free();
+        self.* = undefined;
+    }
+};
+
+fn alignUp(v: usize, a: usize) usize {
+    return (v + a - 1) / a * a;
+}
diff --git a/zig/src/families/ernie55/cuda_lanes.zig b/zig/src/families/ernie55/cuda_lanes.zig
new file mode 100644
index 0000000..96b9bf5
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_lanes.zig
@@ -0,0 +1,309 @@
+//! ERNIE 5.5 Flash Preview CUDA lanes backend (`lanes.backend.Backend` over `cuda_follow.Leader`).
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const engine = @import("cuda_engine.zig");
+const follow = @import("cuda_follow.zig");
+const dspark = @import("cuda_dspark.zig");
+const be = lanes.backend;
+
+const ring: usize = 64;
+const max_rows: usize = 8; // 1 pending + up to 7 DSpark drafts
+const max_held: usize = dspark.block_size; // 7
+
+/// Measured 4x DGX Spark (TP=4 RoCE) ERNIE 5.5 verify costs (ms) for 1..8 rows.
+const gb10_window_costs = [_]lanes.allocate.Cost{
+    .{ .width = 1, .ms = 37.0 }, .{ .width = 2, .ms = 40.0 }, .{ .width = 3, .ms = 43.0 }, .{ .width = 4, .ms = 46.0 },
+    .{ .width = 5, .ms = 49.0 }, .{ .width = 6, .ms = 52.0 }, .{ .width = 7, .ms = 55.0 }, .{ .width = 8, .ms = 58.0 },
+};
+
+const Lane = struct {
+    slot: u32,
+    pending_rows: ?usize = null,
+    held: [max_held]u32 = undefined,
+    held_n: usize = 0,
+    first: ?u64 = null,
+    fill: ?usize = null,
+};
+
+pub const Lanes = struct {
+    x: follow.Leader,
+    lanes: std.AutoHashMapUnmanaged(*const lanes.Stream, Lane) = .empty,
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+    bits: ?cuda.HostBuffer = null,
+    bits_dev: u64 = 0,
+
+    pub fn deinit(self: *Lanes) void {
+        if (self.bits) |*b| b.free();
+        self.lanes.deinit(self.x.e.gpa);
+    }
+
+    pub fn backend(self: *Lanes) be.Backend {
+        return .{ .ptr = self, .vtable = &vt };
+    }
+
+    const vt: be.Backend.VTable = .{
+        .prefill = prefillFn,
+        .prefill_step = prefillStepFn,
+        .cancel_prefill = cancelPrefillFn,
+        .first = firstFn,
+        .queue = queueFn,
+        .read = readFn,
+        .verify = verifyFn,
+        .keep = keepFn,
+        .draft = draftFn,
+        .held = heldFn,
+        .first_masked = firstMaskedFn,
+        .release = releaseFn,
+    };
+
+    pub fn facts(self: *const Lanes) lanes.Model {
+        const head = self.x.e.drafter != null;
+        return .{
+            .root_copies = false,
+            .context_copies = false,
+            .copy_match = 8,
+            .exact_width = max_rows,
+            .gpu_tokens = false,
+            .mtp = head,
+            .speculate = head,
+            .speculate_early = false,
+            .drafts = if (head) max_held else 0,
+            .draft_streams = head,
+            .mtp_step_ms = if (head) 6.0 / @as(f64, max_held) else 0,
+            .window_costs = if (head) &gb10_window_costs else &.{},
+            .shared_costs = &.{},
+            .hidden_rows = true,
+            .batch_rows = max_rows,
+            .max_streams = engine.max_slots,
+        };
+    }
+
+    fn of(ptr: *anyopaque) *Lanes {
+        return @ptrCast(@alignCast(ptr));
+    }
+
+    fn take(self: *Lanes, token: u32) u64 {
+        const h = self.next;
+        self.drawn[h % ring] = token;
+        self.next += 1;
+        return h;
+    }
+
+    fn freeSlot(self: *const Lanes) u32 {
+        var slot: u32 = 0;
+        while (true) : (slot += 1) {
+            var it = self.lanes.valueIterator();
+            const taken = while (it.next()) |l| {
+                if (l.slot == slot) break true;
+            } else false;
+            if (!taken) return slot;
+        }
+    }
+
+    fn claim(self: *Lanes, s: *const lanes.Stream) !*Lane {
+        if (self.lanes.getPtr(s)) |existing| return existing;
+        const slot = self.freeSlot();
+        const gop = try self.lanes.getOrPut(self.x.e.gpa, s);
+        gop.value_ptr.* = .{ .slot = slot };
+        return gop.value_ptr;
+    }
+
+    fn bind(self: *Lanes, s: *const lanes.Stream, kept: ?usize) !*Lane {
+        const l = self.lanes.getPtr(s) orelse return error.UnknownStream;
+        try self.x.bind(l.slot);
+        if (l.pending_rows) |rows| try self.x.keep(kept orelse rows);
+        l.pending_rows = null;
+        return l;
+    }
+
+    fn putBits(self: *Lanes, rows: usize, masks: []const u32) !u64 {
+        if (masks.len == 0) return 0;
+        const words = (self.x.e.w.config.vocab + 31) / 32;
+        if (masks.len != rows * words or rows > engine.window_rows) return error.InvalidGrammarMasks;
+        if (self.bits == null) {
+            var buf = try cuda.HostBuffer.allocMapped(self.x.e.d, engine.window_rows * words * 4);
+            errdefer buf.free();
+            self.bits_dev = try buf.device();
+            self.bits = buf;
+        }
+        @memcpy(self.bits.?.slice(u32)[0..masks.len], masks);
+        return self.bits_dev;
+    }
+
+    fn prefillFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!void {
+        while (!(try prefillStepFn(ptr, s, 0))) {}
+    }
+
+    /// The stream's kept state, where its prompt pass starts (null: none, off the chunk grid, or no longer held).
+    fn resumeFrom(self: *Lanes, s: *lanes.Stream, len: usize) ?engine.Resume {
+        const saved = s.reuse.saved orelse return null;
+        const k: *const engine.Kept = @ptrCast(@alignCast(saved));
+        if (k.at != s.reuse.at or k.at == 0 or k.at >= len or k.at % engine.prompt_rows != 0 or !self.x.e.holds(k.id)) {
+            s.reuse_failed = true;
+            s.reuse_error = if (k.at == 0 or k.at >= len) error.SnapshotNotPrefix else if (k.at != s.reuse.at or k.at % engine.prompt_rows != 0) error.SnapshotOutOfStep else error.SnapshotStale;
+            return null;
+        }
+        s.cached = k.at;
+        return .{ .id = k.id, .at = k.at };
+    }
+
+    /// The prompt pass stands at `at` (a chunk start): the store keeps the state there when it marked it.
+    fn mark(s: *lanes.Stream, at: usize) void {
+        if (at == 0) return;
+        const hook = s.reuse.hook orelse return;
+        if (std.mem.indexOfScalar(u32, s.reuse.marks, @intCast(at)) == null) return;
+        hook.at(hook.ptr, s, @intCast(at));
+    }
+
+    fn prefillStepFn(ptr: *anyopaque, s: *lanes.Stream, max_step: u32) anyerror!bool {
+        _ = max_step; // chunks stay on the prompt grid (kept states stand on it)
+        const self = of(ptr);
+        const l = try self.claim(s);
+        const prompt = s.prompt();
+        if (prompt.len == 0 or prompt.len + max_rows >= self.x.e.capacity) return error.BadPrompt;
+
+        try self.x.bind(l.slot);
+        var resume_id: u64 = 0;
+        if (l.fill == null) {
+            try self.x.begin(s.sampling);
+            l.fill = 0;
+            l.pending_rows = null;
+            l.held_n = 0;
+            l.first = null;
+            s.cached = 0;
+            if (s.prompt_logprobs == null) if (self.resumeFrom(s, prompt.len)) |r| {
+                l.fill = r.at;
+                resume_id = r.id;
+            };
+        }
+
+        const pos0 = l.fill.?;
+        if (resume_id == 0) mark(s, pos0);
+        const take_n = @min(prompt.len - pos0, engine.prompt_rows);
+        const is_last = (pos0 + take_n == prompt.len);
+        const tok = self.x.chunk(prompt[pos0 .. pos0 + take_n], pos0, prompt.len, is_last, resume_id) catch |err| {
+            l.fill = null;
+            return err;
+        };
+        l.fill = pos0 + take_n;
+        if (is_last) {
+            l.first = self.take(tok);
+            l.fill = null;
+            return true;
+        }
+        return false;
+    }
+
+    fn cancelPrefillFn(ptr: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const self = of(ptr);
+        if (self.lanes.getPtr(s)) |l| {
+            l.fill = null;
+        }
+    }
+
+    fn firstFn(ptr: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        _ = position;
+        const self = of(ptr);
+        const l = self.lanes.getPtr(s) orelse return error.UnknownStream;
+        return l.first orelse return error.NoFirstToken;
+    }
+
+    fn firstMaskedFn(ptr: *anyopaque, s: *lanes.Stream, position: u64, mask: []const u32) anyerror!u64 {
+        _ = position;
+        const self = of(ptr);
+        const l = try self.bind(s, null);
+        const bits = try self.putBits(1, mask);
+        const tok = try self.x.firstMasked(bits, mask);
+        const h = self.take(tok);
+        l.first = h;
+        return h;
+    }
+
+    fn value(self: *const Lanes, feed: be.Feed) u32 {
+        return switch (feed) {
+            .handle => |h| self.drawn[h % ring],
+            .value => |v| v,
+        };
+    }
+
+    fn queueFn(ptr: *anyopaque, s: *lanes.Stream, feed: be.Feed, position: u64) anyerror!u64 {
+        const self = of(ptr);
+        const l = try self.bind(s, null);
+        if (position != self.x.e.pos() + 1) return error.PositionMismatch;
+        const tok_in = [1]u32{self.value(feed)};
+        var out: [1]u32 = undefined;
+        try self.x.verify(&tok_in, &out, 0, &.{});
+        l.pending_rows = 1;
+        return self.take(out[0]);
+    }
+
+    fn readFn(ptr: *anyopaque, handle: u64) anyerror!u32 {
+        return of(ptr).drawn[handle % ring];
+    }
+
+    fn verifyFn(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const self = of(ptr);
+        var ids: [max_rows]u32 = undefined;
+        var sampled: [max_rows]u32 = undefined;
+        for (windows, out) |w, *o| {
+            if (w.parents != null) return error.TreesNotBuilt;
+            const l = try self.bind(w.stream, null);
+            if (w.held > l.held_n) return error.NoHeldDrafts;
+            const rows = w.rows();
+            if (rows > max_rows) return error.WindowTooWide;
+            const p = self.x.e.pos();
+            for (w.positions, 0..) |pos_w, r| if (pos_w != p + 1 + r) return error.PositionMismatch;
+            ids[0] = w.pending;
+            const drafts = if (w.held > 0) l.held[0..w.held] else w.tokens;
+            @memcpy(ids[1..][0..drafts.len], drafts);
+            const bits = try self.putBits(rows, w.masks);
+            try self.x.verify(ids[0..rows], sampled[0..rows], bits, w.masks);
+            @memcpy(o.sampled[0..rows], sampled[0..rows]);
+            @memcpy(o.drafts[0..drafts.len], drafts);
+            l.pending_rows = rows;
+        }
+    }
+
+    fn keepFn(ptr: *anyopaque, windows: []const be.Window, paths: []const []const u32) anyerror!void {
+        const self = of(ptr);
+        for (windows, paths) |w, path| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+            _ = try self.bind(w.stream, path.len);
+        }
+    }
+
+    fn draftFn(ptr: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const self = of(ptr);
+        if (self.x.e.drafter == null) return error.NoDraftHead;
+        for (requests) |r| {
+            const l = try self.bind(r.stream, if (r.rows) |rows| rows.len else null);
+            if (r.position != self.x.e.pos() + 1) return error.PositionMismatch;
+            if (r.lanes != null) return error.TreesNotBuilt;
+            var n: usize = 0;
+            const anchor = if (r.rows) |rows| a: {
+                for (rows, 0..) |row, j| if (row != j) return error.TreesNotBuilt;
+                n = rows.len;
+                break :a r.follow[rows.len - 1];
+            } else self.value(r.first orelse return error.NoFirstToken);
+            const depth = @min(r.depth, max_held);
+            try self.x.block(n, anchor, l.held[0..depth]);
+            l.held_n = depth;
+        }
+    }
+
+    fn heldFn(ptr: *anyopaque, s: *lanes.Stream, out: []u32) anyerror!void {
+        const l = of(ptr).lanes.getPtr(s) orelse return error.UnknownStream;
+        if (out.len > l.held_n) return error.NoHeldDrafts;
+        @memcpy(out, l.held[0..out.len]);
+    }
+
+    fn releaseFn(ptr: *anyopaque, s: *lanes.Stream) void {
+        const self = of(ptr);
+        const kv = self.lanes.fetchRemove(s) orelse return;
+        self.x.release(kv.value.slot) catch |err| std.log.err("ernie55 releasing slot {d}: {s}", .{ kv.value.slot, @errorName(err) });
+        if (self.lanes.count() == 0) self.x.idle() catch |err| std.log.err("ernie55 idle step: {s}", .{@errorName(err)});
+    }
+};
diff --git a/zig/src/families/ernie55/cuda_native.zig b/zig/src/families/ernie55/cuda_native.zig
new file mode 100644
index 0000000..7965d5e
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_native.zig
@@ -0,0 +1,258 @@
+//! ERNIE 5.5 Flash Preview native CUDA family entry point for tensorfold-native (TP=1/2/4 over dual-rail RoCE + bundled 3-layer DSpark).
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const core = @import("core");
+const cfg = @import("config.zig");
+const engine = @import("cuda_engine.zig");
+const follow = @import("cuda_follow.zig");
+const ernie_lanes = @import("cuda_lanes.zig");
+
+pub const model_type = "ernie5_5_moe";
+pub const formats: []const []const u8 = &.{"fp8-block128"};
+pub const default_context: i64 = 262_144;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = engine.prompt_rows;
+pub const window_rows: u32 = engine.window_rows;
+pub const explains_open = true;
+/// Kept prompt states stand at chunk starts (the HCA rings and compressed blocks line up there).
+pub const snap_grid: u32 = prompt_rows;
+
+pub const Room = struct { ctx: *anyopaque, read: *const fn (*anyopaque) ?u64 };
+pub const Options = struct {
+    context: usize,
+    drafts: bool,
+    segments: usize = 1,
+    slide: bool = false,
+    room: ?Room = null,
+    rank: u32 = 0,
+    tp: u32 = 1,
+    master: ?[]const u8 = null,
+    master_port: u16 = 29688,
+    launch_from: []const u8 = "",
+};
+
+pub const Peer = struct { bytes: u64, rank: usize };
+pub const Place = struct { rank: usize, world: usize };
+
+pub const Loaded = struct {
+    backend: lanes.backend.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    free_streams: u32 = 1,
+    learn_bytes: usize = 0,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    peer_room: ?Peer = null,
+    follow: ?*const fn (*anyopaque) anyerror!void = null,
+    target: *anyopaque, // the prompt cache keeps this rank group's states (snap_*)
+};
+
+/// A state kept at `at`: its bytes on this rank.
+pub fn snap_bytes(ptr: *anyopaque, at: u32) u64 {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    return own.e.stateBytes(at);
+}
+
+/// The prompt pass stands at `at` (a mark at a chunk start): every rank copies the state there under one new id.
+pub fn snap_save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
+    _ = owner;
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    if (own.e.pos() != at) return error.NotAtMark;
+    const k = try own.gpa.create(engine.Kept);
+    errdefer own.gpa.destroy(k);
+    k.* = try own.lanes.x.save(at);
+    return k;
+}
+
+/// A restore outside a prompt pass would leave the other ranks behind: states resume inside it (Lanes.resumeFrom).
+pub fn snap_restore(ptr: *anyopaque, owner: ?*anyopaque, saved: *anyopaque) anyerror!void {
+    _ = ptr;
+    _ = owner;
+    _ = saved;
+    return error.RestoredInPromptPass;
+}
+
+pub fn snap_drop(ptr: *anyopaque, saved: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const k: *engine.Kept = @ptrCast(@alignCast(saved));
+    own.lanes.x.drop(k.id);
+    own.gpa.destroy(k);
+}
+
+pub fn place(o: anytype) !Place {
+    if (o.tp < 1 or o.rank >= o.tp) return error.NoRank;
+    return .{ .rank = o.rank, .world = o.tp };
+}
+
+pub fn admit(sm: u32, world: usize) error{ Ernie55RequiresSm121, Ernie55BadTp }!void {
+    if (sm != 121) return error.Ernie55RequiresSm121;
+    if (world != 1 and world != 2 and world != 4) return error.Ernie55BadTp;
+}
+
+/// Per-rank weight share for startup memory admission (~41.5 GiB/Spark at TP=4).
+pub fn weightShare(_: std.mem.Allocator, _: std.Io, _: []const u8, total: u64, drafts: bool, _: u32, world: u32) u64 {
+    const w = @max(world, 1);
+    const est = total / w + (if (drafts) @as(u64, 4) << 30 else @as(u64, 2) << 30);
+    return @min(total, est);
+}
+
+pub fn capacity(context: usize) usize {
+    return ((context + 255) / 256) * 256 + 128;
+}
+
+const Owned = struct {
+    gpa: std.mem.Allocator,
+    e: *engine.Engine,
+    lanes: ernie_lanes.Lanes,
+    place: Place,
+    lib: ?cuda.nccl.Library = null,
+    comm: cuda.nccl.Comm = null,
+    group: ?cuda.tp_group.Group = null,
+    link: ?follow.Link = null,
+    benchmark_group: ?[]const u8 = null,
+};
+
+pub fn benchmark(p: *anyopaque) struct { ranks: ?u32, group: ?[]const u8 } {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    return .{ .ranks = if (own.group) |g| @intCast(g.world) else 1, .group = own.benchmark_group };
+}
+
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    _ = kernels;
+    try cuda.rendezvous.fromMaster(o, cuda.rendezvous.Process{}, cuda.rendezvous.Process{});
+    const p = try place(o);
+    try admit(@intCast(try ctx.attribute(.compute_capability_major) * 10 + try ctx.attribute(.compute_capability_minor)), p.world);
+    if (p.world > 1 and std.c.getenv("NCCL_COMM_ID") == null) return error.NoCommId;
+    if (p.world > 1) try cuda.tp_watch.start(io, p.rank, p.world);
+    if (p.world > 1) std.log.info("[tensorfold] ernie55: rank {d} of {d} ({s})", .{ p.rank, p.world, o.launch_from });
+    return openRank(gpa, io, ctx, dir, o, p) catch |err| {
+        cuda.tp_watch.fail(@errorName(err));
+        return err;
+    };
+}
+
+fn openRank(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, o: Options, p: Place) !Loaded {
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.* = .{ .gpa = gpa, .e = undefined, .lanes = undefined, .place = p };
+
+    if (p.world > 1) {
+        var lib = try cuda.nccl.Library.open();
+        errdefer lib.close();
+        var id: cuda.nccl.UniqueId = undefined;
+        if (p.rank == 0) {
+            try lib.check(lib.api.ncclGetUniqueId(&id), "ncclGetUniqueId");
+            cuda.tp_watch.sendId(&id.internal);
+        } else {
+            id.internal = try cuda.tp_watch.takeId(io);
+        }
+        var comm: cuda.nccl.Comm = null;
+        try lib.check(lib.api.ncclCommInitRank(&comm, @intCast(p.world), id, @intCast(p.rank)), "ncclCommInitRank");
+        own.lib = lib;
+        own.comm = comm;
+    }
+
+    const cap = capacity(o.context);
+    own.e = try engine.Engine.init(gpa, io, ctx.d, dir, p.rank, p.world, .{
+        .capacity = cap,
+        .load_dspark = o.drafts,
+    });
+    errdefer own.e.deinit();
+
+    if (p.world > 1) {
+        const words_per_row = (own.e.w.config.vocab + 31) / 32;
+        const max_link_ids = @max(@max(cap, engine.prompt_rows), engine.window_rows * (words_per_row + 1));
+        own.link = try follow.Link.init(gpa, ctx.d, &own.lib.?, own.comm, own.e.stream, max_link_ids);
+    }
+    errdefer if (own.link) |*l| l.deinit();
+
+    if (p.world > 1) {
+        own.group = .{ .lib = own.lib.?, .comm = own.comm, .rank = p.rank, .world = p.world };
+        const roce_off = if (std.c.getenv("TF_ROCE")) |v| std.mem.eql(u8, std.mem.span(v), "0") else false;
+        if (!roce_off) {
+            const max_bytes = try roceBytes(if (std.c.getenv("TF_ROCE_MAX_KB")) |v| std.mem.span(v) else null);
+            try own.group.?.openRoce(gpa, io, ctx.d, own.e.stream, max_bytes);
+        }
+        own.e.group = &own.group.?;
+    }
+    errdefer if (own.group) |*g| if (g.fast) |f| f.deinit();
+
+    // NCCL barrier + room exchange across all ranks (safe across NVMe load skew!)
+    var peer: ?Peer = null;
+    if (p.world > 1) {
+        const mine: u64 = if (o.room) |r| r.read(r.ctx) orelse 0 else std.math.maxInt(u64);
+        var rooms = try cuda.DeviceBuffer.alloc(ctx.d, 8 * p.world);
+        defer rooms.free();
+        const at = rooms.ptr + p.rank * 8;
+        try rooms.upload(p.rank * 8, std.mem.asBytes(&mine));
+        try own.lib.?.check(own.lib.?.api.ncclAllGather(at, rooms.ptr, 8, .u8, own.comm, own.e.stream.handle), "ncclAllGather");
+        try own.e.stream.synchronize();
+        var all: [8]u64 = undefined;
+        try rooms.download(0, std.mem.sliceAsBytes(all[0..p.world]));
+        for (all[1..p.world], 1..) |r, q| {
+            if (peer == null or r < peer.?.bytes) peer = .{ .bytes = r, .rank = q };
+        }
+        try cuda.tp_watch.ready(io, @splat(0));
+    }
+
+    own.benchmark_group = if (own.group) |*g| try core.benchmark_group.cuda(gpa, io, ctx, g, own.e.stream) else null;
+    errdefer if (own.benchmark_group) |b| gpa.free(b);
+
+    own.lanes = .{ .x = .{ .e = own.e, .link = if (own.link) |*l| l else null } };
+    const sb = own.e.streamBytes();
+    return .{
+        .backend = own.lanes.backend(),
+        .facts = own.lanes.facts(),
+        .rows = engine.prompt_rows,
+        .stream_bytes = sb,
+        .free_streams = 1,
+        .ctx = own,
+        .deinit = close,
+        .peer_room = peer,
+        .follow = if (p.rank > 0) followRank else null,
+        .target = own,
+    };
+}
+
+pub fn followRank(ptr: *anyopaque) anyerror!void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const link = if (own.link) |*l| l else return;
+    return follow.follow(own.e, link);
+}
+
+pub const follow_fn = followRank;
+
+fn roceBytes(text: ?[]const u8) !usize {
+    const v = text orelse return 64 * 1024 * 1024;
+    const n = std.fmt.parseInt(usize, v, 10) catch return error.BadRoceCap;
+    if (n == 0 or n > std.math.maxInt(u32) / 1024) return error.BadRoceCap;
+    return n * 1024;
+}
+
+fn close(ptr: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    cuda.tp_watch.ended();
+    own.lanes.x.end() catch {};
+    own.lanes.deinit();
+    if (own.link) |*l| l.deinit();
+    own.e.deinit();
+    if (own.group) |*g| if (g.fast) |f| f.deinit();
+    if (own.lib) |*lib| {
+        _ = lib.api.ncclCommDestroy(own.comm);
+        lib.close();
+    }
+    if (own.benchmark_group) |b| own.gpa.free(b);
+    own.gpa.destroy(own);
+}
+
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.NoRank => "ERNIE 5.5 Flash Preview runs at TP 1, 2, or 4: launch with --tp 4 --rank 0..3",
+        error.NoCommId => "ERNIE 5.5 TP ranks meet over NCCL: give --master (rank 0's address) or set NCCL_COMM_ID",
+        error.Ernie55RequiresSm121 => "ERNIE 5.5 Flash Preview CUDA kernels require GB10 (sm_121)",
+        error.Ernie55BadTp => "ERNIE 5.5 Flash Preview supports TP 1, 2, or 4",
+        else => null,
+    };
+}
diff --git a/zig/src/families/ernie55/cuda_sampler.zig b/zig/src/families/ernie55/cuda_sampler.zig
new file mode 100644
index 0000000..4f5133c
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_sampler.zig
@@ -0,0 +1,166 @@
+//! TP-aware sampler over sample.cu (BF16 whole-row gather + grammar mask + top-k/top-p/temperature draw).
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const shard = @import("cuda_shard.zig");
+const kernels = @import("cuda_kernels.zig");
+
+pub const Sampling = lanes.Sampling;
+pub const Rule = cuda.sample.Rule;
+
+pub fn check(s: ?Sampling) ?Sampling {
+    const x = s orelse return null;
+    return if (x.temperature > 0) x else null;
+}
+
+pub fn rule(s: Sampling) Rule {
+    return cuda.sample.rule(s);
+}
+
+pub fn greedyRule() Rule {
+    return .{
+        .seed = 0,
+        .inv_t = 0,
+        .top_p = 1,
+        .near = 0,
+        .min_log = -std.math.inf(f32),
+        .top_k = 1,
+    };
+}
+
+pub const Sampler = struct {
+    d: *const cuda.Driver,
+    module: cuda.Module,
+    tf_draw: cuda.Function,
+    tf_grammar_mask: cuda.Function,
+    vocab: usize,
+    max_rows: usize,
+    local_bf16: cuda.DeviceBuffer, // bf16 [max_rows, vocab_width]
+    full: cuda.DeviceBuffer, // bf16 [max_rows, vocab]
+    rule_buf: cuda.DeviceBuffer,
+    meta_buf: cuda.DeviceBuffer,
+    tok_buf: cuda.DeviceBuffer,
+    prob_buf: cuda.DeviceBuffer,
+
+    pub fn init(d: *const cuda.Driver, vocab: usize, vocab_width: usize, max_rows: usize) !Sampler {
+        var m = try cuda.Module.load(d, cuda.kernels.sample);
+        errdefer m.unload();
+        const f = try m.function("tf_draw");
+        const gm = try m.function("tf_grammar_mask");
+        var local_bf16 = try cuda.DeviceBuffer.alloc(d, max_rows * vocab_width * 2);
+        errdefer local_bf16.free();
+        var full = try cuda.DeviceBuffer.alloc(d, max_rows * vocab * 2);
+        errdefer full.free();
+        var rb = try cuda.DeviceBuffer.alloc(d, @sizeOf(Rule));
+        errdefer rb.free();
+        var mb = try cuda.DeviceBuffer.alloc(d, 16);
+        errdefer mb.free();
+        var tb = try cuda.DeviceBuffer.alloc(d, max_rows * 4);
+        errdefer tb.free();
+        const pb = try cuda.DeviceBuffer.alloc(d, max_rows * 4);
+        return .{
+            .d = d,
+            .module = m,
+            .tf_draw = f,
+            .tf_grammar_mask = gm,
+            .vocab = vocab,
+            .max_rows = max_rows,
+            .local_bf16 = local_bf16,
+            .full = full,
+            .rule_buf = rb,
+            .meta_buf = mb,
+            .tok_buf = tb,
+            .prob_buf = pb,
+        };
+    }
+
+    pub fn deinit(s: *Sampler) void {
+        s.prob_buf.free();
+        s.tok_buf.free();
+        s.meta_buf.free();
+        s.rule_buf.free();
+        s.full.free();
+        s.local_bf16.free();
+        s.module.unload();
+    }
+
+    pub fn gatherF32(
+        s: *const Sampler,
+        k: *const kernels.Kernels,
+        stream: cuda.Stream,
+        group: ?*const cuda.tp_group.Group,
+        sh: *const shard.Share,
+        logits_f32: u64,
+        rows: usize,
+    ) !void {
+        const vw = sh.vocab_width;
+        const V = s.vocab;
+        try k.f32ToBf16(stream, logits_f32, s.local_bf16.ptr, rows * vw);
+        for (0..rows) |r| {
+            const dst = s.full.ptr + (r * V + sh.vocab_lo) * 2;
+            const src = s.local_bf16.ptr + r * vw * 2;
+            try s.d.check(s.d.api.cuMemcpyDtoDAsync_v2(dst, src, vw * 2, stream.handle), "cuMemcpyDtoDAsync");
+        }
+        if (group) |g| {
+            if (g.world > 1) {
+                const Spread = struct {
+                    lib: *const cuda.nccl.Library,
+                    comm: cuda.nccl.Comm,
+                    stream: cuda.Stream,
+                    full: u64,
+                    vocab: usize,
+                    vw: usize,
+                    world: usize,
+                    rows: usize,
+
+                    fn post(t: @This()) anyerror!void {
+                        for (0..t.rows) |row| {
+                            for (0..t.world) |q| {
+                                const at = t.full + (row * t.vocab + q * t.vw) * 2;
+                                try t.lib.check(t.lib.api.ncclBroadcast(at, at, t.vw, .bf16, @intCast(q), t.comm, t.stream.handle), "ncclBroadcast");
+                            }
+                        }
+                    }
+                };
+                try g.lib.group(Spread{
+                    .lib = &g.lib,
+                    .comm = g.comm,
+                    .stream = stream,
+                    .full = s.full.ptr,
+                    .vocab = V,
+                    .vw = vw,
+                    .world = g.world,
+                    .rows = rows,
+                }, Spread.post);
+            }
+        }
+    }
+
+    pub fn mask(s: *const Sampler, stream: cuda.Stream, rows: usize, bits: u64, words: usize) !void {
+        var args: cuda.Args = .{};
+        args.add(s.full.ptr);
+        args.add(@as(u32, @intCast(s.vocab)));
+        args.add(bits);
+        args.add(@as(u32, @intCast(words)));
+        try cuda.launch.launch(s.tf_grammar_mask, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &args);
+    }
+
+    pub fn drawFull(s: *Sampler, stream: cuda.Stream, rows: usize, first_pos: u64, r: Rule, out: []u32) !void {
+        std.debug.assert(rows <= s.max_rows and out.len >= rows);
+        try s.rule_buf.uploadAsync(0, std.mem.asBytes(&r), stream.handle);
+        const key_base: i32 = @intCast(if (first_pos > 0) first_pos - 1 else 0);
+        const meta = [4]i32{ key_base, 0, 0, 0 };
+        try s.meta_buf.uploadAsync(0, std.mem.asBytes(&meta), stream.handle);
+        var args: cuda.Args = .{};
+        args.add(s.full.ptr);
+        args.add(@as(u32, @intCast(s.vocab)));
+        args.add(s.rule_buf.ptr);
+        args.add(s.meta_buf.ptr);
+        args.add(@as(i32, 0));
+        args.add(s.tok_buf.ptr);
+        args.add(s.prob_buf.ptr);
+        try cuda.launch.launch(s.tf_draw, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 1024 } }, stream, &args);
+        try stream.synchronize();
+        try s.tok_buf.download(0, std.mem.sliceAsBytes(out[0..rows]));
+    }
+};
diff --git a/zig/src/families/ernie55/cuda_shard.zig b/zig/src/families/ernie55/cuda_shard.zig
new file mode 100644
index 0000000..d204652
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_shard.zig
@@ -0,0 +1,80 @@
+//! TP sharding geometry for ERNIE 5.5 Flash Preview (world = 1, 2, or 4).
+const std = @import("std");
+const cfg = @import("config.zig");
+
+pub const Share = struct {
+    rank: usize,
+    world: usize,
+
+    // Attention heads & groups (HCA & DSA both have 64 heads, HCA has 8 o_groups)
+    head_lo: usize,
+    heads: usize,
+    group_lo: usize,
+    groups: usize,
+    o_lo: usize, // HCA o_lora slice: group_lo * o_lora .. (group_lo + groups) * o_lora
+    o_width: usize,
+    dsa_o_lo: usize, // DSA v slice: head_lo * mla_v_dim .. (head_lo + heads) * mla_v_dim
+    dsa_o_width: usize,
+
+    // Dense layer 0 MLP (intermediate = 14336 -> 3584/rank at TP=4; exact multiple of 128!)
+    dense_lo: usize,
+    dense_width: usize,
+
+    // Shared expert & routed MXFP4 experts (moe_intermediate = 2048 -> 512/rank at TP=4)
+    moe_lo: usize,
+    moe_width: usize,
+
+    // Vocabulary LM head (vocab = 201216 -> 50304/rank at TP=4)
+    vocab_lo: usize,
+    vocab_width: usize,
+
+    pub fn of(c: *const cfg.Config, rank: usize, world: usize) !Share {
+        if (world != 1 and world != 2 and world != 4) return error.UnsupportedErnie55Tp;
+        if (rank >= world) return error.BadRank;
+        if (c.heads % world != 0 or c.o_groups % world != 0 or c.mla_heads % world != 0) return error.BadErnie55Shard;
+        if (c.intermediate % world != 0 or (c.intermediate / world) % 128 != 0) return error.BadErnie55Shard;
+        if (c.moe_intermediate % world != 0 or (c.moe_intermediate / world) % 128 != 0) return error.BadErnie55Shard;
+        if (c.vocab % world != 0) return error.BadErnie55Shard;
+
+        const heads = c.heads / world;
+        const groups = c.o_groups / world;
+        const dense_w = c.intermediate / world;
+        const moe_w = c.moe_intermediate / world;
+        const vocab_w = c.vocab / world;
+
+        return .{
+            .rank = rank,
+            .world = world,
+            .head_lo = rank * heads,
+            .heads = heads,
+            .group_lo = rank * groups,
+            .groups = groups,
+            .o_lo = rank * groups * c.o_lora,
+            .o_width = groups * c.o_lora,
+            .dsa_o_lo = rank * heads * c.mla_v_dim,
+            .dsa_o_width = heads * c.mla_v_dim,
+            .dense_lo = rank * dense_w,
+            .dense_width = dense_w,
+            .moe_lo = rank * moe_w,
+            .moe_width = moe_w,
+            .vocab_lo = rank * vocab_w,
+            .vocab_width = vocab_w,
+        };
+    }
+};
+
+test "TP=4 shard divides every ERNIE 5.5 axis on 128-element FP8 block boundaries" {
+    const c: cfg.Config = .{};
+    for (0..4) |r| {
+        const s = try Share.of(&c, r, 4);
+        try std.testing.expectEqual(@as(usize, 16), s.heads);
+        try std.testing.expectEqual(@as(usize, 2), s.groups);
+        try std.testing.expectEqual(@as(usize, 2048), s.o_width);
+        try std.testing.expectEqual(@as(usize, 4096), s.dsa_o_width);
+        try std.testing.expectEqual(@as(usize, 3584), s.dense_width);
+        try std.testing.expectEqual(@as(usize, 512), s.moe_width);
+        try std.testing.expectEqual(@as(usize, 50304), s.vocab_width);
+        try std.testing.expectEqual(@as(usize, 0), s.dense_lo % 128);
+        try std.testing.expectEqual(@as(usize, 0), s.moe_lo % 128);
+    }
+}
diff --git a/zig/src/families/ernie55/cuda_weights.zig b/zig/src/families/ernie55/cuda_weights.zig
new file mode 100644
index 0000000..3f25aa4
--- /dev/null
+++ b/zig/src/families/ernie55/cuda_weights.zig
@@ -0,0 +1,830 @@
+//! ERNIE 5.5 Flash Preview CUDA weight loader (block-128 FP8 packed for qmmf + bulk MXFP4 routed experts + packed BF16 router/lm_head + optional bundled 3-layer DSpark).
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const cfg = @import("config.zig");
+const shard = @import("cuda_shard.zig");
+const rope = @import("rope.zig");
+
+const Driver = cuda.Driver;
+const DeviceBuffer = cuda.DeviceBuffer;
+const QWeight = cuda.qmmf.Weight;
+
+pub const MhcWeights = struct {
+    fn_w: u64, // F32 [24, 16384]
+    scale: u64, // F32 [3] = {alpha_pre, alpha_post, alpha_res}
+    base: u64, // F32 [24]
+};
+
+pub const HcaWeights = struct {
+    q_down: QWeight, // FP8 [1024, 4096]
+    q_norm: u64, // BF16 [1024]
+    q_up: QWeight, // FP8 [heads * 512, 1024] (TP-sliced by heads)
+    kv_proj: QWeight, // FP8 [512, 4096]
+    kv_norm: u64, // BF16 [512]
+    o_gate: QWeight, // FP8 [groups * 1024, 1024] (TP-sliced by groups)
+    wo_a: [8]QWeight, // FP8 [1024, 4096] per local group (only 0..share.groups used)
+    wo_b: QWeight, // FP8 [4096, groups * 1024] (row-parallel)
+    vha_u: u64, // BF16 [heads, 16]
+    vha_v: u64, // BF16 [heads, 16]
+    attn_sink: u64, // F32 [heads]
+    comp_ape: u64 = 0, // F32 [128, 512]
+    comp_wkv: ?QWeight = null, // BF16 [512, 4096] packed for qmmf
+    comp_wgate: ?QWeight = null, // BF16 [512, 4096] packed for qmmf
+    comp_norm: u64 = 0, // BF16 [512]
+};
+
+pub const DsaWeights = struct {
+    q_a: QWeight, // FP8 [1024, 4096]
+    q_a_norm: u64, // BF16 [1024]
+    q_b: QWeight, // FP8 [heads * 256, 1024]
+    kv_a: QWeight, // FP8 [576, 4096]
+    kv_a_norm: u64, // BF16 [512]
+    wk: u64, // BF16 [heads, 192, 512]
+    wv: u64, // BF16 [heads, 256, 512]
+    o_gate: QWeight, // FP8 [heads * 256, 1024]
+    o_proj: QWeight, // FP8 [4096, heads * 256] (row-parallel)
+    vha_u: u64, // BF16 [heads, 16]
+    vha_v: u64, // BF16 [heads, 16]
+    sinks: u64, // F32 [heads]
+    idx_wq_b: QWeight, // FP8 [8192, 1024]
+    idx_wk: QWeight, // BF16 [128, 4096] packed for qmmf
+    idx_k_norm_w: u64, // BF16 [128]
+    idx_k_norm_b: u64, // BF16 [128]
+    idx_weights_proj: QWeight, // BF16 [64, 4096] packed for qmmf
+};
+
+pub const DenseMlpWeights = struct {
+    gate: QWeight, // FP8 [dense_width, 4096]
+    up: QWeight, // FP8 [dense_width, 4096]
+    down: QWeight, // FP8 [4096, dense_width] (row-parallel)
+};
+
+pub const MoeWeights = struct {
+    gate_packed: QWeight, // BF16 [2 * experts, 4096] packed for qmmf ([w0; w1])
+    bias: u64, // F32 [512]
+    routed_scale: u64, // F32 [512]
+    fc1_latent: QWeight, // FP8 [2048, 4096]
+    latent_norm: u64, // BF16 [2048]
+    fc2_latent: QWeight, // FP8 [4096, 2048]
+    shared_w1: QWeight, // FP8 [moe_width, 4096]
+    shared_w3: QWeight, // FP8 [moe_width, 4096]
+    shared_w2: QWeight, // FP8 [4096, moe_width] (row-parallel)
+    w1_q: u64, // uint8 [512, moe_width, 1024]
+    w1_s: u64, // uint8 [512, moe_width, 64]
+    w3_q: u64, // uint8 [512, moe_width, 1024]
+    w3_s: u64, // uint8 [512, moe_width, 64]
+    w2_q: u64, // uint8 [512, 2048, moe_width / 2]
+    w2_s: u64, // uint8 [512, 2048, moe_width / 32]
+};
+
+pub const LayerWeights = struct {
+    attn_norm: u64, // BF16 [4096]
+    ffn_norm: u64, // BF16 [4096]
+    hc_attn: MhcWeights,
+    hc_ffn: MhcWeights,
+    attn: union(enum) { hca: HcaWeights, dsa: DsaWeights },
+    ffn: union(enum) { dense: DenseMlpWeights, moe: MoeWeights },
+};
+
+pub const DsparkLayerWeights = struct {
+    attn_norm: u64, // BF16 [4096]
+    ffn_norm: u64, // BF16 [4096]
+    hc_attn: MhcWeights,
+    hc_ffn: MhcWeights,
+    hca: HcaWeights,
+    moe: MoeWeights,
+};
+
+pub const DsparkWeights = struct {
+    feature_proj: QWeight, // FP8 [4096, 12288]
+    feature_norm: u64, // BF16 [4096]
+    hc_head_fn: u64, // F32 [4, 16384]
+    hc_head_base: u64, // F32 [4]
+    hc_head_scale: u64, // F32 [1]
+    norm: u64, // BF16 [4096]
+    markov_w1: u64, // BF16 [vocab, 256] (transposed from checkpoint [256, vocab])
+    markov_w2: u64, // BF16 [vocab_width, 256] (vocab-sharded)
+    layers: [3]DsparkLayerWeights,
+};
+
+pub const Weights = struct {
+    gpa: std.mem.Allocator,
+    config: cfg.Config,
+    share: shard.Share,
+    loaded_layers: u32,
+    embed: u64 = 0, // BF16 [vocab, 4096]
+    norm: u64 = 0, // BF16 [4096]
+    hc_head_fn: u64 = 0, // F32 [4, 16384]
+    hc_head_base: u64 = 0, // F32 [4]
+    hc_head_scale: u64 = 0, // F32 [1]
+    lm_head: QWeight = undefined, // BF16 [vocab_width, 4096] packed for qmmf
+    multimax_ranges: u64 = 0, // F32 [4]
+    multimax_ts: u64 = 0, // F32 [4]
+    hca_inv_freq: u64 = 0, // F32 [32]
+    mla_inv_freq: u64 = 0, // F32 [32]
+    layers: []LayerWeights = &.{},
+    dspark: ?DsparkWeights = null,
+    buffers: std.ArrayList(DeviceBuffer) = .empty,
+    bytes: u64 = 0,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.buffers.items) |*b| b.free();
+        w.buffers.deinit(w.gpa);
+        w.gpa.free(w.layers);
+        w.* = undefined;
+    }
+};
+
+pub fn e4m3ToF32(b: u8) f32 {
+    const sign: f32 = if ((b & 0x80) != 0) -1.0 else 1.0;
+    const exp: i32 = @intCast((b >> 3) & 0xF);
+    const mant: f32 = @floatFromInt(b & 0x7);
+    if (exp == 0) {
+        return sign * std.math.scalbn(mant * 0.125, -6);
+    }
+    if (exp == 15 and (b & 0x7) == 7) return std.math.nan(f32);
+    return sign * std.math.scalbn(1.0 + mant * 0.125, exp - 7);
+}
+
+fn bf16ToF32(bits: u16) f32 {
+    return @bitCast(@as(u32, bits) << 16);
+}
+
+fn f32ToBf16(v: f32) u16 {
+    const u: u32 = @bitCast(v);
+    const lsb = (u >> 16) & 1;
+    const rounded = u +% (0x7FFF + lsb);
+    return @truncate(rounded >> 16);
+}
+
+pub const LoadOptions = struct {
+    max_layers: ?u32 = null,
+    load_dspark: bool = false,
+};
+
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const Driver, dir: []const u8, rank: usize, world: usize, opts: LoadOptions) !Weights {
+    const c = try cfg.Config.read(gpa, io, dir);
+    const sh = try shard.Share.of(&c, rank, world);
+    const n_layers: u32 = if (opts.max_layers) |ml| @min(ml, c.layers) else c.layers;
+
+    var ck = try core.Checkpoint.openModel(gpa, io, dir);
+    defer core.checkpoint.cache.close(&ck);
+
+    var w: Weights = .{
+        .gpa = gpa,
+        .config = c,
+        .share = sh,
+        .loaded_layers = n_layers,
+        .layers = try gpa.alloc(LayerWeights, n_layers),
+    };
+    errdefer w.deinit();
+
+    var pstream = try cuda.Stream.init(d, false);
+    defer pstream.deinit();
+    var packer = try cuda.modelopt.Packer.load(d);
+    defer packer.unload();
+    var L: Loader = .{ .gpa = gpa, .d = d, .s = pstream, .packer = &packer, .w = &w, .ck = &ck };
+    defer L.deinit();
+
+    const hf = rope.hcaInvFreq(&c);
+    const mf = rope.mlaInvFreq(&c);
+    w.hca_inv_freq = try L.put(std.mem.sliceAsBytes(&hf));
+    w.mla_inv_freq = try L.put(std.mem.sliceAsBytes(&mf));
+
+    w.embed = try L.putRaw("model.embed_tokens.weight");
+    w.norm = try L.putRaw("model.norm.weight");
+    w.hc_head_fn = try L.putTransposedF32("model.mhc_contract.hc_head_fn", c.hcDim(), c.hc_mult);
+    w.hc_head_base = try L.putRaw("model.mhc_contract.hc_head_base");
+    w.hc_head_scale = try L.putRaw("model.mhc_contract.hc_head_scale");
+    w.lm_head = try L.loadBf16Lane("lm_head.weight", sh.vocab_lo, sh.vocab_width, c.hidden);
+    w.multimax_ranges = try L.putBf16AsF32("model.lm_head.multimax_ranges", 0, 4);
+    w.multimax_ts = try L.putBf16AsF32("model.lm_head.multimax_ts", 0, 4);
+
+    for (0..n_layers) |li| {
+        const l: u32 = @intCast(li);
+        w.layers[li] = try L.loadLayer(l);
+        if (rank == 0 and (li == 0 or li == 1 or li == 7 or li + 1 == n_layers or (li + 1) % 10 == 0)) {
+            std.log.info("[ernie55] loaded layer {d}/{d} ({d:.2} GiB)", .{ li + 1, n_layers, @as(f64, @floatFromInt(w.bytes)) / (1024.0 * 1024.0 * 1024.0) });
+        }
+    }
+
+    if (opts.load_dspark) {
+        w.dspark = try L.loadDspark();
+        if (rank == 0) {
+            std.log.info("[ernie55] loaded bundled 3-layer DSpark (total {d:.2} GiB)", .{@as(f64, @floatFromInt(w.bytes)) / (1024.0 * 1024.0 * 1024.0)});
+        }
+    }
+
+    return w;
+}
+
+const Loader = struct {
+    gpa: std.mem.Allocator,
+    d: *const Driver,
+    s: cuda.Stream,
+    packer: *const cuda.modelopt.Packer,
+    w: *Weights,
+    ck: *core.Checkpoint,
+    nbuf: [256]u8 = undefined,
+    nbuf2: [256]u8 = undefined,
+    fp8_raw_scratch: []u8 = &.{},
+    fp8_pack_scratch: []u8 = &.{},
+    fp8_scale_scratch: []f32 = &.{},
+    // Reusable bulk staging buffers for 512 MXFP4 experts per layer
+    moe_w1_q: []u8 = &.{},
+    moe_w1_s: []u8 = &.{},
+    moe_w3_q: []u8 = &.{},
+    moe_w3_s: []u8 = &.{},
+    moe_w2_q: []u8 = &.{},
+    moe_w2_s: []u8 = &.{},
+
+    fn deinit(L: *Loader) void {
+        if (L.fp8_raw_scratch.len > 0) L.gpa.free(L.fp8_raw_scratch);
+        if (L.fp8_pack_scratch.len > 0) L.gpa.free(L.fp8_pack_scratch);
+        if (L.fp8_scale_scratch.len > 0) L.gpa.free(L.fp8_scale_scratch);
+        if (L.moe_w1_q.len > 0) L.gpa.free(L.moe_w1_q);
+        if (L.moe_w1_s.len > 0) L.gpa.free(L.moe_w1_s);
+        if (L.moe_w3_q.len > 0) L.gpa.free(L.moe_w3_q);
+        if (L.moe_w3_s.len > 0) L.gpa.free(L.moe_w3_s);
+        if (L.moe_w2_q.len > 0) L.gpa.free(L.moe_w2_q);
+        if (L.moe_w2_s.len > 0) L.gpa.free(L.moe_w2_s);
+    }
+
+    fn fmt1(L: *Loader, comptime fmt: []const u8, args: anytype) ![]const u8 {
+        return std.fmt.bufPrint(&L.nbuf, fmt, args);
+    }
+
+    fn fmt2(L: *Loader, comptime fmt: []const u8, args: anytype) ![]const u8 {
+        return std.fmt.bufPrint(&L.nbuf2, fmt, args);
+    }
+
+    fn put(L: *Loader, bytes: []const u8) !u64 {
+        const b = try DeviceBuffer.fromHost(L.d, bytes);
+        errdefer {
+            var owned = b;
+            owned.free();
+        }
+        try L.w.buffers.append(L.gpa, b);
+        L.w.bytes += b.len;
+        return b.ptr;
+    }
+
+    fn allocDev(L: *Loader, len: usize) !DeviceBuffer {
+        const b = try DeviceBuffer.alloc(L.d, len);
+        errdefer {
+            var owned = b;
+            owned.free();
+        }
+        try L.w.buffers.append(L.gpa, b);
+        L.w.bytes += b.len;
+        return b;
+    }
+
+    fn putRaw(L: *Loader, name: []const u8) !u64 {
+        const t = try L.ck.get(name);
+        return L.put(t.bytes);
+    }
+
+    fn loadBf16Lane(L: *Loader, name: []const u8, row0: usize, n_rows: usize, cols: usize) !QWeight {
+        const t = try L.ck.get(name);
+        const row_bytes = cols * 2;
+        const src_bytes = t.bytes[row0 * row_bytes .. (row0 + n_rows) * row_bytes];
+        var tmp = try DeviceBuffer.fromHost(L.d, src_bytes);
+        defer tmp.free();
+        const npad = cuda.modelopt.padded(n_rows);
+        const dst = try L.allocDev(npad * cols * 2);
+        try L.packer.bf16Lane(L.s, tmp.ptr, dst.ptr, n_rows, cols);
+        try L.s.synchronize();
+        return cuda.modelopt.bf16Weight(dst.ptr, n_rows, cols);
+    }
+
+    fn loadBf16LanePair(L: *Loader, name0: []const u8, name1: []const u8, rows_each: usize, cols: usize) !QWeight {
+        const t0 = try L.ck.get(name0);
+        const t1 = try L.ck.get(name1);
+        const part_bytes = rows_each * cols * 2;
+        var tmp = try DeviceBuffer.alloc(L.d, 2 * part_bytes);
+        defer tmp.free();
+        try tmp.upload(0, t0.bytes[0..part_bytes]);
+        try tmp.upload(part_bytes, t1.bytes[0..part_bytes]);
+        const n_rows = 2 * rows_each;
+        const npad = cuda.modelopt.padded(n_rows);
+        const dst = try L.allocDev(npad * cols * 2);
+        try L.packer.bf16Lane(L.s, tmp.ptr, dst.ptr, n_rows, cols);
+        try L.s.synchronize();
+        return cuda.modelopt.bf16Weight(dst.ptr, n_rows, cols);
+    }
+
+    fn putRowSliceBf16(L: *Loader, name: []const u8, row0: usize, n_rows: usize, cols: usize) !u64 {
+        const t = try L.ck.get(name);
+        const row_bytes = cols * 2;
+        return L.put(t.bytes[row0 * row_bytes .. (row0 + n_rows) * row_bytes]);
+    }
+
+    fn putRowSliceF32(L: *Loader, name: []const u8, row0: usize, n_rows: usize, cols: usize) !u64 {
+        const t = try L.ck.get(name);
+        const row_bytes = cols * 4;
+        return L.put(t.bytes[row0 * row_bytes .. (row0 + n_rows) * row_bytes]);
+    }
+
+    fn putBf16AsF32(L: *Loader, name: []const u8, lo: usize, count: usize) !u64 {
+        const t = try L.ck.get(name);
+        const src = std.mem.bytesAsSlice(u16, t.bytes);
+        const tmp = try L.gpa.alloc(f32, count);
+        defer L.gpa.free(tmp);
+        for (0..count) |i| tmp[i] = bf16ToF32(src[lo + i]);
+        return L.put(std.mem.sliceAsBytes(tmp));
+    }
+
+    fn putTransposedF32(L: *Loader, name: []const u8, in_rows: usize, in_cols: usize) !u64 {
+        const t = try L.ck.get(name);
+        const src = std.mem.bytesAsSlice(f32, t.bytes);
+        const dst = try L.gpa.alloc(f32, in_rows * in_cols);
+        defer L.gpa.free(dst);
+        for (0..in_rows) |r| {
+            for (0..in_cols) |c| {
+                dst[c * in_rows + r] = src[r * in_cols + c];
+            }
+        }
+        return L.put(std.mem.sliceAsBytes(dst));
+    }
+
+    fn putTransposedBf16(L: *Loader, name: []const u8, in_rows: usize, in_cols: usize) !u64 {
+        const t = try L.ck.get(name);
+        const src = std.mem.bytesAsSlice(u16, t.bytes);
+        const dst = try L.gpa.alloc(u16, in_rows * in_cols);
+        defer L.gpa.free(dst);
+        for (0..in_rows) |r| {
+            for (0..in_cols) |c| {
+                dst[c * in_rows + r] = src[r * in_cols + c];
+            }
+        }
+        return L.put(std.mem.sliceAsBytes(dst));
+    }
+
+    fn ensureScratch(L: *Loader, raw_n: usize, pack_n: usize, scale_n: usize) !void {
+        if (L.fp8_raw_scratch.len < raw_n) {
+            if (L.fp8_raw_scratch.len > 0) L.gpa.free(L.fp8_raw_scratch);
+            L.fp8_raw_scratch = try L.gpa.alloc(u8, raw_n);
+        }
+        if (L.fp8_pack_scratch.len < pack_n) {
+            if (L.fp8_pack_scratch.len > 0) L.gpa.free(L.fp8_pack_scratch);
+            L.fp8_pack_scratch = try L.gpa.alloc(u8, pack_n);
+        }
+        if (L.fp8_scale_scratch.len < scale_n) {
+            if (L.fp8_scale_scratch.len > 0) L.gpa.free(L.fp8_scale_scratch);
+            L.fp8_scale_scratch = try L.gpa.alloc(f32, scale_n);
+        }
+    }
+
+    fn loadFp8Slice(L: *Loader, w_name: []const u8, s_name: []const u8, row0: usize, n: usize, k0: usize, k: usize) !QWeight {
+        const wt = try L.ck.get(w_name);
+        const st = try L.ck.get(s_name);
+        const full_rows = wt.shape[0];
+        const full_cols = wt.shape[1];
+        const npad = cuda.fp8.padded(n);
+        const kg = k / cuda.fp8.group;
+        try L.ensureScratch(n * k, npad * k, npad * kg);
+
+        const raw_slice: []const u8 = if (k0 == 0 and k == full_cols)
+            wt.bytes[row0 * full_cols .. (row0 + n) * full_cols]
+        else blk: {
+            const dst = L.fp8_raw_scratch[0 .. n * k];
+            for (0..n) |r| {
+                const s_off = (row0 + r) * full_cols + k0;
+                @memcpy(dst[r * k .. (r + 1) * k], wt.bytes[s_off .. s_off + k]);
+            }
+            break :blk dst;
+        };
+
+        const packed_codes = L.fp8_pack_scratch[0 .. npad * k];
+        const packed_scales = L.fp8_scale_scratch[0 .. npad * kg];
+        cuda.fp8.packCodes(packed_codes, raw_slice, n, k);
+        const scale_inv = try L.gpa.alloc(f32, st.bytes.len / 4);
+        defer L.gpa.free(scale_inv);
+        @memcpy(std.mem.sliceAsBytes(scale_inv), st.bytes);
+        cuda.fp8.packScalesAt(packed_scales, scale_inv, full_rows, full_cols, row0, k0, n, k);
+
+        const d_codes = try L.put(packed_codes);
+        const d_scales = try L.put(std.mem.sliceAsBytes(packed_scales));
+        return cuda.fp8.weight(d_codes, d_scales, n, k);
+    }
+
+    fn loadMhcPrefix(L: *Loader, prefix: []const u8, comptime kind: []const u8) !MhcWeights {
+        const c = &L.w.config;
+        const fn_w = try L.putTransposedF32(try L.fmt1("{s}.{s}_hyper_connection.mapping_proj.weight", .{ prefix, kind }), c.hcDim(), c.hcMixOut());
+        const base = try L.putRaw(try L.fmt1("{s}.{s}_hyper_connection.bias", .{ prefix, kind }));
+
+        var sc: [3]f32 = undefined;
+        const pre_t = try L.ck.get(try L.fmt1("{s}.{s}_hyper_connection.alpha_pre", .{ prefix, kind }));
+        const post_t = try L.ck.get(try L.fmt1("{s}.{s}_hyper_connection.alpha_post", .{ prefix, kind }));
+        const res_t = try L.ck.get(try L.fmt1("{s}.{s}_hyper_connection.alpha_res", .{ prefix, kind }));
+        sc[0] = std.mem.bytesAsSlice(f32, pre_t.bytes)[0];
+        sc[1] = std.mem.bytesAsSlice(f32, post_t.bytes)[0];
+        sc[2] = std.mem.bytesAsSlice(f32, res_t.bytes)[0];
+        const scale = try L.put(std.mem.sliceAsBytes(&sc));
+
+        return .{ .fn_w = fn_w, .scale = scale, .base = base };
+    }
+
+    fn loadHcaPrefix(L: *Loader, prefix: []const u8, with_comp: bool) !HcaWeights {
+        const c = &L.w.config;
+        const sh = &L.w.share;
+
+        const q_down = try L.loadFp8Slice(
+            try L.fmt1("{s}.self_attn.linear_q_down_proj.weight", .{prefix}),
+            try L.fmt2("{s}.self_attn.linear_q_down_proj.weight_scale_inv", .{prefix}),
+            0, c.q_lora, 0, c.hidden,
+        );
+        const q_norm = try L.putRaw(try L.fmt1("{s}.self_attn.q_layernorm.weight", .{prefix}));
+        const q_up = try L.loadFp8Slice(
+            try L.fmt1("{s}.self_attn.linear_q_up_proj.weight", .{prefix}),
+            try L.fmt2("{s}.self_attn.linear_q_up_proj.weight_scale_inv", .{prefix}),
+            sh.head_lo * c.head_dim, sh.heads * c.head_dim, 0, c.q_lora,
+        );
+        const kv_proj = try L.loadFp8Slice(
+            try L.fmt1("{s}.self_attn.linear_kv_proj.weight", .{prefix}),
+            try L.fmt2("{s}.self_attn.linear_kv_proj.weight_scale_inv", .{prefix}),
+            0, c.head_dim, 0, c.hidden,
+        );
+        const kv_norm = try L.putRaw(try L.fmt1("{s}.self_attn.kv_layernorm.weight", .{prefix}));
+        const o_gate = try L.loadFp8Slice(
+            try L.fmt1("{s}.self_attn.gate_proj.weight", .{prefix}),
+            try L.fmt2("{s}.self_attn.gate_proj.weight_scale_inv", .{prefix}),
+            sh.o_lo, sh.o_width, 0, c.q_lora,
+        );
+
+        var wo_a: [8]QWeight = undefined;
+        const group_k = (c.heads / c.o_groups) * c.head_dim;
+        for (0..sh.groups) |g| {
+            const global_g = sh.group_lo + g;
+            wo_a[g] = try L.loadFp8Slice(
+                try L.fmt1("{s}.self_attn.linear_o_group_proj", .{prefix}),
+                try L.fmt2("{s}.self_attn.linear_o_group_proj_scale_inv", .{prefix}),
+                global_g * c.o_lora, c.o_lora, 0, group_k,
+            );
+        }
+
+        const wo_b = try L.loadFp8Slice(
+            try L.fmt1("{s}.self_attn.o_proj.weight", .{prefix}),
+            try L.fmt2("{s}.self_attn.o_proj.weight_scale_inv", .{prefix}),
+            0, c.hidden, sh.o_lo, sh.o_width,
+        );
+        const vha_u = try L.putRowSliceBf16(try L.fmt1("{s}.self_attn.vha_postmix_U", .{prefix}), sh.head_lo, sh.heads, c.vha_rank);
+        const vha_v = try L.putRowSliceBf16(try L.fmt1("{s}.self_attn.vha_postmix_V", .{prefix}), sh.head_lo, sh.heads, c.vha_rank);
+        const attn_sink = try L.putRowSliceF32(try L.fmt1("{s}.self_attn.core_attention.attn_sink", .{prefix}), sh.head_lo, sh.heads, 1);
+
+        var hca: HcaWeights = .{
+            .q_down = q_down,
+            .q_norm = q_norm,
+            .q_up = q_up,
+            .kv_proj = kv_proj,
+            .kv_norm = kv_norm,
+            .o_gate = o_gate,
+            .wo_a = wo_a,
+            .wo_b = wo_b,
+            .vha_u = vha_u,
+            .vha_v = vha_v,
+            .attn_sink = attn_sink,
+        };
+        if (with_comp) {
+            hca.comp_ape = try L.putRaw(try L.fmt1("{s}.self_attn.core_attention.compressor.ape", .{prefix}));
+            hca.comp_wkv = try L.loadBf16Lane(try L.fmt1("{s}.self_attn.core_attention.compressor.linear_wkv.weight", .{prefix}), 0, c.head_dim, c.hidden);
+            hca.comp_wgate = try L.loadBf16Lane(try L.fmt1("{s}.self_attn.core_attention.compressor.linear_wgate.weight", .{prefix}), 0, c.head_dim, c.hidden);
+            hca.comp_norm = try L.putRaw(try L.fmt1("{s}.self_attn.core_attention.compressor.norm.weight", .{prefix}));
+        }
+        return hca;
+    }
+
+    fn loadDsa(L: *Loader, l: u32) !DsaWeights {
+        const c = &L.w.config;
+        const sh = &L.w.share;
+
+        const q_a = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.self_attn.q_a_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.self_attn.q_a_proj.weight_scale_inv", .{l}),
+            0, c.mla_q_lora, 0, c.hidden,
+        );
+        const q_a_norm = try L.putRaw(try L.fmt1("model.layers.{d}.self_attn.q_a_layernorm.weight", .{l}));
+        const q_head = c.mla_qk_nope + c.mla_qk_rope;
+        const q_b = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.self_attn.q_b_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.self_attn.q_b_proj.weight_scale_inv", .{l}),
+            sh.head_lo * q_head, sh.heads * q_head, 0, c.mla_q_lora,
+        );
+        const kv_a = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.self_attn.kv_a_proj_with_mqa.weight", .{l}),
+            try L.fmt2("model.layers.{d}.self_attn.kv_a_proj_with_mqa.weight_scale_inv", .{l}),
+            0, c.mla_kv_lora + c.mla_qk_rope, 0, c.hidden,
+        );
+        const kv_a_norm = try L.putRaw(try L.fmt1("model.layers.{d}.self_attn.kv_a_layernorm.weight", .{l}));
+
+        const kvb_w = try L.ck.get(try L.fmt1("model.layers.{d}.self_attn.kv_b_proj.weight", .{l}));
+        const kvb_s = try L.ck.get(try L.fmt2("model.layers.{d}.self_attn.kv_b_proj.weight_scale_inv", .{l}));
+        const kvb_scales = std.mem.bytesAsSlice(f32, kvb_s.bytes);
+        const kvb_kb = (c.mla_kv_lora + 127) / 128;
+        const head_stride = c.mla_qk_nope + c.mla_v_dim;
+        const wk_host = try L.gpa.alloc(u16, sh.heads * c.mla_qk_nope * c.mla_kv_lora);
+        defer L.gpa.free(wk_host);
+        const wv_host = try L.gpa.alloc(u16, sh.heads * c.mla_v_dim * c.mla_kv_lora);
+        defer L.gpa.free(wv_host);
+        for (0..sh.heads) |lh| {
+            const gh = sh.head_lo + lh;
+            const row_base = gh * head_stride;
+            for (0..c.mla_qk_nope) |d| {
+                const gr = row_base + d;
+                const sr = gr / 128;
+                for (0..c.mla_kv_lora) |col| {
+                    const qv = kvb_w.bytes[gr * c.mla_kv_lora + col];
+                    const sc = kvb_scales[sr * kvb_kb + col / 128];
+                    wk_host[(lh * c.mla_qk_nope + d) * c.mla_kv_lora + col] = f32ToBf16(e4m3ToF32(qv) * sc);
+                }
+            }
+            for (0..c.mla_v_dim) |d| {
+                const gr = row_base + c.mla_qk_nope + d;
+                const sr = gr / 128;
+                for (0..c.mla_kv_lora) |col| {
+                    const qv = kvb_w.bytes[gr * c.mla_kv_lora + col];
+                    const sc = kvb_scales[sr * kvb_kb + col / 128];
+                    wv_host[(lh * c.mla_v_dim + d) * c.mla_kv_lora + col] = f32ToBf16(e4m3ToF32(qv) * sc);
+                }
+            }
+        }
+        const wk = try L.put(std.mem.sliceAsBytes(wk_host));
+        const wv = try L.put(std.mem.sliceAsBytes(wv_host));
+
+        const o_gate = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.self_attn.gate_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.self_attn.gate_proj.weight_scale_inv", .{l}),
+            sh.dsa_o_lo, sh.dsa_o_width, 0, c.mla_q_lora,
+        );
+        const o_proj = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.self_attn.o_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.self_attn.o_proj.weight_scale_inv", .{l}),
+            0, c.hidden, sh.dsa_o_lo, sh.dsa_o_width,
+        );
+        const vha_u = try L.putRowSliceBf16(try L.fmt1("model.layers.{d}.self_attn.vha_postmix_U", .{l}), sh.head_lo, sh.heads, c.vha_rank);
+        const vha_v = try L.putRowSliceBf16(try L.fmt1("model.layers.{d}.self_attn.vha_postmix_V", .{l}), sh.head_lo, sh.heads, c.vha_rank);
+        const sinks = try L.putBf16AsF32(try L.fmt1("model.layers.{d}.self_attn.core_attention.softmax_offset", .{l}), sh.head_lo, sh.heads);
+
+        const idx_wq_b = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.self_attn.core_attention.indexer.wq_b.weight", .{l}),
+            try L.fmt2("model.layers.{d}.self_attn.core_attention.indexer.wq_b.weight_scale_inv", .{l}),
+            0, c.index_heads * c.index_dim, 0, c.mla_q_lora,
+        );
+        const idx_wk = try L.loadBf16Lane(try L.fmt1("model.layers.{d}.self_attn.core_attention.indexer.wk.weight", .{l}), 0, c.index_dim, c.hidden);
+        const idx_k_norm_w = try L.putRaw(try L.fmt1("model.layers.{d}.self_attn.core_attention.indexer.k_norm.weight", .{l}));
+        const idx_k_norm_b = try L.putRaw(try L.fmt1("model.layers.{d}.self_attn.core_attention.indexer.k_norm.bias", .{l}));
+        const idx_weights_proj = try L.loadBf16Lane(try L.fmt1("model.layers.{d}.self_attn.core_attention.indexer.weights_proj.weight", .{l}), 0, c.index_heads, c.hidden);
+
+        return .{
+            .q_a = q_a,
+            .q_a_norm = q_a_norm,
+            .q_b = q_b,
+            .kv_a = kv_a,
+            .kv_a_norm = kv_a_norm,
+            .wk = wk,
+            .wv = wv,
+            .o_gate = o_gate,
+            .o_proj = o_proj,
+            .vha_u = vha_u,
+            .vha_v = vha_v,
+            .sinks = sinks,
+            .idx_wq_b = idx_wq_b,
+            .idx_wk = idx_wk,
+            .idx_k_norm_w = idx_k_norm_w,
+            .idx_k_norm_b = idx_k_norm_b,
+            .idx_weights_proj = idx_weights_proj,
+        };
+    }
+
+    fn loadDenseMlp(L: *Loader, l: u32) !DenseMlpWeights {
+        const c = &L.w.config;
+        const sh = &L.w.share;
+        const gate = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.mlp.gate_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.mlp.gate_proj.weight_scale_inv", .{l}),
+            sh.dense_lo, sh.dense_width, 0, c.hidden,
+        );
+        const up = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.mlp.up_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.mlp.up_proj.weight_scale_inv", .{l}),
+            sh.dense_lo, sh.dense_width, 0, c.hidden,
+        );
+        const down = try L.loadFp8Slice(
+            try L.fmt1("model.layers.{d}.mlp.down_proj.weight", .{l}),
+            try L.fmt2("model.layers.{d}.mlp.down_proj.weight_scale_inv", .{l}),
+            0, c.hidden, sh.dense_lo, sh.dense_width,
+        );
+        return .{ .gate = gate, .up = up, .down = down };
+    }
+
+    fn ensureMoeStage(L: *Loader, w13_q_all: usize, w13_s_all: usize, w2_q_all: usize, w2_s_all: usize) !void {
+        if (L.moe_w1_q.len < w13_q_all) {
+            if (L.moe_w1_q.len > 0) L.gpa.free(L.moe_w1_q);
+            L.moe_w1_q = try L.gpa.alloc(u8, w13_q_all);
+        }
+        if (L.moe_w1_s.len < w13_s_all) {
+            if (L.moe_w1_s.len > 0) L.gpa.free(L.moe_w1_s);
+            L.moe_w1_s = try L.gpa.alloc(u8, w13_s_all);
+        }
+        if (L.moe_w3_q.len < w13_q_all) {
+            if (L.moe_w3_q.len > 0) L.gpa.free(L.moe_w3_q);
+            L.moe_w3_q = try L.gpa.alloc(u8, w13_q_all);
+        }
+        if (L.moe_w3_s.len < w13_s_all) {
+            if (L.moe_w3_s.len > 0) L.gpa.free(L.moe_w3_s);
+            L.moe_w3_s = try L.gpa.alloc(u8, w13_s_all);
+        }
+        if (L.moe_w2_q.len < w2_q_all) {
+            if (L.moe_w2_q.len > 0) L.gpa.free(L.moe_w2_q);
+            L.moe_w2_q = try L.gpa.alloc(u8, w2_q_all);
+        }
+        if (L.moe_w2_s.len < w2_s_all) {
+            if (L.moe_w2_s.len > 0) L.gpa.free(L.moe_w2_s);
+            L.moe_w2_s = try L.gpa.alloc(u8, w2_s_all);
+        }
+    }
+
+    fn loadMoePrefix(L: *Loader, prefix: []const u8) !MoeWeights {
+        const c = &L.w.config;
+        const sh = &L.w.share;
+
+        const gate_packed = try L.loadBf16LanePair(
+            try L.fmt1("{s}.block_sparse_moe.gate.weight", .{prefix}),
+            try L.fmt2("{s}.block_sparse_moe.gate.weight_1", .{prefix}),
+            c.experts,
+            c.hidden,
+        );
+        const bias = try L.putRaw(try L.fmt1("{s}.block_sparse_moe.e_score_correction_bias", .{prefix}));
+        const routed_scale = try L.putRaw(try L.fmt1("{s}.block_sparse_moe.gate.routed_scaling_factor_param", .{prefix}));
+
+        const fc1 = try L.loadFp8Slice(
+            try L.fmt1("{s}.block_sparse_moe.fc1_latent_proj.weight", .{prefix}),
+            try L.fmt2("{s}.block_sparse_moe.fc1_latent_proj.weight_scale_inv", .{prefix}),
+            0, c.moe_latent, 0, c.hidden,
+        );
+        const latent_norm = try L.putRaw(try L.fmt1("{s}.block_sparse_moe.latent_norm.weight", .{prefix}));
+        const fc2 = try L.loadFp8Slice(
+            try L.fmt1("{s}.block_sparse_moe.fc2_latent_proj.weight", .{prefix}),
+            try L.fmt2("{s}.block_sparse_moe.fc2_latent_proj.weight_scale_inv", .{prefix}),
+            0, c.hidden, 0, c.moe_latent,
+        );
+        const shared_w1 = try L.loadFp8Slice(
+            try L.fmt1("{s}.block_sparse_moe.shared_experts.w1.weight", .{prefix}),
+            try L.fmt2("{s}.block_sparse_moe.shared_experts.w1.weight_scale_inv", .{prefix}),
+            sh.moe_lo, sh.moe_width, 0, c.hidden,
+        );
+        const shared_w3 = try L.loadFp8Slice(
+            try L.fmt1("{s}.block_sparse_moe.shared_experts.w3.weight", .{prefix}),
+            try L.fmt2("{s}.block_sparse_moe.shared_experts.w3.weight_scale_inv", .{prefix}),
+            sh.moe_lo, sh.moe_width, 0, c.hidden,
+        );
+        const shared_w2 = try L.loadFp8Slice(
+            try L.fmt1("{s}.block_sparse_moe.shared_experts.w2.weight", .{prefix}),
+            try L.fmt2("{s}.block_sparse_moe.shared_experts.w2.weight_scale_inv", .{prefix}),
+            0, c.hidden, sh.moe_lo, sh.moe_width,
+        );
+
+        const E = c.experts;
+        const w13_q_row = c.moe_latent / 2;
+        const w13_s_row = c.moe_latent / 32;
+        const w13_q_exp = sh.moe_width * w13_q_row;
+        const w13_s_exp = sh.moe_width * w13_s_row;
+
+        const w2_q_full_row = c.moe_intermediate / 2;
+        const w2_s_full_row = c.moe_intermediate / 32;
+        const w2_q_loc_row = sh.moe_width / 2;
+        const w2_s_loc_row = sh.moe_width / 32;
+        const w2_q_exp = c.moe_latent * w2_q_loc_row;
+        const w2_s_exp = c.moe_latent * w2_s_loc_row;
+
+        try L.ensureMoeStage(E * w13_q_exp, E * w13_s_exp, E * w2_q_exp, E * w2_s_exp);
+
+        // Stage all 512 experts on host, then 6 bulk H2D transfers (vs 3,072 individual uploads).
+        for (0..E) |e| {
+            const w1q_t = try L.ck.get(try L.fmt1("{s}.block_sparse_moe.experts.{d}.w1.weight", .{ prefix, e }));
+            const w1s_t = try L.ck.get(try L.fmt1("{s}.block_sparse_moe.experts.{d}.w1.weight_scale_inv", .{ prefix, e }));
+            @memcpy(L.moe_w1_q[e * w13_q_exp .. (e + 1) * w13_q_exp], w1q_t.bytes[sh.moe_lo * w13_q_row .. (sh.moe_lo + sh.moe_width) * w13_q_row]);
+            @memcpy(L.moe_w1_s[e * w13_s_exp .. (e + 1) * w13_s_exp], w1s_t.bytes[sh.moe_lo * w13_s_row .. (sh.moe_lo + sh.moe_width) * w13_s_row]);
+
+            const w3q_t = try L.ck.get(try L.fmt1("{s}.block_sparse_moe.experts.{d}.w3.weight", .{ prefix, e }));
+            const w3s_t = try L.ck.get(try L.fmt1("{s}.block_sparse_moe.experts.{d}.w3.weight_scale_inv", .{ prefix, e }));
+            @memcpy(L.moe_w3_q[e * w13_q_exp .. (e + 1) * w13_q_exp], w3q_t.bytes[sh.moe_lo * w13_q_row .. (sh.moe_lo + sh.moe_width) * w13_q_row]);
+            @memcpy(L.moe_w3_s[e * w13_s_exp .. (e + 1) * w13_s_exp], w3s_t.bytes[sh.moe_lo * w13_s_row .. (sh.moe_lo + sh.moe_width) * w13_s_row]);
+
+            const w2q_t = try L.ck.get(try L.fmt1("{s}.block_sparse_moe.experts.{d}.w2.weight", .{ prefix, e }));
+            const w2s_t = try L.ck.get(try L.fmt1("{s}.block_sparse_moe.experts.{d}.w2.weight_scale_inv", .{ prefix, e }));
+            if (sh.world == 1) {
+                @memcpy(L.moe_w2_q[e * w2_q_exp .. (e + 1) * w2_q_exp], w2q_t.bytes[0..w2_q_exp]);
+                @memcpy(L.moe_w2_s[e * w2_s_exp .. (e + 1) * w2_s_exp], w2s_t.bytes[0..w2_s_exp]);
+            } else {
+                const q_col0 = sh.moe_lo / 2;
+                const s_col0 = sh.moe_lo / 32;
+                const q_dst = L.moe_w2_q[e * w2_q_exp .. (e + 1) * w2_q_exp];
+                const s_dst = L.moe_w2_s[e * w2_s_exp .. (e + 1) * w2_s_exp];
+                for (0..c.moe_latent) |row| {
+                    const qs = row * w2_q_full_row + q_col0;
+                    @memcpy(q_dst[row * w2_q_loc_row .. (row + 1) * w2_q_loc_row], w2q_t.bytes[qs .. qs + w2_q_loc_row]);
+                    const ss = row * w2_s_full_row + s_col0;
+                    @memcpy(s_dst[row * w2_s_loc_row .. (row + 1) * w2_s_loc_row], w2s_t.bytes[ss .. ss + w2_s_loc_row]);
+                }
+            }
+        }
+
+        const w1_q = try L.put(L.moe_w1_q[0 .. E * w13_q_exp]);
+        const w1_s = try L.put(L.moe_w1_s[0 .. E * w13_s_exp]);
+        const w3_q = try L.put(L.moe_w3_q[0 .. E * w13_q_exp]);
+        const w3_s = try L.put(L.moe_w3_s[0 .. E * w13_s_exp]);
+        const w2_q = try L.put(L.moe_w2_q[0 .. E * w2_q_exp]);
+        const w2_s = try L.put(L.moe_w2_s[0 .. E * w2_s_exp]);
+
+        return .{
+            .gate_packed = gate_packed,
+            .bias = bias,
+            .routed_scale = routed_scale,
+            .fc1_latent = fc1,
+            .latent_norm = latent_norm,
+            .fc2_latent = fc2,
+            .shared_w1 = shared_w1,
+            .shared_w3 = shared_w3,
+            .shared_w2 = shared_w2,
+            .w1_q = w1_q,
+            .w1_s = w1_s,
+            .w3_q = w3_q,
+            .w3_s = w3_s,
+            .w2_q = w2_q,
+            .w2_s = w2_s,
+        };
+    }
+
+    fn loadLayer(L: *Loader, l: u32) !LayerWeights {
+        const c = &L.w.config;
+        var pbuf: [64]u8 = undefined;
+        const prefix = try std.fmt.bufPrint(&pbuf, "model.layers.{d}", .{l});
+        const attn_norm = try L.putRaw(try L.fmt1("{s}.input_layernorm.weight", .{prefix}));
+        const ffn_norm = try L.putRaw(try L.fmt1("{s}.post_attention_layernorm.weight", .{prefix}));
+        const hc_attn = try L.loadMhcPrefix(prefix, "self_attention");
+        const hc_ffn = try L.loadMhcPrefix(prefix, "mlp");
+
+        return .{
+            .attn_norm = attn_norm,
+            .ffn_norm = ffn_norm,
+            .hc_attn = hc_attn,
+            .hc_ffn = hc_ffn,
+            .attn = if (c.isDsa(l)) .{ .dsa = try L.loadDsa(l) } else .{ .hca = try L.loadHcaPrefix(prefix, true) },
+            .ffn = if (c.isMoe(l)) .{ .moe = try L.loadMoePrefix(prefix) } else .{ .dense = try L.loadDenseMlp(l) },
+        };
+    }
+
+    fn loadDspark(L: *Loader) !DsparkWeights {
+        const c = &L.w.config;
+        const sh = &L.w.share;
+
+        const feature_proj = try L.loadFp8Slice(
+            "model.mtp.feature_projection.weight",
+            "model.mtp.feature_projection.weight_scale_inv",
+            0, c.hidden, 0, 3 * c.hidden,
+        );
+        const feature_norm = try L.putRaw("model.mtp.feature_norm.weight");
+        const hc_head_fn = try L.putTransposedF32("model.mtp.mhc_contract.hc_head_fn", c.hcDim(), c.hc_mult);
+        const hc_head_base = try L.putRaw("model.mtp.mhc_contract.hc_head_base");
+        const hc_head_scale = try L.putRaw("model.mtp.mhc_contract.hc_head_scale");
+        const norm = try L.putRaw("model.mtp.norm.weight");
+        const markov_w1 = try L.putTransposedBf16("model.mtp.markov_head.markov_w1.weight", 256, c.vocab);
+        const markov_w2 = try L.putRowSliceBf16("model.mtp.markov_head.markov_w2.weight", sh.vocab_lo, sh.vocab_width, 256);
+
+        var layers: [3]DsparkLayerWeights = undefined;
+        for (0..3) |i| {
+            var pbuf: [64]u8 = undefined;
+            const prefix = try std.fmt.bufPrint(&pbuf, "model.mtp.{d}", .{i});
+            layers[i] = .{
+                .attn_norm = try L.putRaw(try L.fmt1("{s}.input_layernorm.weight", .{prefix})),
+                .ffn_norm = try L.putRaw(try L.fmt1("{s}.post_attention_layernorm.weight", .{prefix})),
+                .hc_attn = try L.loadMhcPrefix(prefix, "self_attention"),
+                .hc_ffn = try L.loadMhcPrefix(prefix, "mlp"),
+                .hca = try L.loadHcaPrefix(prefix, false),
+                .moe = try L.loadMoePrefix(prefix),
+            };
+        }
+
+        return .{
+            .feature_proj = feature_proj,
+            .feature_norm = feature_norm,
+            .hc_head_fn = hc_head_fn,
+            .hc_head_base = hc_head_base,
+            .hc_head_scale = hc_head_scale,
+            .norm = norm,
+            .markov_w1 = markov_w1,
+            .markov_w2 = markov_w2,
+            .layers = layers,
+        };
+    }
+};
+
+test "e4m3ToF32 decodes exact OCP FP8 E4M3 values" {
+    try std.testing.expectEqual(@as(f32, 0.0), e4m3ToF32(0x00));
+    try std.testing.expectEqual(@as(f32, 1.0), e4m3ToF32(0x38));
+    try std.testing.expectEqual(@as(f32, -1.5), e4m3ToF32(0xBC));
+    try std.testing.expectEqual(@as(f32, 448.0), e4m3ToF32(0x7E));
+}
diff --git a/zig/src/families/ernie55/ernie55.zig b/zig/src/families/ernie55/ernie55.zig
new file mode 100644
index 0000000..d9e2fb3
--- /dev/null
+++ b/zig/src/families/ernie55/ernie55.zig
@@ -0,0 +1,14 @@
+//! ERNIE 5.5 Flash Preview family module.
+pub const config = @import("config.zig");
+pub const rope = @import("rope.zig");
