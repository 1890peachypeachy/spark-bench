# batch-size-keyed k: 7 at bs1, 5 at bs2-3, 3 at bs4-7, 2 at bs8-16 (later --speculative-config wins)
SPEC_TOKENS=7
VLLM_EXTRA_ARGS=$'--speculative-config\n{"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"probabilistic","num_speculative_tokens_per_batch_size":[[1,1,7],[2,3,5],[4,7,3],[8,16,2]]}'
