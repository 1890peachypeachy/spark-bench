# eager-mode torch profile (graphs off) so kernels map to ops; not a speed run
PROFILE=1
VLLM_EXTRA_ARGS=$'--enforce-eager\n--profiler-config\n{"profiler": "torch", "torch_profiler_dir": "/cache/prof-eager", "torch_profiler_with_stack": false, "torch_profiler_record_shapes": true, "ignore_frontend": true, "max_iterations": 12}'
