diff --git a/engine/attic.h b/engine/attic.h
new file mode 100644
index 00000000..3518883e
--- /dev/null
+++ b/engine/attic.h
@@ -0,0 +1,143 @@
+// spark-attic (github.com/bertholomus/spark-attic): the GB10's display carveout, the ~2 GiB the driver reserves for a display and never uses on
+// a headless box, lent by atticd as whole 2 MiB slices over a socket. GR8_ATTIC_SOCK names atticd's socket; unset, nothing
+// here runs and nothing is printed. With it, the rank asks its own box's atticd for one slice that spans the weight
+// image's G.embed (the full vocabulary in BF16 on every rank, 1,815 MiB, of which a step reads only its tokens' rows),
+// imports the slice's descriptor and maps the image around it (engine/vmm.h alloc_around): the image takes that much
+// less ordinary memory, so a larger --cap fits in the same MemAvailable. Same bytes at the same offsets; the KV pool
+// stays in ordinary memory. Fail open: no daemon, a refusal, a short lend, a key we cannot send or a slice the driver
+// will not map build the image as GR8_IMG_VMM says, after one line saying why.
+// The protocol is KindlingAI's dispramd socket protocol (Matt Mastracci's dispram, part of Kindling Spark OS), which
+// atticd speaks; the requests are byte for byte those of spark-attic's own clients. AF_UNIX SOCK_SEQPACKET, one flat
+// JSON object a message, the slice's descriptor beside the
+// alloc reply (SCM_RIGHTS). The socket stays open for the life of the process: atticd frees a client's slices when its
+// socket closes and the memory is unmapped. The driver API comes through cudaGetDriverEntryPointByVersion, as in vmm.h.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+#include <unistd.h>
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include "attic_proto.h"
+#include "knobs-rs/gr8_knobs.h"
+#include "loader/g6pack.h"
+#include "vmm.h"
+
+namespace g6attic
+{
+
+// cuMemImportFromShareableHandle (nullptr without), and the minimum granularity of memory shared through a POSIX
+// descriptor (0 without)
+using ImportFn = CUresult (*)(CUmemGenericAllocationHandle*, void*, CUmemAllocationHandleType);
+inline ImportFn import_fn()
+{
+    static const ImportFn f = [] {
+        void* p = nullptr;
+        cudaDriverEntryPointQueryResult q;
+        if (cudaGetDriverEntryPointByVersion("cuMemImportFromShareableHandle", &p, 12000, cudaEnableDefault, &q) != cudaSuccess ||
+            q != cudaDriverEntryPointSuccess)
+            return ImportFn(nullptr);
+        return reinterpret_cast<ImportFn>(p);
+    }();
+    return f;
+}
+inline size_t fd_granularity(int dev)
+{
+    if (!g6vmm::api().ok) return 0;
+    CUmemAllocationProp p = g6vmm::prop(dev);
+    p.requestedHandleTypes = CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR;
+    size_t g = 0;
+    return g6vmm::api().gran(&g, &p, CU_MEM_ALLOC_GRANULARITY_MINIMUM) == CUDA_SUCCESS ? g : 0;
+}
+
+// The image outside the slice, in physical allocations cut at multiples of this (engine/vmm.h alloc_around): on a GB10
+// each one costs the kernel ~25 KB of slab, so chunks of the granularity would take back half of what the slice frees.
+constexpr size_t PIECE = size_t(1) << 30;
+
+// The lend this process holds: atticd's socket, open until exit (closing it would give the slice back)
+inline Client& held()
+{
+    static Client c;
+    return c;
+}
+
+// The image of `pack` with [lo, hi) (the whole slices that span G.embed) mapped from one slice atticd lends, or nullptr
+// and why. Nothing is held on failure: the socket is closed and every mapping undone.
+inline void* place(const g6::Pack& pack, const g6::Entry& e, const std::string& path, size_t& lo, size_t& hi, std::string& why)
+{
+    int dev = 0;
+    cudaGetDevice(&dev);
+    size_t gmin = 0, grec = 0;
+    g6vmm::granularity(dev, gmin, grec);
+    const size_t gfd = fd_granularity(dev);
+    if (!gmin || !gfd || !import_fn()) { why = "no VMM support for memory shared through a descriptor"; return nullptr; }
+    const size_t chunk = (grec + gmin - 1) / gmin * gmin;        // the granularity g6vmm::alloc_around cuts at
+    const size_t g = std::max(std::max(chunk, gfd), SLICE);      // powers of two: the largest is a multiple of the rest
+    if (g % chunk || g % gfd || g % SLICE) { why = "the granularities do not divide each other"; return nullptr; }
+    lo = e.offset / g * g;
+    hi = (e.offset + e.nbytes + g - 1) / g * g;
+    std::string key;
+    if (!key_of(key, why)) return nullptr;
+    Client c;
+    if (!c.connect(path, why)) return nullptr;
+    std::string rep;
+    std::vector<uint64_t> got;
+    if (!c.ask(request(key, "info"), rep, nullptr, why) || !ok_reply(rep, {"largest"}, got, why)) { c.close(); return nullptr; }
+    if (got[0] < hi - lo)
+    {
+        why = "a short lend: atticd's largest slice is " + std::to_string(got[0] >> 20) + " MiB, G.embed needs " +
+              std::to_string((hi - lo) >> 20);
+        c.close();
+        return nullptr;
+    }
+    int fd = -1;
+    if (!c.ask(request(key, "alloc", hi - lo), rep, &fd, why)) { c.close(); return nullptr; }
+    if (!ok_reply(rep, {"size"}, got, why) || got[0] != hi - lo || fd < 0)
+    {
+        if (why.empty())
+            why = fd < 0 ? std::string("atticd's alloc reply carried no descriptor")
+                         : "atticd lent " + std::to_string(got[0]) + " bytes, we asked for " + std::to_string(hi - lo);
+        if (fd >= 0) ::close(fd);
+        c.close();
+        return nullptr;
+    }
+    CUmemGenericAllocationHandle h = 0;
+    const CUresult r = import_fn()(&h, reinterpret_cast<void*>(static_cast<intptr_t>(fd)), CU_MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR);
+    ::close(fd);                         // the handle holds the memory, the socket the lend
+    if (r) { why = "cuMemImportFromShareableHandle " + std::to_string(r); c.close(); return nullptr; }
+    void* p = g6vmm::alloc_around(pack.bytes(), lo, hi, h, PIECE, why);
+    if (!p) { c.close(); return nullptr; }
+    held() = c;
+    return p;
+}
+
+// The device image of `pack` with G.embed in a slice of the display carveout (see the top), with `release` set to free it,
+// or nullptr: GR8_ATTIC_SOCK unset (nothing is printed), a pack without G.embed (the drafter's and the QO packs read the
+// target's), an image after the first (one lend a process), or a failed lend (one line says why).
+inline void* image(const g6::Pack& pack, int rank, void (*&release)(void*))
+{
+    static const auto sock = knob::attic_sock();
+    if (!sock) return nullptr;
+    const g6::Entry* e = pack.find("G.embed");
+    static bool asked = false;
+    if (!e || asked) return nullptr;
+    asked = true;
+    size_t lo = 0, hi = 0;
+    std::string why;
+    void* dev = place(pack, *e, *sock, lo, hi, why);
+    if (!dev)
+    {
+        fprintf(stderr, "# rank %d: attic: no display carveout lent (%s): the image as GR8_IMG_VMM says\n", rank, why.c_str());
+        return nullptr;
+    }
+    release = [](void* p) { g6vmm::release(p); };
+    fprintf(stderr, "# rank %d: attic: G.embed (%.1f MiB at image offset %llu) in a %zu MiB slice of the display carveout from "
+            "%s, image bytes [%zu, %zu) MiB; the rest of the %.2f GB image in %zu allocations of up to %zu MiB\n", rank,
+            e->nbytes / 1048576.0, (unsigned long long)e->offset, (hi - lo) >> 20, sock->c_str(), lo >> 20, hi >> 20,
+            pack.bytes() / 1e9, g6vmm::mappings(dev) - 1, PIECE >> 20);
+    return dev;
+}
+
+}   // namespace g6attic
diff --git a/engine/attic_proto.h b/engine/attic_proto.h
new file mode 100644
index 00000000..8fb48579
--- /dev/null
+++ b/engine/attic_proto.h
@@ -0,0 +1,220 @@
+// The carveout lender's socket protocol: KindlingAI's dispramd protocol (dispram, Kindling Spark OS), as atticd
+// (github.com/bertholomus/spark-attic) speaks it; engine/attic.h uses it. The lender gives the display carveout as whole 2 MiB
+// slices over an AF_UNIX SOCK_SEQPACKET socket, one flat JSON object a message, a slice's descriptor beside the alloc
+// reply (SCM_RIGHTS). The requests are byte for byte those of the other atticd clients (spark-attic's own):
+// python/spark_attic/_proto.py, the TensorFold client patches). No CUDA here: engine/tests/attic_test.cpp tests it on the
+// host.
+#pragma once
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+// g6m4 has a global namespace `bind` (kernels/bind.cuh), so POSIX bind() may not be declared in its translation unit
+// (as in runtime/s2/posix_socket.h): the socket headers come in with bind renamed. A client never binds.
+#define bind g6attic_posix_bind_undeclared
+#include <sys/socket.h>
+#include <sys/un.h>
+#undef bind
+#include <sys/time.h>
+#include <unistd.h>
+#include "knobs-rs/gr8_knobs.h"
+
+namespace g6attic
+{
+
+constexpr const char* DEFAULT_KEY = "spark-attic-1";   // atticd's own default key
+constexpr size_t SLICE = 2u << 20;                       // atticd lends whole 2 MiB slices
+constexpr size_t KEY_MAX = 127;                          // a key goes into a request as it is
+constexpr size_t REPLY_MAX = 4096;
+constexpr size_t MAX_FDS = 12;                           // room for descriptors: a reply carrying more is refused
+constexpr int TIMEOUT_MS = 5000;                         // a daemon that does not answer in this long is none
+
+// 1 to 127 printable ASCII bytes, none a space, '"' or '\\': a key we can send without escaping
+inline bool key_ok(const std::string& k)
+{
+    if (k.empty() || k.size() > KEY_MAX) return false;
+    for (unsigned char c : k)
+        if (c < 0x21 || c > 0x7e || c == '"' || c == '\\') return false;
+    return true;
+}
+
+// {"key":K,"op":OP} or {"key":K,"op":"alloc","size":N}: the same bytes as _proto.py's json.dumps(separators=(",", ":"))
+inline std::string request(const std::string& key, const char* op, size_t size = 0)
+{
+    std::string r = "{\"key\":\"" + key + "\",\"op\":\"" + op + "\"";
+    if (size) r += ",\"size\":" + std::to_string(size);
+    return r + "}";
+}
+
+// The members of a flat JSON object (atticd's info and alloc replies), each value as its text: a string without its quotes
+// (escapes kept as written), a number, true, false or null as written. false for anything else (nested values included).
+inline bool members(const std::string& j, std::vector<std::pair<std::string, std::string>>& out)
+{
+    size_t i = 0;
+    auto ws = [&] { while (i < j.size() && (j[i] == ' ' || j[i] == '\t' || j[i] == '\n' || j[i] == '\r')) ++i; };
+    auto str = [&](std::string& s) {
+        if (i >= j.size() || j[i] != '"') return false;
+        const size_t a = ++i;
+        while (i < j.size() && j[i] != '"') i += j[i] == '\\' ? 2 : 1;
+        if (i >= j.size()) return false;
+        s = j.substr(a, i++ - a);
+        return true;
+    };
+    ws();
+    if (i >= j.size() || j[i++] != '{') return false;
+    ws();
+    if (i < j.size() && j[i] == '}')
+    {
+        ++i;
+        ws();
+        return i == j.size();
+    }
+    for (;;)
+    {
+        std::string k, v;
+        ws();
+        if (!str(k)) return false;
+        ws();
+        if (i >= j.size() || j[i++] != ':') return false;
+        ws();
+        if (i < j.size() && j[i] == '"') { if (!str(v)) return false; }
+        else
+        {
+            const size_t a = i;
+            while (i < j.size() && j[i] != ',' && j[i] != '}' && j[i] != ' ' && j[i] != '\t' && j[i] != '\n' && j[i] != '\r') ++i;
+            v = j.substr(a, i - a);
+            if (v.empty() || v[0] == '{' || v[0] == '[') return false;
+        }
+        out.emplace_back(k, v);
+        ws();
+        if (i >= j.size()) return false;
+        if (j[i] == '}') { ++i; ws(); return i == j.size(); }
+        if (j[i++] != ',') return false;
+    }
+}
+
+// A reply that says "ok":true, with the numbers asked for. why: atticd's own reason when it refused.
+inline bool ok_reply(const std::string& reply, const std::vector<const char*>& want, std::vector<uint64_t>& got, std::string& why)
+{
+    std::vector<std::pair<std::string, std::string>> m;
+    if (!members(reply, m)) { why = "atticd's reply is not a flat JSON object"; return false; }
+    auto find = [&](const char* k) -> const std::string* {
+        for (const auto& kv : m) if (kv.first == k) return &kv.second;
+        return nullptr;
+    };
+    const std::string* ok = find("ok");
+    if (!ok || *ok != "true")
+    {
+        const std::string* e = find("error");
+        why = "atticd refused: " + (e ? *e : std::string("no reason given"));
+        return false;
+    }
+    got.clear();
+    for (const char* k : want)
+    {
+        const std::string* v = find(k);
+        if (!v || v->empty() || v->find_first_not_of("0123456789") != std::string::npos || v->size() > 19)
+        {
+            why = std::string("atticd's reply has no ") + k;
+            return false;
+        }
+        got.push_back(std::stoull(*v));
+    }
+    return true;
+}
+
+// One connection to atticd. The slices it lends stay lent to it until close().
+struct Client
+{
+    int fd = -1;
+
+    bool connect(const std::string& path, std::string& why)
+    {
+        sockaddr_un a = {};
+        a.sun_family = AF_UNIX;
+        if (path.empty() || path.size() >= sizeof a.sun_path) { why = "no atticd at " + path; return false; }
+        memcpy(a.sun_path, path.data(), path.size());
+        fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+        if (fd < 0) { why = std::string("socket: ") + strerror(errno); return false; }
+        const timeval tv = {TIMEOUT_MS / 1000, (TIMEOUT_MS % 1000) * 1000};
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+        int r;
+        do r = ::connect(fd, reinterpret_cast<const sockaddr*>(&a), sizeof a); while (r < 0 && errno == EINTR);
+        if (r < 0)
+        {
+            why = "no atticd at " + path + " (" + strerror(errno) + ")";
+            close();
+            return false;
+        }
+        return true;
+    }
+
+    // one request, one reply; fdout: the descriptor an alloc reply carries, -1 with none (a refusal). A reply carrying
+    // more than it may is refused and every descriptor it carried closed.
+    bool ask(const std::string& req, std::string& reply, int* fdout, std::string& why)
+    {
+        ssize_t n;
+        do n = send(fd, req.data(), req.size(), MSG_NOSIGNAL); while (n < 0 && errno == EINTR);
+        if (n != (ssize_t)req.size()) { why = std::string("send to atticd: ") + (n < 0 ? strerror(errno) : "short"); return false; }
+        char buf[REPLY_MAX];
+        alignas(cmsghdr) char ctl[CMSG_SPACE(MAX_FDS * sizeof(int))];
+        iovec io = {buf, sizeof buf};
+        msghdr m = {};
+        m.msg_iov = &io;
+        m.msg_iovlen = 1;
+        m.msg_control = ctl;
+        m.msg_controllen = sizeof ctl;
+        do n = recvmsg(fd, &m, MSG_CMSG_CLOEXEC); while (n < 0 && errno == EINTR);
+        std::vector<int> fds;
+        if (n > 0)
+            for (cmsghdr* c = CMSG_FIRSTHDR(&m); c; c = CMSG_NXTHDR(&m, c))
+                if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS)
+                    for (size_t k = 0; k < (c->cmsg_len - CMSG_LEN(0)) / sizeof(int); ++k)
+                    {
+                        int x;
+                        memcpy(&x, CMSG_DATA(c) + k * sizeof(int), sizeof x);
+                        fds.push_back(x);
+                    }
+        auto refuse = [&](const std::string& w) {
+            for (int x : fds) ::close(x);
+            why = w;
+            return false;
+        };
+        if (n < 0) return refuse(std::string("no reply from atticd: ") + strerror(errno));
+        if (n == 0) return refuse("atticd closed the connection");
+        if (m.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) return refuse("atticd's reply did not fit");
+        if (fds.size() > (fdout ? 1u : 0u)) return refuse("atticd sent " + std::to_string(fds.size()) + " descriptors with its reply");
+        reply.assign(buf, (size_t)n);
+        if (fdout) *fdout = fds.empty() ? -1 : fds[0];
+        return true;
+    }
+
+    void close()
+    {
+        if (fd >= 0) ::close(fd);
+        fd = -1;
+    }
+};
+
+// The key the requests carry: GR8_ATTIC_KEY_FILE's text with its whitespace trimmed, else atticd's default
+inline bool key_of(std::string& key, std::string& why)
+{
+    static const auto file = knob::attic_key_file();
+    if (!file) { key = DEFAULT_KEY; return true; }
+    std::ifstream in(*file);
+    std::stringstream s;
+    if (in) s << in.rdbuf();
+    if (!in) { why = "GR8_ATTIC_KEY_FILE " + *file + ": " + strerror(errno); return false; }
+    key = s.str();
+    const size_t a = key.find_first_not_of(" \t\r\n"), b = key.find_last_not_of(" \t\r\n");
+    key = a == std::string::npos ? std::string() : key.substr(a, b - a + 1);
+    if (!key_ok(key)) { why = "GR8_ATTIC_KEY_FILE does not hold a key we can send (1 to 127 printable bytes, no space, quote or backslash)"; return false; }
+    return true;
+}
+
+}   // namespace g6attic
