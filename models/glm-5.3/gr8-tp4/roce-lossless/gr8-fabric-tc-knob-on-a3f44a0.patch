From c1787caa8a6cf89a8273d44d365e49e5d5d9e9b3 Mon Sep 17 00:00:00 2001
From: spark <spark@local>
Date: Sun, 22 Nov 2026 10:13:59 -0800
Subject: [PATCH] fabric: GR8_FABRIC_TC knob sets the RC queue pairs' IP
 traffic class (DSCP/ECN) at both RTR sites; 0 = unmarked as before

---
 docs/ENV.md                     |   1 +
 engine/comms/fabric.cpp         |   2 +
 engine/knobs-rs/gr8_knob_ids.rs | 711 +++++++++++++++----------------
 engine/knobs-rs/gr8_knobs.h     | 717 ++++++++++++++++----------------
 knobs/runtime.yaml              |  10 +
 5 files changed, 731 insertions(+), 710 deletions(-)

diff --git a/docs/ENV.md b/docs/ENV.md
index 6685cee8..dee59d00 100644
--- a/docs/ENV.md
+++ b/docs/ENV.md
@@ -166,6 +166,7 @@ Every rank of one engine must run the same value. The set ones that differ from
 | `GR8_DTR_PF_COPY` | flag | `0` |  | Prefill runs o_proj on an exact FP8 copy of its trellis tiles too, as q_b and the dense MLP do, about 25 MB more per layer at TP4. Same bits. |
 | `GR8_DTR_PF_KDA_COPY` | flag | `1` |  | Flash prefill makes exact FP8 copies of the KDA q, k and v trellis matrices for the prefill GEMMs. 0 = no copies. |
 | `GR8_DTR_PF_SHARE_SUH` | flag | `0` |  | Flash prefill dense MLP: up reuses gate's rotated input instead of rotating with its own suh vector. |
+| `GR8_FABRIC_TC` | int | `0` | 0..255 | IP traffic class (the whole TOS byte, DSCP << 2 \| ECN) that the fabric's RC queue pairs send with. 0 leaves the traffic unmarked, as upstream does, so a switch that classifies by DSCP puts it in its best-effort queue. 106 is DSCP 26 plus ECT(0), the usual lossless-RoCE class. Set it on every rank alike, and only after the NICs (trust dscp, PFC on the matching priority) and the switch (DSCP 26 to a PFC-protected traffic class) are set up for it. |
 | `GR8_FPF_ATTN_P1` | flag | `0` |  | Flash prefill attention runs the P1 bodies instead of the GEMM bodies. |
 | `GR8_FPF_DSA_P1` | flag | `0` |  | Flash prefill DSA layers run the P1 bodies instead of the GEMM bodies. |
 | `GR8_FPF_P1` | flag | `0` |  | Flash prefill runs the P1 bodies everywhere, the reference the GEMM bodies are checked against. |
diff --git a/engine/comms/fabric.cpp b/engine/comms/fabric.cpp
index 26b5c25f..05b6edc1 100644
--- a/engine/comms/fabric.cpp
+++ b/engine/comms/fabric.cpp
@@ -589,6 +589,7 @@ void Fabric::init(const FabricConfig& cfg) {
       at.max_dest_rd_atomic = 1; at.min_rnr_timer = 12;
       at.ah_attr.is_global = 1; memcpy(at.ah_attr.grh.dgid.raw, pi.gid, 16); at.ah_attr.grh.sgid_index = R.di.gid_index;
       at.ah_attr.grh.hop_limit = 64; at.ah_attr.port_num = 1;
+      at.ah_attr.grh.traffic_class = static_cast<uint8_t>(knob::fabric_tc());  // GR8_FABRIC_TC: DSCP/ECN marking for a lossless-RoCE switch queue (0 = unmarked)
       FCHECK(ibv_modify_qp(q, &at, IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN | IBV_QP_RQ_PSN | IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER) == 0);
       ibv_qp_attr as{}; as.qp_state = IBV_QPS_RTS; as.timeout = 14; as.retry_cnt = 7; as.rnr_retry = 7; as.sq_psn = mine.psn; as.max_rd_atomic = 1;
       FCHECK(ibv_modify_qp(q, &as, IBV_QP_STATE | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_SQ_PSN | IBV_QP_MAX_QP_RD_ATOMIC) == 0);
@@ -732,6 +733,7 @@ void Fabric::init(const FabricConfig& cfg) {
     at.max_dest_rd_atomic = 1; at.min_rnr_timer = 12;
     at.ah_attr.is_global = 1; memcpy(at.ah_attr.grh.dgid.raw, pi.gid, 16); at.ah_attr.grh.sgid_index = R.di.gid_index;
     at.ah_attr.grh.hop_limit = 64; at.ah_attr.port_num = 1;
+    at.ah_attr.grh.traffic_class = static_cast<uint8_t>(knob::fabric_tc());  // GR8_FABRIC_TC (see the other QP site)
     FCHECK(ibv_modify_qp(q, &at, IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN | IBV_QP_RQ_PSN | IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER) == 0);
     ibv_qp_attr as{}; as.qp_state = IBV_QPS_RTS; as.timeout = 14; as.retry_cnt = 7; as.rnr_retry = 7; as.sq_psn = mine[k * nr + p].psn; as.max_rd_atomic = 1;
     FCHECK(ibv_modify_qp(q, &as, IBV_QP_STATE | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_SQ_PSN | IBV_QP_MAX_QP_RD_ATOMIC) == 0);
