+# Four DGX Sparks (TP=4): the overrides scripts/serve4.sh reads after config/prod.env.
+#   cp config/tp4.env.example config/tp4.env      and fill in every <placeholder>. docs/FOUR_SPARKS.md has the steps.
+#
+# The four nodes need one switched subnet per CX7 port function (RoCE's all-gather pairs HCA h of every rank by
+# IPv4 subnet). A node with a disconnected port that carries an address on the same subnet can break TCP to it
+# (the kernel keeps routes of link-down ports): use the other subnet for WORKERS / HEAD_IP / NCCL_SOCKET_IFNAME.
+IMAGE=dsv41-tensorfold:tp4                   # docker build ... -t this (docs/FOUR_SPARKS.md); serve4.sh ship copies it
+NAME=dsv41-tf4                               # containers dsv41-tf4-r0 .. -r3
+HOST=127.0.0.1                               # 0.0.0.0 serves the LAN, unauthenticated: put a proxy / auth in front
+PORT=8000
+HEAD_IP=<head-link-ip>                       # rank 0 on the link (NCCL rendezvous, round-plan link)
+WORKERS="<user>@<rank1-link-ip> <user>@<rank2-link-ip> <user>@<rank3-link-ip>"
+NCCL_SOCKET_IFNAME=<link netdev>             # e.g. enP2p1s0f1np1
+NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1          # both CX7 functions: 2x NCCL bandwidth for prompt segments
+MODEL=<path>/DeepSeek-V4.1-Flash-EXL3-2.9bpw # same path on every node
+ENGRAM=<path>/dsv41-engram-w4                # engram-l{1,14}-r{rank}of4.bin (scripts/pack_engram.py --world 4)
+PREPARED=<path>/dsv41-prepared               # prepared rank folders, ~50 GB a node, written by the first start
+STATE=<path>/dsv41-state                     # request log and the session NVMe tier
+TF_DSV41_PREFILL_ATTN_BMQ=16                 # 16 heads a rank at TP=4: BMQ 32 does not divide
+MEM_GATE_GIB=104
