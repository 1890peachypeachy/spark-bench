# TensorFold TP4 fleet config for OUR fabric: v0.3.5 recipe + engine 0a0b69a (+ TF_RDMA_GID, TF_SEED_RANDOM/TF_TOP_K_MAX patches)
# on the LibertAI DeepSeek-V4.1-Flash-1017-EXL3-3.5bpw pack. Adapted from tonyd2wild's config.fleet-8000-rail2-p4.env.
# Drop-in for dsv41-tp4: same served name and URL, so Hermes needs no change.
# Rank order matters (ranks 0-1 and 2-3 are the 2D split's pairs). Prep assigned: 0=spark3 1=spark4 2=spark1 3=spark2.
NODES="spark3@10.73.0.3 spark4@10.73.0.4 spark@10.73.0.1 spark2@10.73.0.2"
MASTER_IP="10.73.0.3"
TP_PORT=29760
# Both CX7 rails: 10.73.0.x on rocep1s0f1, 10.74.0.x on roceP2p1s0f1. IPv4 RoCE v2 GID is index 3 on every port (show_gids).
RDMA_HCA="rocep1s0f1,roceP2p1s0f1"
NET_IF="enp1s0f1np1"

MODEL_DIR="/var/tmp/tf1017/model"
ENGRAM_DIR="/var/tmp/tf1017/engram"
ENGINE_DIR="/var/tmp/tf1017/engine-bin-v035"
KIT_DIR="/var/tmp/tf1017/kit"
CACHE_DIR="/var/tmp/tf1017/cache"
LOG_DIR="/var/tmp/tf1017/logs"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

# Same endpoint dsv41-tp4 / dsv41-tp3 exposed (tailnet + LAN, no key): 100.99.120.29:8888, model name GLM-5.3-Flash-EXL3.
HOST=0.0.0.0
PORT=8888
SERVED_NAME=GLM-5.3-Flash-EXL3
SERVER_FLAGS="--no-thinking --max-tokens 32768 --alias GLM-5.3-Flash-EXL3 --temperature 1.0 --top-p 1.0 --top-k 20"

# Victor's cap: 256K per request, even though the engine can do 1M.
CONTEXT=262144
WINDOW=2097152
PARALLEL=16
ENGINE_ENV="TF_SEED_RANDOM=1 TF_TOP_K_MAX=56 TF_RDMA_GID=3 NCCL_IB_GID_INDEX=3 TF_DS_2D_GU=parity TF_DS_ROUND_ROWS=48 TF_DS_STREAMS=16 TF_DS_SERVED_K=solo TF_DS_WINDOW=2097152 TF_DS_ROUND_MS=14.5,17.4,19.9,22.3,24.0,25.9,27.2,28.5,29.9,31.2,32.5,33.8,35.2,36.5,37.8,39.2,40.5,41.8,43.2,44.5,45.8,47.1,48.5,49.8,51.1,52.5,53.8,55.1,56.5,57.8,59.1,60.4,61.8,63.1,64.4,65.8,67.1,68.4,69.8,71.1,72.4,73.7,75.1,76.4,77.7,79.1,80.4,81.7 TF_DS_IDX_SPLIT=1 TENSORFOLD_PLAIN_SPECIALS=1 TENSORFOLD_GRAMMAR_LIB=/kit/grammar/libtfgrammar.so TENSORFOLD_SSE_KEEPALIVE=15 TENSORFOLD_STATS_EVERY=60 TF_FILL_CHUNKS=1 TF_FILL_MANY=1 TF_DS_2D_YX=1 TF_DS_WAVES=1 NCCL_MAX_NCHANNELS=4"
FOLLOW_FLAGS="--round-rows 48 --streams 16 --pool 2097152 --context 262144"
RANK0_FLAGS="--prompt-cache-gib 2"
