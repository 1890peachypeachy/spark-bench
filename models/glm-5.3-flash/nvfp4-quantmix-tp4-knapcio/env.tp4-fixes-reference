# GLM-5.3-Flash TP4 on Victor's 4x DGX Spark fleet — fleet-tuned .env
# Run start.sh on the head (spark3). Fabric = CRS504 RoCE, single active rail rocep1s0f1.
# NFS route: MODEL_DIR/DRAFT_DIR are common absolute paths (/var/tmp/models) — the head holds
# the converted weights locally, workers read them over NFS (see docs/glm53-tp4-nfs-test-plan.md).
# OVERLAY_REMOTE is also a common path because our nodes have per-user homes (spark/spark2/...).
HOSTS="local spark@10.73.0.1 spark2@10.73.0.2 spark4@10.73.0.4"
SSH_OPTS="-o BatchMode=yes"
IPS="10.73.0.3 10.73.0.1 10.73.0.2 10.73.0.4"
FABRIC_IFACE=enp1s0f1np1
IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_HOST_DIR=/var/tmp/nccl-2.30.7
IMAGE=glm53-roce:v11-b58f34ea
MODEL_DIR=/var/tmp/models/glm-quant-mix/lossless8
DRAFT_DIR=/var/tmp/models/incoai/GLM-5.3-Flash-DFlash2-fp8blk
CTN=glm53-lvkp-s-l2
OVERLAY_REMOTE=/var/tmp/glm53-flash-4x-spark
source profiles/current.env

# --- Identity override: match the live GLM-5.3-Flash-EXL3 TP3 lane's URL/model-name ---
# (requested by Victor 2026-09-26 — clients should not need to repoint)
SERVED_NAME=GLM-5.3-Flash-EXL3
PORT=8888
HOST_BIND=0.0.0.0

# --- Note: spark2 hit a transient kernel MemAvailable accounting anomaly (2026-09-27) — MemFree
# was normal (~104G, matching siblings) but MemAvailable was ~19G understated (95G vs 112-117G on
# spark1/3/4), crashing r2 at both GPU_UTIL=0.78 and 0.72. Fixed by rebooting spark2 (MemAvailable
# recovered to 110G post-reboot). After reboot, r2 still fell ~1.5G short of the 0.78 target
# (93.39G actual vs 94.92G desired) — this is real node-to-node headroom variance (spark2 runs
# slightly less usable RAM than its siblings even healthy), not the kernel bug. 0.75 gives real
# margin under the observed 93.39G ceiling without unnecessarily sacrificing KV cache capacity. ---
GPU_UTIL=0.75
