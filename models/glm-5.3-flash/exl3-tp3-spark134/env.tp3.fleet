# === Spark fleet TP3 config (switched CRS504 fabric) 2026-09-15 ===
HEAD_IP=10.73.0.3
WORKER_IP=10.73.0.1
WORKER2_IP=10.73.0.4
WORKER_USER=spark
WORKER2_USER=spark4
WORKER_SSH=spark@10.73.0.1
WORKER2_SSH=spark4@10.73.0.4
WORKER_HOME=/home/spark
WORKER2_HOME=/home/spark4
WORKER_CACHE_DIR=/home/spark/.cache/huggingface
HF_HOME=/home/spark3/.cache/huggingface
SKIP_DOWNLOAD=1
SKIP_SYNC=1

# CX7 on the CRS504 (matches live TP2 verified config)
HEAD_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IF=enp1s0f1np1
WORKER_CX7_IB=rocep1s0f1
WORKER2_CX7_IF=enp1s0f1np1
WORKER2_CX7_IB=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_DEBUG=WARN

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_FALLBACK=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
QUANTIZATION=exl3
IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3
SKIP_PULL=1
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3
ABLIT=0

# weights: local copies on all 3 ranks, no NFS co-tenancy needed
NFS_SHARE=0

# TP3 topology
TP=3
NNODES=3
PORT=8888
MASTER_PORT=29521
CONTAINER_HEAD=glm53-exl3-tp3-head
CONTAINER_WORKER=glm53-exl3-tp3-w1
CONTAINER_WORKER2=glm53-exl3-tp3-w2
TP3_HEAD_OVERRIDE=66
ENABLE_EXPERT_PARALLEL=1
MM_ENCODER_TP_MODE=data
DFLASH_DRAFT_TP=1

# memory (her .env.tp3.example numbers)
MAX_MODEL_LEN=1000000
GPU_MEM_UTIL=0.80
KV_CACHE_DTYPE=fp8
GLM53_INDEXER_WORKSPACE=rightsize
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=7168

# spec decode (match live TP2)
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
DFLASH_TOKENS=7
MTP_TOKENS=2
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
EXL3_FAT_KERNEL=1
EXL3_FAT_GROUPED=1
GLM53_BOOT_SHAPE_WARMUP=1

# scheduler: match today's TP2 behavior (her fair v5 is 2 days old)
GLM53_MIXED_PREFILL_CHUNK=skip
WORKER2_CACHE_DIR=/home/spark4/.cache/huggingface
