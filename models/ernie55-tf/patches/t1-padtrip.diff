+/// TF_ERNIE55_PAD_TRIP=1 (debug, off by default): token 0 is <|ERNIE_PAD|>, which argmax returns for NaN or
+/// degenerate logits and which a healthy model never emits. A round that emits it logs its configuration and, for
+/// verifies, runs the same forward again eagerly (inputs and tables are still in place, and every write is
+/// idempotent: the same rows rewrite the same KV and taps) and logs whether the eager logits are clean too, so a
+/// graph or launch fault (eager clean) tells apart from corrupt state (eager PAD too). Every rank sees the same
+/// tokens, so every rank re-runs and the collectives stay matched.
+var pad_trip_on: ?bool = null;
+var pad_trips: u32 = 0;
+fn padTripOn() bool {
+    if (pad_trip_on) |o| return o;
+    const o = if (std.c.getenv("TF_ERNIE55_PAD_TRIP")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+    if (o) std.log.info("ernie55: PAD tripwire on (TF_ERNIE55_PAD_TRIP=1)", .{});
+    pad_trip_on = o;
+    return o;
+}
+fn hasPad(out: []const u32) usize {
+    var n: usize = 0;
+    for (out) |t| n += @intFromBool(t == 0);
