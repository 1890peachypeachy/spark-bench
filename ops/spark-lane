glm53_tp4_weights_ok() {   # $1 = node ; success = checkpoint + drafter READABLE on that node
  # The knapcio recipe is NFS-backed: spark3 holds the checkpoint locally and exports it,
  # spark1/2/4 read it over the fabric mount. So on a worker this is really a mount test,
  # and an unmounted worker presents an EMPTY directory rather than a missing one — which
  # is exactly why this counts safetensors shards instead of testing the directory.
  # 33 is MEASURED on all four nodes 2026-09-29, not guessed. Do not "round it up"
  # for safety: an invented threshold here rejects a healthy lane, which is how the
  # memory step once refused to launch over a 0.1 GiB shortfall.
  sshx "$1" "test \"\$(ls -1 $GLM53_TP4_WEIGHTS/*.safetensors 2>/dev/null | wc -l)\" -ge 33 \
             && test \"\$(ls -1 $GLM53_TP4_DRAFTER/*.safetensors 2>/dev/null | wc -l)\" -ge 1"
}

# Name the processes competing for UMA on a node that is short or thin on memory.
# Lane ranks are excluded; everything else listed is a co-tenant. A co-tenant with
# restart=unless-stopped survives a reboot, so it must be stopped (or moved), not
# rebooted around. Read-only: this never stops anything itself.
mem_blame() {
  local n names
  for n in "$@"; do
    names="$(sshx "$n" "docker ps --format '{{.Names}}|{{.Label \"x\"}}' 2>/dev/null | cut -d'|' -f1 \
      | grep -vE 'glm53-lvkp|glm53-roce|glm53-tf4|glm53-tp3|dsv41|qwen3' \
      | head -8 | paste -sd, -" 2>/dev/null)"
    if [[ -n "$names" ]]; then
      info "  $n co-tenants holding memory: $names"
      info "  $n stop/move those (a restart=unless-stopped co-tenant returns on boot)"
    else
      info "  $n no co-tenants — this one really is the kernel MemAvailable anomaly; a reboot should clear it"
    fi
  done
}

