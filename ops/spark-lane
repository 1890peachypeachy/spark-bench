#!/usr/bin/env bash
# spark-lane — ONE-SHOT bring-up / teardown / rotation for the lanes on Victor's DGX Spark fleet.
#
# Written to be followed by ANY model, including one with no judgement and no fleet
# knowledge: it checks the fleet itself, refuses to clobber a running lane, verifies
# with a real chat canary (not just an open port), and ends every run with exactly
# two lines a caller can act on:
#
#     RESULT: PASS|FAIL  lane=<lane> action=<action> ...
#     NEXT:  <the single next command to run, or "nothing">
#
# USAGE
#   spark-lane                     # census: what is on every Spark right now
#   spark-lane status              # same as above
#   spark-lane lanes               # list lanes and the nodes each one needs
#   spark-lane up    <lane>        # bring a lane up (refuses if a node is taken)
#   spark-lane down  <lane>        # park a lane (verifies it really stopped)
#   spark-lane verify <lane>       # health only, changes nothing
#   spark-lane rotate <lane>       # park whatever conflicts, then bring it up
#
# LANES
#   comfy-engine      spark2        ComfyUI (music/image/design/video) -> :8188 (no LLM lane)
#   dsv41-tp3         spark1,3,4    DeepSeek V4.1-Flash TP3  -> :8000/v1
#   dsv41-tp4         spark1-4      DeepSeek V4.1-Flash TP4  -> :8000/v1 (Mia's fast line)
#   glm53-tp3         spark1,3,4    GLM-5.3-Flash EXL3 TP3   -> :8888/v1 (TensorFold engine, v1.5, CONTAINER glm53-tf3)
#   glm53-tp4         spark1-4      GLM-5.3-Flash TP4        -> :8888/v1 (knapcio recipe)
#   glm53-tf2         spark3,4      GLM-5.3-Flash EXL3 TP2   -> :8888/v1 (TensorFold engine)
#   jspark3           spark1,3,4    GLM-5.3-Flash EXL3 (jspark3 v2.0.1 TensorFold fork, MLX 4-bit
#                                   weights, disk session-chain) -> :8888/v1; containers
#                                   jspark3-rank{0,1,2}, kit spark3:/var/tmp/jspark3/jspark3.
#                                   Registered 2026-10-04 after the live cutover — jspark3-rank*
#                                   matched NEITHER stage of node_occupant before, so `up` on any
#                                   other lane cleared the occupancy check against a live lane
#                                   (demonstrated 2026-10-04: `up glm53-tp3` reported nodes free
#                                   and began a bring-up on top of the serving lane).
#
# POLICY (do not change these constants casually)
#   * The OpenAI endpoint + served model name stay IDENTICAL across TP3/TP4 swaps:
#     http://100.99.120.29:8000/v1  and  deepseek-v4.1-flash. Rotating the engine
#     behind a stable endpoint is the whole point; clients never change.
#   * Nothing binds beyond localhost + the tailnet. No LAN, no public.
#   * No --restart policy is ever set (GB10 hard rule: never auto-restart an
#     unverified vLLM/SGLang config).
#   * Teardown never deletes artifacts; it stops containers and leaves weights.

set -uo pipefail

# ── stable identity ──────────────────────────────────────────────────────────
DSV41_ENDPOINT="${DSV41_ENDPOINT:-http://100.99.120.29:8000/v1}"
DSV41_MODEL="deepseek-v4.1-flash"
DSV41_HEAD_HOST="spark3"
DSV41_HEAD_IP="100.99.120.29"
TP3_KIT="/home/spark3/dsv41-3x"
TP4_KIT="/home/spark3/dsv41-4x"
# GLM-5.3-Flash EXL3 TP3 lane (Mia's recipe, single self-contained start-tp3.sh)
GLM53_ENDPOINT="${GLM53_ENDPOINT:-http://100.99.120.29:8888/v1}"
GLM53_MODEL="GLM-5.3-Flash-EXL3"
GLM53_HEAD_HOST="spark3"
GLM53_KIT="/home/spark3/GLM53-TP3"
GLM53_CLI="./start-tp3.sh"
GLM53_IMAGE="ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor"
# GLM-5.3-Flash TP4 (knapcio recipe, vLLM + KDA mamba-align fix + DFlash2 fp8blk drafter,
# head-launched over the RoCE fabric). Re-adopted 2026-09-29, replacing the mentat/gx10 kit,
# after upstream fixed the KDA/prefix-cache corruption that forced us off it (issue #2).
# SAME endpoint + served name as the TP3 lane on purpose — clients never repoint (99 Hermes
# config references pin GLM-5.3-Flash-EXL3). The two lanes are mutually exclusive (both own
# :8888) and are DIFFERENT backends despite the shared name.
#
# Differences from the mentat/gx10 kit this replaced, all of which change the runbook:
#   - HEAD-LAUNCHED. One `./start.sh serve` on spark3 rsyncs the overlay to every node and
#     starts ranks 3,2,1,0 itself. Do NOT compose per-node; that is the mentat pattern.
#   - NFS-backed weights. spark3 holds MODEL_DIR locally and EXPORTS it; spark1/2/4 mount
#     10.73.0.3:/ at /var/tmp/models over the fabric. A missing mount = a rank that cannot
#     read the checkpoint, so the mount itself is a preflight check.
#   - No mentatd. There is no mesh daemon in this recipe; nothing to start or join.
#   - Ranks are named ${CTN}-r0..r3, NOT a bare `glm53`.
#   - The util knob is GPU_UTIL in the TOP-LEVEL .env (mentat used GPU_MEM_UTIL in
#     compose/.env). Reading the wrong name silently checks the wrong memory floor.
#   - Verified on our fleet 2026-09-29: upstream's c8 prefix scan PASSES here
#     (cold-vs-warm logprob drift 0.039 vs 0.25-0.36 when broken, 0/48 degenerate).
GLM53_TP4_KIT="/var/tmp/glm53-recipe-tp4"
GLM53_TP4_CLI="./start.sh"
# GLM-5.3-Flash EXL3 TP2 — TensorFold engine (MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-
# TensorFold). 2 nodes: spark3 head (rank 0, serves :8888) + spark4 worker (rank 1) over
# RoCE. Worker weights come over NFS from the shared dsv41-nfs export on spark3
# (/var/tmp/models, hardlink farm under huggingface/) — dsv41-nfs MUST be up or the
# worker's hard mount hangs in 10-min timeouts instead of failing fast (2026-10-02
# post-mortem). SAME endpoint + served name as glm53-tp3/tp4 — mutually exclusive
# (owns :8888); swap with rotate, never with parallel ups.
GLM53_TF2_HEAD="spark3"
GLM53_TF2_KIT="/home/spark3/GLM53-TF"
# glm53-tp3 re-pointed 2026-10-03: TensorFold TP3 (same recipe family as glm53-tf2, own kit copy so
# the two lanes' container names/.env never collide). Kit's .env pins CONTAINER_NAME=glm53-tf3,
# KV_POOL_GIB=27 (Mia's README: 32 leaves rank 0 <6 GiB free at TP3), TP=3 via ./start-tp3.sh.
GLM53_TP3_HEAD="spark3"
GLM53_TP3_KIT="/home/spark3/GLM53-TF3"
GLM53_TP4_ENV=".env"
#
# NAME WARNING (restored 2026-09-29 — it applies to this recipe too): the served name
# says EXL3 and the weights are NOT EXL3. Verified on spark3's own config.json:
# quant_method=modelopt, quant_algo=MIXED_PRECISION (NVFP4 experts + MXFP8/FP8_BLOCK
# attention). The name is a stable IDENTITY LABEL that 99 Hermes config references pin
# to; it is not evidence of the backend. Do NOT "correct" it to match the quantization —
# that repoints every client. Read config.json when you need to know what is loaded.
GLM53_TP4_CTN="glm53-alignfix-20260929"   # DEFAULT ONLY — the kit's .env wins, see glm53_tp4_resolve_ctn()
GLM53_TP4_IMAGE="glm53-roce:v11-b58f34ea"
GLM53_TP4_WEIGHTS="/var/tmp/models/glm-quant-mix/lossless8"
GLM53_TP4_DRAFTER="/var/tmp/models/incoai/GLM-5.3-Flash-DFlash2-fp8blk"
# Workers read the checkpoint from the head over NFS; this is their mount point.
GLM53_TP4_NFS_MOUNT="/var/tmp/models"
# start.sh defaults --gpu-memory-utilization from GPU_UTIL; profiles/current.env ships 0.78
# and our .env pins 0.72 (spark2 runs slightly less usable RAM than its siblings).
GLM53_TP4_UTIL_DEFAULT="0.78"
# ComfyUI creative engine (spark2). Replaced the two-lab creative-engine lane:
# one GPU allocator for music/image/design/video instead of two labs with hard reservations.
COMFY_HOST="spark2"
COMFY_URL="${COMFY_URL:-http://100.71.248.116:8188}"
COMFY_CTN="spark-comfy"
COMFY_DIR="/home/spark2/comfy-build"
REPO_URL="https://github.com/1890peachypeachy/DeepSeek-v4.1-Flash-DGX-Sparks.git"
# Resolve through the ~/.local/bin/spark-lane symlink -- a bare dirname on
# BASH_SOURCE resolves to the symlink's own directory (~/.local/bin), not the
# real ops/ dir, which breaks lane-profiles/ lookups (found 2026-09-25).
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

ENGINE_WAIT="${ENGINE_WAIT:-900}"            # engine boot budget once the image exists
ENGINE_MAX_WAIT="${ENGINE_MAX_WAIT:-10800}"  # ceiling for a COLD bring-up (image build on 4 nodes)
COMFY_WAIT="${COMFY_WAIT:-420}"

SSH_OPTS="-n -o ConnectTimeout=10 -o BatchMode=yes"

# ── output helpers ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'
else B=""; G=""; R=""; Y=""; D=""; N=""; fi

STEPNO=0
STEPS=0
step() { STEPNO=$((STEPNO + 1)); printf '%s[%d/%d]%s %-14s %s\n' "$B" "$STEPNO" "$STEPS" "$N" "$1" "$2"; }
info() { printf '        %s%s%s\n' "$D" "$1" "$N"; }
ok()   { printf '        %sOK%s   %s\n' "$G" "$N" "$1"; }
bad()  { printf '        %sFAIL%s %s\n' "$R" "$N" "$1"; }
warn() { printf '        %sWARN%s %s\n' "$Y" "$N" "$1"; }

FAILED=0
FAIL_STEP=""
FAIL_DETAIL=""
NEXT_CMD="nothing"
note_fail() { FAILED=1; FAIL_STEP="$1"; FAIL_DETAIL="$2"; }
result() { # lane action endpoint model extra
  if [[ $FAILED -eq 0 ]]; then
    printf '\n%sRESULT: PASS%s lane=%s action=%s endpoint=%s model=%s %s\n' "$G" "$N" "$1" "$2" "$3" "$4" "${5:-}"
  else
    printf '\n%sRESULT: FAIL%s lane=%s action=%s step=%s\n' "$R" "$N" "$1" "$2" "$FAIL_STEP"
    printf '        %s\n' "$FAIL_DETAIL"
  fi
  printf '%sNEXT:%s %s\n' "$B" "$N" "$NEXT_CMD"
}

sshx() { ssh $SSH_OPTS "$@"; }

# Detach a remote long-running job AND return immediately. sshx/$SSH_OPTS already
# has -n (stdin), but that is NOT enough for a backgrounded job: the remote
# `bash -c` wrapper ssh spawns keeps the channel's stdout open until its whole
# child chain exits. Since the serve step runs in the foreground of the runner,
# that means ssh waits forever -> `up` hangs and the rotation never advances.
# FIXED 2026-09-25: use `ssh -f`, which backgrounds the ssh CLIENT itself right
# after auth, so the local side returns regardless of the remote channel. The
# remote job still detaches via its own setsid/nohup + fd redirects (callers do).
launch_detached() {
  local host="$1"; shift
  ssh -f -o ConnectTimeout=10 -o BatchMode=yes "$host" "$@" >/dev/null 2>&1
}
docker_names() { sshx "$1" "docker ps --format '{{.Names}}|{{.Image}}' 2>/dev/null"; }

# FIXED 2026-09-26: `up` used to leave stale EXITED containers from a prior
# crash in place, so the recipe's own `docker run`/compose step failed with
# "name already in use", the chain died silently, and the human had to
# manually `docker rm` before a retry ever worked (dsv41-tp4 hit this twice
# in a row, 2026-09-26). occupancy_conflict() only looks at RUNNING
# containers, so it does not catch this — a node can be "free" per that
# check and still have dead containers blocking a clean relaunch.
#
# Scoped by name on purpose: these nodes accumulate months of unrelated
# one-off experiment containers (qwen36-nvfp4, dspark_vllm, r0b0tlab, etc.)
# that a human may still want to inspect post-mortem. A blanket "remove
# every exited container on the node" would destroy that debugging evidence
# for zero benefit — only THIS lane's own known container names can ever
# collide with what it's about to launch, so only those are candidates.
# docker rm without -f also refuses anything still running, so this can
# never touch a live process either way.
lane_container_names() {
  case "$1" in
    dsv41-tp3|dsv41-tp4) echo "dsv41-head dsv41-worker" ;;
    glm53-tp3)           echo "glm53-tf3" ;;
    jspark3)             echo "jspark3-rank0 jspark3-rank1 jspark3-rank2" ;;
    glm53-tp4)           echo "${GLM53_TP4_CTN}-r0 ${GLM53_TP4_CTN}-r1 ${GLM53_TP4_CTN}-r2 ${GLM53_TP4_CTN}-r3" ;;
    glm53-tf2)           echo "glm53-flash-tf" ;;
    comfy-engine)        echo "spark-comfy" ;;
    *) return 1 ;;
  esac
}

cleanup_dead_containers() {
  local lane="$1" n dead names pattern
  names="$(lane_container_names "$lane")" || return 0
  pattern="^($(echo "$names" | tr ' ' '|'))\$"
  for n in $(lane_nodes "$lane"); do
    dead="$(sshx "$n" "docker ps -a --filter status=exited --filter status=dead --filter status=created --format '{{.Names}}'" 2>/dev/null | grep -E "$pattern" || true)"
    if [[ -n "$dead" ]]; then
      info "  $n: removing dead container(s): $(echo "$dead" | tr '\n' ' ')"
      sshx "$n" "echo '$dead' | xargs -r docker rm" >/dev/null 2>&1
    fi
  done
}

# Portable timeout: GNU `timeout` is NOT on macOS (no timeout/gtimeout by default),
# so `down`/`rotate` always failed at the stop step with "timeout: command not found".
# This helper runs a command with a hard wall-clock cap and returns 124 on timeout
# (matching GNU timeout's convention) so the existing `if ! timeout ...` logic works.
# FIXED 2026-09-25: rotation was broken on the Mac because of this.
timeout_run() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return $?
  fi
  # portable fallback: background + sleep + kill, returns 124 on timeout
  "$@" &
  local pid=$!
  ( sleep "$secs"; kill -9 "$pid" 2>/dev/null ) &
  local killer=$!
  local rc=0
  wait "$pid" 2>/dev/null; rc=$?
  kill "$killer" 2>/dev/null
  if ! kill -0 "$pid" 2>/dev/null; then
    # process finished before the killer fired
    return $rc
  fi
  # still alive after the killer's sleep -> it was killed by the killer
  return 124
}

# Occupants of a node, one per line, empty = free.
# Matches the container names/images our lanes actually use.
# Returns EVERY lane present on a node, LLM lanes first. spark2 genuinely hosts two
# tenants (spark-comfy + a glm rank); a single-valued answer made one of them invisible —
# comfy-engine reported `down` while serving, and rotate's park loop could not see it to
# park it, so `rotate dsv41-tp4` would tear down glm53-tp4, then refuse on comfy, leaving
# NOTHING serving. Order matters: the first entry is what node_occupant reports.
node_occupants() {
  local node="$1" out lanes=""
  out="$(docker_names "$node" | grep -E 'spark-comfy|ming-layer-web|spark-image-lab|dsv41-[34]x|sglang|glm53-exl3|glm53-alignfix|glm53-lvkp|glm53-roce|glm53-flash-tf|glm53-tf3|jspark3-rank|^glm53[|]' || true)"
  [[ -z "$out" ]] && { echo ""; return; }
  echo "$out" | grep -qiE 'dsv41-3x|sglang.*3' && lanes="$lanes dsv41-tp3"
  echo "$out" | grep -qiE 'dsv41-4x'           && lanes="$lanes dsv41-tp4"
  # glm family stays mutually exclusive (an image string can match both arms).
  if   echo "$out" | grep -qiE 'glm53-alignfix|glm53-lvkp|glm53-roce' || echo "$out" | grep -qE '^glm53[|]'; then
    lanes="$lanes glm53-tp4"
  elif echo "$out" | grep -qiE 'jspark3-rank'; then
    lanes="$lanes jspark3"
  elif echo "$out" | grep -qiE 'glm53-tf3'; then
    lanes="$lanes glm53-tp3"
  elif echo "$out" | grep -qiE 'glm53-flash-tf'; then
    lanes="$lanes glm53-tf2"
  elif echo "$out" | grep -qiE 'glm53-exl3|glm-5'; then
    lanes="$lanes glm53-tp3"
  fi
  # Single-node sidecar and the retired kit come last: they must never outrank a
  # production rank (that is what made glm53-tp4 read `partial 3/4` while serving).
  echo "$out" | grep -qE  '^spark-comfy[|]'                 && lanes="$lanes comfy-engine"
  echo "$out" | grep -qiE 'ming-layer-web|spark-image-lab'  && lanes="$lanes creative-engine-retired"
  [[ -z "$lanes" ]] && lanes=" llm-lane-unknown"
  echo "${lanes# }"
}

# Highest-precedence single occupant (first entry above). Kept for callers that want one
# name; anything deciding whether a node is SAFE must use node_occupants.
node_occupant() { local a; a="$(node_occupants "$1")"; echo "${a%% *}"; }


# ── canary: a REAL chat completion, because /v1/models can stay green while chat hangs
canary() {
  local url="$1" model="$2" body out
  body="$(curl -s -m 120 "$url/chat/completions" -H 'Content-Type: application/json' -d @- <<JSON
{"model":"$model","messages":[{"role":"user","content":"Reply with the single word: ready"}],"max_tokens":8,"temperature":0,"chat_template_kwargs":{"thinking":false}}
JSON
)"
  out="$(printf '%s' "$body" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("BADJSON"); raise SystemExit(3)
if "choices" not in d: print("APIERR:"+str(d)[:160]); raise SystemExit(4)
c=d["choices"][0]["message"].get("content") or ""
u=d.get("usage",{})
print("TEXT[%s] tok=%s" % (c.strip()[:40], u.get("completion_tokens","?")))
' 2>&1)"
  local rc=$?
  if [[ $rc -ne 0 || "$out" == BADJSON* || "$out" == APIERR* ]]; then
    bad "chat canary: $out"
    note_fail "canary" "the OpenAI endpoint answered but not with a completion: $out"
    NEXT_CMD="spark-lane down ${LANE:-dsv41-tp3} && spark-lane up ${LANE:-dsv41-tp3}   # clean restart, then re-verify"
    return 1
  fi
  ok "chat canary: $out"
  return 0
}

# TensorFold's GLM template emits reasoning BEFORE content, and it ignores
# chat_template_kwargs.thinking (only enable_thinking:false is honored, verified on the
# live lane 2026-10-02). The generic 8-token canary therefore returns content=None and
# proves nothing on this engine — this variant disables thinking so the content check
# is real. Same failure contract as canary().
canary_tf2() {
  local url="$1" model="$2" body out
  body="$(curl -s -m 120 "$url/chat/completions" -H 'Content-Type: application/json' -d @- <<JSON
{"model":"$model","messages":[{"role":"user","content":"Reply with the single word: ready"}],"max_tokens":16,"temperature":0,"chat_template_kwargs":{"enable_thinking":false}}
JSON
)"
  out="$(printf '%s' "$body" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("BADJSON"); raise SystemExit(3)
if "choices" not in d: print("APIERR:"+str(d)[:160]); raise SystemExit(4)
c=d["choices"][0]["message"].get("content") or ""
u=d.get("usage",{})
if not c.strip(): print("EMPTY_CONTENT"); raise SystemExit(5)
print("TEXT[%s] tok=%s" % (c.strip()[:40], u.get("completion_tokens","?")))
' 2>&1)"
  local rc=$?
  if [[ $rc -ne 0 || "$out" == BADJSON* || "$out" == APIERR* || "$out" == EMPTY_CONTENT* ]]; then
    bad "chat canary: $out"
    note_fail "canary" "the OpenAI endpoint answered but not with a completion: $out"
    NEXT_CMD="spark-lane down ${LANE:-glm53-tf2} && spark-lane up ${LANE:-glm53-tf2}   # clean restart, then re-verify"
    return 1
  fi
  ok "chat canary: $out"
  return 0
}

# ── census ───────────────────────────────────────────────────────────────────
census() {
  printf '%s── fleet census ─────────────────────────────────────────────%s\n' "$B" "$N"
  if command -v sparkdash-pp-cli >/dev/null 2>&1; then
    echo "  (sparkDash — LLM lanes only; the comfy engine is invisible here by design)"
    if ! sparkdash-pp-cli status --agent 2>&1 | sed 's/^/    /'; then
      warn "sparkdash-pp-cli status failed — falling back to docker probes only"
    fi
  else
    warn "sparkdash-pp-cli not on PATH — falling back to docker probes only"
  fi
  echo
  echo "  per-node containers (authoritative for occupancy):"
  local n o
  for n in spark1 spark2 spark3 spark4; do
    o="$(docker_names "$n" | grep -E 'spark-comfy|ming-layer-web|spark-image-lab|dsv41-[34]x|sglang|glm53' || true)"
    if [[ -z "$o" ]]; then printf '    %-8s %s(free)%s\n' "$n" "$D" "$N"
    else printf '    %-8s %s\n' "$n" "$(echo "$o" | paste -sd' ' -)"; fi
  done
  echo
  echo "  comfy engine (spark2 — not an LLM lane, so sparkDash never shows it):"
  local ch cc
  ch="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$COMFY_URL/system_stats" 2>/dev/null)"
  cc="$(sshx spark2 'docker inspect --format "{{.State.Status}}" spark-comfy 2>/dev/null' || true)"
  printf '    ComfyUI     :8188  http %-3s  container %-8s  %s\n' "${ch:-000}" "${cc:-absent}" "$COMFY_URL"
  echo
  echo "  DeepSeek lane endpoint: $DSV41_ENDPOINT  (model: $DSV41_MODEL)"
  local models
  models="$(curl -s -m 10 "$DSV41_ENDPOINT/models" 2>/dev/null | python3 -c 'import json,sys
try: print(",".join(m.get("id","?") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("unreachable")' 2>/dev/null)"
  printf '    /v1/models -> %s\n' "${models:-unreachable}"
  printf '    %snote: /v1/models green does NOT mean chat works — use "spark-lane verify <lane>"%s\n' "$D" "$N"
}

# ── lanes ────────────────────────────────────────────────────────────────────
lane_nodes() {
  case "$1" in
    comfy-engine)    echo "spark2" ;;
    dsv41-tp3)       echo "spark1 spark3 spark4" ;;
    dsv41-tp4)       echo "spark1 spark2 spark3 spark4" ;;
    glm53-tp3)       echo "spark1 spark3 spark4" ;;
    jspark3)         echo "spark1 spark3 spark4" ;;
    glm53-tp4)       echo "spark1 spark2 spark3 spark4" ;;
    glm53-tf2)       echo "spark3 spark4" ;;
    *) return 1 ;;
  esac
}

lane_endpoint() { case "$1" in comfy-engine) echo "$COMFY_URL" ;; glm53-tp3|glm53-tp4|glm53-tf2|jspark3) echo "$GLM53_ENDPOINT" ;; *) echo "$DSV41_ENDPOINT" ;; esac; }
lane_model_id() { case "$1" in comfy-engine) echo "comfyui(yue2+qwen-image+ming+h3)" ;; glm53-tp3|glm53-tp4|glm53-tf2|jspark3) echo "$GLM53_MODEL" ;; *) echo "$DSV41_MODEL" ;; esac; }

# ── Lane inventory (single source of truth for the sparkDash lane panel) ─────
ALL_LANE_IDS="comfy-engine dsv41-tp3 dsv41-tp4 glm53-tp3 glm53-tp4 glm53-tf2 jspark3"

# Minimal JSON string escape (values here are ids/hosts/models — no control chars).
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

# up | down | partial, derived from live per-node occupants (never from labels).
#   up      = every node in the lane is held by this lane
#   down    = the lane holds none of its nodes (whoever else holds them is separate;
#             down-but-blocked is `down` + a non-empty `holders` map)
#   partial = the lane holds some but not all of its nodes (a broken half-up)
lane_up_state() {
  local lane="$1" n occ total=0 mine=0
  for n in $(lane_nodes "$lane"); do
    total=$((total + 1))
    occ="$(node_occupants "$n")"
    # membership, not equality: a co-tenanted node still counts as held by this lane
    case " $occ " in *" $lane "*) mine=$((mine + 1)) ;; esac
  done
  if   [[ $mine -eq $total ]]; then echo up
  elif [[ $mine -gt 0 ]];      then echo partial
  else echo down
  fi
}

# JSON object for one lane: {id,nodes[],endpoint,model,status,holders{node:lane}}
lane_json_obj() {
  local l="$1" nodes="[" n f=1 holders="{" hf=1 occ rest
  for n in $(lane_nodes "$l"); do
    [[ $f -eq 1 ]] || nodes="$nodes,"
    f=0; nodes="$nodes$(json_str "$n")"
  done
  nodes="$nodes]"
  # CONTRACT (sparkDash LaneManager + its test fixture): `holders` is "the lanes blocking
  # me, excluding my own claim" — an UP lane reports {}, and every VALUE must be a single
  # parkable lane id. Do not comma-join co-tenants here: LaneManager does
  # `downSet.has(holder)` to decide which nodes a requested `down` frees, so a joined
  # string never matches a lane id and a legitimate rotation gets wrongly blocked.
  # Co-tenancy is reported separately, below.
  local other cot="{" cf=1 mine
  for n in $(lane_nodes "$l"); do
    occ="$(node_occupants "$n")"
    mine=0
    case " $occ " in *" $l "*) mine=1 ;; esac
    if [[ $mine -eq 1 ]]; then
      # I hold this node. Anyone else on it is a co-tenant, not a blocker.
      rest=""
      for other in $occ; do
        [[ "$other" == "$l" ]] && continue
        rest="${rest:+$rest,}$other"
      done
      if [[ -n "$rest" ]]; then
        [[ $cf -eq 1 ]] || cot="$cot,"
        cf=0; cot="$cot$(json_str "$n"):$(json_str "$rest")"
      fi
      continue
    fi
    # I do not hold it: report the top-precedence occupant as a single lane id.
    occ="${occ%% *}"
    [[ -z "$occ" ]] && continue
    [[ $hf -eq 1 ]] || holders="$holders,"
    hf=0; holders="$holders$(json_str "$n"):$(json_str "$occ")"
  done
  cot="$cot}"
  holders="$holders}"
  printf '{"id":%s,"nodes":%s,"endpoint":%s,"model":%s,"status":%s,"holders":%s,"co_tenants":%s}' \
    "$(json_str "$l")" "$nodes" "$(json_str "$(lane_endpoint "$l")")" \
    "$(json_str "$(lane_model_id "$l")")" "$(json_str "$(lane_up_state "$l")")" "$holders" "$cot"
}

lanes_json() {
  local l f=1
  printf '['
  for l in $ALL_LANE_IDS; do
    [[ $f -eq 1 ]] || printf ','
    f=0; lane_json_obj "$l"
  done
  printf ']\n'
}

status_json() {
  local n f=1 l occ
  printf '{"nodes":{'
  for n in spark1 spark2 spark3 spark4; do
    [[ $f -eq 1 ]] || printf ','
    f=0; printf '%s:%s' "$(json_str "$n")" "$(json_str "$(node_occupant "$n")")"
  done
  printf '},"lanes":['
  f=1
  for l in $ALL_LANE_IDS; do
    [[ $f -eq 1 ]] || printf ','
    f=0; lane_json_obj "$l"
  done
  printf ']}\n'
}

# Occupancy conflict check: returns a non-empty string naming any node that is
# occupied by a lane OTHER than the one being brought up. A node occupied by the
# SAME lane is not a conflict (the "already up?" check handles that case).
# FIXED 2026-09-25: previously only flagged "llm-lane" (unknown) and
# comfy-engine-on-spark2, so a named lane like dsv41-tp4 occupying the nodes
# was silently ignored and `up` launched on top of it (wedge risk).
occupancy_conflict() {
  local lane="$1" n occ conflict=""
  for n in $(lane_nodes "$lane"); do
    occ="$(node_occupants "$n")"
    # Report every OTHER tenant on the node, not just the top-precedence one.
    local other rest=""
    for other in $occ; do
      [[ "$other" == "$lane" ]] && continue
      rest="${rest:+$rest,}$other"
    done
    if [[ -n "$rest" ]]; then
      conflict="$conflict $n($rest)"
    fi
  done
  echo "$conflict"
}

# ── comfy engine ─────────────────────────────────────────────────────────────
# ComfyUI v0.38.1 on spark2 serves ALL FOUR creative families (music / image / design /
# video) from ONE GPU allocator. It replaces the retired two-lab creative-engine lane
# (spark-image-lab :7862 + ming-layer-web :8765), which reserved memory per-lab.
#
# WHY THIS LANE IS REGISTERED AT ALL: spark-comfy holds GB10 unified memory. While it was
# unregistered the harness could not see it, so once a TP3 cutover frees spark2 the census
# would report spark2 FREE with ComfyUI still resident — and occupancy_conflict() would
# clear a 4-node bring-up straight on top of it. That is the 2026-09-27 UMA-starvation
# wedge. Registering the lane is the fix; the memory cap that used to contain it is gone.
#
# BRING-UP IS DELEGATED to the recipe's own up.sh. The recipe repo is the source of truth
# for docker flags (--gpus all, --disable-pinned-memory, model mounts, no --restart);
# reconstructing them here would let the two drift.
# Turn an occupancy marker into a command that actually runs. `creative-engine-retired`
# and `llm-lane-unknown` are detection markers, NOT lane ids: `spark-lane down <marker>`
# exits 2 with "unknown lane", so emitting it as NEXT: breaks the machine-readable
# contract a follower model depends on.
comfy_park_hint() {
  local first="${1%% *}"
  case "$first" in
    creative-engine-retired) echo "ssh $COMFY_HOST 'docker stop ming-layer-web spark-image-lab'   # retired kit leftovers" ;;
    llm-lane-unknown)        echo "ssh $COMFY_HOST 'docker ps'   # unrecognised container holding the node" ;;
    *)                       echo "spark-lane down $first   # then: spark-lane up comfy-engine" ;;
  esac
}

comfy_wait() {
  local t=0 st code
  step "wait healthy" "container running + /system_stats 200 (budget ${COMFY_WAIT}s)"
  while [[ $t -lt $COMFY_WAIT ]]; do
    st="$(sshx "$COMFY_HOST" "docker inspect --format '{{.State.Status}}' $COMFY_CTN 2>/dev/null" || true)"
    if [[ "$st" == "running" ]]; then
      code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 "$COMFY_URL/system_stats")"
      if [[ "$code" == "200" ]]; then ok "running + http 200 after ${t}s"; return 0; fi
    fi
    sleep 10; t=$((t + 10))
  done
  note_fail "wait" "not healthy within ${COMFY_WAIT}s (container=${st:-absent} http=${code:-000})"
  NEXT_CMD="ssh spark2 'docker logs --tail 60 $COMFY_CTN'"
  return 1
}

comfy_engine_up() {
  STEPS=5; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  # FIRST, and before anything that could mutate: the recipe's up.sh opens with
  #   docker rm -f spark-comfy
  # so an ungated `up` on a live lane force-removes the container mid-render. Every
  # other lane gates this the same way ("already serving — no change made").
  step "already up?" "is $COMFY_URL already serving?"
  local pre; pre="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$COMFY_URL/system_stats")"
  if [[ "$pre" == "200" ]]; then
    ok "already serving — no change made (and no restart)"
    NEXT_CMD="nothing"
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)" "(already up, unchanged)"
    return 0
  fi
  ok "not serving — safe to start"

  step "occupancy" "spark2 must be free (ComfyUI wants the whole GB10 pool, uncapped)"
  local occ; occ="$(node_occupants "$COMFY_HOST")"
  local blockers="" o
  for o in $occ; do
    [[ "$o" == "comfy-engine" ]] && continue
    blockers="${blockers:+$blockers }$o"
  done
  if [[ -n "$blockers" ]]; then
    note_fail "occupancy" "$COMFY_HOST is held by: $blockers"
    NEXT_CMD="$(comfy_park_hint "$blockers")"
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
    return 1
  fi
  ok "$COMFY_HOST free"

  step "recipe" "$COMFY_DIR/up.sh present on $COMFY_HOST (source of truth for flags)"
  if ! sshx "$COMFY_HOST" "test -x $COMFY_DIR/up.sh"; then
    note_fail "recipe" "$COMFY_DIR/up.sh missing or not executable"
    NEXT_CMD="ssh $COMFY_HOST 'ls -l $COMFY_DIR'"
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
    return 1
  fi
  ok "up.sh present"

  step "start" "running the recipe up.sh"
  if ! sshx "$COMFY_HOST" "$COMFY_DIR/up.sh" >/dev/null 2>&1; then
    warn "up.sh returned non-zero — still judging by health below"
  fi
  ok "up.sh invoked"

  if ! comfy_wait; then
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
    return 1
  fi

  # NEXT_CMD must be set BEFORE result(): result() is what prints the NEXT line.
  [[ $FAILED -eq 0 ]] && NEXT_CMD="spark-lane verify comfy-engine"
  result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
  return $FAILED
}

comfy_engine_down() {
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  # Evict BEFORE stopping so the GB10 pool is handed back deliberately rather than
  # reclaimed by teardown. /free is ComfyUI's own unload endpoint; idle floor is ~758 MiB.
  step "evict" "unload weights + execution cache via $COMFY_URL/free"
  local fc
  fc="$(curl -s -o /dev/null -w '%{http_code}' -m 20 -X POST -H 'Content-Type: application/json' -d '{"unload_models":true,"free_memory":true}' "$COMFY_URL/free" 2>/dev/null)"
  if [[ "$fc" == "200" ]]; then ok "weights + cache evicted"; else warn "free returned ${fc:-000} (container may already be down)"; fi

  step "stop" "stopping $COMFY_CTN (weights on disk are never deleted)"
  sshx "$COMFY_HOST" "docker stop $COMFY_CTN >/dev/null 2>&1 || true"
  ok "stop issued"

  step "confirm" "no creative container left on spark2"
  sleep 3
  local left
  left="$(sshx "$COMFY_HOST" "docker ps --format '{{.Names}}' | grep -E 'spark-comfy|ming-layer-web|spark-image-lab' || true")"
  if [[ -n "$left" ]]; then
    note_fail "confirm" "still running: $(echo "$left" | paste -sd' ' -)"
    NEXT_CMD="ssh spark2 'docker stop $COMFY_CTN'"
  else
    ok "spark2 creative lane clear"
  fi

  result "comfy-engine" "down" "$COMFY_URL" "$(lane_model_id comfy-engine)"
  return $FAILED
}

# ── DeepSeek lanes ───────────────────────────────────────────────────────────
# The kit's own CLI is the source of truth for phases:
#   ./start.sh      doctor -> image -> share -> serve   (TP3)
#   ./start-tp4.sh  same flow with DSV41_LAUNCHER=tp4   (TP4)
dsv41_kit() { case "$1" in dsv41-tp3) echo "$TP3_KIT" ;; dsv41-tp4) echo "$TP4_KIT" ;; esac; }
dsv41_cli() { case "$1" in dsv41-tp3) echo "./start.sh" ;; dsv41-tp4) echo "./start-tp4.sh" ;; esac; }

dsv41_up() {
  local lane="$1" kit cli
  kit="$(dsv41_kit "$lane")"; cli="$(dsv41_cli "$lane")"
  STEPS=8; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "cleanup" "removing any dead containers left from a prior crash"
  cleanup_dead_containers "$lane"
  ok "dead containers cleared (if any)"

  step "kit" "$kit exists"
  if ! sshx "$DSV41_HEAD_HOST" "test -f $kit/$cli"; then
    if [[ "$lane" == "dsv41-tp4" ]]; then
      note_fail "kit" "$kit not staged yet"
      NEXT_CMD="spark-lane stage dsv41-tp4   # clone + write the fleet profile, then up"
    else
      note_fail "kit" "$kit/$cli missing on $DSV41_HEAD_HOST"
      NEXT_CMD="spark-lane status"
    fi
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "kit present"

  step "doctor" "$cli doctor (post-provision gate — the chain runner re-checks it after build+share)"
  # NOTE (fixed 2026-09-25): this is NOT a hard gate here. On a cold bring-up the
  # worker NFS volumes don't exist until `share` runs inside the chain, so a
  # doctor-first gate always self-refused. The chain runner (lane-up-runner.sh)
  # runs doctor AFTER build+share, where the weight check can actually pass. We
  # still surface a pre-flight doctor here for visibility, but a failure is not
  # fatal — the chain's post-provision doctor is the real gate.
  if ! sshx "$DSV41_HEAD_HOST" "cd $kit && $cli doctor" >/dev/null 2>&1; then
    warn "pre-flight doctor reported issues (expected on a cold bring-up before share) — proceeding; the chain re-runs doctor after build+share"
  else
    ok "doctor clean"
  fi

  # Never disturb a lane that is genuinely serving. Port-open is not proof, so this
  # shortcut requires a real completion.
  step "already up?" "is $DSV41_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$DSV41_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$DSV41_ENDPOINT" "$DSV41_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "chain" "build -> share/pack (first time) -> doctor -> serve, detached"
  scp -q -o ConnectTimeout=10 "$HERE/lane-profiles/lane-up-runner.sh" "$DSV41_HEAD_HOST:$kit/spark-lane-run.sh" 2>/dev/null
  if ! sshx "$DSV41_HEAD_HOST" "test -f $kit/spark-lane-run.sh"; then
    note_fail "chain" "could not place the chain runner on $DSV41_HEAD_HOST"
    NEXT_CMD="scp $HERE/lane-profiles/lane-up-runner.sh $DSV41_HEAD_HOST:$kit/spark-lane-run.sh"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  local log="$kit/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$DSV41_HEAD_HOST" "cd $kit && setsid nohup bash spark-lane-run.sh $lane $kit >> $log 2>&1 < /dev/null"
  ok "launched detached (survives this session); log: $log"
  info "cold 4-Spark build fetches pinned sources on all four nodes — this can take a long while"

  # Wait on two signals: the endpoint becoming healthy, OR the chain dying. A silent
  # cold build must not look like a hang, so progress is printed as it goes.
  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or chain exit (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$DSV41_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$DSV41_HEAD_HOST" "pgrep -f 'spark-lane-run.sh' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$DSV41_HEAD_HOST" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "chain" "the bring-up chain exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'tail -60 $log'"
      result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$DSV41_HEAD_HOST" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $DSV41_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi

  step "identity" "served model name must be $DSV41_MODEL"
  local ids
  ids="$(curl -s -m 10 "$DSV41_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$DSV41_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $DSV41_MODEL"
    NEXT_CMD="ssh $DSV41_HEAD_HOST 'grep -n served-model $kit/.env'"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "serving $ids"

  step "canary" "real chat completion (port-open is not proof)"
  canary "$DSV41_ENDPOINT" "$DSV41_MODEL" || { result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"; return 1; }

  result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL" "(chat verified)"
  NEXT_CMD="nothing — lane is serving. To put the comfy engine back: spark-lane rotate comfy-engine"
  return 0
}

dsv41_down() {
  local lane="$1" kit cli
  kit="$(dsv41_kit "$lane")"; cli="$(dsv41_cli "$lane")"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "stop" "$cli stop (bounded, ${DSV41_STOP_TIMEOUT:-180}s cap)"
  # Incident 2026-09-25: an unbounded ssh call here let a wedged upstream
  # stop.sh hang the head node indefinitely (NVRM OOM storm, no clean
  # shutdown, required a physical power-cycle). `timeout` on the ssh client
  # side can't un-stick a wedged remote host, but it stops this script from
  # sitting there blind -- a timeout is now a loud FAIL with a clear next
  # step instead of a silent multi-hour hang.
  if ! timeout_run "${DSV41_STOP_TIMEOUT:-180}" ssh $SSH_OPTS "$DSV41_HEAD_HOST" "cd $kit && $cli stop" >/dev/null 2>&1; then
    note_fail "stop" "$cli stop returned non-zero OR timed out after ${DSV41_STOP_TIMEOUT:-180}s -- if it timed out, the head node may be wedged; verify with 'ssh $DSV41_HEAD_HOST uptime' before retrying, do not just re-run"
    NEXT_CMD="ssh $DSV41_HEAD_HOST 'cd $kit && $cli stop'   # run in the foreground to see whether it hangs or fails cleanly"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "stop issued"

  step "verify torn down" "no lane containers left on $(lane_nodes "$lane")"
  local n left="" c
  for n in $(lane_nodes "$lane"); do
    c="$(docker_names "$n" | grep -E 'dsv41-[34]x|sglang' || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all required nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights and images were NOT deleted."
  return 0
}

# ── GLM-5.3-Flash EXL3 TP3 lane ─────────────────────────────────────────────
# Mia's recipe: start-tp3.sh is a SINGLE self-contained command (build/sync/serve
# in one), unlike the DSV kit's phased doctor->build->share->serve. So the up flow
# is: occupancy -> kit present -> already-up? -> run start detached -> wait -> canary.
glm53_up() {
  local lane="glm53-tp3"
  STEPS=7; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "cleanup" "removing any dead containers left from a prior crash"
  cleanup_dead_containers "$lane"
  ok "dead containers cleared (if any)"

  step "kit" "$GLM53_KIT/$GLM53_CLI exists"
  if ! sshx "$GLM53_HEAD_HOST" "test -f $GLM53_KIT/$GLM53_CLI"; then
    note_fail "kit" "$GLM53_KIT/$GLM53_CLI missing on $GLM53_HEAD_HOST"
    NEXT_CMD="spark-lane status"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "kit present"

  step "already up?" "is $GLM53_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$GLM53_ENDPOINT" "$GLM53_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "start" "$GLM53_CLI start (detached, survives this session)"
  local log="$GLM53_KIT/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$GLM53_HEAD_HOST" "cd $GLM53_KIT && setsid nohup bash $GLM53_CLI start >> $log 2>&1 < /dev/null"
  ok "launched detached; log: $log"
  info "GLM EXL3 TP3 boot is ~15-25 min (weights + drafter + FlashInfer autotune)"

  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or start exited (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$GLM53_HEAD_HOST" "pgrep -f '$GLM53_CLI start' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$GLM53_HEAD_HOST" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "start" "the start command exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $GLM53_HEAD_HOST 'tail -60 $log'"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$GLM53_HEAD_HOST" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $GLM53_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi

  step "identity" "served model name must be $GLM53_MODEL"
  local ids
  ids="$(curl -s -m 10 "$GLM53_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$GLM53_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $GLM53_MODEL"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'grep -n SERVED_MODEL_NAME $GLM53_KIT/.env.tp3'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
