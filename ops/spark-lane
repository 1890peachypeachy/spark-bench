# Minimal JSON string escape (values here are ids/hosts/models — no control chars).
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

# up | down | partial, derived from live per-node occupants (never from labels).
#   up      = every node in the lane is held by this lane
#   down    = the lane holds none of its nodes (whoever else holds them is separate;
#             down-but-blocked is `down` + a non-empty `holders` map)
#   partial = the lane holds some but not all of its nodes (a broken half-up)
lane_up_state() {
  local lane="$1" n occ total=0 mine=0
  for n in $(lane_nodes "$lane"); do
    total=$((total + 1))
    occ="$(node_occupants "$n")"
    # membership, not equality: a co-tenanted node still counts as held by this lane
    case " $occ " in *" $lane "*) mine=$((mine + 1)) ;; esac
  done
  if   [[ $mine -eq $total ]]; then echo up
  elif [[ $mine -gt 0 ]];      then echo partial
  else echo down
  fi
}

# JSON object for one lane: {id,nodes[],endpoint,model,status,holders{node:lane}}
lane_json_obj() {
  local l="$1" nodes="[" n f=1 holders="{" hf=1 occ rest
  for n in $(lane_nodes "$l"); do
    [[ $f -eq 1 ]] || nodes="$nodes,"
    f=0; nodes="$nodes$(json_str "$n")"
  done
  nodes="$nodes]"
  # CONTRACT (sparkDash LaneManager + its test fixture): `holders` is "the lanes blocking
  # me, excluding my own claim" — an UP lane reports {}, and every VALUE must be a single
  # parkable lane id. Do not comma-join co-tenants here: LaneManager does
  # `downSet.has(holder)` to decide which nodes a requested `down` frees, so a joined
  # string never matches a lane id and a legitimate rotation gets wrongly blocked.
  # Co-tenancy is reported separately, below.
  local other cot="{" cf=1 mine
  for n in $(lane_nodes "$l"); do
    occ="$(node_occupants "$n")"
    mine=0
    case " $occ " in *" $l "*) mine=1 ;; esac
    if [[ $mine -eq 1 ]]; then
      # I hold this node. Anyone else on it is a co-tenant, not a blocker.
      rest=""
      for other in $occ; do
        [[ "$other" == "$l" ]] && continue
        rest="${rest:+$rest,}$other"
      done
      if [[ -n "$rest" ]]; then
        [[ $cf -eq 1 ]] || cot="$cot,"
        cf=0; cot="$cot$(json_str "$n"):$(json_str "$rest")"
      fi
      continue
    fi
    # I do not hold it: report the top-precedence occupant as a single lane id.
    occ="${occ%% *}"
    [[ -z "$occ" ]] && continue
    [[ $hf -eq 1 ]] || holders="$holders,"
    hf=0; holders="$holders$(json_str "$n"):$(json_str "$occ")"
  done
  cot="$cot}"
  holders="$holders}"
  printf '{"id":%s,"nodes":%s,"endpoint":%s,"model":%s,"status":%s,"holders":%s,"co_tenants":%s}' \
    "$(json_str "$l")" "$nodes" "$(json_str "$(lane_endpoint "$l")")" \
    "$(json_str "$(lane_model_id "$l")")" "$(json_str "$(lane_up_state "$l")")" "$holders" "$cot"
}

lanes_json() {
  local l f=1
  printf '['
  for l in $ALL_LANE_IDS; do
    [[ $f -eq 1 ]] || printf ','
    f=0; lane_json_obj "$l"
  done
  printf ']\n'
}

status_json() {
  local n f=1 l occ
  printf '{"nodes":{'
  for n in spark1 spark2 spark3 spark4; do
    [[ $f -eq 1 ]] || printf ','
    f=0; printf '%s:%s' "$(json_str "$n")" "$(json_str "$(node_occupant "$n")")"
  done
  printf '},"lanes":['
  f=1
  for l in $ALL_LANE_IDS; do
    [[ $f -eq 1 ]] || printf ','
    f=0; lane_json_obj "$l"
  done
  printf ']}\n'
}

# Occupancy conflict check: returns a non-empty string naming any node that is
# occupied by a lane OTHER than the one being brought up. A node occupied by the
# SAME lane is not a conflict (the "already up?" check handles that case).
# FIXED 2026-09-25: previously only flagged "llm-lane" (unknown) and
# comfy-engine-on-spark2, so a named lane like dsv41-tp4 occupying the nodes
# was silently ignored and `up` launched on top of it (wedge risk).
occupancy_conflict() {
  local lane="$1" n occ conflict=""
  for n in $(lane_nodes "$lane"); do
    occ="$(node_occupants "$n")"
    # Report every OTHER tenant on the node, not just the top-precedence one.
    local other rest=""
    for other in $occ; do
      [[ "$other" == "$lane" ]] && continue
      rest="${rest:+$rest,}$other"
    done
    if [[ -n "$rest" ]]; then
      conflict="$conflict $n($rest)"
    fi
  done
  echo "$conflict"
}

# ── comfy engine ─────────────────────────────────────────────────────────────
# ComfyUI v0.38.1 on spark2 serves ALL FOUR creative families (music / image / design /
# video) from ONE GPU allocator. It replaces the retired two-lab creative-engine lane
# (spark-image-lab :7862 + ming-layer-web :8765), which reserved memory per-lab.
#
# WHY THIS LANE IS REGISTERED AT ALL: spark-comfy holds GB10 unified memory. While it was
# unregistered the harness could not see it, so once a TP3 cutover frees spark2 the census
# would report spark2 FREE with ComfyUI still resident — and occupancy_conflict() would
# clear a 4-node bring-up straight on top of it. That is the 2026-09-27 UMA-starvation
# wedge. Registering the lane is the fix; the memory cap that used to contain it is gone.
#
# BRING-UP IS DELEGATED to the recipe's own up.sh. The recipe repo is the source of truth
# for docker flags (--gpus all, --disable-pinned-memory, model mounts, no --restart);
# reconstructing them here would let the two drift.
# Turn an occupancy marker into a command that actually runs. `creative-engine-retired`
# and `llm-lane-unknown` are detection markers, NOT lane ids: `spark-lane down <marker>`
# exits 2 with "unknown lane", so emitting it as NEXT: breaks the machine-readable
# contract a follower model depends on.
comfy_park_hint() {
  local first="${1%% *}"
  case "$first" in
    creative-engine-retired) echo "ssh $COMFY_HOST 'docker stop ming-layer-web spark-image-lab'   # retired kit leftovers" ;;
    llm-lane-unknown)        echo "ssh $COMFY_HOST 'docker ps'   # unrecognised container holding the node" ;;
    *)                       echo "spark-lane down $first   # then: spark-lane up comfy-engine" ;;
  esac
}

comfy_wait() {
  local t=0 st code
  step "wait healthy" "container running + /system_stats 200 (budget ${COMFY_WAIT}s)"
  while [[ $t -lt $COMFY_WAIT ]]; do
    st="$(sshx "$COMFY_HOST" "docker inspect --format '{{.State.Status}}' $COMFY_CTN 2>/dev/null" || true)"
    if [[ "$st" == "running" ]]; then
      code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 "$COMFY_URL/system_stats")"
      if [[ "$code" == "200" ]]; then ok "running + http 200 after ${t}s"; return 0; fi
    fi
    sleep 10; t=$((t + 10))
  done
  note_fail "wait" "not healthy within ${COMFY_WAIT}s (container=${st:-absent} http=${code:-000})"
  NEXT_CMD="ssh spark2 'docker logs --tail 60 $COMFY_CTN'"
  return 1
}

comfy_engine_up() {
  STEPS=5; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  # FIRST, and before anything that could mutate: the recipe's up.sh opens with
  #   docker rm -f spark-comfy
  # so an ungated `up` on a live lane force-removes the container mid-render. Every
  # other lane gates this the same way ("already serving — no change made").
  step "already up?" "is $COMFY_URL already serving?"
  local pre; pre="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$COMFY_URL/system_stats")"
  if [[ "$pre" == "200" ]]; then
    ok "already serving — no change made (and no restart)"
    NEXT_CMD="nothing"
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)" "(already up, unchanged)"
    return 0
  fi
  ok "not serving — safe to start"

  step "occupancy" "spark2 must be free (ComfyUI wants the whole GB10 pool, uncapped)"
  local occ; occ="$(node_occupants "$COMFY_HOST")"
  local blockers="" o
  for o in $occ; do
    [[ "$o" == "comfy-engine" ]] && continue
    blockers="${blockers:+$blockers }$o"
  done
  if [[ -n "$blockers" ]]; then
    note_fail "occupancy" "$COMFY_HOST is held by: $blockers"
    NEXT_CMD="$(comfy_park_hint "$blockers")"
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
    return 1
  fi
  ok "$COMFY_HOST free"

  step "recipe" "$COMFY_DIR/up.sh present on $COMFY_HOST (source of truth for flags)"
  if ! sshx "$COMFY_HOST" "test -x $COMFY_DIR/up.sh"; then
    note_fail "recipe" "$COMFY_DIR/up.sh missing or not executable"
    NEXT_CMD="ssh $COMFY_HOST 'ls -l $COMFY_DIR'"
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
    return 1
  fi
  ok "up.sh present"

  step "start" "running the recipe up.sh"
  if ! sshx "$COMFY_HOST" "$COMFY_DIR/up.sh" >/dev/null 2>&1; then
    warn "up.sh returned non-zero — still judging by health below"
  fi
  ok "up.sh invoked"

  if ! comfy_wait; then
    result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
    return 1
  fi

  # NEXT_CMD must be set BEFORE result(): result() is what prints the NEXT line.
  [[ $FAILED -eq 0 ]] && NEXT_CMD="spark-lane verify comfy-engine"
  result "comfy-engine" "up" "$COMFY_URL" "$(lane_model_id comfy-engine)"
  return $FAILED
}

comfy_engine_down() {
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  # Evict BEFORE stopping so the GB10 pool is handed back deliberately rather than
  # reclaimed by teardown. /free is ComfyUI's own unload endpoint; idle floor is ~758 MiB.
  step "evict" "unload weights + execution cache via $COMFY_URL/free"
  local fc
  fc="$(curl -s -o /dev/null -w '%{http_code}' -m 20 -X POST -H 'Content-Type: application/json' -d '{"unload_models":true,"free_memory":true}' "$COMFY_URL/free" 2>/dev/null)"
  if [[ "$fc" == "200" ]]; then ok "weights + cache evicted"; else warn "free returned ${fc:-000} (container may already be down)"; fi

  step "stop" "stopping $COMFY_CTN (weights on disk are never deleted)"
  sshx "$COMFY_HOST" "docker stop $COMFY_CTN >/dev/null 2>&1 || true"
  ok "stop issued"

  step "confirm" "no creative container left on spark2"
  sleep 3
  local left
  left="$(sshx "$COMFY_HOST" "docker ps --format '{{.Names}}' | grep -E 'spark-comfy|ming-layer-web|spark-image-lab' || true")"
  if [[ -n "$left" ]]; then
    note_fail "confirm" "still running: $(echo "$left" | paste -sd' ' -)"
    NEXT_CMD="ssh spark2 'docker stop $COMFY_CTN'"
  else
    ok "spark2 creative lane clear"
  fi

  result "comfy-engine" "down" "$COMFY_URL" "$(lane_model_id comfy-engine)"
  return $FAILED
}

# ── DeepSeek lanes ───────────────────────────────────────────────────────────
# The kit's own CLI is the source of truth for phases:
#   ./start.sh      doctor -> image -> share -> serve   (TP3)
#   ./start-tp4.sh  same flow with DSV41_LAUNCHER=tp4   (TP4)
dsv41_kit() { case "$1" in dsv41-tp3) echo "$TP3_KIT" ;; dsv41-tp4) echo "$TP4_KIT" ;; esac; }
dsv41_cli() { case "$1" in dsv41-tp3) echo "./start.sh" ;; dsv41-tp4) echo "./start-tp4.sh" ;; esac; }

dsv41_up() {
  local lane="$1" kit cli
  kit="$(dsv41_kit "$lane")"; cli="$(dsv41_cli "$lane")"
  STEPS=8; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "cleanup" "removing any dead containers left from a prior crash"
  cleanup_dead_containers "$lane"
  ok "dead containers cleared (if any)"

  step "kit" "$kit exists"
  if ! sshx "$DSV41_HEAD_HOST" "test -f $kit/$cli"; then
    if [[ "$lane" == "dsv41-tp4" ]]; then
      note_fail "kit" "$kit not staged yet"
      NEXT_CMD="spark-lane stage dsv41-tp4   # clone + write the fleet profile, then up"
    else
      note_fail "kit" "$kit/$cli missing on $DSV41_HEAD_HOST"
      NEXT_CMD="spark-lane status"
    fi
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "kit present"

  step "doctor" "$cli doctor (post-provision gate — the chain runner re-checks it after build+share)"
  # NOTE (fixed 2026-09-25): this is NOT a hard gate here. On a cold bring-up the
  # worker NFS volumes don't exist until `share` runs inside the chain, so a
  # doctor-first gate always self-refused. The chain runner (lane-up-runner.sh)
  # runs doctor AFTER build+share, where the weight check can actually pass. We
  # still surface a pre-flight doctor here for visibility, but a failure is not
  # fatal — the chain's post-provision doctor is the real gate.
  if ! sshx "$DSV41_HEAD_HOST" "cd $kit && $cli doctor" >/dev/null 2>&1; then
    warn "pre-flight doctor reported issues (expected on a cold bring-up before share) — proceeding; the chain re-runs doctor after build+share"
  else
    ok "doctor clean"
  fi

  # Never disturb a lane that is genuinely serving. Port-open is not proof, so this
  # shortcut requires a real completion.
  step "already up?" "is $DSV41_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$DSV41_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$DSV41_ENDPOINT" "$DSV41_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "chain" "build -> share/pack (first time) -> doctor -> serve, detached"
  scp -q -o ConnectTimeout=10 "$HERE/lane-profiles/lane-up-runner.sh" "$DSV41_HEAD_HOST:$kit/spark-lane-run.sh" 2>/dev/null
  if ! sshx "$DSV41_HEAD_HOST" "test -f $kit/spark-lane-run.sh"; then
    note_fail "chain" "could not place the chain runner on $DSV41_HEAD_HOST"
    NEXT_CMD="scp $HERE/lane-profiles/lane-up-runner.sh $DSV41_HEAD_HOST:$kit/spark-lane-run.sh"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  local log="$kit/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$DSV41_HEAD_HOST" "cd $kit && setsid nohup bash spark-lane-run.sh $lane $kit >> $log 2>&1 < /dev/null"
  ok "launched detached (survives this session); log: $log"
  info "cold 4-Spark build fetches pinned sources on all four nodes — this can take a long while"

  # Wait on two signals: the endpoint becoming healthy, OR the chain dying. A silent
  # cold build must not look like a hang, so progress is printed as it goes.
  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or chain exit (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$DSV41_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$DSV41_HEAD_HOST" "pgrep -f 'spark-lane-run.sh' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$DSV41_HEAD_HOST" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "chain" "the bring-up chain exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'tail -60 $log'"
      result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$DSV41_HEAD_HOST" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $DSV41_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi

  step "identity" "served model name must be $DSV41_MODEL"
  local ids
  ids="$(curl -s -m 10 "$DSV41_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$DSV41_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $DSV41_MODEL"
    NEXT_CMD="ssh $DSV41_HEAD_HOST 'grep -n served-model $kit/.env'"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "serving $ids"

  step "canary" "real chat completion (port-open is not proof)"
  canary "$DSV41_ENDPOINT" "$DSV41_MODEL" || { result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"; return 1; }

  result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL" "(chat verified)"
  NEXT_CMD="nothing — lane is serving. To put the comfy engine back: spark-lane rotate comfy-engine"
  return 0
}

dsv41_down() {
  local lane="$1" kit cli
  kit="$(dsv41_kit "$lane")"; cli="$(dsv41_cli "$lane")"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "stop" "$cli stop (bounded, ${DSV41_STOP_TIMEOUT:-180}s cap)"
  # Incident 2026-09-25: an unbounded ssh call here let a wedged upstream
  # stop.sh hang the head node indefinitely (NVRM OOM storm, no clean
  # shutdown, required a physical power-cycle). `timeout` on the ssh client
  # side can't un-stick a wedged remote host, but it stops this script from
  # sitting there blind -- a timeout is now a loud FAIL with a clear next
  # step instead of a silent multi-hour hang.
  if ! timeout_run "${DSV41_STOP_TIMEOUT:-180}" ssh $SSH_OPTS "$DSV41_HEAD_HOST" "cd $kit && $cli stop" >/dev/null 2>&1; then
    note_fail "stop" "$cli stop returned non-zero OR timed out after ${DSV41_STOP_TIMEOUT:-180}s -- if it timed out, the head node may be wedged; verify with 'ssh $DSV41_HEAD_HOST uptime' before retrying, do not just re-run"
    NEXT_CMD="ssh $DSV41_HEAD_HOST 'cd $kit && $cli stop'   # run in the foreground to see whether it hangs or fails cleanly"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "stop issued"

  step "verify torn down" "no lane containers left on $(lane_nodes "$lane")"
  local n left="" c
  for n in $(lane_nodes "$lane"); do
    c="$(docker_names "$n" | grep -E 'dsv41-[34]x|sglang' || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all required nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights and images were NOT deleted."
  return 0
}

# ── GLM-5.3-Flash EXL3 TP3 lane ─────────────────────────────────────────────
# Mia's recipe: start-tp3.sh is a SINGLE self-contained command (build/sync/serve
# in one), unlike the DSV kit's phased doctor->build->share->serve. So the up flow
# is: occupancy -> kit present -> already-up? -> run start detached -> wait -> canary.
glm53_up() {
  local lane="glm53-tp3"
  STEPS=7; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "cleanup" "removing any dead containers left from a prior crash"
  cleanup_dead_containers "$lane"
  ok "dead containers cleared (if any)"

  step "kit" "$GLM53_KIT/$GLM53_CLI exists"
  if ! sshx "$GLM53_HEAD_HOST" "test -f $GLM53_KIT/$GLM53_CLI"; then
    note_fail "kit" "$GLM53_KIT/$GLM53_CLI missing on $GLM53_HEAD_HOST"
    NEXT_CMD="spark-lane status"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "kit present"

  step "already up?" "is $GLM53_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$GLM53_ENDPOINT" "$GLM53_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "start" "$GLM53_CLI start (detached, survives this session)"
  local log="$GLM53_KIT/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$GLM53_HEAD_HOST" "cd $GLM53_KIT && setsid nohup bash $GLM53_CLI start >> $log 2>&1 < /dev/null"
  ok "launched detached; log: $log"
  info "GLM EXL3 TP3 boot is ~15-25 min (weights + drafter + FlashInfer autotune)"

  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or start exited (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$GLM53_HEAD_HOST" "pgrep -f '$GLM53_CLI start' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$GLM53_HEAD_HOST" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "start" "the start command exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $GLM53_HEAD_HOST 'tail -60 $log'"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$GLM53_HEAD_HOST" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $GLM53_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
