  step "nfs" "dsv41-nfs export alive on $GLM53_TP4_TF_HEAD (all workers read weights through it)"
  if ! sshx "$GLM53_TP4_TF_HEAD" "docker ps --format '{{.Names}}' | grep -q '^dsv41-nfs$'" 2>/dev/null; then
    note_fail "nfs" "dsv41-nfs is NOT running on $GLM53_TP4_TF_HEAD — the workers' NFS volumes would hard-hang instead of failing fast"
    NEXT_CMD="ssh $GLM53_TP4_TF_HEAD 'docker start dsv41-nfs'   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "dsv41-nfs up"

  step "already up?" "is $GLM53_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary_tf2 "$GLM53_ENDPOINT" "$GLM53_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "start" "./start-tp4.sh on $GLM53_TP4_TF_HEAD (detached, survives this session)"
  local log="$GLM53_TP4_TF_KIT/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$GLM53_TP4_TF_HEAD" "cd $GLM53_TP4_TF_KIT && setsid nohup bash ./start-tp4.sh >> $log 2>&1 < /dev/null"
  ok "launched detached; log: $log"
  info "TensorFold TP4 boot: 4 ranks (spark3 head, spark1+spark2+spark4 workers over NFS); first boot compiles kernels (~6+ min, cached after)"

  local ok_wait=0 t=0 code="" last=""
  step "wait healthy" "endpoint up, or start exited (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$GLM53_TP4_TF_HEAD" "pgrep -f 'start-tp4[.]sh' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$GLM53_TP4_TF_HEAD" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "start" "the start command exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $GLM53_TP4_TF_HEAD 'tail -60 $log'"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$GLM53_TP4_TF_HEAD" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $GLM53_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi

  step "identity" "served model name must be $GLM53_MODEL, TP4 across 4 nodes"
  local ids up_ranks=0
  ids="$(curl -s -m 10 "$GLM53_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$GLM53_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $GLM53_MODEL"
    NEXT_CMD="ssh $GLM53_TP4_TF_HEAD 'grep -rn SERVED_NAME $GLM53_TP4_TF_KIT/scripts/'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  for n in $(lane_nodes "$lane"); do
    [[ "$(sshx "$n" "docker ps --filter name=^/glm53-tf4$ -q | wc -l" 2>/dev/null || echo 0)" != "0" ]] && up_ranks=$((up_ranks + 1))
  done
  if [[ $up_ranks -ne 4 ]]; then
    note_fail "identity" "serving $ids but only $up_ranks/4 ranks are up — this is NOT a healthy TP4"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "serving $ids on 4/4 ranks"

  step "canary" "real chat completion (port-open is not proof)"
  # TensorFold is reasoning-first: the generic 8-token canary returns content=None.
  canary_tf2 "$GLM53_ENDPOINT" "$GLM53_MODEL" || { result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"; return 1; }

  result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(chat verified, TP4 4/4)"
  NEXT_CMD="nothing — lane is serving."
  return 0
}

glm53_tp4_down() {
  local lane="glm53-tp4"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "stop" "./stop.sh on $GLM53_TP4_TF_HEAD (bounded, ${DSV41_STOP_TIMEOUT:-180}s cap)"
  if ! timeout_run "${DSV41_STOP_TIMEOUT:-180}" ssh $SSH_OPTS "$GLM53_TP4_TF_HEAD" "cd $GLM53_TP4_TF_KIT && ./stop.sh" >/dev/null 2>&1; then
    note_fail "stop" "./stop.sh returned non-zero OR timed out after ${DSV41_STOP_TIMEOUT:-180}s — verify with 'ssh $GLM53_TP4_TF_HEAD uptime' before retrying"
    NEXT_CMD="ssh $GLM53_TP4_TF_HEAD 'cd $GLM53_TP4_TF_KIT && ./stop.sh'   # run in the foreground to see whether it hangs or fails cleanly"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "stop issued"

  # The pre-repoint knapcio containers (glm53-alignfix-20260929-r*) are DELIBERATELY
  # not matched here: they are the preserved rollback lane (docker stop, NOT rm —
  # see CUTOVER-2026-10-10.md). Only this lane's own TensorFold rank counts.
  step "verify torn down" "no glm53-tf4 ranks left on $(lane_nodes "$lane")"
  local n left="" c
  for n in $(lane_nodes "$lane"); do
    c="$(docker_names "$n" | grep -E '^glm53-tf4' || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all required nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights and images were NOT deleted."
  return 0
}

# ── stage (TP4 kit deploy, idempotent) ───────────────────────────────────────
stage_tp4() {
  STEPS=4; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  step "clone" "$REPO_URL -> $TP4_KIT"
  if sshx "$DSV41_HEAD_HOST" "test -d $TP4_KIT/.git"; then
    ok "already cloned (leaving it in place)"
  else
    if ! sshx "$DSV41_HEAD_HOST" "git clone -q $REPO_URL $TP4_KIT"; then
      note_fail "clone" "git clone failed on $DSV41_HEAD_HOST"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'git clone $REPO_URL $TP4_KIT'"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    ok "cloned"
  fi

  step "profile" ".env.tp4 = upstream example + our fleet deltas (deterministic builder)"
  if sshx "$DSV41_HEAD_HOST" "test -f $TP4_KIT/.env.tp4"; then
    info "profile already present — NOT overwritten (rm it to rebuild deliberately)"
  else
    local prof
    if [[ ! -f "$HERE/lane-profiles/build-dsv41-tp4-env.py" ]]; then
      note_fail "profile" "builder missing: $HERE/lane-profiles/build-dsv41-tp4-env.py"
      NEXT_CMD="spark-lane stage dsv41-tp4"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    scp -q -o ConnectTimeout=10 "$HERE/lane-profiles/build-dsv41-tp4-env.py" "$DSV41_HEAD_HOST:$TP4_KIT/"
    prof="$(sshx "$DSV41_HEAD_HOST" "cd $TP4_KIT && python3 build-dsv41-tp4-env.py ." 2>&1)"
    printf '%s\n' "$prof" | sed 's/^/        /'
    if ! printf '%s' "$prof" | grep -q '^RESULT: PASS'; then
      note_fail "profile" "builder refused to produce a valid .env.tp4 (see output above)"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'cd $TP4_KIT && python3 build-dsv41-tp4-env.py .'"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    ok "profile built and self-verified"
  fi

  # Bug fixed 2026-09-25: this used to require a full local copy of the 516G
  # checkpoint on ALL FOUR nodes, which both isn't how the recipe actually
  # works and made TP4 physically impossible on spark4 (916G disk, only
  # 164G free). The profile we just built has NFS_SHARE=1 (see
  # .env.tp4 / start.sh's own doctor+serve logic) -- same design as TP3:
  # only the HEAD keeps the local checkpoint at $MODEL_DIR, and workers
  # mount it read-only over NFSv4 on the CX7 fabric via the dsv41-nfs
  # exporter. So the real precondition is just "does the head have a
  # complete local copy", not "does every node".
  step "weights" "head node has the local checkpoint (workers read it over NFS, NFS_SHARE=1)"
  if ! sshx "$DSV41_HEAD_HOST" "test -d /var/tmp/models/DeepSeek-V4.1-Flash"; then
    note_fail "weights" "model dir missing on head ($DSV41_HEAD_HOST) -- this one actually needs a local copy"
    NEXT_CMD="spark-lane status   # stage weights on $DSV41_HEAD_HOST first (fabric transfer, not LAN)"
    result "dsv41-tp4" "stage" "-" "-"; return 1
  fi
  ok "head has the checkpoint; workers will mount it over NFS during 'up' (no local copy needed)"

  result "dsv41-tp4" "stage" "-" "-"
  NEXT_CMD="spark-lane up dsv41-tp4   # doctor -> build -> share/pack -> serve (detached). A cold build needs github.com + pypi.org and takes a long while; watch it with: spark-lane logs dsv41-tp4"
  return 0
}

# ── verify ───────────────────────────────────────────────────────────────────
verify_lane() {
  local lane="$1"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  # ComfyUI is NOT an OpenAI endpoint: no /v1/models, no chat completions. The standard
  # path below would fail forever against it, so comfy-engine gets its own checks.
  # The GPU step is the one that matters — ComfyUI will happily fall back to CPU and
  # still answer 200, which looks healthy while being useless for a 5s video shot.
  if [[ "$lane" == "comfy-engine" ]]; then
    step "endpoint" "$COMFY_URL/system_stats"
    local code; code="$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$COMFY_URL/system_stats")"
    if [[ "$code" == "200" ]]; then ok "200"; else
      note_fail "endpoint" "http ${code:-000}"; NEXT_CMD="spark-lane up comfy-engine"
      result "$lane" "verify" "$COMFY_URL" "$(lane_model_id "$lane")"; return $FAILED
    fi

    step "gpu" "ComfyUI must report a CUDA device, not a CPU fallback"
    local dev; dev="$(curl -s -m 10 "$COMFY_URL/system_stats" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin); x = (d.get("devices") or [{}])[0]
    print("%s|%s|%.1f" % (x.get("type",""), x.get("name","?"), x.get("vram_total",0)/2**30))
except Exception:
    print("||0")' 2>/dev/null)"
    case "$dev" in
      cuda*) ok "cuda ${dev#*|} GiB" ;;
      *)     note_fail "gpu" "not on CUDA (device='${dev:-unknown}') — CPU fallback is not acceptable"
             NEXT_CMD="ssh spark2 'docker logs --tail 60 $COMFY_CTN'" ;;
    esac

    step "loaders" "weight FILES for the four families are visible to their loaders"
    # Must match weight FILENAMES, never the raw blob. ComfyUI v0.38.1 ships node classes
    # (MiniMaxH3ImageToVideo, YuE2GenerateMusic, ...) whether or not weights are mounted:
    # bare 'h3' still occurs 103x and 'yue2' 20x after every filename is stripped, so the
    # music and video checks passed with the mounts EMPTY. Only strings ending in a weight
    # extension count, which is what the loader dropdowns actually offer.
    local fam; fam="$(curl -s -m 25 "$COMFY_URL/object_info" | python3 -c 'import json,sys,re
try:
    blob = json.dumps(json.load(sys.stdin))
except Exception:
    print("unreadable"); raise SystemExit
files = " ".join(re.findall(r"[A-Za-z0-9_.\-]+\.(?:safetensors|gguf|sft|pt|pth|bin|ckpt)", blob)).lower()
want = {"music":"yue2_", "image":"qwen_image", "design":"ming_image", "video":"minimax_h3"}
print(" ".join(k if v in files else k.upper()+"-MISSING" for k,v in want.items()))' 2>/dev/null)"
    case "$fam" in
      *MISSING*|unreadable|"") note_fail "loaders" "families: ${fam:-unreadable}"
                               NEXT_CMD="ssh spark2 'ls /home/spark2/comfy-models'" ;;
      *) ok "$fam" ;;
    esac

    result "$lane" "verify" "$COMFY_URL" "$(lane_model_id "$lane")"
    return $FAILED
  fi
  local ep model
  ep="$(lane_endpoint "$lane")"; model="$(lane_model_id "$lane")"
  step "endpoint" "$ep/models"
  local code; code="$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$ep/models")"
  if [[ "$code" != "200" ]]; then
    warn "http $code — falling through to a timed canary anyway (list-models is not proof)"
  else ok "200"; fi
  step "canary" "real chat completion"
  # glm53-tf2/tf3/tp4: TensorFold is reasoning-first — the generic canary's 8-token
  # budget returns content=None on it. Use the enable_thinking:false variant for real proof.
  case "$lane" in
    glm53-tf2|glm53-tp3|glm53-tp4) canary_tf2 "$ep" "$model" ;;
    *)                             canary "$ep" "$model" ;;
  esac
  result "$lane" "verify" "$ep" "$model"
  return $FAILED
}

# ── dispatch ─────────────────────────────────────────────────────────────────
usage() {
  cat <<USAGE
spark-lane — one-shot lane bring-up / teardown / rotation (DGX Spark fleet)

  spark-lane                     census: what is on every Spark right now
  spark-lane lanes               list lanes + the nodes each needs
  spark-lane up    <lane>        bring a lane up   (refuses if a required node is taken)
  spark-lane down  <lane>        park a lane       (verifies it really stopped)
  spark-lane verify <lane>       health only, changes nothing
  spark-lane rotate <lane>       park conflicting lanes, then bring this one up
  spark-lane stage dsv41-tp4     clone + fleet profile + weight check (no serve)

lanes:
  comfy-engine      spark2        ComfyUI music/image/design/video -> $COMFY_URL
  dsv41-tp3         spark1,3,4    DeepSeek V4.1-Flash TP3 -> $DSV41_ENDPOINT
  dsv41-tp4         spark1-4      DeepSeek V4.1-Flash TP4 -> $DSV41_ENDPOINT  (fast line)
  glm53-tp3         spark1,3,4    GLM-5.3-Flash EXL3 TP3  -> $GLM53_ENDPOINT
  glm53-tp4         spark1-4      GLM-5.3-Flash TP4       -> $GLM53_ENDPOINT  (TensorFold engine)
  glm53-tf2         spark3,4      GLM-5.3-Flash EXL3 TP2  -> $GLM53_ENDPOINT  (TensorFold engine)

The DeepSeek endpoint and model name are stable across TP3/TP4: $DSV41_ENDPOINT / $DSV41_MODEL
The GLM lane serves a distinct identity: $GLM53_ENDPOINT / $GLM53_MODEL
USAGE
}

ACT="${1:-status}"
LANE="${2:-}"

case "$ACT" in
  status|census)
    if [[ "$LANE" == "--json" ]]; then status_json; else census; fi ;;
  lanes)
    if [[ "$LANE" == "--json" ]]; then
      lanes_json
    else
      for l in $ALL_LANE_IDS; do
        printf '%-16s nodes: %-26s endpoint: %s\n' "$l" "$(lane_nodes "$l")" "$(lane_endpoint "$l")"
      done
    fi ;;
  up)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    case "$LANE" in comfy-engine) comfy_engine_up ;; glm53-tp3) glm53_tf3_up ;; glm53-tp4) glm53_tp4_up ;; glm53-tf2) glm53_tf2_up ;; *) dsv41_up "$LANE" ;; esac ;;
  down)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    case "$LANE" in comfy-engine) comfy_engine_down ;; glm53-tp3) glm53_tf3_down ;; glm53-tp4) glm53_tp4_down ;; glm53-tf2) glm53_tf2_down ;; *) dsv41_down "$LANE" ;; esac ;;
  verify)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    verify_lane "$LANE" ;;
  rotate)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    echo "${B}── rotate: park everything that $LANE needs, then bring it up ──${N}"
    occ_list=""
    for n in $(lane_nodes "$LANE"); do
      o="$(node_occupants "$n")"
      [[ -n "$o" ]] && occ_list="$occ_list $o"
    done
    for other in comfy-engine dsv41-tp3 dsv41-tp4 glm53-tp3 glm53-tp4 glm53-tf2; do
      [[ "$other" == "$LANE" ]] && continue
      case " $occ_list " in *" $other "*) echo "${Y}parks $other${N}"; "${0:-$HERE/spark-lane}" down "$other" || true ;; esac
    done
    exec "${0:-$HERE/spark-lane}" up "$LANE" ;;
  doctor)
    kit="$(dsv41_kit "${LANE:-}")"
    [[ -n "$kit" ]] || { echo "usage: spark-lane doctor <dsv41-tp3|dsv41-tp4>" >&2; exit 2; }
    cli="$(dsv41_cli "$LANE")"
    echo "${B}$cli doctor${N} on $DSV41_HEAD_HOST ($kit)"
    sshx "$DSV41_HEAD_HOST" "cd $kit && $cli doctor"; rc=$?
    printf 'RESULT: %s lane=%s action=doctor\n' "$([[ $rc -eq 0 ]] && echo PASS || echo FAIL)" "$LANE"
    if [[ $rc -eq 0 ]]; then printf 'NEXT: spark-lane up %s\n' "$LANE"; else printf 'NEXT: read the failure above\n'; fi
    exit $rc ;;
  logs)
    case "${LANE:-}" in
      glm53-tp3) kit="$GLM53_TP3_KIT"; host="$GLM53_TP3_HEAD" ;;
      glm53-tp4) kit="$GLM53_TP4_TF_KIT"; host="$GLM53_TP4_TF_HEAD" ;;
      glm53-tf2) kit="$GLM53_TF2_KIT"; host="$GLM53_TF2_HEAD" ;;
      dsv41-tp3|dsv41-tp4) kit="$(dsv41_kit "$LANE")"; host="$DSV41_HEAD_HOST" ;;
      *) echo "usage: spark-lane logs <dsv41-tp3|dsv41-tp4|glm53-tp3|glm53-tp4|glm53-tf2>" >&2; exit 2 ;;
    esac
    echo "${B}newest bring-up log on $host${N} (tail ${TAIL:-40})"
    sshx "$host" "f=\$(ls -1t $kit/lane-up-*.log 2>/dev/null | head -1); if [[ -n \"\$f\" ]]; then echo \"--- \$f\"; tail -${TAIL:-40} \"\$f\"; else echo 'no lane-up log yet'; fi" ;;
  stage)
    [[ "$LANE" == "dsv41-tp4" ]] || { echo "only 'stage dsv41-tp4' is supported" >&2; exit 2; }
    stage_tp4 ;;
  help|-h|--help) usage ;;
  *) echo "unknown action: $ACT" >&2; usage; exit 2 ;;
esac