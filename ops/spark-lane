# ── jspark3 lane (github.com/jakejharris/jspark3, cutover 2026-10-04) ────────
# jspark3's own serve.sh/stop.sh on each node are the source of truth for flags and
# container naming (jspark3-rank{0,1,2}); this harness only orders the bring-up
# (rank2 -> rank1 -> rank0/head), waits for the endpoint + real chat canary, and
# parks it. SERVE_NAME is overridden to $GLM53_MODEL in config/serve.conf so the
# identity check below holds; see DEVIATIONS.md for the full deviation list.
JSPARK3_KIT="/var/tmp/jspark3/jspark3-v202"   # DEFAULT ONLY — the live deploy wins
JSPARK3_HEAD_HOST="spark3"

# The kit path is BUMPED PER DEPLOYMENT (jspark3 -> jspark3-v202 -> ...) because the
# staging script clones each release into a NEW tree beside the old one. A stale
# constant fails ASYMMETRICALLY, and both directions are silent:
#   * `up`   boots the OLD engine tree, reverting every deviation in DEVIATIONS.md
#            (observed 2026-10-07: constant still said .../jspark3 while the lane
#            had been serving .../jspark3-v202 since the v2.0.2 cutover).
#   * `down` runs stop.sh from the wrong tree and can report PASS while every
#            rank keeps serving.
# So resolve it from the fleet and treat the constant as a fallback only.
#   1. A RUNNING rank is authoritative: its /bundle/wheels mount source IS the kit.
#   2. Lane down (the `up` path): newest /var/tmp/jspark3/jspark3* tree that
#      actually carries scripts/serve.sh.
jspark3_resolve_kit() {
  [[ -n "${JSPARK3_KIT_RESOLVED:-}" ]] && return 0
  JSPARK3_KIT_RESOLVED=1
  local live="" head="${JSPARK3_HEAD_HOST:-spark3}"   # :- so set -u cannot kill the resolver
  live="$(sshx "$head" "docker inspect jspark3-rank0 --format '{{range .Mounts}}{{if eq .Destination \"/bundle/wheels\"}}{{.Source}}{{end}}{{end}}' 2>/dev/null" 2>/dev/null | tr -d '[:space:]')"
  if [[ -n "$live" ]]; then
    live="$(dirname "$live")"
  else
    live="$(sshx "$head" "for d in \$(ls -dt /var/tmp/jspark3/jspark3* 2>/dev/null); do [ -f \"\$d/scripts/serve.sh\" ] && { echo \"\$d\"; break; }; done" 2>/dev/null | tr -d '[:space:]')"
  fi
  if [[ -n "$live" && "$live" != "$JSPARK3_KIT" ]]; then
    warn "live jspark3 kit is $live, registry default is $JSPARK3_KIT — using the live one"
    info "update JSPARK3_KIT in this file so a COLD up (no running rank to inspect) resolves it too"
    JSPARK3_KIT="$live"
  fi
}
jspark3_up() {
  local lane="jspark3"
  STEPS=7; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  jspark3_resolve_kit   # must precede the kit step and every launch_detached below

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "cleanup" "removing any dead jspark3 containers left from a prior crash"
  cleanup_dead_containers "$lane"
  ok "dead containers cleared (if any)"

  step "kit" "$JSPARK3_KIT/scripts/serve.sh exists on all three nodes"
  local n
  for n in $(lane_nodes "$lane"); do
    if ! sshx "$n" "test -f $JSPARK3_KIT/scripts/serve.sh"; then
      note_fail "kit" "$JSPARK3_KIT missing on $n — the recipe tree must be reconciled to every node (see cutover runbook)"
      NEXT_CMD="ssh $n 'ls $JSPARK3_KIT'   # inspect what is missing, then reconcile the tree"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
      return 1
    fi
  done
  ok "kit present on spark1, spark3, spark4"

  step "already up?" "is $GLM53_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary_tf2 "$GLM53_ENDPOINT" "$GLM53_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "start" "serve.sh rank2 (spark4) -> rank1 (spark1) -> rank0 (spark3 head), detached"
  launch_detached spark4 "cd $JSPARK3_KIT && sg docker -c 'setsid ./scripts/serve.sh > /var/tmp/jspark3/serve-rank2.log 2>&1 < /dev/null &'"
  sleep 5
  launch_detached spark1 "cd $JSPARK3_KIT && sg docker -c 'setsid ./scripts/serve.sh > /var/tmp/jspark3/serve-rank1.log 2>&1 < /dev/null &'"
  sleep 5
  launch_detached spark3 "cd $JSPARK3_KIT && sg docker -c 'setsid ./scripts/serve.sh > /var/tmp/jspark3/serve-rank0.log 2>&1 < /dev/null &'"
  ok "launched detached; logs: /var/tmp/jspark3/serve-rank{0,1,2}.log"
  info "first boot compiles kernels; the head's wait-ready.sh tolerates up to 40 min"

  local ok_wait=0 t=0 code=""
  step "wait healthy" "endpoint up (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $GLM53_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="ssh spark3 'tail -30 /var/tmp/jspark3/serve-rank0.log'   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi

  step "identity" "served model name must be $GLM53_MODEL"
  local ids
  ids="$(curl -s -m 10 "$GLM53_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$GLM53_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $GLM53_MODEL"
    NEXT_CMD="ssh spark3 'grep -n SERVE_NAME $JSPARK3_KIT/config/serve.conf'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "serving $ids"

  step "canary" "real chat completion (port-open is not proof)"
  canary_tf2 "$GLM53_ENDPOINT" "$GLM53_MODEL" || { result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"; return 1; }

  result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(chat verified)"
  NEXT_CMD="nothing — lane is serving."
  return 0
}

jspark3_down() {
  local lane="jspark3"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  jspark3_resolve_kit   # a stale kit runs the wrong stop.sh and still reports PASS

  step "stop" "stop.sh per node (recipe's own teardown, bounded 180s each)"
  local n
  for n in $(lane_nodes "$lane"); do
    if ! timeout_run "${DSV41_STOP_TIMEOUT:-180}" sshx "$n" "cd $JSPARK3_KIT && sg docker -c './scripts/stop.sh'" >/dev/null 2>&1; then
      note_fail "stop" "stop.sh failed or timed out on $n — verify with 'ssh $n uptime' before retrying"
      NEXT_CMD="ssh $n 'cd $JSPARK3_KIT && sg docker -c ./scripts/stop.sh'   # run in the foreground to see the failure"
      result "$lane" "down" "-" "-"
      return 1
    fi
  done
  ok "stop issued on all three nodes"

  step "verify torn down" "no jspark3 containers left on $(lane_nodes "$lane")"
  local left="" c
  for n in $(lane_nodes "$lane"); do
    c="$(docker_names "$n" | grep -E 'jspark3-rank' || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all required nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights and images were NOT deleted."
  return 0
}


# Shares :8888 + the GLM-5.3-Flash-EXL3 served name with glm53-tp3 — the two can
# never run together, and `rotate` is the correct way to swap between them.
#
# Three preflights below exist because each one cost us a failed bring-up on
# 2026-09-27; do not remove them:
#   * NFS   — workers read the weights from spark3 over NFS. The mount unit is
#             `nofail` in fstab, so after a reboot where spark3's exporter is not
#             up yet, workers silently boot with NO weights and every rank dies.
#   * cache — page cache counts against the CUDA free-memory check on GB10 UMA.
#             A fresh big file copy (e.g. loading a 31G image) can leave a node
#             ~7G short and the rank aborts before loading a single weight.
#   * mem   — spark2 runs a genuine ~10-18G below its siblings when the kernel
#             MemAvailable anomaly is present. The documented fix is a REBOOT of
#             that node, not lowering GPU_UTIL (see the recipe README).
# The KIT's .env is the source of truth for CTN, not the constant above. Upstream
# bumps it on every redeploy -- start.sh:149 verbatim: "stop, never remove: the
# containers stay for inspection or `docker start`; a new deployment needs a fresh
# CTN". A stale constant here is NOT cosmetic, and the two failure modes are
# asymmetric:
#   up   -> identity counts 0/4 ranks and FAILS a perfectly healthy lane (annoying)
#   down -> the sweep matches nothing, "verify torn down" greps nothing, and the
#           lane reports PASS WHILE ALL FOUR RANKS KEEP SERVING (dangerous)
# The second is the exact class rule 7 exists to prevent, so resolve from the head
# and treat the constant as a fallback only.
glm53_tp4_resolve_ctn() {
  [[ -n "${GLM53_TP4_CTN_RESOLVED:-}" ]] && return 0
  GLM53_TP4_CTN_RESOLVED=1
  local live
  live="$(sshx "$GLM53_HEAD_HOST" "grep -E '^CTN=' $GLM53_TP4_KIT/$GLM53_TP4_ENV | tail -1 | cut -d= -f2" 2>/dev/null | tr -d '[:space:]\"'\''')"
  if [[ -n "$live" && "$live" != "$GLM53_TP4_CTN" ]]; then
    warn "kit .env says CTN=$live, registry default is $GLM53_TP4_CTN — using the kit's"
    info "if this is a redeploy, update GLM53_TP4_CTN in this file so detection keys off the name too"
    GLM53_TP4_CTN="$live"
  fi
}

glm53_tp4_weights_ok() {   # $1 = node ; success = checkpoint + drafter READABLE on that node
  # The knapcio recipe is NFS-backed: spark3 holds the checkpoint locally and exports it,
  # spark1/2/4 read it over the fabric mount. So on a worker this is really a mount test,
  # and an unmounted worker presents an EMPTY directory rather than a missing one — which
  # is exactly why this counts safetensors shards instead of testing the directory.
  # 33 is MEASURED on all four nodes 2026-09-29, not guessed. Do not "round it up"
  # for safety: an invented threshold here rejects a healthy lane, which is how the
  # memory step once refused to launch over a 0.1 GiB shortfall.
  sshx "$1" "test \"\$(ls -1 $GLM53_TP4_WEIGHTS/*.safetensors 2>/dev/null | wc -l)\" -ge 33 \
             && test \"\$(ls -1 $GLM53_TP4_DRAFTER/*.safetensors 2>/dev/null | wc -l)\" -ge 1"
}

# Name the processes competing for UMA on a node that is short or thin on memory.
# Lane ranks are excluded; everything else listed is a co-tenant. A co-tenant with
# restart=unless-stopped survives a reboot, so it must be stopped (or moved), not
# rebooted around. Read-only: this never stops anything itself.
mem_blame() {
  local n names
  for n in "$@"; do
    names="$(sshx "$n" "docker ps --format '{{.Names}}|{{.Label \"x\"}}' 2>/dev/null | cut -d'|' -f1 \
      | grep -vE 'glm53-lvkp|glm53-roce|glm53-tp3|dsv41|qwen3' \
      | head -8 | paste -sd, -" 2>/dev/null)"
    if [[ -n "$names" ]]; then
      info "  $n co-tenants holding memory: $names"
      info "  $n stop/move those (a restart=unless-stopped co-tenant returns on boot)"
    else
      info "  $n no co-tenants — this one really is the kernel MemAvailable anomaly; a reboot should clear it"
    fi
  done
}

glm53_tp4_up() {
  local lane="glm53-tp4"
  # 11: occupancy, kit, image, already-up, cleanup, weights+NFS, memory, start,
  # wait-healthy, identity, canary. (The mentat kit's "node identity" and "mentatd"
  # steps are gone with it: this recipe has no mesh daemon and no per-node naming.)
  STEPS=11; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  local n

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes (incl. glm53-tp3), then brings this one up"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "all 4 nodes free"

  # Only the HEAD needs the kit: start.sh rsyncs overlay/scripts/bench/profiles out to
  # every node itself. Do not "fix" a worker by copying .env to it — the levers that
  # file sets are wired in the launcher + overlay, so a lone .env yields a lane that
  # reads as configured and is not.
  step "kit" "$GLM53_TP4_KIT/$GLM53_TP4_CLI + $GLM53_TP4_ENV on $GLM53_HEAD_HOST"
  if ! sshx "$GLM53_HEAD_HOST" "test -x $GLM53_TP4_KIT/$GLM53_TP4_CLI && test -f $GLM53_TP4_KIT/$GLM53_TP4_ENV"; then
    note_fail "kit" "launcher or .env missing on $GLM53_HEAD_HOST:$GLM53_TP4_KIT"
    NEXT_CMD="rsync -a --exclude .git ~/recipe-db/GLM-5.3-Flash-4x-DGX-Spark-TP4/ $GLM53_HEAD_HOST:$GLM53_TP4_KIT/"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "launcher + .env present on the head"
  glm53_tp4_resolve_ctn   # must follow the kit check: it reads that .env

  step "image" "$GLM53_TP4_IMAGE on all 4 nodes"
  local missing=""
  for n in $(lane_nodes "$lane"); do
    sshx "$n" "docker image inspect $GLM53_TP4_IMAGE >/dev/null 2>&1" || missing="$missing $n"
  done
  if [[ -n "$missing" ]]; then
    note_fail "image" "$GLM53_TP4_IMAGE missing on:$missing"
    info "ship it over the RoCE fabric FROM a Spark node (the Mac cannot route 10.73.0.x)"
    # The SSH user is NOT uniform: spark1's account is `spark`, the others are sparkN.
    # Using spark1@10.73.0.1 fails with a publickey error that reads like a missing
    # key when the key is in fact already authorized (chased this 2026-09-29).
    info "ssh users: 10.73.0.1=spark, 10.73.0.2=spark2, 10.73.0.3=spark3, 10.73.0.4=spark4"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'docker save $GLM53_TP4_IMAGE | ssh <user>@10.73.0.<n> \"docker load\"'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "runtime image present everywhere"

  step "already up?" "is $GLM53_ENDPOINT already serving?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$GLM53_ENDPOINT" "$GLM53_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(already up, unchanged)"
      return 0
    fi
    # Zombie head: the endpoint answers but cannot complete a chat. Do NOT fall
    # through into a bring-up. The old ranks are still up holding their allocation,
    # so the memory step below would find ~21 GiB free against an 87.6 GiB floor,
    # FAIL on all four nodes, and mem_blame() would name this lane's OWN ranks as
    # the co-tenants — telling the operator that the fleet's signature failure mode
    # is a memory problem when it is really a wedged lane. Measured 2026-09-29 with
    # the lane HEALTHY: 21/21/20/23 GiB free. Fail fast with the fix instead.
    note_fail "already up?" "endpoint answers but the chat canary failed — the lane is wedged, not down"
    info "a bring-up from here would misreport this as a memory failure: the live ranks still hold their allocation"
    NEXT_CMD="spark-lane down $lane && spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "not serving yet"

  # Deliberately NOT `docker rm -f`, and deliberately AFTER the already-up check.
  # On 2026-09-27 this step used -f and ran before that check: it force-removed the
  # RUNNING ranks of a healthy lane, and the bring-up then cheerfully reported
  # "not serving yet" about the lane it had just killed. Plain `docker rm` refuses
  # anything still running, so the worst case here is a no-op.
  #
  # This lane ALSO needs it because upstream's stop preserves containers by design,
  # so a normal `down` legitimately leaves four EXITED ranks that would otherwise
  # collide with the next `docker run` on the same CTN.
  step "cleanup" "removing EXITED ${GLM53_TP4_CTN}-r* ranks (recipe's own relaunch bug)"
  for n in $(lane_nodes "$lane"); do
    sshx "$n" "ids=\$(docker ps -a --filter name=^/${GLM53_TP4_CTN}-r --filter status=exited --filter status=created -q); [ -n \"\$ids\" ] && docker rm \$ids >/dev/null 2>&1; true"
  done
  ok "dead ranks cleared (if any); running ranks untouchable by design"

  # NFS-backed: spark3 holds MODEL_DIR on local disk and exports it; the workers see it
  # through a fabric NFS mount. So "weights present" on a worker is really "the mount is
  # up", and an unmounted worker shows an EMPTY directory rather than a missing one —
  # which is why this checks shard COUNT, not mere existence.
  step "weights" "checkpoint + drafter readable on all 4 nodes (head local, workers over NFS)"
  local w_bad="" nfs_bad=""
  for n in $(lane_nodes "$lane"); do
    glm53_tp4_weights_ok "$n" || w_bad="$w_bad $n"
    if [[ "$n" != "$GLM53_HEAD_HOST" ]]; then
      sshx "$n" "findmnt -no FSTYPE $GLM53_TP4_NFS_MOUNT 2>/dev/null | grep -q nfs" \
        || nfs_bad="$nfs_bad $n"
    fi
  done
  if [[ -n "$nfs_bad" ]]; then
    note_fail "weights" "$GLM53_TP4_NFS_MOUNT is not an NFS mount on:$nfs_bad"
    info "the head exports it; a worker without the mount cannot read a single shard"
    NEXT_CMD="ssh <node> 'sudo mount -t nfs4 10.73.0.3:/ $GLM53_TP4_NFS_MOUNT'   # or: systemctl start var-tmp-models.mount"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  if [[ -n "$w_bad" ]]; then
    note_fail "weights" "checkpoint or drafter unreadable on:$w_bad"
    info "ship shards over the RoCE fabric FROM a Spark node (the Mac cannot route 10.73.0.x)"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'ls $GLM53_TP4_WEIGHTS | wc -l; ls $GLM53_TP4_DRAFTER'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "checkpoint + drafter readable on every node (NFS mounts up on all 3 workers)"

  # Page cache competes with the CUDA free-memory check because GB10 is UMA, so
  # always drop it first — that part is cheap and has recovered ~16 GiB in practice.
  #
  # The GATE, though, only rejects what is PHYSICALLY impossible: a node whose
  # MemAvailable is under GPU_UTIL*total can never satisfy the request. Everything
  # above that is a judgement call we are not entitled to make: observed data is
  # 99.5G failed, 105.9G worked, so the real threshold lives somewhere in between
  # and depends on the driver's carveout at that moment. An earlier version of this
  # step added a guessed +10 GiB of headroom and promptly refused to launch over a
  # 0.1 GiB shortfall (101.2 vs 101.3), telling the operator to reboot a node for
  # no reason. Warn about the grey zone, then let the engine be the authority — it
  # fails in ~2 min with an exact number, and the rank-crash hint below finds it.
  step "memory" "drop page cache, then check each node can physically satisfy GPU_UTIL"
  # 2026-09-27: "MemAvailable anomaly" was the wrong diagnosis. spark2 kept losing
  # ~7 GiB between runs and a reboot "fixed" it only until the co-tenant restarted:
  # Penpot (5 containers, restart=unless-stopped) came back on boot and re-took the
  # headroom. Rebooting a node whose competitor is unless-stopped just wastes 5 min.
  # So: name the co-tenants and let the operator decide, instead of ordering a reboot.
  local util req warnfloor avail short="" grey="" short_nodes="" grey_nodes=""
  # This recipe's knob is GPU_UTIL in the TOP-LEVEL .env, NOT the mentat kit's
  # GPU_MEM_UTIL in compose/.env. Reading the old name here would silently fall back
  # to a default and check the wrong floor. Our .env pins 0.72; the profile ships 0.78.
  util="$(sshx "$GLM53_HEAD_HOST" "grep -E '^GPU_UTIL=' $GLM53_TP4_KIT/$GLM53_TP4_ENV | tail -1 | cut -d= -f2" 2>/dev/null | tr -d '[:space:]')"
  util="${util:-$GLM53_TP4_UTIL_DEFAULT}"
  req="$(python3 -c "print(round(121.69*$util, 1))" 2>/dev/null || echo 91.3)"
  warnfloor="$(python3 -c "print(round(121.69*$util + 10, 1))" 2>/dev/null || echo 101.3)"
  for n in $(lane_nodes "$lane"); do
    sshx "$n" "sudo sync; echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1; true"
    sleep 1
    avail="$(sshx "$n" "awk '/^MemAvailable/ {printf \"%.1f\", \$2/1048576}' /proc/meminfo" 2>/dev/null || echo 0)"
    if python3 -c "import sys; sys.exit(0 if float('${avail:-0}') < float('$req') else 1)" 2>/dev/null; then
      short="$short $n(${avail}G<${req}G)"; short_nodes="$short_nodes $n"
    elif python3 -c "import sys; sys.exit(0 if float('${avail:-0}') < float('$warnfloor') else 1)" 2>/dev/null; then
      grey="$grey $n(${avail}G)"; grey_nodes="$grey_nodes $n"
    fi
  done
  if [[ -n "$short" ]]; then
    note_fail "memory" "node(s) cannot physically satisfy GPU_UTIL=$util:$short"
    mem_blame $short_nodes
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  if [[ -n "$grey" ]]; then
    warn "thin margin on:$grey (want >=${warnfloor}G, hard floor ${req}G) — proceeding anyway"
    mem_blame $grey_nodes
  fi
  ok "all nodes clear the ${req}G hard floor (GPU_UTIL=$util)"

  # ONE launcher on the head fans out: start.sh rsyncs the overlay to every node, then
  # starts ranks 3,2,1,0 itself. It runs in the FOREGROUND for the whole bring-up, so it
  # must be detached with launch_detached (`ssh -f`) — `ssh host "... &"` hangs until the
  # whole remote child chain exits, which would strand this function on the launch line
  # while the lane actually comes up fine behind it.
  step "start" "$GLM53_TP4_CLI serve on $GLM53_HEAD_HOST (fans out to all 4 ranks)"
  local log="$GLM53_TP4_KIT/lane-up-$(date +%Y%m%d-%H%M%S).log"
  if ! launch_detached "$GLM53_HEAD_HOST" \
      "cd $GLM53_TP4_KIT && setsid nohup $GLM53_TP4_CLI serve >> $log 2>&1 < /dev/null"; then
    note_fail "start" "could not launch $GLM53_TP4_CLI serve on $GLM53_HEAD_HOST"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'cd $GLM53_TP4_KIT && $GLM53_TP4_CLI serve'   # run in foreground to see why"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "launcher started detached (log: $log)"
  info "healthy in ~5-6 min on our fleet (66 cuda-graph capture sizes x 7 spec families)"

  local ok_wait=0 t=0 code="" ranks="" probe_rc=0 dead_streak=0
  step "wait healthy" "endpoint up, or all ranks die (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    # Rank-liveness probe. An ssh FAILURE is not evidence of a dead rank: during
    # CUDA graph capture the head node is saturated and ssh routinely times out.
    # The original version collapsed both cases to "0" and aborted on a single
    # sample — on 2026-09-27 that killed a perfectly healthy bring-up that was
    # mid-warmup. Only a definitive "ssh worked AND reported zero containers",
    # observed 3 times in a row, counts as a crash.
    ranks="$(sshx "$GLM53_HEAD_HOST" "docker ps --filter name=^/${GLM53_TP4_CTN}-r -q | wc -l" 2>/dev/null)"
    probe_rc=$?
    ranks="$(printf '%s' "$ranks" | tr -d '[:space:]')"
    if [[ $probe_rc -ne 0 || -z "$ranks" ]]; then
      dead_streak=0
      info "+${t}s rank probe unreachable (node busy) — not treating as a crash"
    elif [[ "$ranks" == "0" ]]; then
      dead_streak=$((dead_streak + 1))
      warn "+${t}s head node reports 0 ranks (${dead_streak}/3 confirmations)"
    else
      dead_streak=0
    fi
    if [[ $dead_streak -ge 3 ]]; then
      note_fail "start" "the head rank exited before the endpoint came up"
      info "a rank crash is usually memory on ONE node — check each rank, not just the head"
      NEXT_CMD="for n in \$(echo spark1 spark2 spark3 spark4); do ssh \$n 'docker logs \$(docker ps -a --filter name=^/${GLM53_TP4_CTN}-r -q | head -1) 2>&1 | grep -iE \"ValueError.*memory|Unsupported|RuntimeError\" | tail -3'; done"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then info "+${t}s still booting (head rank alive)"; fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $GLM53_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi

  step "identity" "served model name must be $GLM53_MODEL, TP4 across 4 nodes"
  local ids up_ranks=0
  ids="$(curl -s -m 10 "$GLM53_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$GLM53_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $GLM53_MODEL"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'grep -n SERVED_NAME $GLM53_TP4_KIT/.env'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  for n in $(lane_nodes "$lane"); do
    [[ "$(sshx "$n" "docker ps --filter name=^/${GLM53_TP4_CTN}-r -q | wc -l" 2>/dev/null || echo 0)" != "0" ]] && up_ranks=$((up_ranks + 1))
  done
  if [[ $up_ranks -ne 4 ]]; then
    note_fail "identity" "serving $ids but only $up_ranks/4 ranks are up — this is NOT a healthy TP4"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "serving $ids on 4/4 ranks"

  step "canary" "real chat completion (port-open is not proof)"
  canary "$GLM53_ENDPOINT" "$GLM53_MODEL" || { result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"; return 1; }

  result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(chat verified, TP4 4/4)"
  NEXT_CMD="nothing — lane is serving. Quality gate (after config changes): see the recipe's docs/validation.md qeval panel, needs >=72/75 at c1 and c4."
  return 0
}

glm53_tp4_down() {
  local lane="glm53-tp4"
  STEPS=2; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  # ONE bounded stop on the head — start.sh stop tears down every rank over the fabric.
  # It is wrapped in timeout_run because an ssh call to a recipe stop script that wedges
  # otherwise hangs indefinitely and silently (that is how spark3 sat dead for an hour on
  # 2026-09-25). A wedge must surface as a fast FAIL, not a stall.
  #
  # The NFS export/mounts are deliberately LEFT ALONE: unmounting /var/tmp/models mid-
  # teardown is the exact wildcard trap that wedged spark3 when a blanket sweep removed
  # the dsv41 NFS exporter while it was still mounted. Weights and mounts survive a down.
  step "stop" "$GLM53_TP4_CLI stop on the head (bounded, ${DSV41_STOP_TIMEOUT:-180}s cap)"
  local n stop_rc=0
  glm53_tp4_resolve_ctn
  timeout_run "${DSV41_STOP_TIMEOUT:-180}" ssh $SSH_OPTS "$GLM53_HEAD_HOST" \
    "cd $GLM53_TP4_KIT && $GLM53_TP4_CLI stop" >/dev/null 2>&1 || stop_rc=1

  # Upstream stops WITHOUT removing, on purpose (start.sh:149): the exited containers
  # stay for forensics and for a fast `docker start` restart. So there is no blanket
  # sweep here — force-removing them would throw away both. The sweep is a FALLBACK
  # that fires only when stop actually failed, and `up`'s cleanup step removes the
  # preserved ranks later anyway, right before they would collide with a fresh run.
  if [[ $stop_rc -ne 0 ]]; then
    warn "$GLM53_TP4_CLI stop returned non-zero or timed out — falling back to a direct sweep"
    for n in $(lane_nodes "$lane"); do
      sshx "$n" "ids=\$(docker ps -a --filter name=^/${GLM53_TP4_CTN}-r -q); [ -n \"\$ids\" ] && docker rm -f \$ids >/dev/null 2>&1; true"
    done
    ok "ranks force-swept on all 4 nodes (stop had failed)"
  else
    ok "stop issued on all 4 ranks; containers PRESERVED for inspection/restart (upstream design)"
  fi
  info "NFS export + worker mounts deliberately left up — unmounting mid-teardown is what wedged spark3 on 2026-09-25"

  step "verify torn down" "no ${GLM53_TP4_CTN}-r* ranks left on $(lane_nodes "$lane")"
  local left="" c
  for n in $(lane_nodes "$lane"); do
    # Anchored to the NAME field. An unanchored "glm53" matches the TP3 lane's
    # glm53-exl3 container AND this lane's own image (glm53-roce:v11-*), so a clean
    # teardown would report itself as failed while TP3 was merely running.
    c="$(docker_names "$n" | grep -E "^${GLM53_TP4_CTN}-r" || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all 4 nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights, NFS mounts and images were NOT touched."
  return 0
}

# ── stage (TP4 kit deploy, idempotent) ───────────────────────────────────────
stage_tp4() {
  STEPS=4; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  step "clone" "$REPO_URL -> $TP4_KIT"
  if sshx "$DSV41_HEAD_HOST" "test -d $TP4_KIT/.git"; then
    ok "already cloned (leaving it in place)"
  else
    if ! sshx "$DSV41_HEAD_HOST" "git clone -q $REPO_URL $TP4_KIT"; then
      note_fail "clone" "git clone failed on $DSV41_HEAD_HOST"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'git clone $REPO_URL $TP4_KIT'"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    ok "cloned"
  fi

  step "profile" ".env.tp4 = upstream example + our fleet deltas (deterministic builder)"
  if sshx "$DSV41_HEAD_HOST" "test -f $TP4_KIT/.env.tp4"; then
    info "profile already present — NOT overwritten (rm it to rebuild deliberately)"
  else
    local prof
    if [[ ! -f "$HERE/lane-profiles/build-dsv41-tp4-env.py" ]]; then
      note_fail "profile" "builder missing: $HERE/lane-profiles/build-dsv41-tp4-env.py"
      NEXT_CMD="spark-lane stage dsv41-tp4"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    scp -q -o ConnectTimeout=10 "$HERE/lane-profiles/build-dsv41-tp4-env.py" "$DSV41_HEAD_HOST:$TP4_KIT/"
    prof="$(sshx "$DSV41_HEAD_HOST" "cd $TP4_KIT && python3 build-dsv41-tp4-env.py ." 2>&1)"
    printf '%s\n' "$prof" | sed 's/^/        /'
    if ! printf '%s' "$prof" | grep -q '^RESULT: PASS'; then
      note_fail "profile" "builder refused to produce a valid .env.tp4 (see output above)"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'cd $TP4_KIT && python3 build-dsv41-tp4-env.py .'"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    ok "profile built and self-verified"
  fi

  # Bug fixed 2026-09-25: this used to require a full local copy of the 516G
  # checkpoint on ALL FOUR nodes, which both isn't how the recipe actually
  # works and made TP4 physically impossible on spark4 (916G disk, only
  # 164G free). The profile we just built has NFS_SHARE=1 (see
  # .env.tp4 / start.sh's own doctor+serve logic) -- same design as TP3:
  # only the HEAD keeps the local checkpoint at $MODEL_DIR, and workers
  # mount it read-only over NFSv4 on the CX7 fabric via the dsv41-nfs
  # exporter. So the real precondition is just "does the head have a
  # complete local copy", not "does every node".
  step "weights" "head node has the local checkpoint (workers read it over NFS, NFS_SHARE=1)"
  if ! sshx "$DSV41_HEAD_HOST" "test -d /var/tmp/models/DeepSeek-V4.1-Flash"; then
    note_fail "weights" "model dir missing on head ($DSV41_HEAD_HOST) -- this one actually needs a local copy"
    NEXT_CMD="spark-lane status   # stage weights on $DSV41_HEAD_HOST first (fabric transfer, not LAN)"
    result "dsv41-tp4" "stage" "-" "-"; return 1
  fi
  ok "head has the checkpoint; workers will mount it over NFS during 'up' (no local copy needed)"

  result "dsv41-tp4" "stage" "-" "-"
  NEXT_CMD="spark-lane up dsv41-tp4   # doctor -> build -> share/pack -> serve (detached). A cold build needs github.com + pypi.org and takes a long while; watch it with: spark-lane logs dsv41-tp4"
  return 0
}

# ── verify ───────────────────────────────────────────────────────────────────
verify_lane() {
  local lane="$1"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  # ComfyUI is NOT an OpenAI endpoint: no /v1/models, no chat completions. The standard
  # path below would fail forever against it, so comfy-engine gets its own checks.
  # The GPU step is the one that matters — ComfyUI will happily fall back to CPU and
  # still answer 200, which looks healthy while being useless for a 5s video shot.
  if [[ "$lane" == "comfy-engine" ]]; then
    step "endpoint" "$COMFY_URL/system_stats"
    local code; code="$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$COMFY_URL/system_stats")"
    if [[ "$code" == "200" ]]; then ok "200"; else
      note_fail "endpoint" "http ${code:-000}"; NEXT_CMD="spark-lane up comfy-engine"
      result "$lane" "verify" "$COMFY_URL" "$(lane_model_id "$lane")"; return $FAILED
    fi

    step "gpu" "ComfyUI must report a CUDA device, not a CPU fallback"
    local dev; dev="$(curl -s -m 10 "$COMFY_URL/system_stats" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin); x = (d.get("devices") or [{}])[0]
    print("%s|%s|%.1f" % (x.get("type",""), x.get("name","?"), x.get("vram_total",0)/2**30))
except Exception:
    print("||0")' 2>/dev/null)"
    case "$dev" in
      cuda*) ok "cuda ${dev#*|} GiB" ;;
      *)     note_fail "gpu" "not on CUDA (device='${dev:-unknown}') — CPU fallback is not acceptable"
             NEXT_CMD="ssh spark2 'docker logs --tail 60 $COMFY_CTN'" ;;
    esac

    step "loaders" "weight FILES for the four families are visible to their loaders"
    # Must match weight FILENAMES, never the raw blob. ComfyUI v0.38.1 ships node classes
    # (MiniMaxH3ImageToVideo, YuE2GenerateMusic, ...) whether or not weights are mounted:
    # bare 'h3' still occurs 103x and 'yue2' 20x after every filename is stripped, so the
    # music and video checks passed with the mounts EMPTY. Only strings ending in a weight
    # extension count, which is what the loader dropdowns actually offer.
    local fam; fam="$(curl -s -m 25 "$COMFY_URL/object_info" | python3 -c 'import json,sys,re
try:
    blob = json.dumps(json.load(sys.stdin))
except Exception:
    print("unreadable"); raise SystemExit
files = " ".join(re.findall(r"[A-Za-z0-9_.\-]+\.(?:safetensors|gguf|sft|pt|pth|bin|ckpt)", blob)).lower()
want = {"music":"yue2_", "image":"qwen_image", "design":"ming_image", "video":"minimax_h3"}
print(" ".join(k if v in files else k.upper()+"-MISSING" for k,v in want.items()))' 2>/dev/null)"
    case "$fam" in
      *MISSING*|unreadable|"") note_fail "loaders" "families: ${fam:-unreadable}"
                               NEXT_CMD="ssh spark2 'ls /home/spark2/comfy-models'" ;;
      *) ok "$fam" ;;
    esac

    result "$lane" "verify" "$COMFY_URL" "$(lane_model_id "$lane")"
    return $FAILED
  fi
  local ep model
  ep="$(lane_endpoint "$lane")"; model="$(lane_model_id "$lane")"
  step "endpoint" "$ep/models"
  local code; code="$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$ep/models")"
  if [[ "$code" != "200" ]]; then
    warn "http $code — falling through to a timed canary anyway (list-models is not proof)"
  else ok "200"; fi
  step "canary" "real chat completion"
  # glm53-tf2: the generic canary's 8-token budget returns content=None on TensorFold
  # (reasoning-first template) — use the enable_thinking:false variant for real proof.
  if [[ "$lane" == "glm53-tf2" ]]; then canary_tf2 "$ep" "$model"; else canary "$ep" "$model"; fi
  result "$lane" "verify" "$ep" "$model"
  return $FAILED
}

# ── dispatch ─────────────────────────────────────────────────────────────────
usage() {
  cat <<USAGE
spark-lane — one-shot lane bring-up / teardown / rotation (DGX Spark fleet)

  spark-lane                     census: what is on every Spark right now
  spark-lane lanes               list lanes + the nodes each needs
  spark-lane up    <lane>        bring a lane up   (refuses if a required node is taken)
  spark-lane down  <lane>        park a lane       (verifies it really stopped)
  spark-lane verify <lane>       health only, changes nothing
  spark-lane rotate <lane>       park conflicting lanes, then bring this one up
  spark-lane stage dsv41-tp4     clone + fleet profile + weight check (no serve)

lanes:
  comfy-engine      spark2        ComfyUI music/image/design/video -> $COMFY_URL
  dsv41-tp3         spark1,3,4    DeepSeek V4.1-Flash TP3 -> $DSV41_ENDPOINT
  dsv41-tp4         spark1-4      DeepSeek V4.1-Flash TP4 -> $DSV41_ENDPOINT  (fast line)
  glm53-tp3         spark1,3,4    GLM-5.3-Flash EXL3 TP3  -> $GLM53_ENDPOINT
  glm53-tp4         spark1-4      GLM-5.3-Flash TP4       -> $GLM53_ENDPOINT  (knapcio recipe)
  glm53-tf2         spark3,4      GLM-5.3-Flash EXL3 TP2  -> $GLM53_ENDPOINT  (TensorFold engine)
  jspark3           spark1,3,4    GLM-5.3-Flash EXL3 (jspark3) -> $GLM53_ENDPOINT

The DeepSeek endpoint and model name are stable across TP3/TP4: $DSV41_ENDPOINT / $DSV41_MODEL
The GLM lane serves a distinct identity: $GLM53_ENDPOINT / $GLM53_MODEL
USAGE
}

ACT="${1:-status}"
LANE="${2:-}"

case "$ACT" in
  status|census)
    if [[ "$LANE" == "--json" ]]; then status_json; else census; fi ;;
  lanes)
    if [[ "$LANE" == "--json" ]]; then
      lanes_json
    else
      for l in $ALL_LANE_IDS; do
        printf '%-16s nodes: %-26s endpoint: %s\n' "$l" "$(lane_nodes "$l")" "$(lane_endpoint "$l")"
      done
    fi ;;
  up)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    case "$LANE" in comfy-engine) comfy_engine_up ;; glm53-tp3) glm53_tf3_up ;; glm53-tp4) glm53_tp4_up ;; glm53-tf2) glm53_tf2_up ;; jspark3) jspark3_up ;; *) dsv41_up "$LANE" ;; esac ;;
  down)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    case "$LANE" in comfy-engine) comfy_engine_down ;; glm53-tp3) glm53_tf3_down ;; glm53-tp4) glm53_tp4_down ;; glm53-tf2) glm53_tf2_down ;; jspark3) jspark3_down ;; *) dsv41_down "$LANE" ;; esac ;;
  verify)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    verify_lane "$LANE" ;;
  rotate)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    echo "${B}── rotate: park everything that $LANE needs, then bring it up ──${N}"
    occ_list=""
    for n in $(lane_nodes "$LANE"); do
      o="$(node_occupants "$n")"
      [[ -n "$o" ]] && occ_list="$occ_list $o"
    done
    for other in comfy-engine dsv41-tp3 dsv41-tp4 glm53-tp3 glm53-tp4 glm53-tf2 jspark3; do
      [[ "$other" == "$LANE" ]] && continue
      case " $occ_list " in *" $other "*) echo "${Y}parks $other${N}"; "${0:-$HERE/spark-lane}" down "$other" || true ;; esac
    done
    exec "${0:-$HERE/spark-lane}" up "$LANE" ;;
  doctor)
    kit="$(dsv41_kit "${LANE:-}")"
    [[ -n "$kit" ]] || { echo "usage: spark-lane doctor <dsv41-tp3|dsv41-tp4>" >&2; exit 2; }
    cli="$(dsv41_cli "$LANE")"
    echo "${B}$cli doctor${N} on $DSV41_HEAD_HOST ($kit)"
    sshx "$DSV41_HEAD_HOST" "cd $kit && $cli doctor"; rc=$?
    printf 'RESULT: %s lane=%s action=doctor\n' "$([[ $rc -eq 0 ]] && echo PASS || echo FAIL)" "$LANE"
    if [[ $rc -eq 0 ]]; then printf 'NEXT: spark-lane up %s\n' "$LANE"; else printf 'NEXT: read the failure above\n'; fi
    exit $rc ;;
  logs)
    case "${LANE:-}" in
      glm53-tp3) kit="$GLM53_TP3_KIT"; host="$GLM53_TP3_HEAD" ;;
      glm53-tp4) kit="$GLM53_TP4_KIT"; host="$GLM53_HEAD_HOST" ;;
      glm53-tf2) kit="$GLM53_TF2_KIT"; host="$GLM53_TF2_HEAD" ;;
      dsv41-tp3|dsv41-tp4) kit="$(dsv41_kit "$LANE")"; host="$DSV41_HEAD_HOST" ;;
      *) echo "usage: spark-lane logs <dsv41-tp3|dsv41-tp4|glm53-tp3|glm53-tp4|glm53-tf2>" >&2; exit 2 ;;
    esac
    echo "${B}newest bring-up log on $host${N} (tail ${TAIL:-40})"
    sshx "$host" "f=\$(ls -1t $kit/lane-up-*.log 2>/dev/null | head -1); if [[ -n \"\$f\" ]]; then echo \"--- \$f\"; tail -${TAIL:-40} \"\$f\"; else echo 'no lane-up log yet'; fi" ;;
  stage)
    [[ "$LANE" == "dsv41-tp4" ]] || { echo "only 'stage dsv41-tp4' is supported" >&2; exit 2; }
    stage_tp4 ;;
  help|-h|--help) usage ;;
  *) echo "unknown action: $ACT" >&2; usage; exit 2 ;;
esac