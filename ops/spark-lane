  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or start exited (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
