#!/usr/bin/env bash
# spark-lane — ONE-SHOT bring-up / teardown / rotation for the lanes on Victor's DGX Spark fleet.
#
# Written to be followed by ANY model, including one with no judgement and no fleet
# knowledge: it checks the fleet itself, refuses to clobber a running lane, verifies
# with a real chat canary (not just an open port), and ends every run with exactly
# two lines a caller can act on:
#
#     RESULT: PASS|FAIL  lane=<lane> action=<action> ...
#     NEXT:  <the single next command to run, or "nothing">
#
# USAGE
#   spark-lane                     # census: what is on every Spark right now
#   spark-lane status              # same as above
#   spark-lane lanes               # list lanes and the nodes each one needs
#   spark-lane up    <lane>        # bring a lane up (refuses if a node is taken)
#   spark-lane down  <lane>        # park a lane (verifies it really stopped)
#   spark-lane verify <lane>       # health only, changes nothing
#   spark-lane rotate <lane>       # park whatever conflicts, then bring it up
#
# LANES
#   comfy-engine      spark2        ComfyUI (music/image/design/video) -> :8188 (no LLM lane)
#   dsv41-tp3         spark1,3,4    DeepSeek V4.1-Flash TP3  -> :8000/v1
#   dsv41-tp4         spark1-4      DeepSeek V4.1-Flash TP4  -> :8000/v1 (Mia's fast line)
# NOTE 2026-10-12: dsv41 lanes are PARKED-INVENTORY per Victor 2026-10-05 (GLM = main).
# Not an open decision; restore only on explicit request. See GBrain
# dsv41-g19-lane-parked-inventory.
#   glm53-tp3         spark1,3,4    GLM-5.3-Flash EXL3 TP3   -> :8888/v1 (TensorFold engine, v1.5, CONTAINER glm53-tf3)
#   glm53-tp4         spark1-4      GLM-5.3-Flash TP4        -> :8888/v1 (TensorFold engine, v0.6.0, CONTAINER glm53-tf4)
#   glm53-tf2         spark3,4      GLM-5.3-Flash EXL3 TP2   -> :8888/v1 (TensorFold engine)
#
# POLICY (do not change these constants casually)
#   * The OpenAI endpoint + served model name stay IDENTICAL across TP3/TP4 swaps:
#     http://100.99.120.29:8000/v1  and  deepseek-v4.1-flash. Rotating the engine
#     behind a stable endpoint is the whole point; clients never change.
#   * Nothing binds beyond localhost + the tailnet. No LAN, no public.
#   * No --restart policy is ever set (GB10 hard rule: never auto-restart an
#     unverified vLLM/SGLang config).
#   * Teardown never deletes artifacts; it stops containers and leaves weights.

set -uo pipefail

# ── stable identity ──────────────────────────────────────────────────────────
DSV41_ENDPOINT="${DSV41_ENDPOINT:-http://100.99.120.29:8000/v1}"
DSV41_MODEL="deepseek-v4.1-flash"
DSV41_HEAD_HOST="spark3"
DSV41_HEAD_IP="100.99.120.29"
