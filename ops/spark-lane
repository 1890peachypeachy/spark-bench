#!/usr/bin/env bash
# spark-lane — ONE-SHOT bring-up / teardown / rotation for the lanes on Victor's DGX Spark fleet.
#
# Written to be followed by ANY model, including one with no judgement and no fleet
# knowledge: it checks the fleet itself, refuses to clobber a running lane, verifies
# with a real chat canary (not just an open port), and ends every run with exactly
# two lines a caller can act on:
#
#     RESULT: PASS|FAIL  lane=<lane> action=<action> ...
#     NEXT:  <the single next command to run, or "nothing">
#
# USAGE
#   spark-lane                     # census: what is on every Spark right now
#   spark-lane status              # same as above
#   spark-lane lanes               # list lanes and the nodes each one needs
#   spark-lane up    <lane>        # bring a lane up (refuses if a node is taken)
#   spark-lane down  <lane>        # park a lane (verifies it really stopped)
#   spark-lane verify <lane>       # health only, changes nothing
#   spark-lane rotate <lane>       # park whatever conflicts, then bring it up
#
# LANES
#   creative-engine   spark2        image lab :7862 + design lab :8765  (no LLM lane)
#   dsv41-tp3         spark1,3,4    DeepSeek V4.1-Flash TP3  -> :8000/v1
#   dsv41-tp4         spark1-4      DeepSeek V4.1-Flash TP4  -> :8000/v1 (Mia's fast line)
#   glm53-tp3         spark1,3,4    GLM-5.3-Flash EXL3 TP3   -> :8888/v1 (Mia's recipe)
#
# POLICY (do not change these constants casually)
#   * The OpenAI endpoint + served model name stay IDENTICAL across TP3/TP4 swaps:
#     http://100.99.120.29:8000/v1  and  deepseek-v4.1-flash. Rotating the engine
#     behind a stable endpoint is the whole point; clients never change.
#   * Nothing binds beyond localhost + the tailnet. No LAN, no public.
#   * No --restart policy is ever set (GB10 hard rule: never auto-restart an
#     unverified vLLM/SGLang config).
#   * Teardown never deletes artifacts; it stops containers and leaves weights.

set -uo pipefail

# ── stable identity ──────────────────────────────────────────────────────────
DSV41_ENDPOINT="${DSV41_ENDPOINT:-http://100.99.120.29:8000/v1}"
DSV41_MODEL="deepseek-v4.1-flash"
DSV41_HEAD_HOST="spark3"
DSV41_HEAD_IP="100.99.120.29"
TP3_KIT="/home/spark3/dsv41-3x"
TP4_KIT="/home/spark3/dsv41-4x"
# GLM-5.3-Flash EXL3 TP3 lane (Mia's recipe, single self-contained start-tp3.sh)
GLM53_ENDPOINT="${GLM53_ENDPOINT:-http://100.99.120.29:8888/v1}"
GLM53_MODEL="GLM-5.3-Flash-EXL3"
GLM53_HEAD_HOST="spark3"
GLM53_KIT="/home/spark3/GLM53-TP3"
GLM53_CLI="./start-tp3.sh"
GLM53_IMAGE="ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor"
LAB_DESIGN_HOST="spark2"
LAB_DESIGN_URL="http://100.71.248.116:8765"
LAB_IMAGE_URL="http://100.71.248.116:7862"
LAB_DESIGN_TIP="100.71.248.116"
LAB_IMAGE_DIR="/home/spark2/spark-image-lab"
LAB_DESIGN_DIR="/home/spark2/antling-design-lab"
REPO_URL="https://github.com/1890peachypeachy/DeepSeek-v4.1-Flash-DGX-Sparks.git"
# Resolve through the ~/.local/bin/spark-lane symlink -- a bare dirname on
# BASH_SOURCE resolves to the symlink's own directory (~/.local/bin), not the
# real ops/ dir, which breaks lane-profiles/ lookups (found 2026-09-25).
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

ENGINE_WAIT="${ENGINE_WAIT:-900}"            # engine boot budget once the image exists
ENGINE_MAX_WAIT="${ENGINE_MAX_WAIT:-10800}"  # ceiling for a COLD bring-up (image build on 4 nodes)
LAB_WAIT="${LAB_WAIT:-420}"

SSH_OPTS="-n -o ConnectTimeout=10 -o BatchMode=yes"

# ── output helpers ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'
else B=""; G=""; R=""; Y=""; D=""; N=""; fi

STEPNO=0
STEPS=0
step() { STEPNO=$((STEPNO + 1)); printf '%s[%d/%d]%s %-14s %s\n' "$B" "$STEPNO" "$STEPS" "$N" "$1" "$2"; }
info() { printf '        %s%s%s\n' "$D" "$1" "$N"; }
ok()   { printf '        %sOK%s   %s\n' "$G" "$N" "$1"; }
bad()  { printf '        %sFAIL%s %s\n' "$R" "$N" "$1"; }
warn() { printf '        %sWARN%s %s\n' "$Y" "$N" "$1"; }

FAILED=0
FAIL_STEP=""
FAIL_DETAIL=""
NEXT_CMD="nothing"
note_fail() { FAILED=1; FAIL_STEP="$1"; FAIL_DETAIL="$2"; }
result() { # lane action endpoint model extra
  if [[ $FAILED -eq 0 ]]; then
    printf '\n%sRESULT: PASS%s lane=%s action=%s endpoint=%s model=%s %s\n' "$G" "$N" "$1" "$2" "$3" "$4" "${5:-}"
  else
    printf '\n%sRESULT: FAIL%s lane=%s action=%s step=%s\n' "$R" "$N" "$1" "$2" "$FAIL_STEP"
    printf '        %s\n' "$FAIL_DETAIL"
  fi
  printf '%sNEXT:%s %s\n' "$B" "$N" "$NEXT_CMD"
}

sshx() { ssh $SSH_OPTS "$@"; }

# Detach a remote long-running job AND return immediately. sshx/$SSH_OPTS already
# has -n (stdin), but that is NOT enough for a backgrounded job: the remote
# `bash -c` wrapper ssh spawns keeps the channel's stdout open until its whole
# child chain exits. Since the serve step runs in the foreground of the runner,
# that means ssh waits forever -> `up` hangs and the rotation never advances.
# FIXED 2026-09-25: use `ssh -f`, which backgrounds the ssh CLIENT itself right
# after auth, so the local side returns regardless of the remote channel. The
# remote job still detaches via its own setsid/nohup + fd redirects (callers do).
launch_detached() {
  local host="$1"; shift
  ssh -f -o ConnectTimeout=10 -o BatchMode=yes "$host" "$@" >/dev/null 2>&1
}
docker_names() { sshx "$1" "docker ps --format '{{.Names}}|{{.Image}}' 2>/dev/null"; }

# Portable timeout: GNU `timeout` is NOT on macOS (no timeout/gtimeout by default),
# so `down`/`rotate` always failed at the stop step with "timeout: command not found".
# This helper runs a command with a hard wall-clock cap and returns 124 on timeout
# (matching GNU timeout's convention) so the existing `if ! timeout ...` logic works.
# FIXED 2026-09-25: rotation was broken on the Mac because of this.
timeout_run() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return $?
  fi
  # portable fallback: background + sleep + kill, returns 124 on timeout
  "$@" &
  local pid=$!
  ( sleep "$secs"; kill -9 "$pid" 2>/dev/null ) &
  local killer=$!
  local rc=0
  wait "$pid" 2>/dev/null; rc=$?
  kill "$killer" 2>/dev/null
  if ! kill -0 "$pid" 2>/dev/null; then
    # process finished before the killer fired
    return $rc
  fi
  # still alive after the killer's sleep -> it was killed by the killer
  return 124
}

# Occupants of a node, one per line, empty = free.
# Matches the container names/images our lanes actually use.
node_occupant() {
  local node="$1" out img lane
  out="$(docker_names "$node" | grep -E 'ming-layer-web|spark-image-lab|dsv41-[34]x|sglang|glm53' || true)"
  [[ -z "$out" ]] && { echo ""; return; }
  if echo "$out" | grep -qE 'ming-layer-web|spark-image-lab'; then
    echo "creative-engine"
    return
  fi
  # Detect which lane by image name (TP3 vs TP4 vs GLM)
  img="$(sshx "$node" "docker ps --format '{{.Image}}' 2>/dev/null | grep -E 'dsv41-[34]x|sglang|glm53' | head -1" 2>/dev/null || true)"
  case "$img" in
    *dsv41-3x*|*sglang*3*) lane="dsv41-tp3" ;;
    *dsv41-4x*)            lane="dsv41-tp4" ;;
    *glm53*|*exl3*)        lane="glm53-tp3" ;;
    *)                      lane="llm-lane-unknown" ;;
  esac
  echo "$lane"
}

# ── canary: a REAL chat completion, because /v1/models can stay green while chat hangs
canary() {
  local url="$1" model="$2" body out
  body="$(curl -s -m 120 "$url/chat/completions" -H 'Content-Type: application/json' -d @- <<JSON
{"model":"$model","messages":[{"role":"user","content":"Reply with the single word: ready"}],"max_tokens":8,"temperature":0,"chat_template_kwargs":{"thinking":false}}
JSON
)"
  out="$(printf '%s' "$body" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("BADJSON"); raise SystemExit(3)
if "choices" not in d: print("APIERR:"+str(d)[:160]); raise SystemExit(4)
c=d["choices"][0]["message"].get("content") or ""
u=d.get("usage",{})
print("TEXT[%s] tok=%s" % (c.strip()[:40], u.get("completion_tokens","?")))
' 2>&1)"
  local rc=$?
  if [[ $rc -ne 0 || "$out" == BADJSON* || "$out" == APIERR* ]]; then
    bad "chat canary: $out"
    note_fail "canary" "the OpenAI endpoint answered but not with a completion: $out"
    NEXT_CMD="spark-lane down ${LANE:-dsv41-tp3} && spark-lane up ${LANE:-dsv41-tp3}   # clean restart, then re-verify"
    return 1
  fi
  ok "chat canary: $out"
  return 0
}

# ── census ───────────────────────────────────────────────────────────────────
census() {
  printf '%s── fleet census ─────────────────────────────────────────────%s\n' "$B" "$N"
  if command -v sparkdash-pp-cli >/dev/null 2>&1; then
    echo "  (sparkDash — LLM lanes only; the creative engine is invisible here by design)"
    if ! sparkdash-pp-cli status --agent 2>&1 | sed 's/^/    /'; then
      warn "sparkdash-pp-cli status failed — falling back to docker probes only"
    fi
  else
    warn "sparkdash-pp-cli not on PATH — falling back to docker probes only"
  fi
  echo
  echo "  per-node containers (authoritative for occupancy):"
  local n o
  for n in spark1 spark2 spark3 spark4; do
    o="$(docker_names "$n" | grep -E 'ming-layer-web|spark-image-lab|dsv41-[34]x|sglang|glm53' || true)"
    if [[ -z "$o" ]]; then printf '    %-8s %s(free)%s\n' "$n" "$D" "$N"
    else printf '    %-8s %s\n' "$n" "$(echo "$o" | paste -sd' ' -)"; fi
  done
  echo
  echo "  creative engine (spark2 — not an LLM lane, so sparkDash never shows it):"
  local dh ih dc ic
  dh="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$LAB_DESIGN_URL/api/health" 2>/dev/null)"
  ih="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$LAB_IMAGE_URL/" 2>/dev/null)"
  dc="$(sshx spark2 'docker inspect --format "{{.State.Status}}" ming-layer-web 2>/dev/null' || true)"
  ic="$(sshx spark2 'docker inspect --format "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}" spark-image-lab-lab-1 2>/dev/null' || true)"
  printf '    design lab  :8765  http %-3s  container %-8s  %s\n' "${dh:-000}" "${dc:-absent}" "$LAB_DESIGN_URL"
  printf '    image lab   :7862  http %-3s  container %-8s  %s\n' "${ih:-000}" "${ic:-absent}" "$LAB_IMAGE_URL"
  echo
  echo "  DeepSeek lane endpoint: $DSV41_ENDPOINT  (model: $DSV41_MODEL)"
  local models
  models="$(curl -s -m 10 "$DSV41_ENDPOINT/models" 2>/dev/null | python3 -c 'import json,sys
try: print(",".join(m.get("id","?") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("unreachable")' 2>/dev/null)"
  printf '    /v1/models -> %s\n' "${models:-unreachable}"
  printf '    %snote: /v1/models green does NOT mean chat works — use "spark-lane verify <lane>"%s\n' "$D" "$N"
}

# ── lanes ────────────────────────────────────────────────────────────────────
lane_nodes() {
  case "$1" in
    creative-engine) echo "spark2" ;;
    dsv41-tp3)       echo "spark1 spark3 spark4" ;;
    dsv41-tp4)       echo "spark1 spark2 spark3 spark4" ;;
    glm53-tp3)       echo "spark1 spark3 spark4" ;;
    *) return 1 ;;
  esac
}

lane_endpoint() { case "$1" in creative-engine) echo "$LAB_DESIGN_URL + $LAB_IMAGE_URL" ;; glm53-tp3) echo "$GLM53_ENDPOINT" ;; *) echo "$DSV41_ENDPOINT" ;; esac; }
lane_model_id() { case "$1" in creative-engine) echo "ming-image-0.1-design(+ -layer)" ;; glm53-tp3) echo "$GLM53_MODEL" ;; *) echo "$DSV41_MODEL" ;; esac; }

# Occupancy conflict check: returns a non-empty string naming any node that is
# occupied by a lane OTHER than the one being brought up. A node occupied by the
# SAME lane is not a conflict (the "already up?" check handles that case).
# FIXED 2026-09-25: previously only flagged "llm-lane" (unknown) and
# creative-engine-on-spark2, so a named lane like dsv41-tp4 occupying the nodes
# was silently ignored and `up` launched on top of it (wedge risk).
occupancy_conflict() {
  local lane="$1" n occ conflict=""
  for n in $(lane_nodes "$lane"); do
    occ="$(node_occupant "$n")"
    if [[ -n "$occ" && "$occ" != "$lane" ]]; then
      conflict="$conflict $n($occ)"
    fi
  done
  echo "$conflict"
}

# ── creative engine ──────────────────────────────────────────────────────────
lab_image_up() {
  step "image lab" "starting (compose: doctor gate, then detached)"
  sshx spark2 "cd $LAB_IMAGE_DIR && ./spark start" >/dev/null 2>&1
  if [[ $? -ne 0 ]]; then
    note_fail "image-lab-up" "spark start returned non-zero (doctor gate or compose error)"
    NEXT_CMD="ssh spark2 'cd $LAB_IMAGE_DIR && ./spark start'   # run in the foreground to see the error"
    return 1
  fi
  ok "image lab container started"
  return 0
}

lab_design_up() {
  step "design lab" "starting (detached, tailnet bind)"
  # TRAP: the launcher does `docker run --name ming-layer-web` with NO pre-clean, so a
  # leftover container (running or stopped) makes the re-run fail with "name already in
  # use". Remove any leftover first -- this is the only destructive bit, and it only
  # ever touches that one container.
  if sshx spark2 "docker inspect ming-layer-web" >/dev/null 2>&1; then
    info "leftover ming-layer-web present — removing before re-run"
    sshx spark2 "docker rm -f ming-layer-web" >/dev/null 2>&1
  fi
  sshx spark2 "cd $LAB_DESIGN_DIR && MING_DETACH=1 MING_BIND_IP=$LAB_DESIGN_TIP scripts/run_web_gx10.sh" >/dev/null 2>&1
  if [[ $? -ne 0 ]]; then
    note_fail "design-lab-up" "run_web_gx10.sh returned non-zero"
    NEXT_CMD="ssh spark2 'cd $LAB_DESIGN_DIR && MING_DETACH=1 MING_BIND_IP=$LAB_DESIGN_TIP scripts/run_web_gx10.sh'"
    return 1
  fi
  ok "design lab container started"
  return 0
}

lab_wait_design() {
  local t=0 st=""
  step "wait healthy" "design lab container running (budget ${LAB_WAIT}s)"
  # TRAP: the design lab's /api/health deliberately returns 400 with
  # {"detail":"Use the Lab through localhost or an SSH tunnel"} when hit from
  # outside the tailnet bind — it is DESIGNED to refuse external access. So a 200
  # healthcheck can never pass. Judge health by the container's running state
  # instead (the exposure step below still confirms it answers on the tailnet).
  while [[ $t -lt $LAB_WAIT ]]; do
    st="$(sshx spark2 'docker inspect --format "{{.State.Status}}" ming-layer-web 2>/dev/null' || true)"
    if [[ "$st" == "running" ]]; then
      ok "container running after ${t}s"
      return 0
    fi
    sleep 10; t=$((t + 10))
  done
  note_fail "design-lab-health" "ming-layer-web not running within ${LAB_WAIT}s (last: ${st:-absent})"
  NEXT_CMD="ssh spark2 'docker logs --tail 40 ming-layer-web'"
  return 1
}

lab_wait_image() {
  local t=0 h=""
  step "wait healthy" "image lab container healthcheck (budget ${LAB_WAIT}s)"
  while [[ $t -lt $LAB_WAIT ]]; do
    h="$(sshx spark2 'docker inspect --format "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}" spark-image-lab-lab-1 2>/dev/null' || true)"
    case "$h" in
      healthy) ok "healthy after ${t}s"; return 0 ;;
      unhealthy) note_fail "image-lab-health" "container reports unhealthy"
                 NEXT_CMD="ssh spark2 'cd $LAB_IMAGE_DIR && ./spark logs'"; return 1 ;;
    esac
    sleep 10; t=$((t + 10))
  done
  note_fail "image-lab-health" "container did not become healthy within ${LAB_WAIT}s (last: ${h:-absent})"
  NEXT_CMD="ssh spark2 'cd $LAB_IMAGE_DIR && ./spark logs'"
  return 1
}

creative_engine_up() {
  STEPS=5; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  step "occupancy" "spark2 must be free (creative engine is the only lane that uses it)"
  local occ; occ="$(node_occupant spark2)"
  if [[ -n "$occ" && "$occ" != "creative-engine" ]]; then
    note_fail "occupancy" "spark2 is running $occ — park it first"
    NEXT_CMD="spark-lane rotate creative-engine   # parks the conflicting lane, then brings this one up"
    result "$LANE" "up" "$(lane_endpoint "$LANE")" "$(lane_model_id "$LANE")"
    return 1
  fi
  ok "spark2 free (or already this lane)"

  lab_image_up || { result "$LANE" "up" "$(lane_endpoint "$LANE")" "$(lane_model_id "$LANE")"; return 1; }
  lab_design_up || { result "$LANE" "up" "$(lane_endpoint "$LANE")" "$(lane_model_id "$LANE")"; return 1; }
  lab_wait_image || { result "$LANE" "up" "$(lane_endpoint "$LANE")" "$(lane_model_id "$LANE")"; return 1; }
  lab_wait_design || { result "$LANE" "up" "$(lane_endpoint "$LANE")" "$(lane_model_id "$LANE")"; return 1; }

  step "exposure" "both labs answer on the tailnet, nothing wider"
  local dh ih
  dh="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$LAB_DESIGN_URL/api/health")"
  ih="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$LAB_IMAGE_URL/")"
  ok "design http=$dh  image http=$ih  (bound to $LAB_DESIGN_TIP only)"

  result "$LANE" "up" "$(lane_endpoint "$LANE")" "$(lane_model_id "$LANE")" "(no LLM lane: invisible to sparkDash)"
  NEXT_CMD="nothing — creative engine is serving. To free spark2 for a 4-Spark lane: spark-lane down creative-engine"
  return 0
}

creative_engine_down() {
  STEPS=4; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  step "design lab" "stopping + removing ming-layer-web"
  if sshx spark2 "docker inspect ming-layer-web" >/dev/null 2>&1; then
    sshx spark2 "docker rm -f ming-layer-web" >/dev/null 2>&1
    ok "design lab stopped"
  else
    ok "design lab already stopped (no container)"
  fi

  step "image lab" "compose stop"
  sshx spark2 "cd $LAB_IMAGE_DIR && ./spark stop" >/dev/null 2>&1
  ok "image lab stopped"

  step "verify freed" "no lab containers remain on spark2"
  local left; left="$(sshx spark2 "docker ps --format '{{.Names}}' | grep -E 'ming-layer-web|spark-image-lab' || true")"
  if [[ -n "$left" ]]; then
    note_fail "freed" "still running on spark2: $left"
    NEXT_CMD="ssh spark2 'docker rm -f $left'"
    result "$LANE" "down" "$(lane_endpoint "$LANE")" "-"
    return 1
  fi
  step "verify freed" "GPU memory released on spark2"
  local mem; mem="$(sshx spark2 "nvidia-smi --query-gpu=memory.used --format=csv,noheader 2>/dev/null | head -1" || true)"
  ok "spark2 is free for a 4-Spark lane (vram now: ${mem:-unknown})"

  result "$LANE" "down" "-" "-"
  NEXT_CMD="nothing — spark2 is free. Bring up a fleet lane with: spark-lane up dsv41-tp4"
  return 0
}

# ── DeepSeek lanes ───────────────────────────────────────────────────────────
# The kit's own CLI is the source of truth for phases:
#   ./start.sh      doctor -> image -> share -> serve   (TP3)
#   ./start-tp4.sh  same flow with DSV41_LAUNCHER=tp4   (TP4)
dsv41_kit() { case "$1" in dsv41-tp3) echo "$TP3_KIT" ;; dsv41-tp4) echo "$TP4_KIT" ;; esac; }
dsv41_cli() { case "$1" in dsv41-tp3) echo "./start.sh" ;; dsv41-tp4) echo "./start-tp4.sh" ;; esac; }

dsv41_up() {
  local lane="$1" kit cli
  kit="$(dsv41_kit "$lane")"; cli="$(dsv41_cli "$lane")"
  STEPS=7; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "kit" "$kit exists"
  if ! sshx "$DSV41_HEAD_HOST" "test -f $kit/$cli"; then
    if [[ "$lane" == "dsv41-tp4" ]]; then
      note_fail "kit" "$kit not staged yet"
      NEXT_CMD="spark-lane stage dsv41-tp4   # clone + write the fleet profile, then up"
    else
      note_fail "kit" "$kit/$cli missing on $DSV41_HEAD_HOST"
      NEXT_CMD="spark-lane status"
    fi
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "kit present"

  step "doctor" "$cli doctor (post-provision gate — the chain runner re-checks it after build+share)"
  # NOTE (fixed 2026-09-25): this is NOT a hard gate here. On a cold bring-up the
  # worker NFS volumes don't exist until `share` runs inside the chain, so a
  # doctor-first gate always self-refused. The chain runner (lane-up-runner.sh)
  # runs doctor AFTER build+share, where the weight check can actually pass. We
  # still surface a pre-flight doctor here for visibility, but a failure is not
  # fatal — the chain's post-provision doctor is the real gate.
  if ! sshx "$DSV41_HEAD_HOST" "cd $kit && $cli doctor" >/dev/null 2>&1; then
    warn "pre-flight doctor reported issues (expected on a cold bring-up before share) — proceeding; the chain re-runs doctor after build+share"
  else
    ok "doctor clean"
  fi

  # Never disturb a lane that is genuinely serving. Port-open is not proof, so this
  # shortcut requires a real completion.
  step "already up?" "is $DSV41_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$DSV41_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$DSV41_ENDPOINT" "$DSV41_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "chain" "build -> share/pack (first time) -> doctor -> serve, detached"
  scp -q -o ConnectTimeout=10 "$HERE/lane-profiles/lane-up-runner.sh" "$DSV41_HEAD_HOST:$kit/spark-lane-run.sh" 2>/dev/null
  if ! sshx "$DSV41_HEAD_HOST" "test -f $kit/spark-lane-run.sh"; then
    note_fail "chain" "could not place the chain runner on $DSV41_HEAD_HOST"
    NEXT_CMD="scp $HERE/lane-profiles/lane-up-runner.sh $DSV41_HEAD_HOST:$kit/spark-lane-run.sh"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  local log="$kit/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$DSV41_HEAD_HOST" "cd $kit && setsid nohup bash spark-lane-run.sh $lane $kit >> $log 2>&1 < /dev/null"
  ok "launched detached (survives this session); log: $log"
  info "cold 4-Spark build fetches pinned sources on all four nodes — this can take a long while"

  # Wait on two signals: the endpoint becoming healthy, OR the chain dying. A silent
  # cold build must not look like a hang, so progress is printed as it goes.
  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or chain exit (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$DSV41_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$DSV41_HEAD_HOST" "pgrep -f 'spark-lane-run.sh' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$DSV41_HEAD_HOST" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "chain" "the bring-up chain exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'tail -60 $log'"
      result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$DSV41_HEAD_HOST" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $DSV41_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi

  step "identity" "served model name must be $DSV41_MODEL"
  local ids
  ids="$(curl -s -m 10 "$DSV41_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$DSV41_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $DSV41_MODEL"
    NEXT_CMD="ssh $DSV41_HEAD_HOST 'grep -n served-model $kit/.env'"
    result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"
    return 1
  fi
  ok "serving $ids"

  step "canary" "real chat completion (port-open is not proof)"
  canary "$DSV41_ENDPOINT" "$DSV41_MODEL" || { result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL"; return 1; }

  result "$lane" "up" "$DSV41_ENDPOINT" "$DSV41_MODEL" "(chat verified)"
  NEXT_CMD="nothing — lane is serving. To put the creative engine back: spark-lane rotate creative-engine"
  return 0
}

dsv41_down() {
  local lane="$1" kit cli
  kit="$(dsv41_kit "$lane")"; cli="$(dsv41_cli "$lane")"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "stop" "$cli stop (bounded, ${DSV41_STOP_TIMEOUT:-180}s cap)"
  # Incident 2026-09-25: an unbounded ssh call here let a wedged upstream
  # stop.sh hang the head node indefinitely (NVRM OOM storm, no clean
  # shutdown, required a physical power-cycle). `timeout` on the ssh client
  # side can't un-stick a wedged remote host, but it stops this script from
  # sitting there blind -- a timeout is now a loud FAIL with a clear next
  # step instead of a silent multi-hour hang.
  if ! timeout_run "${DSV41_STOP_TIMEOUT:-180}" ssh $SSH_OPTS "$DSV41_HEAD_HOST" "cd $kit && $cli stop" >/dev/null 2>&1; then
    note_fail "stop" "$cli stop returned non-zero OR timed out after ${DSV41_STOP_TIMEOUT:-180}s -- if it timed out, the head node may be wedged; verify with 'ssh $DSV41_HEAD_HOST uptime' before retrying, do not just re-run"
    NEXT_CMD="ssh $DSV41_HEAD_HOST 'cd $kit && $cli stop'   # run in the foreground to see whether it hangs or fails cleanly"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "stop issued"

  step "verify torn down" "no lane containers left on $(lane_nodes "$lane")"
  local n left="" c
  for n in $(lane_nodes "$lane"); do
    c="$(docker_names "$n" | grep -E 'dsv41-[34]x|sglang' || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all required nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights and images were NOT deleted."
  return 0
}

# ── GLM-5.3-Flash EXL3 TP3 lane ─────────────────────────────────────────────
# Mia's recipe: start-tp3.sh is a SINGLE self-contained command (build/sync/serve
# in one), unlike the DSV kit's phased doctor->build->share->serve. So the up flow
# is: occupancy -> kit present -> already-up? -> run start detached -> wait -> canary.
glm53_up() {
  local lane="glm53-tp3"
  STEPS=6; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "occupancy" "$(lane_nodes "$lane")"
  local conflict
  conflict="$(occupancy_conflict "$lane")"
  if [[ -n "$conflict" ]]; then
    note_fail "occupancy" "nodes already taken:$conflict"
    NEXT_CMD="spark-lane rotate $lane   # parks the conflicting lanes, then brings this one up"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "all required nodes free"

  step "kit" "$GLM53_KIT/$GLM53_CLI exists"
  if ! sshx "$GLM53_HEAD_HOST" "test -f $GLM53_KIT/$GLM53_CLI"; then
    note_fail "kit" "$GLM53_KIT/$GLM53_CLI missing on $GLM53_HEAD_HOST"
    NEXT_CMD="spark-lane status"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "kit present"

  step "already up?" "is $GLM53_ENDPOINT already serving completions?"
  if [[ "$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)" == "200" ]]; then
    if canary "$GLM53_ENDPOINT" "$GLM53_MODEL" >/dev/null 2>&1; then
      ok "already serving — no change made (and no restart)"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(already up, unchanged)"
      NEXT_CMD="nothing"
      return 0
    fi
    warn "endpoint answers but the chat canary failed — doing a full bring-up"
  fi
  ok "not serving yet"

  step "start" "$GLM53_CLI start (detached, survives this session)"
  local log="$GLM53_KIT/lane-up-$(date +%Y%m%d-%H%M%S).log"
  launch_detached "$GLM53_HEAD_HOST" "cd $GLM53_KIT && setsid nohup bash $GLM53_CLI start >> $log 2>&1 < /dev/null"
  ok "launched detached; log: $log"
  info "GLM EXL3 TP3 boot is ~15-25 min (weights + drafter + FlashInfer autotune)"

  local ok_wait=0 t=0 code="" alive="" last=""
  step "wait healthy" "endpoint up, or start exited (ceiling ${ENGINE_MAX_WAIT}s)"
  while [[ $t -lt $ENGINE_MAX_WAIT ]]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$GLM53_ENDPOINT/models" 2>/dev/null)"
    [[ "$code" == "200" ]] && { ok "endpoint up after ${t}s"; ok_wait=1; break; }
    alive="$(sshx "$GLM53_HEAD_HOST" "pgrep -f '$GLM53_CLI start' >/dev/null 2>&1 && echo 1 || echo 0" 2>/dev/null || echo 0)"
    if [[ "$alive" != "1" ]]; then
      last="$(sshx "$GLM53_HEAD_HOST" "grep -E '^!!!|FAILED|Error|error:' $log 2>/dev/null | tail -3" || true)"
      note_fail "start" "the start command exited before the endpoint came up"
      info "log: ${last:-<no error line found — read the log>}"
      NEXT_CMD="ssh $GLM53_HEAD_HOST 'tail -60 $log'"
      result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
      return 1
    fi
    if [[ $t -gt 0 && $((t % 120)) -eq 0 ]]; then
      last="$(sshx "$GLM53_HEAD_HOST" "tail -1 $log 2>/dev/null | cut -c1-110" || true)"
      info "+${t}s still working: ${last:-<no log line yet>}"
    fi
    sleep 15; t=$((t + 15))
  done
  if [[ $ok_wait -eq 0 ]]; then
    note_fail "wait-healthy" "no 200 from $GLM53_ENDPOINT/models within ${ENGINE_MAX_WAIT}s (last: $code)"
    NEXT_CMD="spark-lane logs $lane   # then re-run: spark-lane up $lane"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi

  step "identity" "served model name must be $GLM53_MODEL"
  local ids
  ids="$(curl -s -m 10 "$GLM53_ENDPOINT/models" | python3 -c 'import json,sys
try: print(" ".join(m.get("id","") for m in json.load(sys.stdin).get("data",[])))
except Exception: print("")' 2>/dev/null)"
  if [[ "$ids" != *"$GLM53_MODEL"* ]]; then
    note_fail "identity" "endpoint serves [$ids], expected $GLM53_MODEL"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'grep -n SERVED_MODEL_NAME $GLM53_KIT/.env.tp3'"
    result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"
    return 1
  fi
  ok "serving $ids"

  step "canary" "real chat completion (port-open is not proof)"
  canary "$GLM53_ENDPOINT" "$GLM53_MODEL" || { result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL"; return 1; }

  result "$lane" "up" "$GLM53_ENDPOINT" "$GLM53_MODEL" "(chat verified)"
  NEXT_CMD="nothing — lane is serving. To put the creative engine back: spark-lane rotate creative-engine"
  return 0
}

glm53_down() {
  local lane="glm53-tp3"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"

  step "stop" "$GLM53_CLI stop (bounded, ${DSV41_STOP_TIMEOUT:-180}s cap)"
  if ! timeout_run "${DSV41_STOP_TIMEOUT:-180}" ssh $SSH_OPTS "$GLM53_HEAD_HOST" "cd $GLM53_KIT && $GLM53_CLI stop" >/dev/null 2>&1; then
    note_fail "stop" "$GLM53_CLI stop returned non-zero OR timed out after ${DSV41_STOP_TIMEOUT:-180}s -- if it timed out, the head node may be wedged; verify with 'ssh $GLM53_HEAD_HOST uptime' before retrying"
    NEXT_CMD="ssh $GLM53_HEAD_HOST 'cd $GLM53_KIT && $GLM53_CLI stop'   # run in the foreground to see whether it hangs or fails cleanly"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "stop issued"

  step "verify torn down" "no lane containers left on $(lane_nodes "$lane")"
  local n left="" c
  for n in $(lane_nodes "$lane"); do
    c="$(docker_names "$n" | grep -E 'glm53|exl3' || true)"
    [[ -n "$c" ]] && left="$left $n:$c"
  done
  if [[ -n "$left" ]]; then
    note_fail "torn-down" "containers still present:$left"
    NEXT_CMD="spark-lane status   # inspect, then re-run down"
    result "$lane" "down" "-" "-"
    return 1
  fi
  ok "all required nodes released"

  result "$lane" "down" "-" "-"
  NEXT_CMD="nothing — nodes released. Weights and images were NOT deleted."
  return 0
}

# ── stage (TP4 kit deploy, idempotent) ───────────────────────────────────────
stage_tp4() {
  STEPS=4; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  step "clone" "$REPO_URL -> $TP4_KIT"
  if sshx "$DSV41_HEAD_HOST" "test -d $TP4_KIT/.git"; then
    ok "already cloned (leaving it in place)"
  else
    if ! sshx "$DSV41_HEAD_HOST" "git clone -q $REPO_URL $TP4_KIT"; then
      note_fail "clone" "git clone failed on $DSV41_HEAD_HOST"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'git clone $REPO_URL $TP4_KIT'"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    ok "cloned"
  fi

  step "profile" ".env.tp4 = upstream example + our fleet deltas (deterministic builder)"
  if sshx "$DSV41_HEAD_HOST" "test -f $TP4_KIT/.env.tp4"; then
    info "profile already present — NOT overwritten (rm it to rebuild deliberately)"
  else
    local prof
    if [[ ! -f "$HERE/lane-profiles/build-dsv41-tp4-env.py" ]]; then
      note_fail "profile" "builder missing: $HERE/lane-profiles/build-dsv41-tp4-env.py"
      NEXT_CMD="spark-lane stage dsv41-tp4"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    scp -q -o ConnectTimeout=10 "$HERE/lane-profiles/build-dsv41-tp4-env.py" "$DSV41_HEAD_HOST:$TP4_KIT/"
    prof="$(sshx "$DSV41_HEAD_HOST" "cd $TP4_KIT && python3 build-dsv41-tp4-env.py ." 2>&1)"
    printf '%s\n' "$prof" | sed 's/^/        /'
    if ! printf '%s' "$prof" | grep -q '^RESULT: PASS'; then
      note_fail "profile" "builder refused to produce a valid .env.tp4 (see output above)"
      NEXT_CMD="ssh $DSV41_HEAD_HOST 'cd $TP4_KIT && python3 build-dsv41-tp4-env.py .'"
      result "dsv41-tp4" "stage" "-" "-"; return 1
    fi
    ok "profile built and self-verified"
  fi

  # Bug fixed 2026-09-25: this used to require a full local copy of the 516G
  # checkpoint on ALL FOUR nodes, which both isn't how the recipe actually
  # works and made TP4 physically impossible on spark4 (916G disk, only
  # 164G free). The profile we just built has NFS_SHARE=1 (see
  # .env.tp4 / start.sh's own doctor+serve logic) -- same design as TP3:
  # only the HEAD keeps the local checkpoint at $MODEL_DIR, and workers
  # mount it read-only over NFSv4 on the CX7 fabric via the dsv41-nfs
  # exporter. So the real precondition is just "does the head have a
  # complete local copy", not "does every node".
  step "weights" "head node has the local checkpoint (workers read it over NFS, NFS_SHARE=1)"
  if ! sshx "$DSV41_HEAD_HOST" "test -d /var/tmp/models/DeepSeek-V4.1-Flash"; then
    note_fail "weights" "model dir missing on head ($DSV41_HEAD_HOST) -- this one actually needs a local copy"
    NEXT_CMD="spark-lane status   # stage weights on $DSV41_HEAD_HOST first (fabric transfer, not LAN)"
    result "dsv41-tp4" "stage" "-" "-"; return 1
  fi
  ok "head has the checkpoint; workers will mount it over NFS during 'up' (no local copy needed)"

  result "dsv41-tp4" "stage" "-" "-"
  NEXT_CMD="spark-lane up dsv41-tp4   # doctor -> build -> share/pack -> serve (detached). A cold build needs github.com + pypi.org and takes a long while; watch it with: spark-lane logs dsv41-tp4"
  return 0
}

# ── verify ───────────────────────────────────────────────────────────────────
verify_lane() {
  local lane="$1"
  STEPS=3; STEPNO=0; FAILED=0; NEXT_CMD="nothing"
  if [[ "$lane" == "creative-engine" ]]; then
    # TRAP: the design lab's /api/health deliberately returns 400 with
    # {"detail":"Use the Lab through localhost or an SSH tunnel"} when hit from
    # outside the tailnet bind — it is DESIGNED to refuse external access. So a 200
    # check can never pass. Judge the design lab by its container running state.
    step "design lab" "ming-layer-web container running (api/health refuses external access by design)"
    local ds; ds="$(sshx spark2 'docker inspect --format "{{.State.Status}}" ming-layer-web 2>/dev/null' || true)"
    [[ "$ds" == "running" ]] && ok "container running" || { note_fail "design-lab" "container ${ds:-absent}"; NEXT_CMD="spark-lane up creative-engine"; }
    step "image lab" "$LAB_IMAGE_URL/ + container health"
    local ih; ih="$(curl -s -o /dev/null -w '%{http_code}' -m 8 "$LAB_IMAGE_URL/")"
    [[ "$ih" == "200" ]] && ok "200" || { note_fail "image-lab" "http $ih"; NEXT_CMD="spark-lane up creative-engine"; }
    result "$lane" "verify" "$(lane_endpoint "$lane")" "$(lane_model_id "$lane")"
    return $FAILED
  fi
  local ep model
  ep="$(lane_endpoint "$lane")"; model="$(lane_model_id "$lane")"
  step "endpoint" "$ep/models"
  local code; code="$(curl -s -o /dev/null -w '%{http_code}' -m 10 "$ep/models")"
  if [[ "$code" != "200" ]]; then
    warn "http $code — falling through to a timed canary anyway (list-models is not proof)"
  else ok "200"; fi
  step "canary" "real chat completion"
  canary "$ep" "$model"
  result "$lane" "verify" "$ep" "$model"
  return $FAILED
}

# ── dispatch ─────────────────────────────────────────────────────────────────
usage() {
  cat <<USAGE
spark-lane — one-shot lane bring-up / teardown / rotation (DGX Spark fleet)

  spark-lane                     census: what is on every Spark right now
  spark-lane lanes               list lanes + the nodes each needs
  spark-lane up    <lane>        bring a lane up   (refuses if a required node is taken)
  spark-lane down  <lane>        park a lane       (verifies it really stopped)
  spark-lane verify <lane>       health only, changes nothing
  spark-lane rotate <lane>       park conflicting lanes, then bring this one up
  spark-lane stage dsv41-tp4     clone + fleet profile + weight check (no serve)

lanes:
  creative-engine   spark2        image lab :7862 + design lab :8765
  dsv41-tp3         spark1,3,4    DeepSeek V4.1-Flash TP3 -> $DSV41_ENDPOINT
  dsv41-tp4         spark1-4      DeepSeek V4.1-Flash TP4 -> $DSV41_ENDPOINT  (fast line)
  glm53-tp3         spark1,3,4    GLM-5.3-Flash EXL3 TP3  -> $GLM53_ENDPOINT

The DeepSeek endpoint and model name are stable across TP3/TP4: $DSV41_ENDPOINT / $DSV41_MODEL
The GLM lane serves a distinct identity: $GLM53_ENDPOINT / $GLM53_MODEL
USAGE
}

ACT="${1:-status}"
LANE="${2:-}"

case "$ACT" in
  status|census) census ;;
  lanes)
    for l in creative-engine dsv41-tp3 dsv41-tp4 glm53-tp3; do
      printf '%-16s nodes: %-26s endpoint: %s\n' "$l" "$(lane_nodes "$l")" "$(lane_endpoint "$l")"
    done ;;
  up)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    case "$LANE" in creative-engine) creative_engine_up ;; glm53-tp3) glm53_up ;; *) dsv41_up "$LANE" ;; esac ;;
  down)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    case "$LANE" in creative-engine) creative_engine_down ;; glm53-tp3) glm53_down ;; *) dsv41_down "$LANE" ;; esac ;;
  verify)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    verify_lane "$LANE" ;;
  rotate)
    [[ -z "$LANE" ]] && { usage; exit 2; }
    lane_nodes "$LANE" >/dev/null || { echo "unknown lane: $LANE" >&2; usage; exit 2; }
    echo "${B}── rotate: park everything that $LANE needs, then bring it up ──${N}"
    occ_list=""
    for n in $(lane_nodes "$LANE"); do
      o="$(node_occupant "$n")"
      [[ -n "$o" ]] && occ_list="$occ_list $o"
    done
    for other in creative-engine dsv41-tp3 dsv41-tp4 glm53-tp3; do
      [[ "$other" == "$LANE" ]] && continue
      case " $occ_list " in *" $other "*) echo "${Y}parks $other${N}"; "${0:-$HERE/spark-lane}" down "$other" || true ;; esac
    done
    exec "${0:-$HERE/spark-lane}" up "$LANE" ;;
  doctor)
    kit="$(dsv41_kit "${LANE:-}")"
    [[ -n "$kit" ]] || { echo "usage: spark-lane doctor <dsv41-tp3|dsv41-tp4>" >&2; exit 2; }
    cli="$(dsv41_cli "$LANE")"
    echo "${B}$cli doctor${N} on $DSV41_HEAD_HOST ($kit)"
    sshx "$DSV41_HEAD_HOST" "cd $kit && $cli doctor"; rc=$?
    printf 'RESULT: %s lane=%s action=doctor\n' "$([[ $rc -eq 0 ]] && echo PASS || echo FAIL)" "$LANE"
    if [[ $rc -eq 0 ]]; then printf 'NEXT: spark-lane up %s\n' "$LANE"; else printf 'NEXT: read the failure above\n'; fi
    exit $rc ;;
  logs)
    case "${LANE:-}" in
      glm53-tp3) kit="$GLM53_KIT"; host="$GLM53_HEAD_HOST" ;;
      dsv41-tp3|dsv41-tp4) kit="$(dsv41_kit "$LANE")"; host="$DSV41_HEAD_HOST" ;;
      *) echo "usage: spark-lane logs <dsv41-tp3|dsv41-tp4|glm53-tp3>" >&2; exit 2 ;;
    esac
    echo "${B}newest bring-up log on $host${N} (tail ${TAIL:-40})"
    sshx "$host" "f=\$(ls -1t $kit/lane-up-*.log 2>/dev/null | head -1); if [[ -n \"\$f\" ]]; then echo \"--- \$f\"; tail -${TAIL:-40} \"\$f\"; else echo 'no lane-up log yet'; fi" ;;
  stage)
    [[ "$LANE" == "dsv41-tp4" ]] || { echo "only 'stage dsv41-tp4' is supported" >&2; exit 2; }
    stage_tp4 ;;
  help|-h|--help) usage ;;
  *) echo "unknown action: $ACT" >&2; usage; exit 2 ;;
esac